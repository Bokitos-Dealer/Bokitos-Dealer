# Copy to .env and fill in. Everything is optional; features switch on when set.
PORT=3000
# Public address of the shop, used for payment return links.
PUBLIC_URL=https://www.your-domain.eu
# Set to 1 when running behind a reverse proxy / load balancer.
TRUST_PROXY=

# Admin page at /admin
ADMIN_PASSWORD=

# Online payments (Stripe Checkout). Webhook endpoint: <PUBLIC_URL>/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bank transfer details shown to customers who choose prepayment
BANK_IBAN=
BANK_HOLDER=

# Emails through Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Bokitos Air <orders@your-domain.eu>
SHOP_EMAIL=

# Where orders are stored (JSON file)
DATA_DIR=data
