        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Amsterdam</string>
            <string name="Source"><![CDATA[--!strict
-- Lists the data modules of Amsterdam. Generated by tools/osm_to_luau.py.

return {
	meta = require(script.Meta),
	buildings = { script.Buildings1, script.Buildings2, script.Buildings3, script.Buildings4, script.Buildings5, script.Buildings6, script.Buildings7, script.Buildings8, script.Buildings9, script.Buildings10, script.Buildings11, script.Buildings12 },
	roads = { script.Roads1, script.Roads2 },
	areas = { script.Areas1 },
	props = { script.Props1 },
	lanes = { script.Lanes1, script.Lanes2 },
}
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="14">
            <Properties>
              <string name="Name">Areas1</string>
              <string name="Source"><![CDATA[-- Water, parks and bridges of Amsterdam (part 1)
-- Map data (c) OpenStreetMap contributors, ODbL. Generated by tools/osm_to_luau.py.
