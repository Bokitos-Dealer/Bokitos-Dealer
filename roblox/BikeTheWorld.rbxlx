	spawn = { x = -2572, z = -4366, yaw = -0.249 },
	landmarks = {
		{ id = "timessquare", name = "Times Square", x = -2530, z = -4422, radius = 600, fact = "Times Square is so bright at night that it is called 'the crossroads of the world'. On New Year's Eve a giant ball drops here." },
		{ id = "empire", name = "Empire State Building", x = -2665, z = 6146, radius = 500, fact = "The Empire State Building is 443 metres tall with its antenna. It was built in only 410 days, in 1931!" },
		{ id = "chrysler", name = "Chrysler Building", x = 5945, z = 2631, radius = 450, fact = "The Chrysler Building has a shiny steel crown with triangle windows, and steel eagles looking out over the city." },
		{ id = "grandcentral", name = "Grand Central Terminal", x = 4444, z = 1404, radius = 600, fact = "Grand Central has 44 train platforms, more than any other station in the world. Its ceiling is painted with stars!" },
		{ id = "flatiron", name = "Flatiron Building", x = -6038, z = 14304, radius = 400, fact = "The Flatiron Building is shaped like an old clothes iron. At its pointy end it is only 2 metres wide!" },
		{ id = "rockefeller", name = "Rockefeller Center", x = 3204, z = -5240, radius = 600, fact = "Rockefeller Center has a famous ice rink and, at Christmas, a giant Christmas tree with thousands of lights." },
		{ id = "bryantpark", name = "Bryant Park", x = -590, z = 442, radius = 600, fact = "Bryant Park sits right behind the New York Public Library. In winter it gets a free ice skating rink." },
		{ id = "library", name = "New York Public Library", x = 253, z = 884, radius = 400, fact = "Two famous stone lions guard the library's front steps. Their names are Patience and Fortitude." },
		{ id = "centralpark", name = "Central Park", x = 4638, z = -13486, radius = 1200, fact = "Central Park is a giant park in the middle of Manhattan, bigger than the whole country of Monaco!" },
		{ id = "madisonsquare", name = "Madison Square Park", x = -4638, z = 13265, radius = 500, fact = "In 1912 Madison Square had the first public Christmas tree with electric lights in the United States." },
	},
