              <string name="Source"><![CDATA[--!strict
-- Amsterdam: settings and points of interest. Generated by tools/osm_to_luau.py.
-- Map data (c) OpenStreetMap contributors, ODbL.
return {
	name = "Amsterdam",
	style = "amsterdam",
	-- playable area in decimetres (x east, z south)
	bounds = { -10075, -12592, 10075, 12592 },
	waterLevel = -4, -- studs
	levelHeight = 31, -- decimetres
	spawn = { x = 1631, z = -3316, yaw = 1.532 },
	landmarks = {
		{ id = "dam", name = "Dam Square", x = 1291, z = -3427, radius = 450, fact = "Amsterdam began here! About 750 years ago people built a dam in the river Amstel, and that is how the city got its name." },
		{ id = "palace", name = "Royal Palace", x = 204, z = -3427, radius = 450, fact = "The Royal Palace was built in 1648 as the city hall. It stands on 13,659 wooden poles hammered into the ground!" },
		{ id = "monument", name = "National Monument", x = 1937, z = -3150, radius = 220, fact = "This white stone pillar on the Dam remembers the people who died in the Second World War." },
		{ id = "centraal", name = "Centraal Station", x = 6117, z = -9838, radius = 700, fact = "Amsterdam Centraal opened in 1889. It stands on three man-made islands and almost 9,000 wooden poles." },
		{ id = "westerkerk", name = "Westerkerk", x = -4826, z = -5085, radius = 450, fact = "The Westerkerk tower is 85 metres tall, the highest church tower in Amsterdam. On top sits a blue imperial crown." },
		{ id = "annefrank", name = "Anne Frank House", x = -4758, z = -5748, radius = 220, fact = "Anne Frank hid in a secret annex in this house during the Second World War and wrote her famous diary here." },
		{ id = "munt", name = "Munttoren", x = 1631, z = 3758, radius = 300, fact = "The Mint Tower: in 1672 coins were made here, because during a war Amsterdam could not reach the normal mint." },
		{ id = "bloemenmarkt", name = "Flower Market", x = 68, z = 3537, radius = 350, fact = "The Bloemenmarkt is the only floating flower market in the world. Its shops stand on boats in the Singel canal!" },
		{ id = "magerebrug", name = "Skinny Bridge", x = 7748, z = 7296, radius = 300, fact = "The Magere Brug is a white drawbridge over the river Amstel. At night it is lit up with 1,200 little lights." },
		{ id = "rijksmuseum", name = "Rijksmuseum", x = -3942, z = 11054, radius = 750, fact = "The Rijksmuseum holds Rembrandt's famous painting The Night Watch. There is a bike path right through the middle of the building!" },
		{ id = "leidseplein", name = "Leidseplein", x = -5641, z = 6522, radius = 400, fact = "Leidseplein is one of the busiest squares in Amsterdam, full of trams, street performers and lights." },
		{ id = "begijnhof", name = "Begijnhof", x = -680, z = 884, radius = 300, fact = "The Begijnhof is a quiet hidden courtyard. Het Houten Huys here is one of only two wooden houses left in the old city." },
	},
