	landmarks = {
		{ id = "eiffel", name = "Eiffel Tower", x = -7689, z = 6345, radius = 950, fact = "The Eiffel Tower is 330 metres tall and was built in 1889. At night it sparkles with 20,000 lights!" },
		{ id = "trocadero", name = "Trocadéro", x = -12010, z = 2100, radius = 700, fact = "From the Trocadéro terrace you get the most famous view of the Eiffel Tower, right across the river Seine." },
		{ id = "arc", name = "Arc de Triomphe", x = -7294, z = -10811, radius = 600, fact = "The Arc de Triomphe is 50 metres tall. Twelve avenues meet at the giant roundabout around it!" },
		{ id = "champs", name = "Champs-Élysées", x = 2050, z = -6411, radius = 600, fact = "The Champs-Élysées is almost 2 km long. Every summer the Tour de France bike race finishes here!" },
		{ id = "concorde", name = "Place de la Concorde", x = 11864, z = -1769, radius = 600, fact = "The obelisk in the middle of the square is more than 3,000 years old and came all the way from Egypt." },
		{ id = "grandpalais", name = "Grand Palais", x = 5492, z = -2321, radius = 750, fact = "The Grand Palais has a giant glass roof held up by 8,500 tonnes of iron, built for the World's Fair of 1900." },
		{ id = "alexandre", name = "Pont Alexandre III", x = 6298, z = 111, radius = 450, fact = "Pont Alexandre III is the fanciest bridge in Paris, with golden winged horses on its four corners." },
		{ id = "invalides", name = "Les Invalides", x = 5492, z = 9949, radius = 800, fact = "The golden dome of Les Invalides is 107 metres high. The emperor Napoleon is buried underneath it." },
		{ id = "champdemars", name = "Champ de Mars", x = -4687, z = 9285, radius = 900, fact = "The Champ de Mars is the long park next to the Eiffel Tower. Parisians love to have picnics here." },
		{ id = "seine", name = "The Seine", x = -2563, z = 1658, radius = 600, fact = "The Seine flows 777 km to the sea. In Paris, 37 bridges cross it!" },
