      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Game settings. Edit prices, Robux item IDs and cities here.
--
-- ROBUX ITEMS: create each Game Pass / Developer Product on the Roblox
-- Creator Dashboard (create.roblox.com > your experience > Monetization),
-- then paste its ID below. Items with id = 0 show "Coming soon" in the shop.

local Config = {}

Config.GameName = "Bike the World"

-- 1 metre = 3 studs (a Roblox character is about 1.7 m tall)
Config.M = 3

-- Coins you earn by playing
Config.Rewards = {
	PerKilometre = 12, -- riding distance
	CoinPickup = 5, -- spinning coins on the streets
	Landmark = 50, -- first visit of a famous place
	DeliveryBase = 30, -- delivering an order
	DeliveryTimeBonus = 30, -- extra when you are fast
	DailyBonus = 75, -- once per day
}

export type BikeDef = {
	id: string,
	name: string,
	price: number, -- coins (0 = free)
	gamePass: string?, -- key into Config.GamePasses if it is a Robux bike
	topSpeed: number, -- metres per second without boost
	power: number, -- acceleration multiplier
	handling: number, -- steering multiplier
	wheel: number, -- wheel radius in metres
	style: string, -- model style
	color: Color3,
	description: string,
}

Config.Bikes = {
	{ id = "city", name = "Dutch City Bike", price = 0, topSpeed = 7.5, power = 1.0, handling = 1.0, wheel = 0.355, style = "city", color = Color3.fromRGB(25, 25, 28), description = "The classic Dutch 'omafiets'. Comfy and cool." },
	{ id = "bmx", name = "BMX", price = 250, topSpeed = 8.0, power = 1.3, handling = 1.35, wheel = 0.26, style = "bmx", color = Color3.fromRGB(0, 170, 255), description = "Small, quick and super nimble." },
	{ id = "cargo", name = "Cargo Bike", price = 400, topSpeed = 7.0, power = 0.95, handling = 0.8, wheel = 0.3, style = "cargo", color = Color3.fromRGB(60, 110, 70), description = "A Dutch bakfiets with a big box in front." },
	{ id = "racer", name = "Racing Bike", price = 900, topSpeed = 10.5, power = 1.35, handling = 0.95, wheel = 0.34, style = "racer", color = Color3.fromRGB(220, 40, 40), description = "Thin tyres, drop bars, very fast!" },
	{ id = "ebike", name = "E-Bike", price = 1500, topSpeed = 10.0, power = 1.8, handling = 1.0, wheel = 0.35, style = "city", color = Color3.fromRGB(240, 240, 240), description = "An electric motor helps you pedal." },
	{ id = "golden", name = "Golden Bike", price = 0, gamePass = "GoldenBike", topSpeed = 11.0, power = 1.6, handling = 1.25, wheel = 0.35, style = "racer", color = Color3.fromRGB(255, 196, 40), description = "Shiny gold and the fastest bike in town." },
} :: { BikeDef }

export type ColorDef = { id: string, name: string, price: number, color: Color3 }
Config.Colors = {
	{ id = "black", name = "Black", price = 0, color = Color3.fromRGB(25, 25, 28) },
	{ id = "red", name = "Red", price = 0, color = Color3.fromRGB(205, 45, 45) },
	{ id = "blue", name = "Blue", price = 50, color = Color3.fromRGB(40, 100, 220) },
	{ id = "mint", name = "Mint", price = 50, color = Color3.fromRGB(130, 210, 180) },
	{ id = "pink", name = "Pink", price = 50, color = Color3.fromRGB(255, 120, 190) },
	{ id = "orange", name = "Orange", price = 50, color = Color3.fromRGB(255, 140, 30) },
	{ id = "purple", name = "Purple", price = 50, color = Color3.fromRGB(140, 80, 210) },
	{ id = "white", name = "White", price = 50, color = Color3.fromRGB(240, 240, 240) },
} :: { ColorDef }

export type CosmeticDef = { id: string, name: string, price: number, gamePass: string?, description: string }
Config.Cosmetics = {
	{ id = "helmet", name = "Helmet", price = 100, description = "Safety first!" },
	{ id = "flowers", name = "Flower Basket", price = 150, description = "Tulips in your front basket." },
	{ id = "streamers", name = "Streamers", price = 80, description = "Colourful streamers on the handlebars." },
	{ id = "rainbow", name = "Rainbow Trail", price = 0, gamePass = "RainbowTrail", description = "Leave a rainbow behind you." },
	{ id = "puppy", name = "Puppy in Basket", price = 0, gamePass = "Puppy", description = "A happy puppy rides along." },
} :: { CosmeticDef }

export type PassDef = { id: number, name: string, suggestedPrice: number, description: string }

-- Robux: Game Passes (bought once, kept forever)
Config.GamePasses = {
	DoubleCoins = { id = 0, name = "2x Coins", suggestedPrice = 199, description = "Earn double coins from everything." },
	GoldenBike = { id = 0, name = "Golden Bike", suggestedPrice = 149, description = "The fastest bike, in shiny gold." },
	RainbowTrail = { id = 0, name = "Rainbow Trail", suggestedPrice = 99, description = "A rainbow trail behind your bike." },
	Puppy = { id = 0, name = "Puppy in Basket", suggestedPrice = 99, description = "A puppy that rides in your basket." },
} :: { [string]: PassDef }

-- Robux: Developer Products (can be bought many times)
export type ProductDef = { key: string, id: number, coins: number, suggestedPrice: number }
Config.Products = {
	{ key = "Coins100", id = 0, coins = 100, suggestedPrice = 25 },
	{ key = "Coins550", id = 0, coins = 550, suggestedPrice = 99 },
	{ key = "Coins1500", id = 0, coins = 1500, suggestedPrice = 249 },
} :: { ProductDef }

export type CityDef = {
	id: string,
	name: string,
	country: string,
	origin: Vector3,
	color: Color3,
	food: { string },
	rainChance: number,
	module: string,
}

Config.Cities = {
	{ id = "amsterdam", name = "Amsterdam", country = "Netherlands", origin = Vector3.new(9000, 0, 0), color = Color3.fromRGB(230, 60, 40), food = { "stroopwafels", "a cheese wheel", "poffertjes", "bitterballen", "a tulip bouquet" }, rainChance = 0.35, module = "Amsterdam" },
	{ id = "paris", name = "Paris", country = "France", origin = Vector3.new(-9000, 0, 0), color = Color3.fromRGB(40, 80, 200), food = { "croissants", "a baguette", "macarons", "crêpes", "a fresh flower bunch" }, rainChance = 0.1, module = "Paris" },
	{ id = "newyork", name = "New York", country = "USA", origin = Vector3.new(0, 0, 9000), color = Color3.fromRGB(250, 200, 40), food = { "a pizza slice", "bagels", "hot dogs", "a pretzel", "a big cookie" }, rainChance = 0.1, module = "NewYork" },
} :: { CityDef }

Config.HubOrigin = Vector3.new(0, 0, 0)

-- Day/night: one full day takes this many real minutes
Config.DayLengthMinutes = 24

-- Data store name (change the version suffix to wipe all saves)
Config.DataStoreName = "BikeTheWorld_v1"

-- Optional sound IDs (upload the WAV files from the roblox/assets folder,
-- or pick free sounds in the Creator Store, then paste "rbxassetid://123").
Config.Sounds = {
	Bell = "",
	Coin = "",
	Landmark = "",
	Purchase = "",
	Splash = "rbxasset://sounds/impact_water.mp3",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">Kit</string>
          <string name="Source"><![CDATA[--!strict
-- Reusable building and street-furniture generators (pure data).
-- Building frame: origin at the bottom centre of the facade, local -Z points
-- out to the street, the building extends towards local +Z.

local Build = require(script.Parent.Build)

type BuildList = Build.BuildList
type Rng = Build.Rng

local Kit = {}

local M = 3 -- studs per metre

Kit.M = M

local GLASS = 0x26323d
local GLASS_TAG_CHANCE = 0.35

--- Yaw that makes a building face along the normal (nx, nz).
function Kit.faceYaw(nx: number, nz: number): number
	return math.atan2(-nx, -nz)
end

local function window(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, lx: number, ly: number, w: number, h: number, col: number?)
	local tag = if rng:chance(GLASS_TAG_CHANCE) then "NightWindow" else nil
	b:obox(ox, oz, yaw, lx, ly, -0.18, w, h, 0.36, { mat = "SmoothPlastic", col = col or GLASS, refl = 0.15, tag = tag, shadow = false, coll = false })
end

-- ---------------------------------------------------------------------------
-- Amsterdam canal house
-- ---------------------------------------------------------------------------
local BRICKS = { 0x5a2c22, 0x7d3a2b, 0x8a4430, 0x2b2726, 0x6e4a35, 0x9b5a3c }
local PLASTER = { 0xe9e4d8, 0x7e8a86, 0xc8b089, 0x6b2420, 0x3f4b45 }
local DOORS = { 0x1f3b2d, 0x161616, 0x1d2a44, 0x5a1c1c, 0x2d4a3e }
local GABLES = { "triangle", "step", "neck", "bell", "cornice", "cornice" }

function Kit.canalHouse(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number, floors: number?)
	local nFloors = floors or rng:int(3, 4)
	local plaster = rng:chance(0.3)
	local col = if plaster then rng:pick(PLASTER) else rng:pick(BRICKS)
	local mat = if plaster then "Plaster" else "Brick"
	local groundH = 3.6 * M
	local floorH = 3.0 * M
	local H = groundH + (nFloors - 1) * floorH
	-- slight lean, like the real "dancing houses"
	local lean = if rng:chance(0.3) then rng:range(-0.025, 0.025) else 0
	b:obox(ox, oz, yaw, 0, H / 2, d / 2, w, H, d, { mat = mat, col = col, roll = lean })
	-- windows
	local bays = if w < 8.5 * M then 2 else 3
	local doorBay = rng:int(1, bays)
	for f = 0, nFloors - 1 do
		local base = if f == 0 then 0 else groundH + (f - 1) * floorH
		local fh = if f == 0 then groundH else floorH
		for i = 1, bays do
			local lx = -w / 2 + (i - 0.5) * w / bays
			if f == 0 and i == doorBay then
				b:obox(ox, oz, yaw, lx, 1.15 * M + 0.2, -0.15, 1.1 * M, 2.3 * M, 0.3, { mat = "Wood", col = rng:pick(DOORS) })
				b:obox(ox, oz, yaw, lx, 0.25, -0.6, 1.5 * M, 0.5, 1.2, { mat = "Concrete", col = 0x8d877c })
			else
				window(b, rng, ox, oz, yaw, lx, base + fh * 0.55, 1.15 * M, (if f == 0 then 1.9 else 1.75) * M)
			end
		end
	end
	-- gable / roof
	local gable = rng:pick(GABLES)
	local roofCol = 0x2c2b2e
	if gable == "cornice" then
		b:obox(ox, oz, yaw, 0, H + 0.4, -0.2, w + 0.6, 0.8, 1.4, { mat = "SmoothPlastic", col = 0xf2efe8 })
		b:obox(ox, oz, yaw, 0, H + 0.5, d / 2 + 0.5, w - 0.4, 1.0, d - 1, { mat = "Slate", col = roofCol })
	else
		local hg = math.min(w * 0.85, 7 * M)
		-- pitched roof behind the gable
		b:prism(ox, oz, yaw, 0, H, d / 2 + 0.6, w, hg * 0.85, d - 1.2, { mat = "ClayRoofTiles", col = roofCol })
		if gable == "triangle" then
			b:prism(ox, oz, yaw, 0, H, -0.05, w + 0.1, hg, 0.6, { mat = mat, col = col })
		elseif gable == "step" then
			local steps = 3
			for s = 1, steps do
				local sw = w * (1 - (s - 1) * 0.28)
				b:obox(ox, oz, yaw, 0, H + (s - 0.5) * hg / steps, 0.3, sw, hg / steps, 1.2, { mat = mat, col = col })
			end
		else
			local nw = w * 0.45
			b:obox(ox, oz, yaw, 0, H + hg * 0.42, 0.3, nw, hg * 0.84, 1.2, { mat = mat, col = col })
			-- shoulders
			b:prism(ox, oz, yaw, -nw / 2 - (w - nw) / 4, H, 0.3, (w - nw) / 2, hg * 0.35, 1.2, { mat = mat, col = col })
			b:prism(ox, oz, yaw, nw / 2 + (w - nw) / 4, H, 0.3, (w - nw) / 2, hg * 0.35, 1.2, { mat = mat, col = col })
			if gable == "bell" then
				-- rounded top: a cylinder whose axis runs into the facade
				local cx, cz = Build.rot(yaw, 0, 0.3)
				b:cyl(ox + cx, H + hg * 0.84, oz + cz, 1.2, nw / 2, { yaw = yaw + math.pi / 2, mat = mat, col = col })
			else
				b:prism(ox, oz, yaw, 0, H + hg * 0.84, 0.3, nw + 0.6, hg * 0.22, 1.3, { mat = "SmoothPlastic", col = 0xf2efe8 })
			end
		end
		-- hoist beam
		b:obox(ox, oz, yaw, 0, H + hg * 0.55, -0.9, 0.45, 0.45, 2.2, { mat = "Wood", col = 0x2b2420, coll = false })
	end
	-- the front door's position along the facade (for delivery targets)
	local doorLx = -w / 2 + (doorBay - 0.5) * w / bays
	return H, doorLx
end

-- ---------------------------------------------------------------------------
-- Paris: Haussmann building
-- ---------------------------------------------------------------------------
local AWNINGS = { 0x9b1c1c, 0x1f4d2b, 0x1d3557, 0x7a1f3d, 0x3a3a3a }

function Kit.haussmann(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number, shop: boolean?)
	local stone = rng:pick({ 0xe8dcc2, 0xe2d5b8, 0xeee4cf, 0xd9cbb0 })
	local groundH = 4.5 * M
	local floorH = 3.2 * M
	local nFloors = 4
	local H = groundH + nFloors * floorH
	b:obox(ox, oz, yaw, 0, H / 2, d / 2, w, H, d, { mat = "Limestone", col = stone })
	-- shopfront
	if shop ~= false then
		b:obox(ox, oz, yaw, 0, groundH * 0.45, -0.15, w - 1.5, groundH * 0.75, 0.3, { mat = "SmoothPlastic", col = 0x1f262c, refl = 0.2, tag = if rng:chance(0.6) then "NightWindow" else nil, coll = false })
		if rng:chance(0.45) then
			b:obox(ox, oz, yaw, 0, groundH * 0.85, -1.6, w - 2, 0.4, 3.2, { mat = "Fabric", col = rng:pick(AWNINGS), pitch = -0.25, coll = false })
		end
	end
	local bays = math.max(2, math.floor(w / (5 * M)))
	for f = 1, nFloors do
		local base = groundH + (f - 1) * floorH
		for i = 1, bays do
			local lx = -w / 2 + (i - 0.5) * w / bays
			window(b, rng, ox, oz, yaw, lx, base + floorH * 0.5, 1.25 * M, 2.2 * M)
		end
		-- wrought iron balconies on the 2nd and top floors
		if f == 2 or f == nFloors then
			b:obox(ox, oz, yaw, 0, base + 0.2, -0.9, w - 0.4, 0.35, 1.8, { mat = "Limestone", col = stone })
			b:obox(ox, oz, yaw, 0, base + 1.3, -1.7, w - 0.6, 2.0, 0.15, { mat = "Metal", col = 0x1b1b1b, transp = 0.25, coll = false, shadow = false })
		end
	end
	-- cornice and grey zinc mansard roof with dormers
	b:obox(ox, oz, yaw, 0, H + 0.35, -0.3, w + 0.4, 0.7, 1.6, { mat = "Limestone", col = stone })
	local mh = 3.2 * M
	b:owedge(ox, oz, yaw, 0, H + 0.7 + mh / 2, 1.6, w, mh, 3.2, { mat = "Metal", col = 0x6d7378 })
	b:obox(ox, oz, yaw, 0, H + 0.7 + mh / 2, d / 2 + 1.6, w, mh, d - 3.2, { mat = "Metal", col = 0x6d7378 })
	for i = 1, math.max(1, bays - 1) do
		local lx = -w / 2 + (i + 0.0) * w / bays
		b:obox(ox, oz, yaw, lx, H + 0.7 + mh * 0.45, 1.1, 1.1 * M, 1.6 * M, 1.4, { mat = "Limestone", col = stone, coll = false })
	end
	-- chimney
	b:obox(ox, oz, yaw, rng:range(-w / 3, w / 3), H + mh + 2, d * 0.6, 1.5, 3.5, 3, { mat = "Brick", col = 0x9b5a3c })
	return H
end

-- ---------------------------------------------------------------------------
-- New York
-- ---------------------------------------------------------------------------
local TOWER_GLASS = { 0x3c5468, 0x2f4252, 0x50677a, 0x6b7c88, 0x33424d }
local TOWER_STONE = { 0xb8b0a2, 0x8f8676, 0xcfc6b5, 0x7d6c5c, 0xa39684 }

function Kit.skyscraper(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number, h: number)
	local glassy = rng:chance(0.55)
	local col = if glassy then rng:pick(TOWER_GLASS) else rng:pick(TOWER_STONE)
	local mat = if glassy then "Glass" else "Concrete"
	-- lobby
	b:obox(ox, oz, yaw, 0, 3 * M, d / 2, w, 6 * M, d, { mat = "SmoothPlastic", col = 0x1e2328, refl = 0.2 })
	local setback = rng:chance(0.45)
	local segs = if setback then 3 else 1
	local y = 6 * M
	local cw, cd = w, d
	for s = 1, segs do
		local sh = (h - 6 * M) / segs
		b:obox(ox, oz, yaw, 0, y + sh / 2, d / 2, cw, sh, cd, { mat = mat, col = col, refl = if glassy then 0.25 else 0 })
		-- floor bands: a few lit at night
		local bands = math.floor(sh / (12 * M))
		for k = 1, bands do
			local by = y + k * sh / (bands + 1)
			b:obox(ox, oz, yaw, 0, by, d / 2, cw + 0.3, 0.6, cd + 0.3, { mat = "SmoothPlastic", col = if glassy then 0x8899a6 else 0x5d544a, shadow = false, coll = false, tag = if rng:chance(0.5) then "NightWindow" else nil })
		end
		y += sh
		cw *= 0.78
		cd *= 0.78
	end
	if rng:chance(0.35) then
		b:obox(ox, oz, yaw, 0, y + 6, d / 2, 0.8, 12, 0.8, { mat = "Metal", col = 0x9aa0a6 })
		b:obox(ox, oz, yaw, 0, y + 12.5, d / 2, 1.2, 1.2, 1.2, { mat = "Neon", col = 0xff3030, tag = "NightBeacon" })
	end
	return y
end

local BROWN = { 0x6b4436, 0x5c3a2e, 0x7a5040, 0x4f3328, 0x8c6a55 }
function Kit.brownstone(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number)
	local col = rng:pick(BROWN)
	local floorH = 3.2 * M
	local H = 4 * floorH
	b:obox(ox, oz, yaw, 0, H / 2, d / 2, w, H, d, { mat = "Sandstone", col = col })
	for f = 1, 3 do
		for i = 1, 3 do
			window(b, rng, ox, oz, yaw, -w / 2 + (i - 0.5) * w / 3, f * floorH + floorH * 0.5, 1.1 * M, 1.9 * M)
		end
	end
	-- stoop (front steps)
	-- a wedge is tallest at its local +Z side, which here is the building side
	b:owedge(ox, oz, yaw, w * 0.28, floorH * 0.4, -1.8 * M, 1.6 * M, floorH * 0.8, 3.6 * M, { mat = "Sandstone", col = col })
	b:obox(ox, oz, yaw, w * 0.28, floorH * 0.85 + 0.6, -0.15, 1.2 * M, 2.4 * M, 0.3, { mat = "Wood", col = 0x2a1a12 })
	b:obox(ox, oz, yaw, 0, H + 0.4, -0.2, w + 0.4, 0.8, 1.2, { mat = "SmoothPlastic", col = 0x2e2420 })
	return H
end

-- ---------------------------------------------------------------------------
-- Street furniture
-- ---------------------------------------------------------------------------
function Kit.tree(b: BuildList, rng: Rng, x: number, z: number, scale: number?, palette: { number }?)
	local s = (scale or 1) * rng:range(0.85, 1.2)
	local trunkH = 5 * M * s
	b:cyl(x, trunkH / 2, z, trunkH, 0.28 * M * s, { roll = math.pi / 2, mat = "Wood", col = 0x4a3b2f })
	local greens = palette or { 0x3f6b2f, 0x4d7a35, 0x56823a, 0x3a5f2a }
	local leaf = rng:pick(greens)
	b:ball(x, trunkH + 1.6 * M * s, z, 2.7 * M * s, { mat = "LeafyGrass", col = leaf, coll = false })
	b:ball(x + rng:range(-1.2, 1.2) * M * s, trunkH + 0.4 * M * s, z + rng:range(-1.2, 1.2) * M * s, 2.0 * M * s, { mat = "LeafyGrass", col = leaf, coll = false })
end

function Kit.lamp(b: BuildList, x: number, z: number, style: string?)
	local h = 4.8 * M
	b:cyl(x, h / 2, z, h, 0.09 * M, { roll = math.pi / 2, mat = "Metal", col = 0x15171a })
	local head
	if style == "modern" then
		head = b:box(x, h + 0.3, z, 0.9 * M, 0.25 * M, 0.5 * M, { mat = "SmoothPlastic", col = 0xfff1c8, tag = "StreetLight", coll = false })
	else
		b:box(x, h + 0.5 * M + 0.6, z, 0.75 * M, 0.2 * M, 0.75 * M, { mat = "Metal", col = 0x15171a, coll = false })
		head = b:box(x, h + 0.3 * M, z, 0.55 * M, 0.6 * M, 0.55 * M, { mat = "SmoothPlastic", col = 0xfff1c8, tag = "StreetLight", coll = false, shadow = false })
	end
	b:light(head, 40, 1.4, 0xffcf8a)
end

function Kit.bollard(b: BuildList, x: number, z: number)
	b:cyl(x, 1.25, z, 2.5, 0.32, { roll = math.pi / 2, mat = "Metal", col = 0x4a1d16 })
end

function Kit.bench(b: BuildList, x: number, z: number, yaw: number)
	b:obox(x, z, yaw, 0, 1.4, 0, 1.8 * M, 0.3, 0.55 * M, { mat = "Wood", col = 0x6b4a2f })
	b:obox(x, z, yaw, 0, 2.6, 0.75, 1.8 * M, 1.2, 0.2, { mat = "Wood", col = 0x6b4a2f })
	b:obox(x, z, yaw, -0.8 * M, 0.7, 0, 0.3, 1.4, 0.5 * M, { mat = "Metal", col = 0x222222 })
	b:obox(x, z, yaw, 0.8 * M, 0.7, 0, 0.3, 1.4, 0.5 * M, { mat = "Metal", col = 0x222222 })
end

local FRAME_COLS = { 0x141414, 0x141414, 0x1d2533, 0x1f3326, 0xe9e6dd, 0x7d1f1f, 0x8fbfb0 }
--- A parked bike (5 parts). yaw = direction the bike points.
function Kit.parkedBike(b: BuildList, rng: Rng, x: number, z: number, yaw: number)
	local r = 0.35 * M
	local col = rng:pick(FRAME_COLS)
	for _, lz in { -0.56 * M, 0.56 * M } do
		local wx, wz = Build.rot(yaw, 0, lz)
		b:cyl(x + wx, r, z + wz, 0.12, r, { yaw = yaw, mat = "Rubber", col = 0x151515, coll = false, shadow = false })
	end
	b:obox(x, z, yaw, 0, 0.75 * M, 0, 0.15, 0.15, 1.15 * M, { mat = "Metal", col = col, pitch = 0.35, coll = false })
	b:obox(x, z, yaw, 0, 1.0 * M, 0.25 * M, 0.5, 0.25, 0.8, { mat = "Leather", col = 0x3b2a1c, coll = false })
	b:obox(x, z, yaw, 0, 1.06 * M, -0.42 * M, 1.6, 0.15, 0.15, { mat = "Metal", col = 0x9a9da0, coll = false })
end

function Kit.cafeTable(b: BuildList, rng: Rng, x: number, z: number)
	b:cyl(x, 1.2, z, 2.4, 0.15, { roll = math.pi / 2, mat = "Metal", col = 0x222222 })
	b:cyl(x, 2.45, z, 0.15, 1.1, { roll = math.pi / 2, mat = "Marble", col = 0xeeeeee })
	for k = 0, 1 do
		local a = k * math.pi + rng:range(0, 1)
		b:box(x + math.cos(a) * 2.2, 1.4, z + math.sin(a) * 2.2, 1.3, 0.25, 1.3, { mat = "Wood", col = 0x8b5a2b, coll = false })
	end
end

function Kit.hydrant(b: BuildList, x: number, z: number)
	b:cyl(x, 1.1, z, 2.2, 0.45, { roll = math.pi / 2, mat = "Metal", col = 0xc62828 })
	b:ball(x, 2.2, z, 0.5, { mat = "Metal", col = 0xc62828 })
end

function Kit.flowerBox(b: BuildList, rng: Rng, x: number, z: number, yaw: number)
	b:obox(x, z, yaw, 0, 0.6, 0, 3, 1.2, 1.2, { mat = "Wood", col = 0x5a3a22 })
	for i = -1, 1 do
		local cols = { 0xe23d3d, 0xf2c230, 0xf07ab0, 0xffffff, 0xff7f2a }
		local wx, wz = Build.rot(yaw, i * 0.9, 0)
		b:ball(x + wx, 1.45, z + wz, 0.45, { mat = "SmoothPlastic", col = rng:pick(cols), coll = false, shadow = false })
	end
end

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">PartFactory</string>
          <string name="Source"><![CDATA[--!strict
-- Turns one build-list primitive into a Roblox part. Used by the server
-- (whole cities) and by the client (facade details near the player).

local Build = require(script.Parent.Build)

local PartFactory = {}

local MATERIALS: { [string]: Enum.Material } = {
	SmoothPlastic = Enum.Material.SmoothPlastic,
	Plastic = Enum.Material.Plastic,
	Brick = Enum.Material.Brick,
	Cobblestone = Enum.Material.Cobblestone,
	Concrete = Enum.Material.Concrete,
	Asphalt = Enum.Material.Asphalt,
	Pavement = Enum.Material.Pavement,
	Granite = Enum.Material.Granite,
	Limestone = Enum.Material.Limestone,
	Sandstone = Enum.Material.Sandstone,
	Marble = Enum.Material.Marble,
	Slate = Enum.Material.Slate,
	Wood = Enum.Material.Wood,
	WoodPlanks = Enum.Material.WoodPlanks,
	Metal = Enum.Material.Metal,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Fabric = Enum.Material.Fabric,
	Grass = Enum.Material.Grass,
	LeafyGrass = Enum.Material.LeafyGrass,
	Ground = Enum.Material.Ground,
	Sand = Enum.Material.Sand,
	Mud = Enum.Material.Mud,
	Rubber = Enum.Material.Rubber,
	Leather = Enum.Material.Leather,
	Plaster = Enum.Material.Plaster,
	ClayRoofTiles = Enum.Material.ClayRoofTiles,
	RoofShingles = Enum.Material.RoofShingles,
	ForceField = Enum.Material.ForceField,
	Foil = Enum.Material.Foil,
}
PartFactory.MATERIALS = MATERIALS

function PartFactory.color(hex: number): Color3
	return Color3.fromRGB(bit32.extract(hex, 16, 8), bit32.extract(hex, 8, 8), bit32.extract(hex, 0, 8))
end

function PartFactory.cframe(origin: Vector3, p: Build.Prim): CFrame
	return CFrame.new(origin.X + p.x, origin.Y + p.y, origin.Z + p.z)
		* CFrame.Angles(0, p.yaw, 0)
		* CFrame.Angles(p.pitch, 0, 0)
		* CFrame.Angles(0, 0, p.roll)
end

--- A new anchored part for `p` (not parented). Tags and lights are left to
--- the caller.
function PartFactory.make(p: Build.Prim, origin: Vector3): BasePart
	local part: BasePart
	if p.k == "wedge" then
		part = Instance.new("WedgePart")
	elseif p.k == "cwedge" then
		part = Instance.new("CornerWedgePart")
	else
		local pp = Instance.new("Part")
		if p.k == "cyl" then
			pp.Shape = Enum.PartType.Cylinder
		elseif p.k == "ball" then
			pp.Shape = Enum.PartType.Ball
		end
		part = pp
	end
	part.Anchored = true
	part.Size = Vector3.new(p.sx, p.sy, p.sz)
	part.CFrame = PartFactory.cframe(origin, p)
	part.Material = MATERIALS[p.mat] or Enum.Material.SmoothPlastic
	part.Color = PartFactory.color(p.col)
	part.CanCollide = p.coll
	part.CanTouch = false
	part.CanQuery = p.coll -- the bike's raycasts only need solid things
	part.CastShadow = p.shadow
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if p.transp > 0 then
		part.Transparency = p.transp
	end
	if p.refl > 0 then
		part.Reflectance = p.refl
	end
	return part
end

return PartFactory
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="70">
        <Properties>
          <string name="Name">Real</string>
        </Properties>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Buildings</string>
            <string name="Source"><![CDATA[--!strict
-- The big shapes of real buildings (made on the server): the solid body,
-- Amsterdam gable roofs, Paris mansard roofs, New York water towers,
-- church roofs and houseboats. Windows and other small details are added
-- near the player by the client (see Real/Facades).

local Build = require(script.Parent.Parent.Build)
local Decode = require(script.Parent.Decode)
local Look = require(script.Parent.Look)
local Mass = require(script.Parent.Mass)

type BuildList = Build.BuildList
type Opts = Build.Opts
type Building = Decode.Building

local Buildings = {}

local M = Look.M

export type Frame = {
	x: number, -- middle of the front, at ground level
	z: number,
	ux: number, -- along the front (local X)
	uz: number,
	nx: number, -- outwards (local +Z)
	nz: number,
	width: number,
	depth: number,
	yaw: number,
}

--- The street front of a building, if it has one.
function Buildings.frame(bld: Building): Frame?
	if bld.mode == 2 and #bld.rects >= 5 then
		local cx, cz, w, d, yaw = bld.rects[1], bld.rects[2], bld.rects[3], bld.rects[4], bld.rects[5]
		local nx, nz = math.sin(yaw), math.cos(yaw)
		return {
			x = cx + nx * d / 2,
			z = cz + nz * d / 2,
			ux = math.cos(yaw),
			uz = -math.sin(yaw),
			nx = nx,
			nz = nz,
			width = w,
			depth = d,
			yaw = yaw,
		}
	end
	local f = bld.facade
	if f < 1 or f > bld.n then
		return nil
	end
	local g = f % bld.n + 1
	local ax, az, cx, cz = bld.xs[f], bld.zs[f], bld.xs[g], bld.zs[g]
	local dx, dz = cx - ax, cz - az
	local L = math.sqrt(dx * dx + dz * dz)
	if L < 1 then
		return nil
	end
	local ux, uz = dx / L, dz / L
	local nx, nz = -uz, ux -- outwards
	local depth = 0
	for i = 1, bld.n do
		depth = math.max(depth, -((bld.xs[i] - ax) * nx + (bld.zs[i] - az) * nz))
	end
	return {
		x = (ax + cx) / 2,
		z = (az + cz) / 2,
		ux = ux,
		uz = uz,
		nx = nx,
		nz = nz,
		width = L,
		depth = math.max(depth, 3),
		yaw = math.atan2(-uz, ux),
	}
end

local function wallOpts(bld: Building): Opts
	local mat = Look.MAT[bld.mat] or "Brick"
	local o: Opts = { mat = mat, col = bld.wall }
	if mat == "Glass" then
		o.refl = 0.22
	elseif mat == "Metal" then
		o.refl = 0.08
	end
	return o
end
Buildings.wallOpts = wallOpts

--- Fill the footprint between y0 and y1 (boxes or triangle prisms).
local function solid(b: BuildList, bld: Building, y0: number, y1: number, o: Opts)
	if bld.mode == 0 then
		local xs, zs, t = bld.xs, bld.zs, bld.tris
		for i = 1, #t - 2, 3 do
			local a, c, d = t[i], t[i + 1], t[i + 2]
			if xs[a] and xs[c] and xs[d] then
				Mass.triPrism(b, xs[a], zs[a], xs[c], zs[c], xs[d], zs[d], y0, y1, o)
			end
		end
	else
		local r = bld.rects
		for i = 1, #r - 4, 5 do
			Mass.rect(b, r[i], r[i + 1], r[i + 2], r[i + 3], r[i + 4], y0, y1, o)
		end
	end
end
Buildings.solid = solid

--- The eave height of a building (where the walls stop and the roof starts).
function Buildings.eave(bld: Building): number
	local h = bld.top - bld.base
	if bld.style == 1 then
		local f = Buildings.frame(bld)
		if f then
			return bld.top - Buildings.gableHeight(bld, f)
		end
	elseif bld.style == 2 then
		return bld.top - math.min(3.4 * M, h * 0.3)
	end
	return bld.top
end

function Buildings.gableHeight(bld: Building, f: Frame): number
	local h = bld.top - bld.base
	return math.clamp(f.width * 0.85, 2.6 * M, 7 * M) * math.min(1, h / (11 * M))
end

local function waterTower(b: BuildList, x: number, z: number, y: number)
	local wood = { mat = "WoodPlanks", col = 0x6B4A32, coll = false }
	local steel = { mat = "Metal", col = 0x3A3A3A, coll = false }
	-- legs (two crossed plates) and the barrel with its pointy hat
	b:box(x, y + 2 * M, z, 0.25 * M, 4 * M, 3.4 * M, steel)
	b:box(x, y + 2 * M, z, 3.4 * M, 4 * M, 0.25 * M, steel)
	b:cyl(x, y + 4 * M + 2.6 * M, z, 5.2 * M, 2.2 * M, { roll = math.pi / 2, mat = wood.mat, col = wood.col, coll = false })
	b:cyl(x, y + 4 * M + 5.4 * M, z, 0.6 * M, 1.6 * M, { roll = math.pi / 2, mat = steel.mat, col = 0x2E2E2E, coll = false })
end

--- Add the big shapes of one building. `wl` is the water level (studs).
function Buildings.mass(b: BuildList, bld: Building, style: string, wl: number, rng: Build.Rng)
	local o = wallOpts(bld)
	local base = if bld.base < 0.5 then -0.8 else bld.base
	local top = bld.top
	local s = bld.style
	if s == 6 then
		-- houseboat: a dark hull in the water with a cabin on top
		solid(b, bld, wl - 1.6, wl + 2.4, { mat = "WoodPlanks", col = 0x2B2B2B })
		solid(b, bld, wl + 2.4, wl + 8.4, { mat = "WoodPlanks", col = bld.wall })
		return
	elseif s == 9 then
		-- a canopy roof on posts
		solid(b, bld, math.max(top - 1.2, 0), top, { mat = "Metal", col = 0x6E7378 })
		return
	elseif s == 1 then
		local f = Buildings.frame(bld)
		if f then
			local gh = Buildings.gableHeight(bld, f)
			local eave = top - gh
			solid(b, bld, base, eave, o)
			-- the gable roof runs from the front to the back; the client adds
			-- roof tiles and the decorated gable top close by
			b:prism(f.x, f.z, f.yaw, 0, eave, -f.depth / 2, f.width, gh, f.depth, { mat = o.mat, col = bld.wall })
			return
		end
	elseif s == 2 then
		local eave = Buildings.eave(bld)
		local zinc: Opts = { mat = "Slate", col = bld.roof }
		if bld.mode == 2 then
			-- walls, then the zinc mansard: a sloped front and a set-back top
			local r = bld.rects
			local set = 1.6 * M
			for i = 1, #r - 4, 5 do
				local cx, cz, w, d, yaw = r[i], r[i + 1], r[i + 2], r[i + 3], r[i + 4]
				Mass.rect(b, cx, cz, w, d, yaw, base, eave, o)
				local nx, nz = math.sin(yaw), math.cos(yaw)
				if d > set + 2 then
					Mass.rect(b, cx - nx * set / 2, cz - nz * set / 2, w, d - set, yaw, eave, top, zinc)
					local fx, fz = cx + nx * (d / 2 - set / 2), cz + nz * (d / 2 - set / 2)
					-- WedgeParts slope down towards local -Z: turn it to face the street
					b:wedge(fx, (eave + top) / 2, fz, w, top - eave, set, { yaw = yaw + math.pi, mat = zinc.mat, col = zinc.col })
				else
					Mass.rect(b, cx, cz, w, d, yaw, eave, top, zinc)
				end
			end
		elseif bld.mode == 1 then
			solid(b, bld, base, eave, o)
			solid(b, bld, eave, top, zinc)
		else
			solid(b, bld, base, top, o)
		end
		return
	elseif s == 7 then
		-- church: walls and a steep roof along the longest side
		local r = bld.rects
		if bld.mode ~= 0 and #r >= 5 then
			local k, best = 1, 0
			for i = 1, #r - 4, 5 do
				if r[i + 2] * r[i + 3] > best then
					best, k = r[i + 2] * r[i + 3], i
				end
			end
			local cx, cz, w, d, yaw = r[k], r[k + 1], r[k + 2], r[k + 3], r[k + 4]
			local wallTop = base + (top - base) * 0.6
			solid(b, bld, base, wallTop, o)
			local roofH = top - wallTop
			if w >= d then
				-- ridge along local X: turn the prism 90 degrees
				b:prism(cx, cz, yaw + math.pi / 2, 0, wallTop, 0, d, roofH, w, { mat = "Slate", col = bld.roof })
			else
				b:prism(cx, cz, yaw, 0, wallTop, 0, w, roofH, d, { mat = "Slate", col = bld.roof })
			end
			return
		end
	end
	solid(b, bld, base, top, o)
	if s == 3 and bld.mode ~= 0 and #bld.rects >= 5 then
		local h = (top - base) / M
		if h > 15 and h < 70 and rng:chance(0.22) then
			local r = bld.rects
			local w, d = r[3], r[4]
			if w > 9 * M and d > 9 * M then
				waterTower(b, r[1], r[2], top)
			end
		end
	end
end

return Buildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Decode</string>
            <string name="Source"><![CDATA[--!strict
-- Reads the compact city data written by tools/osm_to_luau.py (real
-- OpenStreetMap data). Numbers in the data are decimetres; everything this
-- module returns is in studs (1 metre = 3 studs), relative to the city centre,
-- with x = east and z = south.

local Decode = {}

local DM = 0.3 -- decimetres -> studs

export type Building = {
	style: number,
	top: number, -- studs
	base: number,
	wall: number, -- 0xRRGGBB
	mat: number, -- material code (see Real/Materials)
	roof: number,
	n: number, -- number of outline vertices
	xs: { number },
	zs: { number },
	flags: string, -- one digit per outline edge: 0 hidden, 1 blank, 2 street, 3 shop
	facade: number, -- 1-based index of the front edge, or 0
	mode: number, -- 0 triangles, 1 boxes, 2 boxes with the street front at +Z
	rects: { number }, -- cx, cz, w, d, yaw for each box (flattened)
	tris: { number }, -- 1-based vertex indices, 3 per triangle
	index: number,
}

export type Road = {
	kind: number, -- 1 car, 2 bike path, 3 pedestrian street, 4 path, 5 pavement on a bridge, 6 tram rails
	width: number, -- studs
	surf: number,
	flags: number, -- 1 bridge, 2 one-way, 8 has a bridge deck, 32 bike lanes, 64 centre line
	xs: { number },
	zs: { number },
}

export type Area = {
	kind: number, -- 1 water, 2 grass, 3 forest, 4 playground, 5 flowers, 6 bridge deck, 7 pier, 8 square
	rings: { { number } }, -- each ring: x1, z1, x2, z2, ...
	flags: { { number } }, -- per ring, per edge
}

export type Prop = { kind: number, x: number, z: number, yaw: number, extra: number }

export type Lane = {
	kind: string, -- "car" | "bike" | "walk" | "boat" | "tram"
	width: number,
	oneway: boolean,
	j0: number,
	j1: number,
	y: number?, -- studs above the street (nil = water level)
	xs: { number },
	zs: { number },
}

--- All lines of a list of data modules (each module returns one string).
function Decode.lines(modules: { any }): { string }
	local out = {}
	for _, m in modules do
		local text = (require :: any)(m) :: string
		for line in string.gmatch(text, "[^\n]+") do
			table.insert(out, line)
		end
	end
	return out
end

local function tokens(line: string): { string }
	return string.split(line, " ")
end

function Decode.building(line: string, index: number): Building?
	local t = tokens(line)
	local function n(i: number): number
		return tonumber(t[i]) or 0
	end
	local nOuter, nTotal = n(7), n(8)
	if nOuter < 3 then
		return nil
	end
	local b: Building = {
		style = n(1),
		top = n(2) * DM,
		base = n(3) * DM,
		wall = n(4),
		mat = n(5),
		roof = n(6),
		n = nOuter,
		xs = {},
		zs = {},
		flags = t[10] or "",
		facade = n(9) + 1,
		mode = n(11),
		rects = {},
		tris = {},
		index = index,
	}
	local i = 12
	local px, pz = 0, 0
	for k = 1, nTotal do
		local x, z = n(i), n(i + 1)
		if k > 1 then
			x += px
			z += pz
		end
		px, pz = x, z
		b.xs[k] = x * DM
		b.zs[k] = z * DM
		i += 2
	end
	if b.mode == 0 then
		while t[i] do
			table.insert(b.tris, n(i) + 1)
			i += 1
		end
	else
		local count = n(i)
		i += 1
		for _ = 1, count do
			table.insert(b.rects, n(i) * DM)
			table.insert(b.rects, n(i + 1) * DM)
			table.insert(b.rects, n(i + 2) * DM)
			table.insert(b.rects, n(i + 3) * DM)
			table.insert(b.rects, n(i + 4) / 1000)
			i += 5
		end
	end
	return b
end

function Decode.buildings(modules: { any }): { Building }
	local out = {}
	for _, line in Decode.lines(modules) do
		local b = Decode.building(line, #out + 1)
		if b then
			table.insert(out, b)
		end
	end
	return out
end

local function points(t: { string }, start: number, count: number, xs: { number }, zs: { number })
	local x0, z0 = 0, 0
	for k = 1, count do
		local x = tonumber(t[start + (k - 1) * 2]) or 0
		local z = tonumber(t[start + (k - 1) * 2 + 1]) or 0
		if k == 1 then
			x0, z0 = x, z
		else
			x += x0
			z += z0
		end
		xs[k] = x * DM
		zs[k] = z * DM
	end
end

function Decode.roads(modules: { any }): { Road }
	local out = {}
	for _, line in Decode.lines(modules) do
		local t = tokens(line)
		local r: Road = {
			kind = tonumber(t[1]) or 1,
			width = (tonumber(t[2]) or 0) * DM,
			surf = tonumber(t[3]) or 0,
			flags = tonumber(t[4]) or 0,
			xs = {},
			zs = {},
		}
		points(t, 6, tonumber(t[5]) or 0, r.xs, r.zs)
		if #r.xs >= 2 then
			table.insert(out, r)
		end
	end
	return out
end

function Decode.areas(modules: { any }): { Area }
	local out = {}
	for _, line in Decode.lines(modules) do
		local t = tokens(line)
		local kind = tonumber(t[1]) or 0
		local nr = tonumber(t[2]) or 0
		local a: Area = { kind = kind, rings = {}, flags = {} }
		local i = 3 + nr
		local x0, z0 = 0, 0
		local first = true
		for r = 1, nr do
			local len = tonumber(t[2 + r]) or 0
			local ring, fl = {}, {}
			for _ = 1, len do
				local x = tonumber(t[i]) or 0
				local z = tonumber(t[i + 1]) or 0
				if first then
					x0, z0 = x, z
					first = false
				else
					x += x0
					z += z0
				end
				table.insert(ring, x * DM)
				table.insert(ring, z * DM)
				table.insert(fl, tonumber(t[i + 2]) or 0)
				i += 3
			end
			table.insert(a.rings, ring)
			table.insert(a.flags, fl)
		end
		table.insert(out, a)
	end
	return out
end

function Decode.props(modules: { any }): { Prop }
	local out = {}
	for _, line in Decode.lines(modules) do
		local t = tokens(line)
		table.insert(out, {
			kind = tonumber(t[1]) or 0,
			x = (tonumber(t[2]) or 0) * DM,
			z = (tonumber(t[3]) or 0) * DM,
			yaw = (tonumber(t[4]) or 0) / 1000,
			extra = tonumber(t[5]) or 0,
		})
	end
	return out
end

local LANE_KINDS = { "car", "bike", "walk", "boat", "tram" }

function Decode.lanes(modules: { any }): { Lane }
	local out = {}
	for _, line in Decode.lines(modules) do
		local t = tokens(line)
		local y = tonumber(t[6]) or 0
		local l: Lane = {
			kind = LANE_KINDS[tonumber(t[1]) or 1] or "car",
			width = (tonumber(t[2]) or 0) * DM,
			oneway = bit32.band(tonumber(t[3]) or 0, 2) ~= 0,
			j0 = tonumber(t[4]) or 0,
			j1 = tonumber(t[5]) or 0,
			y = if y <= -990 then nil else y * DM,
			xs = {},
			zs = {},
		}
		points(t, 8, tonumber(t[7]) or 0, l.xs, l.zs)
		if #l.xs >= 2 then
			table.insert(out, l)
		end
	end
	return out
end

Decode.DM = DM

return Decode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">Facades</string>
            <string name="Source"><![CDATA[--!strict
-- Small facade details (windows, doors, shop fronts, Dutch gable tops, Paris
-- balconies and dormers, New York fire escapes) and road markings. The client
-- makes these only for the streets around the player, so the city can be
-- detailed without millions of parts.

local Build = require(script.Parent.Parent.Build)
local Buildings = require(script.Parent.Buildings)
local Decode = require(script.Parent.Decode)
local Look = require(script.Parent.Look)

type BuildList = Build.BuildList
type Opts = Build.Opts
type Building = Decode.Building

local Facades = {}

local M = Look.M
local MAX_FLOORS = 14 -- windows above this are left to the plain wall

local function boxAt(b: BuildList, x: number, y: number, z: number, sx: number, sy: number, sz: number, yaw: number, o: Opts)
	if sx < 0.05 or sy < 0.05 or sz < 0.02 then
		return -- too small to see (or a building part too short for this detail)
	end
	local op: Opts = table.clone(o) :: Opts
	op.yaw = yaw
	op.coll = false
	op.shadow = false
	b:box(x, y, z, sx, sy, sz, op)
end

--- Walk along one street front: calls fn(s) for `count` evenly spaced bays.
local function bays(L: number, bay: number, fn: (number, number) -> ())
	local count = math.floor(L / bay)
	if count < 1 then
		return
	end
	local spacing = L / count
	for j = 1, count do
		fn((j - 0.5) * spacing, j)
	end
end

type Edge = {
	ax: number,
	az: number,
	ux: number,
	uz: number,
	nx: number,
	nz: number,
	L: number,
	yaw: number,
	shop: boolean,
}

local function edges(bld: Building): { Edge }
	local out = {}
	local n = bld.n
	for i = 1, n do
		local c = string.byte(bld.flags, i)
		if not c or c < 50 then -- "2" (street) or "3" (shop) only
			continue
		end
		local j = i % n + 1
		local ax, az = bld.xs[i], bld.zs[i]
		local dx, dz = bld.xs[j] - ax, bld.zs[j] - az
		local L = math.sqrt(dx * dx + dz * dz)
		if L < 2.2 * M then
			continue
		end
		local ux, uz = dx / L, dz / L
		table.insert(out, { ax = ax, az = az, ux = ux, uz = uz, nx = -uz, nz = ux, L = L, yaw = math.atan2(-uz, ux), shop = c == 51 })
	end
	return out
end

--- A framed window: light frame with dark glass in front of it.
local function window(b: BuildList, e: Edge, s: number, y: number, w: number, h: number, look: Look.CityLook, framed: boolean, rng: Build.Rng)
	local x, z = e.ax + e.ux * s, e.az + e.uz * s
	if framed then
		boxAt(b, x + e.nx * 0.06, y, z + e.nz * 0.06, w + 0.5, h + 0.5, 0.12, e.yaw, { mat = "SmoothPlastic", col = look.frame })
	end
	-- about half the windows light up at night
	boxAt(b, x + e.nx * 0.12, y, z + e.nz * 0.12, w, h, 0.14, e.yaw, { mat = "Glass", col = look.glass, refl = 0.25, tag = if rng:chance(0.45) then "NightWindow" else nil })
end

local function door(b: BuildList, e: Edge, s: number, y0: number, look: Look.CityLook, rng: Build.Rng, stoop: boolean)
	local x, z = e.ax + e.ux * s, e.az + e.uz * s
	local w, h = 1.1 * M, 2.4 * M
	boxAt(b, x + e.nx * 0.06, y0 + h / 2 + 0.1, z + e.nz * 0.06, w + 0.5, h + 0.4, 0.12, e.yaw, { mat = "SmoothPlastic", col = look.frame })
	boxAt(b, x + e.nx * 0.12, y0 + h / 2, z + e.nz * 0.12, w, h, 0.14, e.yaw, { mat = "WoodPlanks", col = rng:pick(look.doorColors) })
	if stoop then
		boxAt(b, x + e.nx * 0.6 * M, y0 + 0.25 * M, z + e.nz * 0.6 * M, w + 1.2, 0.5 * M, 1.2 * M, e.yaw, { mat = "Granite", col = 0x8E8A84 })
	end
end

local function shopFront(b: BuildList, e: Edge, y0: number, gf: number, look: Look.CityLook, rng: Build.Rng)
	local w = math.min(e.L * 0.82, e.L - 1.2 * M)
	if w < 2 * M then
		return
	end
	local s = e.L / 2
	local x, z = e.ax + e.ux * s, e.az + e.uz * s
	local h = gf * 0.62
	boxAt(b, x + e.nx * 0.12, y0 + 0.5 * M + h / 2, z + e.nz * 0.12, w, h, 0.14, e.yaw, { mat = "Glass", col = 0x3A4A55, refl = 0.3, tag = "NightWindow" })
	boxAt(b, x + e.nx * 0.08, y0 + 0.5 * M + h + 0.6 * M, z + e.nz * 0.08, w + 0.6, 1.0 * M, 0.2, e.yaw, { mat = "SmoothPlastic", col = rng:pick(look.awnings) })
	-- sloping awning
	local depth = 1.4 * M
	local op: Opts = { yaw = e.yaw, pitch = -0.35, mat = "Fabric", col = rng:pick(look.awnings), coll = false, shadow = true }
	b:box(x + e.nx * depth / 2, y0 + 0.5 * M + h + 0.15 * M, z + e.nz * depth / 2, w, 0.12, depth * 1.06, op)
end

-- Amsterdam gable tops ------------------------------------------------------------------------
local function gable(b: BuildList, bld: Building, f: Buildings.Frame, rng: Build.Rng, look: Look.CityLook)
	local gh = Buildings.gableHeight(bld, f)
	local eave = bld.top - gh
	local W = f.width
	local wall: Opts = { mat = Look.MAT[bld.mat] or "Brick", col = bld.wall, coll = false }
	local trim: Opts = { mat = "SmoothPlastic", col = 0xF2F0EA, coll = false, shadow = false }
	local roof: Opts = { mat = "Slate", col = bld.roof, coll = false }
	local function at(lx: number, lz: number): (number, number)
		return f.x + f.ux * lx + f.nx * lz, f.z + f.uz * lx + f.nz * lz
	end
	-- roof tiles on both slopes of the gable roof
	local slopeLen = math.sqrt((W / 2) ^ 2 + gh ^ 2)
	local ang = math.atan2(gh, W / 2)
	for _, side in { -1, 1 } do
		local x, z = at(side * W / 4, -f.depth / 2)
		local op = table.clone(roof) :: Opts
		op.yaw = f.yaw
		op.roll = -side * ang
		b:box(x, eave + gh / 2 + 0.15, z, slopeLen + 0.4, 0.25, f.depth + 0.3, op)
	end
	local kind = rng:int(1, 5)
	local front = 0.25
	if kind == 1 then
		-- step gable
		local steps = if W > 7 * M then 4 else 3
		for k = 0, steps - 1 do
			local w = W * (1 - k / steps)
			local h = gh / steps
			local x, z = at(0, front)
			local op = table.clone(wall) :: Opts
			op.yaw = f.yaw
			b:box(x, eave + (k + 0.5) * h, z, w, h, 0.5, op)
			for _, side in { -1, 1 } do
				local cx, cz = at(side * (w / 2 - 0.3), front + 0.05)
				local t = table.clone(trim) :: Opts
				t.yaw = f.yaw
				b:box(cx, eave + (k + 1) * h + 0.1, cz, 0.9, 0.2, 0.62, t)
			end
		end
	elseif kind == 2 or kind == 3 then
		-- neck or bell gable: a tall middle part with white edges
		local nw = W * (if kind == 2 then 0.42 else 0.55)
		local x, z = at(0, front)
		local op = table.clone(wall) :: Opts
		op.yaw = f.yaw
		b:box(x, eave + gh * 0.55, z, nw, gh * 1.1, 0.5, op)
		local t = table.clone(trim) :: Opts
		t.yaw = f.yaw
		b:box(x, eave + gh * 1.1 + 0.15, z, nw + 0.6, 0.35, 0.65, t)
		if kind == 3 then
			b:ball(x, eave + gh * 1.1 + 0.7, z, 0.45, { mat = "SmoothPlastic", col = 0xF2F0EA, coll = false })
		end
		for _, side in { -1, 1 } do
			local sx, sz = at(side * (nw / 2 + (W - nw) / 4), front)
			local wop = table.clone(wall) :: Opts
			wop.yaw = f.yaw + (if side < 0 then math.pi / 2 else -math.pi / 2)
			b:wedge(sx, eave + gh * 0.22, sz, 0.5, gh * 0.44, (W - nw) / 2, wop)
		end
	elseif kind == 4 then
		-- straight cornice front hiding the roof
		local x, z = at(0, front)
		local op = table.clone(wall) :: Opts
		op.yaw = f.yaw
		b:box(x, eave + gh * 0.4, z, W, gh * 0.8, 0.5, op)
		local t = table.clone(trim) :: Opts
		t.yaw = f.yaw
		b:box(x, eave + gh * 0.8 + 0.25, z, W + 0.6, 0.5, 0.9, t)
	else
		-- spout gable: white edges along the slopes
		for _, side in { -1, 1 } do
			local x, z = at(side * W / 4, front)
			local t = table.clone(trim) :: Opts
			t.yaw = f.yaw
			t.roll = -side * ang
			b:box(x, eave + gh / 2, z, slopeLen, 0.35, 0.6, t)
		end
	end
	-- attic window / loading door and the hoist beam
	local x, z = at(0, 0.1)
	boxAt(b, x, eave + gh * 0.35, z, math.min(1.1 * M, W * 0.3), gh * 0.38, 0.3, f.yaw, { mat = "SmoothPlastic", col = look.frame })
	boxAt(b, x + f.nx * 0.1, eave + gh * 0.35, z + f.nz * 0.1, math.min(0.9 * M, W * 0.24), gh * 0.32, 0.32, f.yaw, { mat = "WoodPlanks", col = rng:pick(look.doorColors) })
	if rng:chance(0.7) then
		local hx, hz = at(0, 0.6 * M)
		boxAt(b, hx, eave + gh * 0.82, hz, 0.35 * M, 0.35 * M, 1.4 * M, f.yaw, { mat = "WoodPlanks", col = 0x2A2420 })
	end
end

--- Add the details of one building. `y0` is where its street front starts.
function Facades.building(b: BuildList, bld: Building, style: string, rng: Build.Rng)
	local s = bld.style
	if s == 6 or s == 9 then
		return
	end
	local look = Look.get(style)
	local list = edges(bld)
	if #list == 0 then
		return
	end
	local base = bld.base
	local eave = Buildings.eave(bld)
	local gf = look.groundFloor * M
	local fh = look.floor * M
	local ww, wh = look.window[1] * M, look.window[2] * M
	local floors = math.min(MAX_FLOORS, math.floor((eave - base - gf - 0.5 * M) / fh))
	local tall = (bld.top - base) > 45 * M
	local glass = s == 4 or bld.mat == 4
	local framed = style ~= "newyork" and not glass
	for _, e in list do
		if glass then
			-- curtain wall: slim mullions and floor bands near the street
			local bandTop = math.min(eave, base + gf + MAX_FLOORS * fh)
			bays(e.L, 1.6 * M, function(sx)
				local x, z = e.ax + e.ux * sx, e.az + e.uz * sx
				boxAt(b, x + e.nx * 0.1, (base + bandTop) / 2, z + e.nz * 0.1, 0.12 * M, bandTop - base, 0.2, e.yaw, { mat = "Metal", col = 0x9AA3AA })
			end)
			for k = 0, math.floor((bandTop - base) / fh) - 1, 2 do
				local x, z = e.ax + e.ux * e.L / 2, e.az + e.uz * e.L / 2
				boxAt(b, x + e.nx * 0.1, base + gf + k * fh, z + e.nz * 0.1, e.L, 0.35 * M, 0.2, e.yaw, { mat = "Metal", col = 0x8A939A })
			end
			continue
		end
		if s == 5 or (tall and style == "newyork") then
			-- tower: dark window columns up the front
			local colTop = math.min(eave - 1.5 * M, base + gf + MAX_FLOORS * fh)
			bays(e.L, look.bay * M, function(sx)
				local x, z = e.ax + e.ux * sx, e.az + e.uz * sx
				boxAt(b, x + e.nx * 0.12, (base + gf + colTop) / 2, z + e.nz * 0.12, ww, colTop - base - gf, 0.14, e.yaw, { mat = "Glass", col = look.glass, refl = 0.2, tag = "NightWindow" })
			end)
		else
			-- upper floors
			for k = 1, floors do
				local y = base + gf + (k - 0.5) * fh
				local h = if style == "paris" and (k == 1 or k == 4) then wh * 1.08 else wh
				bays(e.L, look.bay * M, function(sx)
					window(b, e, sx, y, ww, math.min(h, fh * 0.78), look, framed, rng)
				end)
			end
		end
		-- ground floor
		if base < 0.5 * M then
			if e.shop then
				shopFront(b, e, base, gf, look, rng)
			else
				local count = math.floor(e.L / (look.bay * M))
				if count >= 2 then
					local doorBay = rng:int(1, count)
					local spacing = e.L / count
					for j = 1, count do
						local sx = (j - 0.5) * spacing
						if j == doorBay then
							door(b, e, sx, base, look, rng, style == "amsterdam" or (style == "newyork" and s == 3 and rng:chance(0.4)))
						else
							window(b, e, sx, base + gf * 0.55, ww, math.min(wh, gf * 0.55), look, framed, rng)
						end
					end
				elseif count == 1 then
					door(b, e, e.L / 2, base, look, rng, style == "amsterdam")
				end
			end
		end
		-- city specials
		if style == "paris" and s == 2 then
			local x, z = e.ax + e.ux * e.L / 2, e.az + e.uz * e.L / 2
			-- stone band above the shops, balconies on the 2nd and 5th floor, cornice
			boxAt(b, x + e.nx * 0.15, base + gf + 0.15 * M, z + e.nz * 0.15, e.L, 0.3 * M, 0.3, e.yaw, { mat = "Limestone", col = 0xE8DFCB })
			for _, k in { 1, 4 } do
				if k <= floors then
					local y = base + gf + (k - 1) * fh + 0.1
					boxAt(b, x + e.nx * 0.45 * M, y, z + e.nz * 0.45 * M, e.L - 0.4, 0.15 * M, 0.9 * M, e.yaw, { mat = "Limestone", col = 0xE0D4BA })
					boxAt(b, x + e.nx * 0.88 * M, y + 0.5 * M, z + e.nz * 0.88 * M, e.L - 0.4, 0.9 * M, 0.08, e.yaw, { mat = "Metal", col = 0x1E2420, transp = 0.25 })
				end
			end
			boxAt(b, x + e.nx * 0.4, eave + 0.2 * M, z + e.nz * 0.4, e.L + 0.4, 0.45 * M, 0.9, e.yaw, { mat = "Limestone", col = 0xE8DFCB })
			-- dormer windows in the zinc roof
			if bld.mode == 2 then
				bays(e.L, look.bay * M * 2, function(sx)
					local dx, dz = e.ax + e.ux * sx - e.nx * 0.9 * M, e.az + e.uz * sx - e.nz * 0.9 * M
					boxAt(b, dx, eave + 1.5 * M, dz, 1.4 * M, 2 * M, 1.6 * M, e.yaw, { mat = "Slate", col = bld.roof })
					boxAt(b, dx + e.nx * 0.82 * M, eave + 1.45 * M, dz + e.nz * 0.82 * M, 0.9 * M, 1.3 * M, 0.1, e.yaw, { mat = "Glass", col = look.glass, tag = "NightWindow" })
				end)
			else
				boxAt(b, x + e.nx * 0.1, (eave + bld.top) / 2, z + e.nz * 0.1, e.L, bld.top - eave, 0.2, e.yaw, { mat = "Slate", col = bld.roof })
			end
		elseif style == "newyork" and s == 3 and floors >= 3 and e.L > 6 * M and rng:chance(0.4) then
			-- fire escape: a platform and a ladder on every floor
			local fw = math.min(e.L * 0.5, 7 * M)
			local cx, cz = e.ax + e.ux * e.L * 0.5 + e.nx * 0.6 * M, e.az + e.uz * e.L * 0.5 + e.nz * 0.6 * M
			for k = 1, math.min(floors, 8) do
				local y = base + gf + (k - 1) * fh
				boxAt(b, cx, y, cz, fw, 0.12 * M, 1.1 * M, e.yaw, { mat = "Metal", col = 0x2B2B2B })
				boxAt(b, cx + e.nx * 0.5 * M, y + 0.5 * M, cz + e.nz * 0.5 * M, fw, 0.06 * M, 0.06 * M, e.yaw, { mat = "Metal", col = 0x2B2B2B })
				if k < floors then
					local op: Opts = { yaw = e.yaw, roll = math.atan2(fh, fw * 0.8), mat = "Metal", col = 0x2B2B2B, coll = false, shadow = false }
					b:box(cx, y + fh / 2, cz, math.sqrt((fw * 0.8) ^ 2 + fh ^ 2), 0.08 * M, 0.5 * M, op)
				end
			end
		elseif style == "amsterdam" and base < 0.5 * M and not e.shop and rng:chance(0.3) then
			-- flower boxes or a bench in front of the house
			local x, z = e.ax + e.ux * e.L * 0.3 + e.nx * 0.5 * M, e.az + e.uz * e.L * 0.3 + e.nz * 0.5 * M
			boxAt(b, x, 0.35 * M, z, 1.6 * M, 0.5 * M, 0.5 * M, e.yaw, { mat = "WoodPlanks", col = 0x5A4636 })
			b:ball(x, 0.75 * M, z, 0.45 * M, { mat = "LeafyGrass", col = rng:pick({ 0xD94A4A, 0xF2C230, 0xE87AB0, 0x5E8A3F }), coll = false, shadow = false })
		end
	end
	if s == 1 then
		local f = Buildings.frame(bld)
		if f then
			gable(b, bld, f, rng, look)
		end
	end
end

-- Road markings ---------------------------------------------------------------------------------
local LINE_TOP = 0.2

local function strip(b: BuildList, ax: number, az: number, bx: number, bz: number, w: number, y: number, col: number, mat: string?)
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	if len < 0.2 then
		return
	end
	b:box((ax + bx) / 2, y, (az + bz) / 2, w, 0.05, len, { yaw = math.atan2(dx, dz), mat = mat or "SmoothPlastic", col = col, coll = false, shadow = false })
end

function Facades.road(b: BuildList, r: Decode.Road, style: string)
	local bridge = bit32.band(r.flags, 1) ~= 0
	local y = LINE_TOP + (if bridge then 0.65 else 0)
	local xs, zs = r.xs, r.zs
	if r.kind == 6 then
		-- tram rails
		for i = 1, #xs - 1 do
			local dx, dz = xs[i + 1] - xs[i], zs[i + 1] - zs[i]
			local len = math.sqrt(dx * dx + dz * dz)
			if len > 0.2 then
				local nx, nz = -dz / len, dx / len
				for _, side in { -0.72 * M, 0.72 * M } do
					strip(b, xs[i] + nx * side, zs[i] + nz * side, xs[i + 1] + nx * side, zs[i + 1] + nz * side, 0.1 * M, y + 0.01, 0x6E6A66, "Metal")
				end
			end
		end
		return
	end
	if r.kind ~= 1 then
		return
	end
	local centre = bit32.band(r.flags, 64) ~= 0
	local bikeLanes = bit32.band(r.flags, 32) ~= 0
	for i = 1, #xs - 1 do
		local ax, az, bx, bz = xs[i], zs[i], xs[i + 1], zs[i + 1]
		local dx, dz = bx - ax, bz - az
		local len = math.sqrt(dx * dx + dz * dz)
		if len < 0.5 then
			continue
		end
		local ux, uz, nx, nz = dx / len, dz / len, -dz / len, dx / len
		if centre and bit32.band(r.flags, 2) == 0 then
			if style == "newyork" then
				for _, off in { -0.12 * M, 0.12 * M } do
					strip(b, ax + nx * off, az + nz * off, bx + nx * off, bz + nz * off, 0.1 * M, y, 0xE8B92E)
				end
			else
				-- dashes: 3 m line, 6 m gap
				local s = 1.5 * M
				while s < len - 1.5 * M do
					strip(b, ax + ux * (s - 1.5 * M), az + uz * (s - 1.5 * M), ax + ux * (s + 1.5 * M), az + uz * (s + 1.5 * M), 0.12 * M, y, 0xEDEDE8)
					s += 9 * M
				end
			end
		end
		if bikeLanes and r.width > 7 * M then
			local col = if style == "amsterdam" then 0x9A3D33 elseif style == "newyork" then 0x3E8A4E else 0x4A4B50
			for _, side in { -1, 1 } do
				local off = side * (r.width / 2 - 0.9 * M)
				strip(b, ax + nx * off, az + nz * off, bx + nx * off, bz + nz * off, 1.6 * M, y - 0.01, col, "Asphalt")
				local lo = side * (r.width / 2 - 1.75 * M)
				strip(b, ax + nx * lo, az + nz * lo, bx + nx * lo, bz + nz * lo, 0.12 * M, y + 0.01, 0xEDEDE8)
			end
		end
	end
end

--- Zebra crossing across a street (from the props list).
function Facades.crossing(b: BuildList, p: Decode.Prop, style: string)
	local width = math.max(p.extra * Decode.DM, 6 * M)
	local stripes = math.floor(width / (1.0 * M))
	local long = if style == "newyork" then 3.5 * M else 3 * M
	for k = 0, stripes - 1 do
		local lx = -width / 2 + (k + 0.5) * (width / stripes)
		b:obox(p.x, p.z, p.yaw, lx, LINE_TOP, 0, 0.5 * M, 0.05, long, { mat = "SmoothPlastic", col = 0xEDEDE8, coll = false, shadow = false })
	end
end

return Facades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Generate</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a real city (from OpenStreetMap data) as a build list for the
-- server: buildings, streets, bridges, quay walls, terrain (ground, water,
-- grass), trees, lamps and other street furniture, plus the points of
-- interest the game needs (landmarks, coins, shops, doors, spawn).

local Build = require(script.Parent.Parent.Build)
local Kit = require(script.Parent.Parent.Kit)
local Roads = require(script.Parent.Parent.Roads)
local Buildings = require(script.Parent.Buildings)
local Decode = require(script.Parent.Decode)
local Look = require(script.Parent.Look)
local Mass = require(script.Parent.Mass)

type BuildList = Build.BuildList
type Opts = Build.Opts

local M = Look.M
local DM = Decode.DM

local Generate = {}

export type CityData = {
	meta: any,
	buildings: { any },
	roads: { any },
	areas: { any },
	props: { any },
	lanes: { any },
}

export type Context = {
	b: BuildList,
	buildings: { Decode.Building },
	meta: any,
	style: string,
	look: Look.CityLook,
	wl: number, -- water level (studs)
	rng: Build.Rng,
}

export type TerrainSpec = {
	bounds: { number }, -- x0, z0, x1, z1 (studs, relative to the city origin)
	waterLevel: number,
	polys: { { kind: number, rings: { { number } } } },
}

-- top of each kind of street surface (studs); slightly different so crossing
-- streets never flicker
local TOP = { [1] = 0.18, [2] = 0.22, [3] = 0.15, [4] = 0.12, [5] = 0.25 }
local DECK = 0.6 -- top of a bridge deck

-- Streets ---------------------------------------------------------------------------
local function streets(ctx: Context, roads: { Decode.Road })
	local b = ctx.b
	local look = ctx.look
	for _, r in roads do
		if r.kind == 6 then
			continue -- tram rails are drawn by the client
		end
		local bridge = bit32.band(r.flags, 1) ~= 0
		local hasDeck = bit32.band(r.flags, 8) ~= 0
		local width = math.max(r.width, if r.kind == 1 then 4 * M else 1.4 * M)
		local top = (TOP[r.kind] or 0.15) + (if bridge then DECK + 0.05 else 0)
		local surf = Look.SURF[r.surf] or Look.SURF[0]
		local s: Roads.Surface = { mat = surf.mat, col = surf.col }
		local xs, zs = r.xs, r.zs
		local n = #xs
		for i = 1, n - 1 do
			local ax, az, bx, bz = xs[i], zs[i], xs[i + 1], zs[i + 1]
			local dx, dz = bx - ax, bz - az
			local len = math.sqrt(dx * dx + dz * dz)
			if len < 0.1 then
				continue
			end
			local ux, uz = dx / len, dz / len
			-- overlap at bends so corners have no gaps
			local ext = math.min(width / 2, 6)
			if i > 1 then
				ax -= ux * ext
				az -= uz * ext
			end
			if i < n - 1 then
				bx += ux * ext
				bz += uz * ext
			end
			Roads.seg(b, ax, az, bx, bz, width, top, s)
			if bridge and not hasDeck then
				-- a simple bridge: a deck and low walls on both sides
				local dw = width + 1.2 * M
				Roads.seg(b, xs[i], zs[i], xs[i + 1], zs[i + 1], dw, top - 0.3, look.deck, { coll = true })
				local p = b.prims[#b.prims]
				p.y -= 0.5
				p.sy = 1.6
				local nx, nz = -uz, ux
				for _, side in { -1, 1 } do
					local off = side * (dw / 2 - 0.3)
					Roads.wall(b, xs[i] + nx * off, zs[i] + nz * off, xs[i + 1] + nx * off, zs[i + 1] + nz * off, 0.6, top - 0.3, top + 1.1 * M, look.parapet)
				end
			end
		end
	end
end

-- Water edges, bridge decks, piers ------------------------------------------------------------
local function areas(ctx: Context, list: { Decode.Area }, terrain: TerrainSpec)
	local b = ctx.b
	local look = ctx.look
	local wl = ctx.wl
	for _, a in list do
		local k = a.kind
		if k == 1 or k == 2 or k == 3 or k == 4 or k == 5 or k == 8 then
			table.insert(terrain.polys, { kind = k, rings = a.rings })
		end
		if k == 1 then
			-- quay walls with a stone edge on top
			for ri, ring in a.rings do
				local fl = a.flags[ri]
				local n = #ring // 2
				for i = 1, n do
					if fl[i] ~= 1 then
						continue
					end
					local j = i % n + 1
					local ax, az, bx, bz = ring[2 * i - 1], ring[2 * i], ring[2 * j - 1], ring[2 * j]
					local dx, dz = bx - ax, bz - az
					local len = math.sqrt(dx * dx + dz * dz)
					if len < 0.2 then
						continue
					end
					-- outwards from the water = towards the land
					local nx, nz = -dz / len, dx / len
					Roads.wall(b, ax - nx * 0.75, az - nz * 0.75, bx - nx * 0.75, bz - nz * 0.75, 1.5, wl - 14, 0.1, look.quay)
					Roads.wall(b, ax + nx * 1.0, az + nz * 1.0, bx + nx * 1.0, bz + nz * 1.0, 4.5, -0.4, 0.22, look.cap)
				end
			end
		elseif k == 6 then
			local ring = a.rings[1]
			if ring then
				-- thin enough for small boats to pass underneath
				Mass.fillRing(b, ring, -1.0, DECK, { mat = look.deck.mat, col = look.deck.col })
				local fl = a.flags[1]
				local n = #ring // 2
				for i = 1, n do
					if fl[i] == 1 then
						local j = i % n + 1
						local ax, az, bx, bz = ring[2 * i - 1], ring[2 * i], ring[2 * j - 1], ring[2 * j]
						local dx, dz = bx - ax, bz - az
						local len = math.sqrt(dx * dx + dz * dz)
						if len > 0.5 then
							local nx, nz = -dz / len, dx / len
							Roads.wall(b, ax - nx * 0.45, az - nz * 0.45, bx - nx * 0.45, bz - nz * 0.45, 0.9, DECK - 0.1, DECK + 1.05 * M, look.parapet)
						end
					end
				end
			end
		elseif k == 7 then
			local ring = a.rings[1]
			if ring then
				Mass.fillRing(b, ring, wl + 0.4, wl + 1.6, { mat = "WoodPlanks", col = 0x7A6048 })
			end
		end
	end
end

-- Street furniture ------------------------------------------------------------------------------
local function lamp(ctx: Context, x: number, z: number, light: boolean)
	local b = ctx.b
	local look = ctx.look
	local col = look.lampColor
	local head: Build.Prim
	if look.lamp == "newyork" then
		b:cyl(x, 4.5 * M, z, 9 * M, 0.11 * M, { roll = math.pi / 2, mat = "Metal", col = col })
		b:box(x + 0.9 * M, 8.9 * M, z, 1.8 * M, 0.12 * M, 0.12 * M, { mat = "Metal", col = col, coll = false })
		head = b:box(x + 1.8 * M, 8.75 * M, z, 0.9 * M, 0.25 * M, 0.45 * M, { mat = "SmoothPlastic", col = 0xFFF1C8, tag = "StreetLight", coll = false })
	elseif look.lamp == "paris" then
		b:cyl(x, 2.4 * M, z, 4.8 * M, 0.09 * M, { roll = math.pi / 2, mat = "Metal", col = col })
		head = b:box(x, 5.1 * M, z, 0.55 * M, 0.75 * M, 0.55 * M, { mat = "SmoothPlastic", col = 0xFFF1C8, tag = "StreetLight", coll = false, shadow = false })
	else
		b:cyl(x, 2.1 * M, z, 4.2 * M, 0.08 * M, { roll = math.pi / 2, mat = "Metal", col = col })
		head = b:box(x, 4.45 * M, z, 0.5 * M, 0.55 * M, 0.5 * M, { mat = "SmoothPlastic", col = 0xFFF1C8, tag = "StreetLight", coll = false, shadow = false })
	end
	if light then
		b:light(head, 42, 1.3, 0xFFCF8A)
	end
end

local function tree(ctx: Context, x: number, z: number, height: number)
	local b = ctx.b
	local look = ctx.look
	local rng = ctx.rng
	local h = (if height > 2 then height else look.treeHeight * rng:range(0.8, 1.2)) * M
	local r = math.min(look.crownRadius * M * rng:range(0.8, 1.15), h * 0.42)
	local trunkH = h - r * 1.3
	b:cyl(x, trunkH / 2, z, trunkH, 0.22 * M, { roll = math.pi / 2, mat = "Wood", col = 0x4E3B2C })
	b:ball(x, trunkH + r * 0.75, z, r, { mat = "LeafyGrass", col = rng:pick(look.crown), coll = false, shadow = true })
end

local function props(ctx: Context, list: { Decode.Prop })
	local b = ctx.b
	local look = ctx.look
	local rng = ctx.rng
	for _, p in list do
		local k, x, z, yaw = p.kind, p.x, p.z, p.yaw
		if k == 1 then
			tree(ctx, x, z, p.extra / 10)
		elseif k == 2 then
			lamp(ctx, x, z, p.extra == 1)
		elseif k == 3 then
			-- bench along the street
			b:obox(x, z, yaw, 0, 0.45 * M, 0, 0.5 * M, 0.9 * M, 1.8 * M, { mat = "WoodPlanks", col = 0x7A5A3A })
			b:obox(x, z, yaw, 0.25 * M, 0.95 * M, 0, 0.08 * M, 0.5 * M, 1.8 * M, { mat = "WoodPlanks", col = 0x7A5A3A })
		elseif k == 4 then
			-- parked bikes side by side
			local count = math.clamp(p.extra, 2, if ctx.style == "amsterdam" then 4 else 3)
			for i = 1, count do
				local off = (i - (count + 1) / 2) * 0.7 * M
				local bx, bz = Build.rot(yaw, 0, off)
				Kit.parkedBike(b, rng, x + bx, z + bz, yaw + math.pi / 2)
			end
		elseif k == 5 then
			b:cyl(x, 0.45 * M, z, 0.9 * M, 0.09 * M, { roll = math.pi / 2, mat = "Metal", col = look.bollard })
		elseif k == 6 then
			b:cyl(x, 0.3 * M, z, 0.6 * M, 2.4 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xCFC4AE })
			b:cyl(x, 0.5 * M, z, 0.15 * M, 2.1 * M, { roll = math.pi / 2, mat = "Glass", col = 0x6FA8C8, transp = 0.3, coll = false })
			b:cyl(x, 1.2 * M, z, 1.6 * M, 0.35 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xCFC4AE })
		elseif k == 7 then
			-- traffic light on the right side of the street
			local half = p.extra * DM / 2 + 0.8 * M
			local sx, sz = Build.rot(yaw, half, 0)
			local px, pz = x + sx, z + sz
			b:cyl(px, 1.8 * M, pz, 3.6 * M, 0.07 * M, { roll = math.pi / 2, mat = "Metal", col = 0x2A2A2A })
			b:obox(px, pz, yaw, 0, 3.2 * M, 0, 0.35 * M, 0.9 * M, 0.3 * M, { mat = "Metal", col = 0x1E1E1E, coll = false })
			local cols = { 0xFF3030, 0xFFB020, 0x30E060 }
			for i, c in cols do
				local lx, lz = Build.rot(yaw, 0, -0.17 * M)
				b:ball(px + lx, (3.5 - (i - 1) * 0.28) * M, pz + lz, 0.09 * M, { mat = "Neon", col = c, coll = false, shadow = false, tag = "TrafficLight" .. i })
			end
		elseif k == 8 then
			-- Paris advertising column (colonne Morris)
			b:cyl(x, 1.6 * M, z, 3.2 * M, 0.6 * M, { roll = math.pi / 2, mat = "SmoothPlastic", col = 0x2F4A33 })
			b:cyl(x, 1.5 * M, z, 2.2 * M, 0.62 * M, { roll = math.pi / 2, mat = "SmoothPlastic", col = 0xE8DCC0, coll = false })
			b:ball(x, 3.3 * M, z, 0.62 * M, { mat = "SmoothPlastic", col = 0x2F4A33 })
		elseif k == 9 then
			-- fire hydrant
			b:cyl(x, 0.35 * M, z, 0.7 * M, 0.14 * M, { roll = math.pi / 2, mat = "Metal", col = 0xB8B8B0 })
			b:ball(x, 0.72 * M, z, 0.13 * M, { mat = "Metal", col = 0xB8B8B0 })
		elseif k == 10 then
			-- bus shelter
			b:obox(x, z, yaw, -0.7 * M, 1.2 * M, 0, 0.08 * M, 2.4 * M, 3.6 * M, { mat = "Glass", col = 0x9FB7C0, transp = 0.5 })
			b:obox(x, z, yaw, 0, 2.45 * M, 0, 1.6 * M, 0.12 * M, 3.8 * M, { mat = "Metal", col = 0x3A3A3A })
			b:obox(x, z, yaw, -0.3 * M, 0.5 * M, 0, 0.4 * M, 0.08 * M, 2.4 * M, { mat = "Metal", col = 0x3A3A3A })
		end
	end
end

--- Build the whole city. `landmarks` adds the hand-made landmark models.
function Generate.city(data: CityData, landmarks: ((any) -> ())?): BuildList
	local meta = data.meta
	local b = Build.new()
	local style = meta.style :: string
	local ctx: Context = {
		b = b,
		buildings = {},
		meta = meta,
		style = style,
		look = Look.get(style),
		wl = meta.waterLevel,
		rng = Build.rng(#meta.name * 7919 + 11),
	}
	local bd = meta.bounds
	local terrain: TerrainSpec = {
		bounds = { bd[1] * DM, bd[2] * DM, bd[3] * DM, bd[4] * DM },
		waterLevel = meta.waterLevel,
		polys = {},
	}
	;(b :: any).terrain = terrain
	-- buildings
	ctx.buildings = Decode.buildings(data.buildings)
	for _, bld in ctx.buildings do
		Buildings.mass(b, bld, style, ctx.wl, ctx.rng)
	end
	streets(ctx, Decode.roads(data.roads))
	areas(ctx, Decode.areas(data.areas), terrain)
	props(ctx, Decode.props(data.props))
	if landmarks then
		landmarks(ctx)
	end
	-- points of interest
	for _, l in meta.landmarks do
		b:landmark(l.id, l.name, l.x * DM, 10, l.z * DM, l.radius * DM, l.fact)
	end
	for _, s in meta.shops do
		b:shop(s.x * DM, 0.2, s.z * DM, 0, s.label)
	end
	local c = meta.coins
	for i = 1, #c - 2, 3 do
		b:coin(c[i] * DM, c[i + 2] * DM + 3.2, c[i + 1] * DM)
	end
	local d = meta.doors
	for i = 1, #d - 1, 2 do
		b:door(d[i] * DM, 0.2, d[i + 1] * DM, 0)
	end
	b.spawn = { x = meta.spawn.x * DM, y = 6, z = meta.spawn.z * DM, yaw = meta.spawn.yaw }
	return b
end

--- Traffic lanes in city coordinates (studs). Lanes on the water get y = nil.
function Generate.lanes(data: CityData): { Decode.Lane }
	return Decode.lanes(data.lanes)
end

return Generate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Landmarks</string>
            <string name="Source"><![CDATA[--!strict
-- Hand-made models of famous landmarks, placed at their real positions
-- (from the map data). Sizes follow the real buildings (1 m = 3 studs).

local Build = require(script.Parent.Parent.Build)
local Decode = require(script.Parent.Decode)

type BuildList = Build.BuildList
type Opts = Build.Opts

local M = 3
local DM = Decode.DM

local Landmarks = {}

export type Model = { kind: string, x: number, z: number, yaw: number, w: number, d: number }

--- A local frame: (lx, ly, lz) in metres around (x, z) turned by yaw -> studs.
local function frame(x: number, z: number, yaw: number)
	local f = {}
	function f.p(lx: number, lz: number): (number, number)
		local wx, wz = Build.rot(yaw, lx * M, lz * M)
		return x + wx, z + wz
	end
	return f
end

local function with(o: Opts, group: string): Opts
	local c = table.clone(o) :: Opts
	c.group = group
	return c
end

--- Highest building top (studs) near a point.
function Landmarks.topNear(buildings: { Decode.Building }, x: number, z: number, r: number): number
	local best = 0
	for _, bld in buildings do
		local near = false
		for i = 1, bld.n do
			local dx, dz = bld.xs[i] - x, bld.zs[i] - z
			if dx * dx + dz * dz < r * r then
				near = true
				break
			end
		end
		local rc = bld.rects
		for i = 1, #rc - 4, 5 do
			if (rc[i] - x) ^ 2 + (rc[i + 1] - z) ^ 2 < r * r then
				near = true
			end
		end
		if near then
			best = math.max(best, bld.top)
		end
	end
	return best
end

-- A box beam between two points (metres in the local frame) ------------------------------
local function beam(b: BuildList, f: any, ax: number, ay: number, az: number, bx: number, by: number, bz: number, w: number, o: Opts)
	local x1, z1 = f.p(ax, az)
	local x2, z2 = f.p(bx, bz)
	b:beam(x1, ay * M, z1, x2, by * M, z2, w * M, w * M, o)
end

--- A see-through lattice frustum: corner girders and X braces on each side.
local function lattice(b: BuildList, f: any, cx0: number, cz0: number, h0: number, y0: number, cx1: number, cz1: number, h1: number, y1: number, girder: number, o: Opts)
	local c0 = { { cx0 - h0, cz0 - h0 }, { cx0 + h0, cz0 - h0 }, { cx0 + h0, cz0 + h0 }, { cx0 - h0, cz0 + h0 } }
	local c1 = { { cx1 - h1, cz1 - h1 }, { cx1 + h1, cz1 - h1 }, { cx1 + h1, cz1 + h1 }, { cx1 - h1, cz1 + h1 } }
	for i = 1, 4 do
		beam(b, f, c0[i][1], y0, c0[i][2], c1[i][1], y1, c1[i][2], girder, o)
	end
	for i = 1, 4 do
		local j = i % 4 + 1
		beam(b, f, c0[i][1], y0, c0[i][2], c1[j][1], y1, c1[j][2], girder * 0.45, o)
		beam(b, f, c0[j][1], y0, c0[j][2], c1[i][1], y1, c1[i][2], girder * 0.45, o)
	end
end

-- Paris ---------------------------------------------------------------------------------------
local function eiffel(b: BuildList, m: Model)
	local g = "Eiffel Tower"
	-- the four legs point north, east, south and west
	local f = frame(m.x, m.z, math.pi / 4)
	local iron: Opts = { mat = "Metal", col = 0x6E5B4A, group = g }
	local s0, s1, s2 = 46, 31, 17
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			-- leg up to the first floor, and on to the second
			lattice(b, f, sx * s0, sz * s0, 11, 0, sx * (s0 + s1) / 2, sz * (s0 + s1) / 2, 8.5, 30, 2.2, iron)
			lattice(b, f, sx * (s0 + s1) / 2, sz * (s0 + s1) / 2, 8.5, 30, sx * s1, sz * s1, 6.5, 57, 2, iron)
			lattice(b, f, sx * s1, sz * s1, 6, 57, sx * s2, sz * s2, 4, 115, 1.7, iron)
		end
	end
	-- the big decorative arches between the legs
	for side = 0, 3 do
		local a0 = side * math.pi / 2
		local steps = 6
		local last: { number }? = nil
		for k = 0, steps do
			local t = k / steps
			local across = (t - 0.5) * 2 * (s0 - 8)
			local up = 9 + 30 * math.sin(t * math.pi)
			local lx, lz = across * math.cos(a0) - (s0 - 3) * math.sin(a0), across * math.sin(a0) + (s0 - 3) * math.cos(a0)
			if last then
				beam(b, f, last[1], last[2], last[3], lx, up, lz, 1.6, iron)
			end
			last = { lx, up, lz }
		end
	end
	-- first and second floor platforms
	for _, fl in { { 57, 35, 6 }, { 115, 20, 4 } } do
		local y, half, h = fl[1], fl[2], fl[3]
		for side = 0, 3 do
			local a0 = side * math.pi / 2
			local cx, cz = -half * math.sin(a0), half * math.cos(a0)
			local px, pz = f.p(cx, cz)
			b:box(px, (y + h / 2) * M, pz, half * 2 * M, h * M, 2 * M, { yaw = math.pi / 4 + a0, mat = "Metal", col = 0x6E5B4A, group = g })
		end
		local px, pz = f.p(0, 0)
		b:box(px, (y + 0.5) * M, pz, half * 1.9 * M, 1 * M, half * 1.9 * M, { yaw = math.pi / 4, mat = "Metal", col = 0x5E4D3E, group = g })
	end
	-- the slim top part, curving in
	local tiers = { { 115, 17 }, { 160, 12 }, { 205, 9 }, { 245, 7 }, { 276, 5.5 } }
	for i = 1, #tiers - 1 do
		local a, c = tiers[i], tiers[i + 1]
		lattice(b, f, 0, 0, a[2], a[1], 0, 0, c[2], c[1], 1.4, iron)
	end
	local px, pz = f.p(0, 0)
	b:box(px, 280 * M, pz, 13 * M, 8 * M, 13 * M, { yaw = math.pi / 4, mat = "Metal", col = 0x6E5B4A, group = g })
	b:box(px, 288 * M, pz, 8 * M, 8 * M, 8 * M, { yaw = math.pi / 4, mat = "Metal", col = 0x5E4D3E, group = g })
	b:cyl(px, 310 * M, pz, 40 * M, 1 * M, { roll = math.pi / 2, mat = "Metal", col = 0xB9B4AA, group = g })
	b:ball(px, 296 * M, pz, 2.5 * M, { mat = "Neon", col = 0xFFE8A0, tag = "Beacon", coll = false, group = g })
	-- sparkling lights for the night show
	local rng = Build.rng(1889)
	for _ = 1, 90 do
		local y = rng:range(5, 300)
		local half = if y < 57 then 40 - y * 0.15 elseif y < 115 then 31 - (y - 57) * 0.24 else math.max(5, 17 - (y - 115) * 0.072)
		local side = rng:int(0, 3)
		local a0 = side * math.pi / 2
		local across = rng:range(-half, half)
		local lx, lz = across * math.cos(a0) - half * math.sin(a0), across * math.sin(a0) + half * math.cos(a0)
		local wx, wz = f.p(lx, lz)
		b:ball(wx, y * M, wz, 0.5, { mat = "Neon", col = 0xFFF4C2, tag = "Sparkle", coll = false, shadow = false, group = g })
	end
end

local function arc(b: BuildList, m: Model)
	local g = "Arc de Triomphe"
	-- local X: the long side (45 m), the big arches look down the avenues
	local f = frame(m.x, m.z, m.yaw)
	local stone: Opts = { mat = "Limestone", col = 0xE0D4BA, group = g }
	local W, D, H = 45, 22, 50
	local bigW, bigH, smallW, smallH = 14.6, 29.2, 8.4, 18.7
	local pw, pd = (W - bigW) / 2, (D - smallW) / 2
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local x, z = f.p(sx * (bigW / 2 + pw / 2), sz * (smallW / 2 + pd / 2))
			b:box(x, bigH / 2 * M, z, pw * M, bigH * M, pd * M, with({ yaw = m.yaw, mat = stone.mat, col = stone.col }, g))
		end
		-- above the small arch on each short side
		local x, z = f.p(sx * (bigW / 2 + pw / 2), 0)
		b:box(x, (smallH + bigH) / 2 * M, z, pw * M, (bigH - smallH) * M, smallW * M, with({ yaw = m.yaw, mat = stone.mat, col = stone.col }, g))
	end
	-- rounded tops of the big arch
	for _, sx in { -1, 1 } do
		local x, z = f.p(sx * (bigW / 2 - 1.6), 0)
		b:wedge(x, (bigH - 1.6) * M, z, D * M, 3.2 * M, 3.2 * M, with({ yaw = m.yaw + sx * math.pi / 2, roll = math.pi, mat = stone.mat, col = stone.col }, g))
	end
	-- attic with cornices
	local cx, cz = f.p(0, 0)
	b:box(cx, (bigH + H) / 2 * M, cz, W * M, (H - bigH) * M, D * M, with({ yaw = m.yaw, mat = stone.mat, col = stone.col }, g))
	for _, y in { bigH + 0.4, 37, H - 0.3 } do
		b:box(cx, y * M, cz, (W + 1.2) * M, 0.8 * M, (D + 1.2) * M, with({ yaw = m.yaw, mat = stone.mat, col = 0xEDE4CF }, g))
	end
end

local function obelisk(b: BuildList, m: Model)
	local g = "Luxor Obelisk"
	local x, z = m.x, m.z
	b:box(x, 2.5 * M, z, 5 * M, 5 * M, 5 * M, { mat = "Granite", col = 0x8E8A84, group = g })
	b:box(x, 7 * M, z, 3.6 * M, 4 * M, 3.6 * M, { mat = "Granite", col = 0x9A968F, group = g })
	b:box(x, 15 * M, z, 2.5 * M, 12 * M, 2.5 * M, { mat = "Granite", col = 0xC7A08A, group = g })
	b:box(x, 26 * M, z, 2.1 * M, 10 * M, 2.1 * M, { mat = "Granite", col = 0xC7A08A, group = g })
	b:prism(x, z, 0, 0, 31 * M, 0, 2.1 * M, 2.4 * M, 2.1 * M, { mat = "Foil", col = 0xE2B33C, group = g })
	b:prism(x, z, math.pi / 2, 0, 31 * M, 0, 2.1 * M, 2.4 * M, 2.1 * M, { mat = "Foil", col = 0xE2B33C, group = g })
	-- the two fountains on the north-south axis of the square
	for _, sz in { -1, 1 } do
		local fz = z + sz * 40 * M
		b:cyl(x, 0.5 * M, fz, 1 * M, 15 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xC9BEA6, group = g })
		b:cyl(x, 1.0 * M, fz, 0.2 * M, 14.3 * M, { roll = math.pi / 2, mat = "Glass", col = 0x5F9EC0, transp = 0.25, coll = false, group = g })
		b:cyl(x, 3 * M, fz, 4 * M, 1.4 * M, { roll = math.pi / 2, mat = "Metal", col = 0x3E5A48, group = g })
		b:cyl(x, 5 * M, fz, 0.6 * M, 5 * M, { roll = math.pi / 2, mat = "Metal", col = 0x3E5A48, group = g })
		b:cyl(x, 7.5 * M, fz, 4 * M, 0.9 * M, { roll = math.pi / 2, mat = "Metal", col = 0x3E5A48, group = g })
		b:cyl(x, 9.5 * M, fz, 0.5 * M, 2.6 * M, { roll = math.pi / 2, mat = "Foil", col = 0xD8B048, group = g })
	end
end

local function dome(b: BuildList, m: Model, top: number)
	local g = "Les Invalides"
	local x, z = m.x, m.z
	local y0 = math.max(top, 26 * M)
	b:cyl(x, y0 + 12 * M, z, 24 * M, 13 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xE0D4BA, group = g })
	b:cyl(x, y0 + 24.5 * M, z, 1 * M, 14.2 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xEDE4CF, group = g })
	b:ball(x, y0 + 25 * M, z, 14 * M, { mat = "Foil", col = 0xC9A53A, refl = 0.15, group = g })
	b:cyl(x, y0 + 42 * M, z, 9 * M, 3 * M, { roll = math.pi / 2, mat = "Foil", col = 0xD4B04A, group = g })
	b:ball(x, y0 + 46.5 * M, z, 3 * M, { mat = "Foil", col = 0xD4B04A, group = g })
	b:cyl(x, y0 + 56 * M, z, 16 * M, 0.5 * M, { roll = math.pi / 2, mat = "Foil", col = 0xE2BE50, group = g })
	b:ball(x, y0 + 64.5 * M, z, 1 * M, { mat = "Foil", col = 0xE2BE50, group = g })
end

local function alexandre(b: BuildList, m: Model)
	local g = "Pont Alexandre III"
	local f = frame(m.x, m.z, m.yaw)
	local half = m.w / 20 / 2 -- metres (w is in decimetres)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local x, z = f.p(sx * (half - 9), sz * 22)
			b:box(x, 1.5 * M, z, 8 * M, 3 * M, 8 * M, with({ yaw = m.yaw, mat = "Granite", col = 0xB5AC9A }, g))
			b:box(x, 9 * M, z, 5.5 * M, 12 * M, 5.5 * M, with({ yaw = m.yaw, mat = "Limestone", col = 0xD6CBB2 }, g))
			b:box(x, 15.5 * M, z, 6.5 * M, 1 * M, 6.5 * M, with({ yaw = m.yaw, mat = "Limestone", col = 0xE0D4BA }, g))
			-- golden winged horse with its rider (simplified)
			b:box(x, 17.5 * M, z, 1.6 * M, 3 * M, 3.2 * M, with({ yaw = m.yaw, mat = "Foil", col = 0xE2B33C }, g))
			local wx, wz = f.p(sx * (half - 9), sz * 22 - sz * 0.2)
			b:box(wx, 19.2 * M, wz, 4.4 * M, 1.6 * M, 0.25 * M, with({ yaw = m.yaw, roll = 0.35, mat = "Foil", col = 0xE2B33C }, g))
			b:box(wx, 19.2 * M, wz, 4.4 * M, 1.6 * M, 0.25 * M, with({ yaw = m.yaw, roll = -0.35, mat = "Foil", col = 0xE2B33C }, g))
		end
	end
	-- ornate lamps along both sides of the bridge
	for i = -3, 3 do
		for _, sz in { -1, 1 } do
			local x, z = f.p(i * 14, sz * 19.5)
			b:cyl(x, (0.6 + 2.6) * M, z, 5.2 * M, 0.12 * M, { roll = math.pi / 2, mat = "Metal", col = 0x2C3A30, group = g })
			local head = b:ball(x, (0.6 + 5.6) * M, z, 0.35 * M, { mat = "SmoothPlastic", col = 0xFFF1C8, tag = "StreetLight", coll = false, group = g })
			if i % 2 == 0 then
				b:light(head, 36, 1.2, 0xFFD8A0)
			end
		end
	end
end

-- Amsterdam -----------------------------------------------------------------------------------
local function westertoren(b: BuildList, m: Model)
	local g = "Westertoren"
	local x, z, yaw = m.x, m.z, m.yaw
	local brick: Opts = { yaw = yaw, mat = "Brick", col = 0x6E3B2A, group = g }
	local stone: Opts = { yaw = yaw, mat = "Limestone", col = 0xD8CFBD, group = g }
	local wood: Opts = { yaw = yaw, mat = "WoodPlanks", col = 0x2E4A6E, group = g }
	b:box(x, 16 * M, z, 9.5 * M, 32 * M, 9.5 * M, brick)
	b:box(x, 32.4 * M, z, 10.2 * M, 0.8 * M, 10.2 * M, stone)
	b:box(x, 37.5 * M, z, 8 * M, 10 * M, 8 * M, stone)
	-- octagon: two squares turned 45 degrees
	for _, t in { 0, math.pi / 4 } do
		b:box(x, 47.5 * M, z, 6.6 * M, 10 * M, 6.6 * M, { yaw = yaw + t, mat = "Limestone", col = 0xD8CFBD, group = g })
		b:box(x, 57 * M, z, 5 * M, 9 * M, 5 * M, { yaw = yaw + t, mat = wood.mat, col = wood.col, group = g })
		b:box(x, 65 * M, z, 3.6 * M, 7 * M, 3.6 * M, { yaw = yaw + t, mat = wood.mat, col = wood.col, group = g })
	end
	-- clock faces
	for k = 0, 3 do
		local a = yaw + k * math.pi / 2
		local cx, cz = x + math.sin(a) * 4.05 * M, z + math.cos(a) * 4.05 * M
		b:cyl(cx, 39 * M, cz, 0.2 * M, 1.6 * M, { yaw = a + math.pi / 2, mat = "SmoothPlastic", col = 0xF2F0EA, group = g })
	end
	-- the blue imperial crown
	b:cyl(x, 70.5 * M, z, 1.2 * M, 2.6 * M, { roll = math.pi / 2, mat = "Foil", col = 0xD9B044, group = g })
	b:ball(x, 73 * M, z, 2.4 * M, { mat = "SmoothPlastic", col = 0x2A5BB0, group = g })
	b:cyl(x, 79 * M, z, 10 * M, 0.35 * M, { roll = math.pi / 2, mat = "Foil", col = 0xD9B044, group = g })
	b:ball(x, 84.4 * M, z, 0.7 * M, { mat = "Foil", col = 0xD9B044, group = g })
end

local function munttoren(b: BuildList, m: Model)
	local g = "Munttoren"
	local x, z, yaw = m.x, m.z, m.yaw
	local w, d = math.max(m.w / 10, 6), math.max(m.d / 10, 5)
	b:box(x, 7 * M, z, w * M, 14 * M, d * M, { yaw = yaw, mat = "Brick", col = 0x7A4532, group = g })
	b:box(x, 14.3 * M, z, (w + 0.4) * M, 0.6 * M, (d + 0.4) * M, { yaw = yaw, mat = "Limestone", col = 0xE2DACB, group = g })
	b:box(x, 17.5 * M, z, 5 * M, 6 * M, 5 * M, { yaw = yaw, mat = "Limestone", col = 0xE2DACB, group = g })
	for _, t in { 0, math.pi / 4 } do
		b:box(x, 23.5 * M, z, 4.4 * M, 6 * M, 4.4 * M, { yaw = yaw + t, mat = "Limestone", col = 0xE2DACB, group = g })
		b:box(x, 28.5 * M, z, 3.2 * M, 4 * M, 3.2 * M, { yaw = yaw + t, mat = "WoodPlanks", col = 0xE8E2D2, group = g })
	end
	for k = 0, 3 do
		local a = yaw + k * math.pi / 2
		b:cyl(x + math.sin(a) * 2.25 * M, 24 * M, z + math.cos(a) * 2.25 * M, 0.2 * M, 1.4 * M, { yaw = a + math.pi / 2, mat = "SmoothPlastic", col = 0x1E2A3A, group = g })
	end
	b:ball(x, 31.5 * M, z, 1.7 * M, { mat = "Metal", col = 0x3E4E44, group = g })
	b:cyl(x, 35.5 * M, z, 6 * M, 0.25 * M, { roll = math.pi / 2, mat = "Foil", col = 0xD9B044, group = g })
	b:ball(x, 38.6 * M, z, 0.45 * M, { mat = "Foil", col = 0xD9B044, group = g })
end

local function monument(b: BuildList, m: Model)
	local g = "National Monument"
	local x, z = m.x, m.z
	local white: Opts = { mat = "Marble", col = 0xEDE8DC, group = g }
	for i, r in { 14, 12, 10 } do
		b:cyl(x, (i - 0.5) * 0.4 * M, z, 0.4 * M, r * M, { roll = math.pi / 2, mat = white.mat, col = 0xD9D3C6, group = g })
	end
	b:box(x, 12 * M, z, 4.6 * M, 21 * M, 3.4 * M, white)
	b:box(x, 22.8 * M, z, 5.4 * M, 0.8 * M, 4.2 * M, white)
	-- the curved wall behind the pillar (east side)
	for k = 0, 8 do
		local a = -math.pi / 2 + k * math.pi / 8
		local wx, wz = x + math.cos(a) * 9 * M, z + math.sin(a) * 9 * M
		b:box(wx, 1.8 * M, wz, 0.8 * M, 2.4 * M, 3.6 * M, { yaw = -a, mat = white.mat, col = white.col, group = g })
	end
end

local function palace(b: BuildList, m: Model, top: number)
	local g = "Royal Palace"
	local x, z = m.x, m.z
	local y0 = math.max(top, 27 * M)
	for _, t in { 0, math.pi / 4 } do
		b:box(x, y0 + 4 * M, z, 9 * M, 8 * M, 9 * M, { yaw = t, mat = "Sandstone", col = 0xD9CCAE, group = g })
		b:box(x, y0 + 10 * M, z, 6 * M, 4 * M, 6 * M, { yaw = t, mat = "Sandstone", col = 0xD9CCAE, group = g })
	end
	b:ball(x, y0 + 13 * M, z, 4 * M, { mat = "Metal", col = 0x5C8C74, group = g })
	b:cyl(x, y0 + 18 * M, z, 3 * M, 0.25 * M, { roll = math.pi / 2, mat = "Foil", col = 0xD9B044, group = g })
	b:box(x, y0 + 20 * M, z, 1.6 * M, 1.1 * M, 0.3 * M, { mat = "Foil", col = 0xD9B044, group = g })
end

local function magereBrug(b: BuildList, m: Model)
	local g = "Magere Brug"
	local f = frame(m.x, m.z, m.yaw)
	local white: Opts = { mat = "WoodPlanks", col = 0xF2F0EA, group = g }
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local x, z = f.p(sx * 5, sz * 4.2)
			b:box(x, 5.3 * M, z, 0.6 * M, 9.4 * M, 0.6 * M, with({ yaw = m.yaw, mat = white.mat, col = white.col }, g))
		end
		local cx, cz = f.p(sx * 5, 0)
		b:box(cx, 10.2 * M, cz, 0.6 * M, 0.6 * M, 9 * M, with({ yaw = m.yaw, mat = white.mat, col = white.col }, g))
	end
	for _, sz in { -1, 1 } do
		-- the long balance beams on top
		local x, z = f.p(0, sz * 4.2)
		b:box(x, 10.9 * M, z, 26 * M, 0.7 * M, 0.5 * M, with({ yaw = m.yaw, mat = white.mat, col = white.col }, g))
		for k = -6, 6 do
			local bx, bz = f.p(k * 2, sz * 4.2)
			b:ball(bx, 11.4 * M, bz, 0.25, { mat = "SmoothPlastic", col = 0xFFE2A0, tag = "BridgeBulb", coll = false, shadow = false, group = g })
		end
	end
end

-- New York --------------------------------------------------------------------------------------
local function spire(b: BuildList, x: number, z: number, top: number, want: number, steel: boolean, g: string)
	if top >= want * M - 20 then
		return
	end
	local mat = if steel then "Metal" else "Limestone"
	local col = if steel then 0xC9CCD0 else 0xCDBFA3
	local tiers: { number } = if steel then { 12, 9.5, 7.5, 5.5, 3.6 } else { 9, 6, 3.5 }
	local h = math.min(want * M - top, 120 * M)
	local tierH = h * 0.55 / #tiers
	local y = top
	for i, r in tiers do
		b:cyl(x, y + tierH / 2, z, tierH, r * M, { roll = math.pi / 2, mat = mat, col = col, refl = if steel then 0.35 else 0, group = g })
		if i == 2 and not steel then
			b:cyl(x, y + tierH / 2, z, tierH * 0.9, (r + 0.1) * M, { roll = math.pi / 2, mat = "Neon", col = 0x4F8BFF, tag = "Billboard", coll = false, group = g })
		end
		y += tierH
	end
	b:cyl(x, y + (want * M - y) / 2, z, want * M - y, 0.7 * M, { roll = math.pi / 2, mat = "Metal", col = 0xB9BDC2, group = g })
	b:ball(x, want * M, z, 0.8 * M, { mat = "Neon", col = 0xFF3030, tag = "Beacon", coll = false, group = g })
end

local function lion(b: BuildList, m: Model)
	local g = "Library lions"
	local stone: Opts = { yaw = m.yaw, mat = "Marble", col = 0xE3DCCB, group = g }
	b:box(m.x, 0.9 * M, m.z, 1.7 * M, 1.8 * M, 4.2 * M, { yaw = m.yaw, mat = "Granite", col = 0xA9A295, group = g })
	b:box(m.x, 2.4 * M, m.z, 1.2 * M, 1.2 * M, 3 * M, stone)
	local hx, hz = Build.rot(m.yaw, 0, -1.4 * M)
	b:ball(m.x + hx, 3.4 * M, m.z + hz, 0.95 * M, stone)
	local fx, fz = Build.rot(m.yaw, 0, -1.9 * M)
	b:ball(m.x + fx, 3.3 * M, m.z + fz, 0.6 * M, stone)
end

local function prometheus(b: BuildList, m: Model)
	local g = "Prometheus"
	b:box(m.x, 1 * M, m.z, 3 * M, 2 * M, 2 * M, { mat = "Granite", col = 0x6E6A64, group = g })
	b:cyl(m.x, 5.5 * M, m.z + 1.5, 0.3 * M, 4 * M, { mat = "Foil", col = 0xE2B33C, group = g })
	b:box(m.x, 3.6 * M, m.z, 3.6 * M, 1 * M, 1.2 * M, { roll = 0.3, mat = "Foil", col = 0xE2B33C, group = g })
	b:ball(m.x + 1.6 * M, 4.4 * M, m.z, 0.5 * M, { mat = "Foil", col = 0xE2B33C, group = g })
end

local SIGNS = { "BIKE THE WORLD", "I ♥ NY", "BROADWAY", "SHOWS TONIGHT", "NEW YORK CITY", "SMILE!", "PIZZA", "TIMES SQ", "WELCOME!", "RIDE ON!" }
local NEON = { 0xFF3B6B, 0x3BC8FF, 0xFFD23B, 0x7CFF5A, 0xB06BFF, 0xFF8A2B, 0xFFFFFF }

local function timesSquare(b: BuildList, m: Model, buildings: { Decode.Building })
	local g = "Times Square"
	local rng = Build.rng(42)
	local R = 95 * M
	local placed = 0
	for _, bld in buildings do
		if placed > 60 then
			break
		end
		local n = bld.n
		for i = 1, n do
			local c = string.byte(bld.flags, i)
			if not c or c < 50 then -- "2" or "3": street fronts only
				continue
			end
			local j = i % n + 1
			local ax, az, cx, cz = bld.xs[i], bld.zs[i], bld.xs[j], bld.zs[j]
			local mx, mz = (ax + cx) / 2, (az + cz) / 2
			if (mx - m.x) ^ 2 + (mz - m.z) ^ 2 > R * R then
				continue
			end
			local dx, dz = cx - ax, cz - az
			local L = math.sqrt(dx * dx + dz * dz)
			if L < 6 * M or bld.top < 14 * M then
				continue
			end
			local ux, uz = dx / L, dz / L
			local nx, nz = -uz, ux
			local yaw = math.atan2(-uz, ux)
			local w = math.min(L * 0.8, 24 * M)
			local h = math.min(rng:range(7, 14) * M, bld.top - 8 * M)
			local y = rng:range(5, 9) * M + h / 2
			local px, pz = mx + nx * 0.6, mz + nz * 0.6
			b:box(px, y, pz, w, h, 0.6, { yaw = yaw, mat = "Neon", col = rng:pick(NEON), tag = "Billboard", coll = false, shadow = false, group = g })
			if rng:chance(0.55) then
				local sx, sz = mx + nx * 1.1, mz + nz * 1.1
				b:sign(sx, y, sz, yaw + math.pi, w * 0.9, h * 0.45, rng:pick(SIGNS), 0xFFFFFF, 0x111111)
			end
			placed += 1
			if bld.top > 40 * M and rng:chance(0.5) then
				local h2 = math.min(rng:range(8, 16) * M, bld.top - y - h)
				if h2 > 4 * M then
					b:box(px, y + h / 2 + 2 * M + h2 / 2, pz, w * 0.85, h2, 0.6, { yaw = yaw, mat = "Neon", col = rng:pick(NEON), tag = "Billboard", coll = false, shadow = false, group = g })
					placed += 1
				end
			end
		end
	end
end

local function ballDrop(b: BuildList, m: Model, top: number)
	local g = "Times Square Ball"
	local y = math.max(top, 30 * M)
	b:cyl(m.x, y + 6 * M, m.z, 12 * M, 0.3 * M, { roll = math.pi / 2, mat = "Metal", col = 0x9A9A9A, group = g })
	b:ball(m.x, y + 12 * M, m.z, 1.8 * M, { mat = "Glass", col = 0xBFE6FF, refl = 0.4, tag = "Billboard", group = g })
end

--- Add every hand-made model listed in the city's data.
function Landmarks.build(ctx: any)
	local b: BuildList = ctx.b
	local buildings: { Decode.Building } = ctx.buildings
	for _, raw in ctx.meta.models or {} do
		local m: Model = { kind = raw.kind, x = raw.x * DM, z = raw.z * DM, yaw = raw.yaw, w = raw.w, d = raw.d }
		local k = m.kind
		if k == "eiffel" then
			eiffel(b, m)
		elseif k == "arc" then
			arc(b, m)
		elseif k == "obelisk" then
			obelisk(b, m)
		elseif k == "dome" then
			dome(b, m, Landmarks.topNear(buildings, m.x, m.z, 30 * M))
		elseif k == "alexandre" then
			alexandre(b, m)
		elseif k == "westertoren" then
			westertoren(b, m)
		elseif k == "munttoren" then
			munttoren(b, m)
		elseif k == "monument" then
			monument(b, m)
		elseif k == "palace" then
			palace(b, m, Landmarks.topNear(buildings, m.x, m.z, 12 * M))
		elseif k == "magerebrug" then
			magereBrug(b, m)
		elseif k == "empirespire" then
			spire(b, m.x, m.z, Landmarks.topNear(buildings, m.x, m.z, 20 * M), 443, false, "Empire State Building")
		elseif k == "chryslercrown" then
			spire(b, m.x, m.z, Landmarks.topNear(buildings, m.x, m.z, 14 * M), 319, true, "Chrysler Building")
		elseif k == "lion" then
			lion(b, m)
		elseif k == "prometheus" then
			prometheus(b, m)
		elseif k == "timessquare" then
			timesSquare(b, m, buildings)
		elseif k == "ballDrop" then
			ballDrop(b, m, Landmarks.topNear(buildings, m.x, m.z, 10 * M))
		end
	end
end

return Landmarks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">Look</string>
            <string name="Source"><![CDATA[--!strict
-- How each real city looks: materials, colours and street furniture styles.
-- Used by the server (city shapes) and the client (facade details).

local Look = {}

Look.M = 3 -- studs per metre

-- material codes written by tools/osm_to_luau.py
Look.MAT = {
	[0] = "Brick",
	[1] = "Plaster",
	[2] = "Limestone",
	[3] = "Concrete",
	[4] = "Glass",
	[5] = "Sandstone",
	[6] = "WoodPlanks",
	[7] = "Granite",
	[8] = "Metal",
}

-- street surface codes
Look.SURF = {
	[0] = { mat = "Asphalt", col = 0x3B3C40 },
	[1] = { mat = "Brick", col = 0x8A6658 }, -- Dutch klinkers
	[2] = { mat = "Cobblestone", col = 0x77726B }, -- Paris pavés
	[3] = { mat = "Asphalt", col = 0x9A3D33 }, -- red Dutch bike path
	[4] = { mat = "Concrete", col = 0x9D9B96 },
	[5] = { mat = "Pavement", col = 0xB5AEA2 },
	[6] = { mat = "Sand", col = 0xD2C09C }, -- park gravel
	[7] = { mat = "WoodPlanks", col = 0x8A6A4A },
	[8] = { mat = "Granite", col = 0x9A968F },
	[9] = { mat = "Grass", col = 0x5B8A3C },
}

export type CityLook = {
	quay: { mat: string, col: number },
	cap: { mat: string, col: number },
	deck: { mat: string, col: number },
	parapet: { mat: string, col: number },
	crown: { number },
	treeHeight: number, -- metres
	crownRadius: number,
	lamp: string,
	lampColor: number,
	bollard: number,
	bench: number,
	bikeColors: { number },
	shareBike: number?,
	-- facades
	groundFloor: number, -- metres
	floor: number,
	bay: number,
	window: { number }, -- width, height (metres)
	frame: number,
	glass: number,
	doorColors: { number },
	awnings: { number },
}

Look.city = {
	amsterdam = {
		quay = { mat = "Brick", col = 0x5E3B2E },
		cap = { mat = "Granite", col = 0x8E8A84 },
		deck = { mat = "Brick", col = 0x6A3C2E },
		parapet = { mat = "Brick", col = 0x6A3C2E },
		crown = { 0x4C7A34, 0x557F38, 0x46702F, 0x5E8A3F },
		treeHeight = 13,
		crownRadius = 4.2,
		lamp = "amsterdam",
		lampColor = 0x1F2B24,
		bollard = 0x5A2A22,
		bench = 0x2F4A33,
		bikeColors = { 0x1E1E20, 0x23395D, 0x2D5A3C, 0x8C2F2F, 0xD9D4C7, 0x5A4636 },
		shareBike = nil,
		groundFloor = 3.6,
		floor = 3.1,
		bay = 2.3,
		window = { 1.15, 1.9 },
		frame = 0xF2F0EA,
		glass = 0x23292E,
		doorColors = { 0x1F3A2A, 0x22324A, 0x6B1E1E, 0x1C1C1C, 0x5A3A24, 0x2E4E4E },
		awnings = { 0x2D5A3C, 0x8C2F2F, 0x23395D, 0x3B3B3B },
	} :: CityLook,
	paris = {
		quay = { mat = "Limestone", col = 0xB8AD98 },
		cap = { mat = "Limestone", col = 0xCFC4AE },
		deck = { mat = "Limestone", col = 0xC9BEA6 },
		parapet = { mat = "Limestone", col = 0xD3C8B0 },
		crown = { 0x5C7F3A, 0x678A41, 0x557636 },
		treeHeight = 16,
		crownRadius = 4.8,
		lamp = "paris",
		lampColor = 0x1E2420,
		bollard = 0x2C3A30,
		bench = 0x2C3A30,
		bikeColors = { 0x1E1E20, 0x5C6E58, 0xD9D4C7, 0x8C2F2F },
		shareBike = 0x7FA88A, -- Vélib' green
		groundFloor = 4.4,
		floor = 3.0,
		bay = 3.1,
		window = { 1.25, 2.3 },
		frame = 0xE9E4D8,
		glass = 0x2A3036,
		doorColors = { 0x1F3A2A, 0x22324A, 0x2B2B2B, 0x4A2E22 },
		awnings = { 0x8C2F2F, 0x23395D, 0x1F3A2A, 0x6B1E1E },
	} :: CityLook,
	newyork = {
		quay = { mat = "Concrete", col = 0x7D7A74 },
		cap = { mat = "Granite", col = 0x8A8680 },
		deck = { mat = "Granite", col = 0x8A8680 },
		parapet = { mat = "Granite", col = 0x8A8680 },
		crown = { 0x5A8A3A, 0x6A9444, 0x4E7A33 },
		treeHeight = 10,
		crownRadius = 3.4,
		lamp = "newyork",
		lampColor = 0x6E7378,
		bollard = 0x55595D,
		bench = 0x2F4A33,
		bikeColors = { 0x1E1E20, 0x8C2F2F, 0x23395D },
		shareBike = 0x1E6FD9, -- Citi Bike blue
		groundFloor = 4.5,
		floor = 3.4,
		bay = 2.6,
		window = { 1.1, 1.75 },
		frame = 0xD9D4C7,
		glass = 0x2A3138,
		doorColors = { 0x1C1C1C, 0x3A2A20, 0x22324A },
		awnings = { 0x8C2F2F, 0x23395D, 0x1F3A2A, 0xC8A02E, 0x3B3B3B },
	} :: CityLook,
}

function Look.get(style: string): CityLook
	return Look.city[style] or Look.city.amsterdam
end

return Look
]]></string>
