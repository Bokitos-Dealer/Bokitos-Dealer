      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">BikeModel</string>
          <string name="Source"><![CDATA[--!strict
-- Builds bike models out of parts. Used for player bikes (server) and the
-- cyclists in the city (client). Forward is -Z (like any Roblox model).
--
-- Joints the client animates every frame:
--   Root.SteerJoint (Motor6D)   -> rotate about Y to steer
--   Steer.FrontWheel (Motor6D)  -> rotate about X to roll
--   Root.RearWheel (Motor6D)    -> rotate about X to roll
--   Root.Crank (Motor6D)        -> rotate about X to pedal

local CollectionService = game:GetService("CollectionService")

local BikeModel = {}

local M = 3
BikeModel.RootHeight = 1.5 -- studs between the ground and the Root part's centre

export type Look = {
	style: string, -- "city" | "bmx" | "cargo" | "racer"
	color: Color3,
	wheel: number, -- metres
	cosmetics: { [string]: boolean }?,
	gold: boolean?,
}

local CHROME = Color3.fromRGB(185, 188, 192)
local BLACK = Color3.fromRGB(20, 20, 22)
local BROWN = Color3.fromRGB(74, 50, 33)

local function newPart(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	if shape then
		p.Shape = shape
	end
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

--- A round rod between two points (bike-local), welded to `to`.
local function rod(parent: Instance, origin: CFrame, a: Vector3, b: Vector3, thick: number, color: Color3, to: BasePart, mat: Enum.Material?): Part?
	local len = (b - a).Magnitude
	if len < 0.01 then
		return nil
	end
	local mid = (a + b) / 2
	local cf = origin * CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0)
	-- cylinders run along X; lookAt points -Z at b, so turn 90 degrees
	local p = newPart(parent, Vector3.new(len, thick, thick), cf, color, mat or Enum.Material.Metal, Enum.PartType.Cylinder)
	weld(to, p)
	return p
end

local function box(parent: Instance, origin: CFrame, center: Vector3, size: Vector3, color: Color3, to: BasePart, mat: Enum.Material?, rot: CFrame?): Part
	local p = newPart(parent, size, origin * CFrame.new(center) * (rot or CFrame.identity), color, mat or Enum.Material.SmoothPlastic)
	weld(to, p)
	return p
end

local function motor(name: string, p0: BasePart, p1: BasePart, c0: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = p0
	m.Part1 = p1
	m.C0 = c0
	m.C1 = CFrame.identity
	m.Parent = p0
	return m
end

local function wheel(parent: Instance, origin: CFrame, axle: Vector3, r: number, gold: boolean): Part
	local tire = newPart(parent, Vector3.new(0.32, r * 2, r * 2), origin * CFrame.new(axle), BLACK, Enum.Material.Rubber, Enum.PartType.Cylinder)
	local rim = newPart(parent, Vector3.new(0.36, r * 1.62, r * 1.62), origin * CFrame.new(axle), if gold then Color3.fromRGB(255, 200, 60) else CHROME, Enum.Material.Metal, Enum.PartType.Cylinder)
	rim.Transparency = 0.15
	weld(tire, rim)
	-- two "spokes" so you can see the wheel turn
	for k = 0, 1 do
		local s = newPart(parent, Vector3.new(0.1, r * 1.55, 0.12), origin * CFrame.new(axle) * CFrame.Angles(k * math.pi / 2, 0, 0), CHROME, Enum.Material.Metal)
		weld(tire, s)
	end
	local hub = newPart(parent, Vector3.new(0.5, 0.4, 0.4), origin * CFrame.new(axle), CHROME, Enum.Material.Metal, Enum.PartType.Cylinder)
	weld(tire, hub)
	tire.Name = "Wheel"
	return tire
end

--- Build a bike model at `origin` (a CFrame on the ground, facing -Z).
function BikeModel.build(look: Look, origin: CFrame, parentTo: Instance?): Model
	local model = Instance.new("Model")
	model.Name = "Bike"
	local style = look.style
	local gold = look.gold == true
	local col = look.color
	local mat = if gold then Enum.Material.Foil else Enum.Material.SmoothPlastic
	local cos: { [string]: boolean } = look.cosmetics or {}
	local r = look.wheel * M
	local wb = (if style == "cargo" then 2.0 elseif style == "bmx" then 1.0 else 1.12) * M
	local rearAxle = Vector3.new(0, r, wb / 2)
	local frontAxle = Vector3.new(0, r, -wb / 2)
	local bb = Vector3.new(0, 0.29 * M, (if style == "cargo" then 0.45 else 0.03) * M)
	local headTop = Vector3.new(0, (if style == "bmx" then 0.8 else 0.98) * M, frontAxle.Z + 0.16 * M)
	local headBottom = Vector3.new(0, (if style == "bmx" then 0.55 else 0.72) * M, frontAxle.Z + 0.09 * M)
	local saddle = Vector3.new(0, (if style == "bmx" then 0.82 elseif style == "racer" then 1.03 else 1.0) * M, bb.Z + 0.19 * M)
	if style == "cargo" then
		headTop = Vector3.new(0, 0.98 * M, bb.Z - 0.42 * M)
		headBottom = Vector3.new(0, 0.72 * M, bb.Z - 0.48 * M)
	end

	-- root (invisible, carries the mass and the constraints)
	local root = newPart(model, Vector3.new(1, 1, 1), origin * CFrame.new(0, BikeModel.RootHeight, 0), BLACK, Enum.Material.SmoothPlastic)
	root.Name = "Root"
	root.Transparency = 1
	root.Massless = false
	model.PrimaryPart = root

	-- frame
	if style == "city" or style == "cargo" then
		rod(model, origin, headTop - Vector3.new(0, 0.05 * M, 0), Vector3.new(0, 0.42 * M, bb.Z - 0.12 * M), 0.22, col, root, mat)
		rod(model, origin, Vector3.new(0, 0.42 * M, bb.Z - 0.12 * M), bb, 0.22, col, root, mat)
		rod(model, origin, headBottom, Vector3.new(0, 0.36 * M, bb.Z - 0.1 * M), 0.2, col, root, mat)
	else
		rod(model, origin, headTop, saddle - Vector3.new(0, 0.12 * M, 0.02 * M), 0.2, col, root, mat)
		rod(model, origin, headBottom, bb, 0.24, col, root, mat)
	end
	rod(model, origin, bb, saddle - Vector3.new(0, 0.1 * M, 0), 0.2, col, root, mat)
	rod(model, origin, bb, rearAxle, 0.14, col, root, mat)
	rod(model, origin, saddle - Vector3.new(0, 0.15 * M, 0), rearAxle, 0.12, col, root, mat)
	rod(model, origin, headBottom, headTop, 0.26, col, root, mat)
	if style == "city" or style == "cargo" then
		-- closed chain case and rear rack
		local mid = (bb + rearAxle) / 2 + Vector3.new(0.22, 0, 0)
		local len = (rearAxle - bb).Magnitude
		box(model, origin, mid, Vector3.new(0.15, 0.48, len), BLACK, root, Enum.Material.SmoothPlastic, CFrame.Angles(math.atan2(rearAxle.Y - bb.Y, rearAxle.Z - bb.Z) * -1 + 0, 0, 0))
		box(model, origin, Vector3.new(0, 0.78 * M, rearAxle.Z - 0.05 * M), Vector3.new(0.45, 0.08, 1.5), BLACK, root, Enum.Material.Metal)
		-- mudguards
		box(model, origin, rearAxle + Vector3.new(0, r + 0.12, 0), Vector3.new(0.3, 0.08, 1.8), col, root, mat)
	end
	-- saddle (a real Seat so the avatar can sit on it)
	local seat = Instance.new("Seat")
	seat.Name = "Saddle"
	seat.Size = Vector3.new(0.9, 0.3, 1.2)
	seat.CFrame = origin * CFrame.new(saddle)
	seat.Color = if style == "racer" then BLACK else BROWN
	seat.Material = Enum.Material.Leather
	seat.CanCollide = false
	seat.CanTouch = false
	seat.CanQuery = false
	seat.Massless = true
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.Parent = model
	weld(root, seat)
	-- rear wheel and light
	local rw = wheel(model, origin, rearAxle, r, gold)
	motor("RearWheel", root, rw, CFrame.new(rearAxle - Vector3.new(0, BikeModel.RootHeight, 0)))
	local rearLight = box(model, origin, Vector3.new(0, 0.8 * M, rearAxle.Z + 0.6), Vector3.new(0.3, 0.2, 0.15), Color3.fromRGB(170, 20, 25), root, Enum.Material.SmoothPlastic)
	rearLight.Name = "RearLight"

	-- cranks and pedals
	local crank = newPart(model, Vector3.new(0.2, 0.4, 0.4), origin * CFrame.new(bb), CHROME, Enum.Material.Metal, Enum.PartType.Cylinder)
	crank.Name = "CrankHub"
	motor("Crank", root, crank, CFrame.new(bb - Vector3.new(0, BikeModel.RootHeight, 0)))
	for _, side in { -1, 1 } do
		local arm = newPart(model, Vector3.new(0.12, 0.17 * M, 0.18), origin * CFrame.new(bb + Vector3.new(side * 0.35, -side * 0.085 * M, 0)), BLACK, Enum.Material.Metal)
		weld(crank, arm)
		local pedal = newPart(model, Vector3.new(0.45, 0.1, 0.3), origin * CFrame.new(bb + Vector3.new(side * 0.55, -side * 0.17 * M, 0)), BLACK, Enum.Material.Rubber)
		weld(crank, pedal)
	end

	-- steering assembly: rotates about the head tube
	local axis = (headTop - headBottom).Unit
	-- local Y follows the head tube, local X points sideways
	local steerCF = CFrame.fromMatrix(headBottom, axis:Cross(Vector3.new(0, 0, 1)).Unit, axis)
	local steer = newPart(model, Vector3.new(0.3, 0.3, 0.3), origin * steerCF, BLACK, Enum.Material.SmoothPlastic)
	steer.Name = "Steer"
	steer.Transparency = 1
	motor("SteerJoint", root, steer, CFrame.new(-Vector3.new(0, BikeModel.RootHeight, 0)) * steerCF)
	-- fork
	for _, side in { -0.22, 0.22 } do
		rod(model, origin, headBottom + Vector3.new(side * 0.6, 0, 0), frontAxle + Vector3.new(side, 0, 0), 0.12, col, steer, mat)
	end
	-- handlebar
	local gripY = (if style == "racer" then 0.98 elseif style == "bmx" then 0.95 else 1.07) * M
	local gripZ = headTop.Z + (if style == "racer" then -0.08 elseif style == "bmx" then 0.02 else 0.22) * M
	local stem = headTop + Vector3.new(0, 0.07 * M, -0.03 * M)
	rod(model, origin, headTop, stem, 0.16, CHROME, steer)
	local half = (if style == "bmx" then 0.34 else 0.28) * M
	rod(model, origin, stem, Vector3.new(-half, gripY, gripZ), 0.13, CHROME, steer)
	rod(model, origin, stem, Vector3.new(half, gripY, gripZ), 0.13, CHROME, steer)
	for _, side in { -1, 1 } do
		local g = rod(model, origin, Vector3.new(side * half, gripY, gripZ), Vector3.new(side * (half + 0.45), gripY, gripZ + 0.15), 0.2, BLACK, steer, Enum.Material.Rubber)
		if g then
			g.Name = if side < 0 then "GripL" else "GripR"
		end
		if cos.streamers then
			for k = 0, 2 do
				local cols = { Color3.fromRGB(255, 80, 120), Color3.fromRGB(255, 220, 60), Color3.fromRGB(80, 200, 255) }
				box(model, origin, Vector3.new(side * (half + 0.6), gripY - 0.45, gripZ + 0.2 + k * 0.08), Vector3.new(0.06, 0.9, 0.06), cols[k + 1], steer, Enum.Material.Neon)
			end
		end
	end
	-- bell
	local bell = newPart(model, Vector3.new(0.25, 0.3, 0.3), origin * CFrame.new(-half + 0.35, gripY + 0.15, gripZ - 0.25), CHROME, Enum.Material.Metal, Enum.PartType.Cylinder)
	bell.Name = "Bell"
	weld(steer, bell)
	-- head light (SpotLight switched on at night by the client)
	local lamp = box(model, origin, Vector3.new(0, headBottom.Y - 0.2, frontAxle.Z - 0.15 + 0.3), Vector3.new(0.3, 0.3, 0.3), BLACK, steer, Enum.Material.SmoothPlastic)
	lamp.Name = "HeadLamp"
	local spot = Instance.new("SpotLight")
	spot.Name = "Beam"
	spot.Range = 40
	spot.Angle = 50
	spot.Brightness = 2.5
	spot.Face = Enum.NormalId.Front
	spot.Enabled = false
	spot.Parent = lamp
	-- front wheel
	local fw = wheel(model, origin, frontAxle, r, gold)
	local fwOffset = steerCF:Inverse() * CFrame.new(frontAxle)
	motor("FrontWheel", steer, fw, CFrame.new(fwOffset.Position))
	if style == "city" then
		box(model, origin, frontAxle + Vector3.new(0, r + 0.12, 0), Vector3.new(0.3, 0.08, 1.6), col, steer, mat)
	end

	-- front crate / cargo box
	local crateTop: Vector3? = nil
	if style == "city" then
		local c = Vector3.new(0, 0.88 * M, frontAxle.Z - 0.12 * M)
		local W, D, H = 0.42 * M, 0.34 * M, 0.26 * M
		local wood = Color3.fromRGB(138, 90, 51)
		box(model, origin, c, Vector3.new(W, 0.1, D), wood, steer, Enum.Material.WoodPlanks)
		box(model, origin, c + Vector3.new(0, H / 2, -D / 2), Vector3.new(W, H, 0.1), wood, steer, Enum.Material.WoodPlanks)
		box(model, origin, c + Vector3.new(0, H / 2, D / 2), Vector3.new(W, H, 0.1), wood, steer, Enum.Material.WoodPlanks)
		box(model, origin, c + Vector3.new(-W / 2, H / 2, 0), Vector3.new(0.1, H, D), wood, steer, Enum.Material.WoodPlanks)
		box(model, origin, c + Vector3.new(W / 2, H / 2, 0), Vector3.new(0.1, H, D), wood, steer, Enum.Material.WoodPlanks)
		crateTop = c
	elseif style == "cargo" then
		local c = Vector3.new(0, 0.62 * M, (bb.Z - 0.48 * M + frontAxle.Z) / 2 - 0.1 * M)
		local W, D, H = 0.7 * M, 0.85 * M, 0.45 * M
		box(model, origin, c, Vector3.new(W, H, D), col, root, Enum.Material.WoodPlanks)
		box(model, origin, c + Vector3.new(0, H / 2 + 0.05, 0), Vector3.new(W - 0.3, 0.1, D - 0.3), Color3.fromRGB(60, 45, 35), root, Enum.Material.Fabric)
		crateTop = c + Vector3.new(0, H / 2, 0)
	end
	if crateTop and cos.flowers then
		local cols = { Color3.fromRGB(226, 61, 61), Color3.fromRGB(242, 194, 48), Color3.fromRGB(240, 122, 176), Color3.fromRGB(255, 255, 255) }
		for k = 0, 5 do
			local off = Vector3.new(((k % 3) - 1) * 0.35, 0.65, (math.floor(k / 3) - 0.5) * 0.4)
			local f = newPart(model, Vector3.new(0.35, 0.35, 0.35), origin * CFrame.new(crateTop + off), cols[(k % 4) + 1], Enum.Material.SmoothPlastic, Enum.PartType.Ball)
			weld(if style == "cargo" then root else steer, f)
		end
	end
	if cos.puppy then
		local at = crateTop or Vector3.new(0, 0.85 * M, rearAxle.Z)
		local fur = Color3.fromRGB(205, 160, 105)
		local holder = if crateTop and style == "city" then steer else root
		box(model, origin, at + Vector3.new(0, 0.55, 0.1), Vector3.new(0.6, 0.6, 0.9), fur, holder, Enum.Material.Fabric)
		box(model, origin, at + Vector3.new(0, 1.05, -0.35), Vector3.new(0.55, 0.5, 0.55), fur, holder, Enum.Material.Fabric)
		box(model, origin, at + Vector3.new(0, 0.95, -0.7), Vector3.new(0.25, 0.2, 0.2), BLACK, holder, Enum.Material.SmoothPlastic)
		for _, s in { -1, 1 } do
			box(model, origin, at + Vector3.new(s * 0.3, 1.25, -0.3), Vector3.new(0.12, 0.35, 0.25), Color3.fromRGB(150, 105, 60), holder, Enum.Material.Fabric)
		end
		box(model, origin, at + Vector3.new(0, 0.85, 0.6), Vector3.new(0.12, 0.12, 0.45), fur, holder, Enum.Material.Fabric)
	end
	if cos.rainbow then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, rearAxle.Y + 0.4 - BikeModel.RootHeight, rearAxle.Z)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, rearAxle.Y + 1.6 - BikeModel.RootHeight, rearAxle.Z)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.9
		trail.LightEmission = 0.6
		trail.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 160, 40)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 240, 60)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 220, 90)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(60, 140, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 80, 255)),
		})
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = root
	end
	CollectionService:AddTag(model, "Bike")
	model:SetAttribute("Style", style)
	if parentTo then
		model.Parent = parentTo
	end
	return model
end

--- Pedal position (bike-local, studs, relative to the ground origin) for a
--- crank angle; side = -1 left, 1 right.
function BikeModel.pedalOffset(style: string, crank: number, side: number): Vector3
	local bbZ = (if style == "cargo" then 0.45 else 0.03) * M
	local a = crank + (if side > 0 then 0 else math.pi)
	return Vector3.new(side * 0.55, 0.29 * M - math.cos(a) * 0.17 * M, bbZ + math.sin(a) * 0.17 * M)
end

return BikeModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">BikePhysics</string>
          <string name="Source"><![CDATA[--!strict
-- Bike physics, tuned for fun but based on real cycling forces:
-- pedal power, rolling resistance (depends on the street surface), air drag
-- (including head/tail wind), hills and brakes. Units: metres and seconds.
-- Pure Luau, so it can be unit tested outside Roblox.

local BikePhysics = {}

export type Params = {
	topSpeed: number, -- m/s on flat ground without wind or boost
	power: number, -- acceleration multiplier
	handling: number, -- steering multiplier
	wheel: number, -- wheel radius (m)
}

export type State = {
	speed: number, -- m/s, negative = walking the bike backwards
	steer: number, -- steering angle (rad)
	lean: number, -- lean angle (rad)
	stamina: number, -- 0..1 for the boost
	crank: number, -- pedal crank angle (rad)
	wheel: number, -- wheel rotation (rad)
	yawRate: number,
}

export type Input = {
	throttle: number, -- 0..1
	brake: number, -- 0..1
	steer: number, -- -1 (left) .. 1 (right)
	boost: boolean,
}

export type Ground = {
	crr: number, -- rolling resistance coefficient
	slope: number, -- rise over run along the direction of travel
	grip: number, -- 0..1
}

local MASS = 90
local G = 9.81
local BASE_POWER = 230 -- watts: a keen rider (snappy for a game)
local WHEELBASE = 1.1
local REF_CRR = 0.006

BikePhysics.Surfaces = {
	Asphalt = 0.005,
	SmoothPlastic = 0.005,
	Pavement = 0.008,
	Concrete = 0.007,
	Brick = 0.010,
	Cobblestone = 0.016,
	Granite = 0.009,
	Limestone = 0.009,
	Slate = 0.01,
	Wood = 0.009,
	WoodPlanks = 0.01,
	Marble = 0.007,
	Metal = 0.007,
	Sand = 0.03,
	Grass = 0.028,
	LeafyGrass = 0.03,
	Ground = 0.025,
	Mud = 0.045,
}

function BikePhysics.newState(): State
	return { speed = 0, steer = 0, lean = 0, stamina = 1, crank = 0, wheel = 0, yawRate = 0 }
end

--- Air-drag coefficient that makes `topSpeed` the cruising speed on flat ground.
local function dragK(p: Params): number
	local v = p.topSpeed
	local power = BASE_POWER * p.power
	return math.max(0.05, (power - REF_CRR * MASS * G * v) / (v * v * v))
end

local function approach(cur: number, target: number, rate: number, dt: number): number
	return cur + (target - cur) * (1 - math.exp(-rate * dt))
end

--- Advance the bike by dt seconds. `headwind` is the wind speed blowing
--- against you (m/s, negative = tailwind). Returns the new state (mutated).
function BikePhysics.step(s: State, p: Params, input: Input, ground: Ground, headwind: number, dt: number): State
	local boosting = input.boost and s.stamina > 0.02 and input.throttle > 0
	local power = BASE_POWER * p.power * (if boosting then 1.65 else 1)
	local v = s.speed

	-- forces along the direction of travel
	local drive = 0
	if input.throttle > 0 and v >= -0.05 then
		local maxForce = 190 * p.power * (if boosting then 1.4 else 1)
		drive = math.min(power / math.max(v, 1.2), maxForce) * input.throttle
	end
	local k = dragK(p)
	local air = v + headwind
	local fAir = k * air * math.abs(air)
	local fRoll = if math.abs(v) > 0.05 then ground.crr * MASS * G * math.sign(v) else 0
	local fGrav = MASS * G * ground.slope
	local accel = (drive - fAir - fRoll - fGrav) / MASS

	-- brakes (strong and friendly), and walking backwards when stopped
	if input.brake > 0 then
		if v > 0.15 then
			accel -= 5.5 * input.brake * (0.6 + 0.4 * ground.grip)
		elseif v > -1.2 then
			accel = -1.5 * input.brake
		else
			accel = 0
		end
	elseif v < 0 then
		accel = 3 -- stop rolling backwards when the brake is released
	end
	local newV = v + accel * dt
	if input.brake == 0 and v >= 0 and newV < 0 and fGrav <= 0 then
		newV = 0
	end
	if v < 0 and input.brake == 0 then
		newV = math.min(0, newV)
	end
	s.speed = math.clamp(newV, -1.4, 30)

	-- steering: quick at low speed, calmer at high speed
	local maxSteer = 0.65 / (1 + 0.25 * math.abs(s.speed)) * p.handling
	s.steer = approach(s.steer, input.steer * maxSteer, 9, dt)
	if math.abs(s.speed) < 0.6 then
		-- turn on the spot so it is easy to get going again
		s.yawRate = -input.steer * 1.4 * p.handling * (1 - math.abs(s.speed) / 0.6) - s.speed * math.tan(s.steer) / WHEELBASE * (math.abs(s.speed) / 0.6)
	else
		s.yawRate = -s.speed * math.tan(s.steer) / WHEELBASE
	end
	local latAcc = s.speed * -s.yawRate
	s.lean = approach(s.lean, math.clamp(math.atan(latAcc / G), -0.55, 0.55), 6, dt)

	-- stamina for the boost
	if boosting then
		s.stamina = math.max(0, s.stamina - 0.16 * dt)
	else
		s.stamina = math.min(1, s.stamina + 0.1 * dt)
	end

	-- animation
	if input.throttle > 0 and s.speed > 0.05 then
		s.crank += (s.speed / 4.3) * math.pi * 2 * dt
	end
	s.wheel += s.speed * dt / p.wheel
	return s
end

return BikePhysics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[--!strict
-- A "build list": plain data describing a city (no Roblox instances).
-- City generators fill it in; the server's Materializer turns it into parts,
-- terrain water and lights. Being plain data means generators can be unit
-- tested with the standalone Luau runtime.
--
-- All coordinates are studs, relative to the city origin.
-- Rotation convention matches CFrame.Angles(0, yaw, 0): local +X maps to
-- (cos yaw, 0, -sin yaw) and local +Z maps to (sin yaw, 0, cos yaw).

export type Prim = {
	k: string, -- "box" | "wedge" | "cyl" | "ball" | "cwedge"
	x: number, y: number, z: number,
	sx: number, sy: number, sz: number,
	yaw: number, pitch: number, roll: number,
	mat: string,
	col: number, -- 0xRRGGBB
	coll: boolean,
	shadow: boolean,
	tag: string?,
	transp: number,
	refl: number,
	light: { range: number, brightness: number, col: number }?,
}

export type Opts = {
	yaw: number?, pitch: number?, roll: number?,
	mat: string?, col: number?, coll: boolean?, shadow: boolean?,
	tag: string?, transp: number?, refl: number?,
}

export type Landmark = { id: string, name: string, x: number, y: number, z: number, radius: number, fact: string }
export type Lane = { kind: string, pts: { { number } }, loop: boolean? } -- kind: "bike" | "walk" | "car" | "boat"
export type Spot = { x: number, y: number, z: number, yaw: number?, label: string? }
export type Portal = { id: string, x: number, y: number, z: number, yaw: number }
export type Sign = { x: number, y: number, z: number, yaw: number, w: number, h: number, text: string, col: number, bg: number }

local Build = {}
Build.__index = Build

export type BuildList = typeof(setmetatable({} :: {
	prims: { Prim },
	water: { { number } }, -- {x,y,z,sx,sy,sz,yaw}
	ground: { { any } }, -- terrain fills: {mat,x,y,z,sx,sy,sz,yaw}
	landmarks: { Landmark },
	coins: { Spot },
	lanes: { Lane },
	doors: { Spot },
	shops: { Spot },
	signs: { Sign },
	spawn: Spot,
	portals: { Portal },
}, Build))

function Build.new(): BuildList
	local self = setmetatable({
		prims = {},
		water = {},
		ground = {},
		landmarks = {},
		coins = {},
		lanes = {},
		doors = {},
		shops = {},
		signs = {},
		spawn = { x = 0, y = 4, z = 0, yaw = 0 },
		portals = {},
	}, Build)
	return self
end

local function add(self: BuildList, k: string, x: number, y: number, z: number, sx: number, sy: number, sz: number, o: Opts?): Prim
	local op: Opts = o or {}
	local p: Prim = {
		k = k,
		x = x, y = y, z = z,
		sx = sx, sy = sy, sz = sz,
		yaw = op.yaw or 0, pitch = op.pitch or 0, roll = op.roll or 0,
		mat = op.mat or "SmoothPlastic",
		col = op.col or 0xcccccc,
		coll = if op.coll == nil then true else op.coll,
		shadow = if op.shadow == nil then true else op.shadow,
		tag = op.tag,
		transp = op.transp or 0,
		refl = op.refl or 0,
	}
	table.insert(self.prims, p)
	return p
end

function Build.box(self: BuildList, x: number, y: number, z: number, sx: number, sy: number, sz: number, o: Opts?): Prim
	return add(self, "box", x, y, z, sx, sy, sz, o)
end
function Build.wedge(self: BuildList, x: number, y: number, z: number, sx: number, sy: number, sz: number, o: Opts?): Prim
	return add(self, "wedge", x, y, z, sx, sy, sz, o)
end
function Build.cwedge(self: BuildList, x: number, y: number, z: number, sx: number, sy: number, sz: number, o: Opts?): Prim
	return add(self, "cwedge", x, y, z, sx, sy, sz, o)
end
-- Cylinder along its local X axis.
function Build.cyl(self: BuildList, x: number, y: number, z: number, length: number, radius: number, o: Opts?): Prim
	return add(self, "cyl", x, y, z, length, radius * 2, radius * 2, o)
end
function Build.ball(self: BuildList, x: number, y: number, z: number, radius: number, o: Opts?): Prim
	return add(self, "ball", x, y, z, radius * 2, radius * 2, radius * 2, o)
end

--- A box between two points on the ground plane (a beam), centred at height y.
function Build.beam(self: BuildList, ax: number, ay: number, az: number, bx: number, by: number, bz: number, w: number, h: number, o: Opts?): Prim?
	local dx, dy, dz = bx - ax, by - ay, bz - az
	local len = math.sqrt(dx * dx + dy * dy + dz * dz)
	if len < 1e-3 then
		return nil
	end
	local horiz = math.sqrt(dx * dx + dz * dz)
	local op: Opts = table.clone(o or {}) :: Opts
	-- local Z runs along the beam: yaw so that local +Z -> (dx,dz), pitch tilts it
	op.yaw = math.atan2(dx, dz)
	op.pitch = -math.atan2(dy, horiz)
	return add(self, "box", (ax + bx) / 2, (ay + by) / 2, (az + bz) / 2, w, h, len, op)
end

--- Rotate a local offset (lx, lz) by yaw.
function Build.rot(yaw: number, lx: number, lz: number): (number, number)
	local c, s = math.cos(yaw), math.sin(yaw)
	return lx * c + lz * s, -lx * s + lz * c
end

--- Oriented box in a local frame (origin ox,oz; yaw), local position (lx, ly, lz).
function Build.obox(self: BuildList, ox: number, oz: number, yaw: number, lx: number, ly: number, lz: number, sx: number, sy: number, sz: number, o: Opts?): Prim
	local wx, wz = Build.rot(yaw, lx, lz)
	local op: Opts = table.clone(o or {}) :: Opts
	op.yaw = yaw + (op.yaw or 0)
	return add(self, "box", ox + wx, ly, oz + wz, sx, sy, sz, op)
end
function Build.owedge(self: BuildList, ox: number, oz: number, yaw: number, lx: number, ly: number, lz: number, sx: number, sy: number, sz: number, o: Opts?): Prim
	local wx, wz = Build.rot(yaw, lx, lz)
	local op: Opts = table.clone(o or {}) :: Opts
	op.yaw = yaw + (op.yaw or 0)
	return add(self, "wedge", ox + wx, ly, oz + wz, sx, sy, sz, op)
end

--- Triangular prism (gable / roof): base width w along local X, height h,
--- extruded `depth` along local Z, base at ly. Apex is at local x = 0.
--- Made of two wedges whose tall edges meet at the apex.
function Build.prism(self: BuildList, ox: number, oz: number, yaw: number, lx: number, ly: number, lz: number, w: number, h: number, depth: number, o: Opts?)
	-- A WedgePart is tallest at its local +Z side and slopes down to -Z.
	-- Turning it 90 degrees puts the slope across local X.
	local half = w / 2
	-- left half: tall edge must face +X (towards the apex)
	self:owedge(ox, oz, yaw, lx - half / 2, ly + h / 2, lz, depth, h, half, (function()
		local op: Opts = table.clone(o or {}) :: Opts
		op.yaw = math.pi / 2
		return op
	end)())
	-- right half: tall edge faces -X
	self:owedge(ox, oz, yaw, lx + half / 2, ly + h / 2, lz, depth, h, half, (function()
		local op: Opts = table.clone(o or {}) :: Opts
		op.yaw = -math.pi / 2
		return op
	end)())
end

function Build.addWater(self: BuildList, x: number, y: number, z: number, sx: number, sy: number, sz: number, yaw: number?)
	table.insert(self.water, { x, y, z, sx, sy, sz, yaw or 0 })
end

function Build.light(self: BuildList, p: Prim, range: number, brightness: number, col: number)
	p.light = { range = range, brightness = brightness, col = col }
end

function Build.landmark(self: BuildList, id: string, name: string, x: number, y: number, z: number, radius: number, fact: string)
	table.insert(self.landmarks, { id = id, name = name, x = x, y = y, z = z, radius = radius, fact = fact })
end

function Build.coin(self: BuildList, x: number, y: number, z: number)
	table.insert(self.coins, { x = x, y = y, z = z })
end

function Build.lane(self: BuildList, kind: string, pts: { { number } }, loop: boolean?)
	if #pts >= 2 then
		table.insert(self.lanes, { kind = kind, pts = pts, loop = loop })
	end
end

function Build.door(self: BuildList, x: number, y: number, z: number, yaw: number, label: string?)
	table.insert(self.doors, { x = x, y = y, z = z, yaw = yaw, label = label })
end

function Build.shop(self: BuildList, x: number, y: number, z: number, yaw: number, label: string)
	table.insert(self.shops, { x = x, y = y, z = z, yaw = yaw, label = label })
end

function Build.sign(self: BuildList, x: number, y: number, z: number, yaw: number, w: number, h: number, text: string, col: number?, bg: number?)
	table.insert(self.signs, { x = x, y = y, z = z, yaw = yaw, w = w, h = h, text = text, col = col or 0xffffff, bg = bg or 0x1d3f8f })
end

--- Count primitives (for budgets/tests).
function Build.count(self: BuildList): number
	return #self.prims
end

-- Deterministic random numbers (so every server builds the same city).
export type Rng = { next: (Rng) -> number, range: (Rng, number, number) -> number, int: (Rng, number, number) -> number, pick: <T>(Rng, { T }) -> T, chance: (Rng, number) -> boolean }

function Build.rng(seed: number): Rng
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	local r = {}
	function r.next(_self: any): number
		state = (state * 48271) % 2147483647
		return (state - 1) / 2147483646
	end
	function r.range(self2: any, a: number, b: number): number
		return a + (b - a) * self2:next()
	end
	function r.int(self2: any, a: number, b: number): number
		return math.floor(a + (b - a + 1) * self2:next())
	end
	function r.pick(self2: any, list: { any }): any
		return list[math.clamp(math.floor(self2:next() * #list) + 1, 1, #list)]
	end
	function r.chance(self2: any, p: number): boolean
		return self2:next() < p
	end
	return (r :: any) :: Rng
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">Cities</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Amsterdam</string>
            <string name="Source"><![CDATA[--!strict
-- Amsterdam: a compact horseshoe of canals around the Dam, opening north to
-- the IJ where Centraal Station sits on its island. Pure build-list data.

local Build = require(script.Parent.Parent.Build)
local Kit = require(script.Parent.Parent.Kit)
local Roads = require(script.Parent.Parent.Roads)

type BuildList = Build.BuildList

local M = Kit.M
local S = Roads.SURF
local TOP = Roads.TOP
local P = Roads.P
local rad = math.rad

local Amsterdam = {}

local SECTOR = rad(100) -- canal ring half-angle (0 = south)
local R_PLAZA = 35 * M
local QUAY = 11 * M
local WATER_TOP = -1.8 * M
local WATER_DEPTH = 4 * M
local RAMP = 4 * M
local BRIDGE_H = 1.15 * M
local R_IJ = 75 * M -- north of this radius the wedge is open water (the IJ)

type Canal = { name: string, r: number, hw: number }
local CANALS: { Canal } = {
	{ name = "Singel", r = 95 * M, hw = 9 * M },
	{ name = "Herengracht", r = 166 * M, hw = 10 * M },
	{ name = "Keizersgracht", r = 239 * M, hw = 11 * M },
	{ name = "Prinsengracht", r = 312 * M, hw = 10 * M },
}
local R_EDGE = 363 * M

-- radial streets: angle (deg), start radius, width (m), name, bike lanes
type Radial = { deg: number, r0: number, w: number, name: string, bike: boolean?, boundary: boolean? }
local RADIALS: { Radial } = {
	{ deg = 0, r0 = R_PLAZA, w = 14, name = "Leidsestraat", bike = true },
	{ deg = -60, r0 = R_PLAZA, w = 10, name = "Raadhuisstraat" },
	{ deg = 60, r0 = R_PLAZA, w = 10, name = "Utrechtsestraat" },
	{ deg = -100, r0 = R_PLAZA, w = 10, name = "Haarlemmerstraat", boundary = true },
	{ deg = 100, r0 = R_PLAZA, w = 10, name = "Prins Hendrikkade", boundary = true },
	{ deg = -20, r0 = 75 * M, w = 9, name = "Spiegelstraat" },
	{ deg = 20, r0 = 75 * M, w = 9, name = "Vijzelstraat" },
	{ deg = -40, r0 = 75 * M, w = 9, name = "Runstraat" },
	{ deg = 40, r0 = 75 * M, w = 9, name = "Reguliersdwarsstraat" },
	{ deg = -80, r0 = 75 * M, w = 9, name = "Berenstraat" },
	{ deg = 80, r0 = 75 * M, w = 9, name = "Amstelstraat" },
}

-- Quay cross-section from the water outwards (metres): granite edge, tree
-- strip, klinker road, pavement in front of the houses.
local QUAY_XS = {
	{ w = 0.5, s = S.granite, top = TOP.edge, kind = "edge" },
	{ w = 2.5, s = S.strip, top = TOP.strip, kind = "strip" },
	{ w = 5.5, s = S.klinker, top = TOP.road, kind = "road" },
	{ w = 2.5, s = S.side, top = TOP.side, kind = "side" },
}

local function radialHW(rd: Radial): number
	return rd.w * M / 2
end

--- Angular half-width of a radial street at radius r (plus margin).
local function cutAngle(rd, r: number, margin: number): number
	return math.asin(math.clamp((radialHW(rd) + margin) / r, 0, 1))
end

--- Remaining [a,b] angle intervals of the ring sector after removing streets.
local function freeIntervals(r: number, margin: number, onlyFrom: number?): { { number } }
	local cuts = {}
	for _, rd in RADIALS do
		if rd.r0 <= r + 1 and (not onlyFrom or rd.r0 <= onlyFrom) then
			local th = rad(rd.deg)
			local a = cutAngle(rd, r, margin)
			table.insert(cuts, { th - a, th + a })
		end
	end
	table.sort(cuts, function(p, q)
		return p[1] < q[1]
	end)
	local out = {}
	local cur = -SECTOR
	for _, c in cuts do
		if c[1] > cur then
			table.insert(out, { cur, math.min(c[1], SECTOR) })
		end
		cur = math.max(cur, c[2])
	end
	if cur < SECTOR then
		table.insert(out, { cur, SECTOR })
	end
	return out
end

--- Height of a radial street at radius r (bridges over canals).
local function radialHeight(r: number): number
	local h = 0
	for _, c in CANALS do
		h = math.max(h, Roads.hump(r - c.r, BRIDGE_H, c.hw + RAMP))
	end
	return h
end

local function quayBands(c: Canal): ({ number }, { number })
	-- inner quay (water at larger r) and outer quay (water at smaller r)
	return { c.r - c.hw - QUAY, c.r - c.hw }, { c.r + c.hw, c.r + c.hw + QUAY }
end

-- ---------------------------------------------------------------------------
local function buildQuays(b: BuildList, rng: Build.Rng)
	for ci, c in CANALS do
		local inner, outer = quayBands(c)
		for side = 1, 2 do
			local band = if side == 1 then inner else outer
			-- strips listed from the water outwards
			local rWater = if side == 1 then band[2] else band[1]
			local dir = if side == 1 then -1 else 1
			local acc = 0
			for _, st in QUAY_XS do
				local ra = rWater + dir * acc * M
				local rb = rWater + dir * (acc + st.w) * M
				local r0, r1 = math.min(ra, rb), math.max(ra, rb)
				acc += st.w
				if st.kind == "road" then
					-- roads run straight through the crossings
					Roads.arc(b, r0, r1, -SECTOR, SECTOR, st.top, st.s)
					-- traffic lanes (both directions) and coins
					local rm = (r0 + r1) / 2
					for _, off in { -1.2 * M, 1.2 * M } do
						local pts = {}
						local n = math.ceil((rm * 2 * SECTOR) / 30)
						for i = 0, n do
							local th = -SECTOR + 2 * SECTOR * i / n
							local x, z = P(rm + off, th)
							table.insert(pts, { x, TOP.road + 0.1, z })
						end
						if off < 0 then
							local rev = {}
							for i = #pts, 1, -1 do
								table.insert(rev, pts[i])
							end
							pts = rev
						end
						b:lane("bike", pts)
						if ci <= 2 and off > 0 then
							b:lane("car", pts)
						end
					end
					for _, iv in freeIntervals(rm, 2 * M) do
						local th = iv[1] + 0.02
						while th < iv[2] - 0.02 do
							if rng:chance(0.45) then
								local x, z = P(rm, th)
								b:coin(x, TOP.road + 3, z)
							end
							th += (32 * M / 3) / rm
						end
					end
				else
					for _, iv in freeIntervals((r0 + r1) / 2, 0.4 * M) do
						Roads.arc(b, r0, r1, iv[1], iv[2], st.top, st.s)
					end
				end
				if st.kind == "side" then
					local rm = (r0 + r1) / 2
					for _, iv in freeIntervals(rm, 1 * M) do
						local pts = {}
						local n = math.max(1, math.ceil(rm * (iv[2] - iv[1]) / 30))
						for i = 0, n do
							local th = iv[1] + (iv[2] - iv[1]) * i / n
							local x, z = P(rm, th)
							table.insert(pts, { x, TOP.side + 0.1, z })
						end
						b:lane("walk", pts)
					end
				end
				if st.kind == "strip" then
					-- trees, lamps and parked bikes along the water
					local rm = (r0 + r1) / 2
					for _, iv in freeIntervals(rm, 4 * M) do
						local th = iv[1] + 0.01
						local k = 0
						while th < iv[2] - 0.01 do
							local x, z = P(rm, th)
							Kit.tree(b, rng, x, z, 1, { 0x3f6b2f, 0x4d7a35, 0x6b7a2f, 0x8a8a30 })
							local gapTh = th + (6 * M) / rm
							if gapTh < iv[2] then
								local gx, gz = P(rm, gapTh)
								local roll = rng:next()
								if k % 3 == 1 then
									Kit.lamp(b, gx, gz)
								elseif roll < 0.35 then
									local tx, tz = math.cos(gapTh), -math.sin(gapTh)
									for j = 0, 1 do
										Kit.parkedBike(b, rng, gx + tx * j * 2.2, gz + tz * j * 2.2, math.atan2(math.sin(gapTh), math.cos(gapTh)) + rng:range(-0.3, 0.3))
									end
								elseif roll < 0.6 then
									Kit.bench(b, gx, gz, Kit.faceYaw(-dir * math.sin(gapTh), -dir * math.cos(gapTh)))
								end
							end
							k += 1
							th += (12 * M) / rm
						end
					end
				end
			end
			-- Amsterdammertjes (bollards) between pavement and road
			local rEdge = if side == 1 then band[1] + 2.5 * M - 0.6 else band[2] - 2.5 * M + 0.6
			for _, iv in freeIntervals(rEdge, 2 * M) do
				local th = iv[1] + 0.01
				while th < iv[2] do
					if rng:chance(0.35) then
						local x, z = P(rEdge, th)
						Kit.bollard(b, x, z)
					end
					th += (8 * M) / rEdge
				end
			end
		end
		-- the canal: walls, water, houseboats, boat lane
		local r0, r1 = c.r - c.hw, c.r + c.hw
		Roads.arcWall(b, r0 - 1, -SECTOR, SECTOR, WATER_TOP - WATER_DEPTH, TOP.edge, 2, S.brick)
		Roads.arcWall(b, r1 + 1, -SECTOR, SECTOR, WATER_TOP - WATER_DEPTH, TOP.edge, 2, S.brick)
		Roads.arcWater(b, r0, r1, -SECTOR - rad(8), SECTOR + rad(8), WATER_TOP, WATER_DEPTH)
		local pts = {}
		local n = math.ceil(c.r * 2 * SECTOR / 40)
		for i = 0, n do
			local th = -SECTOR + 2 * SECTOR * i / n
			local x, z = P(c.r + 2.5 * M, th)
			table.insert(pts, { x, WATER_TOP, z })
		end
		b:lane("boat", pts)
		-- houseboats moored along the walls
		for _, sideR in { r0 + 2.4 * M, r1 - 2.4 * M } do
			for _, iv in freeIntervals(sideR, 12 * M) do
				local th = iv[1] + 0.02
				while th < iv[2] - (16 * M) / sideR do
					if rng:chance(0.45) then
						local len = rng:range(13, 18) * M
						local tm = th + (len / 2) / sideR
						local x, z = P(sideR, tm)
						local yaw = math.atan2(math.cos(tm), -math.sin(tm))
						local hull = rng:pick({ 0x1e2a24, 0x18202e, 0x2a1a16, 0x222222 })
						local cabin = rng:pick({ 0x6b4a2f, 0x2f4f3f, 0x3a5a7a, 0x8b6f47, 0xc9c3b5, 0x7a2f2a })
						b:box(x, WATER_TOP + 0.6, z, 4 * M, 1.8, len, { yaw = yaw, mat = "Wood", col = hull })
						b:obox(x, z, yaw, 0, WATER_TOP + 1.5 + 2.6, 0, 3.4 * M, 5.2, len * 0.75, { mat = "WoodPlanks", col = cabin })
						b:obox(x, z, yaw, 0, WATER_TOP + 1.5 + 5.4, 0, 3.6 * M, 0.4, len * 0.78, { mat = "Slate", col = 0x2a2a2a })
						b:obox(x, z, yaw, 0, WATER_TOP + 1.5 + 2.9, 0, 3.45 * M, 1.6, len * 0.6, { mat = "SmoothPlastic", col = 0x1d2a33, refl = 0.2, tag = "NightWindow", coll = false })
						th = tm + (len / 2 + rng:range(3, 8) * M) / sideR
					else
						th += (10 * M) / sideR
					end
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------------
local function buildRadials(b: BuildList, rng: Build.Rng)
	for _, rd in RADIALS do
		local th = rad(rd.deg)
		local hw = radialHW(rd)
		local rEnd = R_EDGE
		local nx, nz = math.cos(th), -math.sin(th)
		-- radius intervals that are not bridges
		local spans = {}
		local cur = rd.r0
		for _, c in CANALS do
			local a, z2 = c.r - c.hw - RAMP, c.r + c.hw + RAMP
			if a > cur then
				table.insert(spans, { cur, a })
			end
			cur = z2
			-- the bridge itself
			local ax, az = P(a, th)
			local bx, bz = P(z2, th)
			Roads.bridge(b, ax, az, bx, bz, rd.w * M, BRIDGE_H, WATER_TOP, c.hw * 2, { lights = true, segs = 6 })
		end
		if rEnd > cur then
			table.insert(spans, { cur, rEnd })
		end
		-- road surface (plus red bike lanes on wide streets)
		for _, sp in spans do
			local ax, az = P(sp[1], th)
			local bx, bz = P(sp[2], th)
			if rd.bike then
				Roads.seg(b, ax, az, bx, bz, (rd.w - 6) * M, TOP.road + 0.06, S.asphalt)
				for _, sgn in { -1, 1 } do
					local o = sgn * (rd.w / 2 - 2.5) * M
					Roads.seg(b, ax + nx * o, az + nz * o, bx + nx * o, bz + nz * o, 2 * M, TOP.bike + 0.06, S.bike)
				end
			else
				Roads.seg(b, ax, az, bx, bz, (rd.w - 3) * M, TOP.road + 0.06, S.klinker)
			end
			-- pavements, interrupted where quay roads cross
			for _, sgn in { -1, 1 } do
				local o = sgn * (hw - (if rd.bike then 1.5 else 0.75) * M)
				local sw = (if rd.bike then 3 else 1.5) * M
				local a = sp[1]
				for _, c in CANALS do
					local inner, outer = quayBands(c)
					for _, q in { inner, outer } do
						-- road part of this quay
						local q0, q1
						if q == inner then
							q0, q1 = q[2] - 8.5 * M, q[2] - 3 * M
						else
							q0, q1 = q[1] + 3 * M, q[1] + 8.5 * M
						end
						if q0 > a and q0 < sp[2] then
							local x0, z0 = P(a, th)
							local x1, z1 = P(q0, th)
							Roads.seg(b, x0 + nx * o, z0 + nz * o, x1 + nx * o, z1 + nz * o, sw, TOP.side, S.side)
							a = math.min(q1, sp[2])
						end
					end
				end
				if sp[2] - a > 1 then
					local x0, z0 = P(a, th)
					local x1, z1 = P(sp[2], th)
					Roads.seg(b, x0 + nx * o, z0 + nz * o, x1 + nx * o, z1 + nz * o, sw, TOP.side, S.side)
				end
			end
		end
		-- along the IJ the boundary streets need a quay wall on the water side
		if rd.boundary then
			local sgn = if rd.deg > 0 then 1 else -1
			for _, sp in spans do
				local a = math.max(sp[1], R_IJ)
				if sp[2] > a + 1 then
					local o = sgn * (hw + 1)
					local x0, z0 = P(a, th)
					local x1, z1 = P(sp[2], th)
					local wx0, wz0, wx1, wz1 = x0 + nx * o, z0 + nz * o, x1 + nx * o, z1 + nz * o
					local len = math.sqrt((wx1 - wx0) ^ 2 + (wz1 - wz0) ^ 2)
					b:box((wx0 + wx1) / 2, (WATER_TOP - WATER_DEPTH + TOP.side) / 2, (wz0 + wz1) / 2, 2, TOP.side - (WATER_TOP - WATER_DEPTH), len, { yaw = math.atan2(wx1 - wx0, wz1 - wz0), mat = S.brick.mat, col = S.brick.col })
				end
			end
		end
		-- lanes: both directions, following the bridge humps
		for _, sgn in { -1, 1 } do
			local o = sgn * 1.4 * M
			local pts = {}
			local r = rd.r0
			while r <= rEnd do
				local x, z = P(r, th)
				table.insert(pts, { x + nx * o, radialHeight(r) + TOP.road + 0.3, z + nz * o })
				r += 6 * M
			end
			if sgn > 0 then
				local rev = {}
				for i = #pts, 1, -1 do
					table.insert(rev, pts[i])
				end
				pts = rev
			end
			b:lane("bike", pts)
			local wpts = {}
			for _, p in pts do
				table.insert(wpts, { p[1] + nx * sgn * (hw - 1.6 * M - 1.4 * M), p[2] + 0.4, p[3] + nz * sgn * (hw - 1.6 * M - 1.4 * M) })
			end
			b:lane("walk", wpts)
		end
		-- coins along the street
		local r = rd.r0 + 10 * M
		while r < rEnd - 5 * M do
			if rng:chance(0.4) then
				local x, z = P(r, th)
				b:coin(x, radialHeight(r) + 3, z)
			end
			r += 22 * M
		end
		-- lamps on the pavements
		r = rd.r0 + 8 * M
		local s = 1
		while r < rEnd do
			if radialHeight(r) < 0.01 then
				local x, z = P(r, th)
				local o = s * (hw - 0.8 * M)
				Kit.lamp(b, x + nx * o, z + nz * o)
			end
			s = -s
			r += 26 * M
		end
	end
end

-- ---------------------------------------------------------------------------
-- Houses on every block face
local function houseRow(b: BuildList, rng: Build.Rng, R: number, facing: number, depth: number, th0: number, th1: number, floorsMin: number, floorsMax: number, doorsEvery: number)
	local len = R * (th1 - th0)
	if len < 6 * M then
		return
	end
	local acc = 0
	local count = 0
	while acc < len - 4 * M do
		local w = rng:range(7, 10.5) * M
		if len - acc - w < 5 * M then
			w = len - acc
		end
		local tA = th0 + acc / R
		local tB = th0 + (acc + w) / R
		local tm = (tA + tB) / 2
		local chord = 2 * R * math.sin((tB - tA) / 2)
		local fx, fz = P(R * math.cos((tB - tA) / 2), tm)
		local nx, nz = math.sin(tm) * facing, math.cos(tm) * facing
		local yaw = Kit.faceYaw(nx, nz)
		local _, doorLx = Kit.canalHouse(b, rng, fx, fz, yaw, chord - 0.2, depth, rng:int(floorsMin, floorsMax))
		count += 1
		if count % doorsEvery == 0 then
			local lx, lz = Build.rot(yaw, doorLx, -2 * M)
			b:door(fx + lx, TOP.side, fz + lz, yaw)
		end
		acc += w
	end
end

local function blockFaces(b: BuildList, rng: Build.Rng, r0: number, r1: number, onlyInner: boolean?, onlyOuter: boolean?, exOuter: { { number } }?, exInner: { { number } }?)
	local depth = math.min(14 * M, (r1 - r0) / 2 - 0.5)
	local function skip(a: number, z: number, list: { { number } }?): boolean
		if not list then
			return false
		end
		for _, ex in list do
			if a < ex[2] and z > ex[1] then
				return true
			end
		end
		return false
	end
	if not onlyOuter then
		for _, iv in freeIntervals(r0, 0.3 * M, r0) do
			if not skip(iv[1], iv[2], exInner) then
				houseRow(b, rng, r0, -1, depth, iv[1], iv[2], 3, 4, 3)
			end
		end
	end
	if not onlyInner then
		for _, iv in freeIntervals(r1, 0.3 * M, r1) do
			if not skip(iv[1], iv[2], exOuter) then
				houseRow(b, rng, r1, 1, depth, iv[1], iv[2], 3, 4, 3)
			end
		end
	end
	-- ground under the block (courtyards)
	Roads.arc(b, r0, r1, -SECTOR, SECTOR, 0.1, S.ground, 60)
end

-- ---------------------------------------------------------------------------
-- The north: Damrak, Prins Hendrikkade, the IJ and Centraal Station
local function buildNorth(b: BuildList, rng: Build.Rng)
	-- open water of the IJ in the north wedge
	for r = R_IJ, R_EDGE + 140 * M, 60 * M do
		local r1 = r + 60 * M
		Roads.arcWater(b, r, r1, SECTOR + rad(1), 2 * math.pi - SECTOR - rad(1), WATER_TOP, WATER_DEPTH)
	end
	-- old-centre houses north of the Dam (between the boundary streets)
	local wedge0, wedge1 = SECTOR + cutAngle(RADIALS[4], 50 * M, 0.3 * M), 2 * math.pi - SECTOR - cutAngle(RADIALS[4], 50 * M, 0.3 * M)
	local dam0 = math.pi - math.asin(13 * M / R_PLAZA)
	Roads.arc(b, R_PLAZA, 64 * M, SECTOR, 2 * math.pi - SECTOR, 0.1, S.ground, 60)
	for _, iv in { { wedge0, math.pi - math.asin(13 * M / (64 * M)) }, { math.pi + math.asin(13 * M / (64 * M)), wedge1 } } do
		houseRow(b, rng, 64 * M, 1, 13 * M, iv[1], iv[2], 4, 5, 2)
	end
	houseRow(b, rng, R_PLAZA + 0.2, -1, 12 * M, wedge0, dam0, 4, 5, 2)
	-- (the west side of the Dam is the Royal Palace)
	-- Prins Hendrikkade along the water
	Roads.arc(b, 64 * M, 72 * M, SECTOR, 2 * math.pi - SECTOR, TOP.road, S.asphalt)
	Roads.arc(b, 72 * M, 75 * M, SECTOR, 2 * math.pi - SECTOR, TOP.side, S.side)
	Roads.arcWall(b, R_IJ + 1, SECTOR, 2 * math.pi - SECTOR, WATER_TOP - WATER_DEPTH, TOP.side, 2, S.brick)
	-- Damrak (north) from the Dam to the station island, with bike lanes
	local zA, zB = -R_PLAZA, -R_IJ
	Roads.seg(b, 0, zA, 0, zB, 14 * M, TOP.road + 0.06, S.asphalt)
	for _, sx in { -1, 1 } do
		Roads.seg(b, sx * 8.5 * M, zA, sx * 8.5 * M, zB, 2.5 * M, TOP.bike + 0.06, S.bike)
		Roads.seg(b, sx * 11 * M, zA, sx * 11 * M, -64 * M, 2.5 * M, TOP.side, S.side)
	end
	-- low bridge over the water to the island
	Roads.bridge(b, 0, -R_IJ + 2, 0, -128 * M - 2, 24 * M, 0.5 * M, WATER_TOP, 30 * M, { deck = S.asphalt, wall = S.stone, segs = 10, lights = true })
	-- station island
	local ix0, ix1, iz0, iz1 = -75 * M, 75 * M, -176 * M, -128 * M
	b:box(0, -WATER_DEPTH / 2 + 0.15, (iz0 + iz1) / 2, ix1 - ix0, WATER_DEPTH * 2 + 0.3, iz1 - iz0, { mat = "Pavement", col = 0xb4ac9d })
	-- Centraal Station
	Amsterdam.station(b, rng, 0, -158 * M)
	b.spawn = { x = 0, y = TOP.plaza + 4, z = -132 * M, yaw = math.pi }
	-- parked bikes in front of the station (there are thousands in real life)
	for row = 0, 2 do
		for i = -18, 18 do
			if math.abs(i) > 4 and rng:chance(0.85) then
				Kit.parkedBike(b, rng, i * 2.2 + rng:range(-0.3, 0.3), -136 * M - row * 3 * M, rng:range(-0.15, 0.15))
			end
		end
	end
	-- lanes on Damrak
	for _, sx in { -1, 1 } do
		local pts = {}
		for z = zA, -128 * M, -15 do
			local u = z - (-R_IJ + 2 + (-128 * M - 2)) / 2
			local L = (128 * M - R_IJ + 4) / 2
			local h = if z < -R_IJ then Roads.hump(u, 0.5 * M, L) + 0.3 else TOP.road
			table.insert(pts, { sx * 8.5 * M, h + 0.3, z })
		end
		if sx > 0 then
			local rev = {}
			for i = #pts, 1, -1 do
				table.insert(rev, pts[i])
			end
			pts = rev
		end
		b:lane("bike", pts)
	end
	-- a windmill on the east waterfront (De Gooyer style)
	local wx, wz = P(R_EDGE - 10 * M, SECTOR - rad(4))
	Amsterdam.windmill(b, wx, wz)
	b:landmark("windmill", "Windmill", wx, 10, wz, 40 * M, "The Netherlands has about 1,000 windmills. They used to pump water out of the low land!")
end

-- ---------------------------------------------------------------------------
-- Landmarks
function Amsterdam.station(b: BuildList, rng: Build.Rng, cx: number, cz: number)
	local w, d = 120 * M, 22 * M
	local brick = 0x8a3f2c
	local yaw = math.pi -- facade faces +z (towards the city)
	b:obox(cx, cz, yaw, 0, 9 * M, 0, w, 18 * M, d, { mat = "Brick", col = brick })
	-- windows rows
	for f = 0, 2 do
		for i = -12, 12 do
			b:obox(cx, cz, yaw, i * 4.5 * M, (3 + f * 5) * M, -d / 2 - 0.2, 1.6 * M, 2.8 * M, 0.5, { mat = "SmoothPlastic", col = 0x26323d, refl = 0.2, tag = if rng:chance(0.4) then "NightWindow" else nil, coll = false, shadow = false })
		end
	end
	-- light stone bands
	for _, y in { 5.5, 10.5, 15.5 } do
		b:obox(cx, cz, yaw, 0, y * M, -d / 2 - 0.3, w + 0.5, 0.6 * M, 0.8, { mat = "Limestone", col = 0xd8ccb3, coll = false })
	end
	-- central hall with a gable
	b:obox(cx, cz, yaw, 0, 12 * M, -2 * M, 30 * M, 24 * M, d, { mat = "Brick", col = brick })
	b:prism(cx, cz, yaw, 0, 24 * M, -2 * M, 30 * M, 8 * M, d, { mat = "Slate", col = 0x4f6a63 })
	-- two towers with clocks
	for _, sx in { -1, 1 } do
		local tx = sx * 20 * M
		b:obox(cx, cz, yaw, tx, 17 * M, -d / 2 + 3 * M, 7 * M, 34 * M, 7 * M, { mat = "Brick", col = brick })
		b:obox(cx, cz, yaw, tx, 34.5 * M, -d / 2 + 3 * M, 7.8 * M, 1 * M, 7.8 * M, { mat = "Limestone", col = 0xd8ccb3 })
		-- pointed roof: two crossing gables
		b:prism(cx, cz, yaw, tx, 35 * M, -d / 2 + 3 * M, 7.6 * M, 8 * M, 7.6 * M, { mat = "Slate", col = 0x4f6a63 })
		b:prism(cx, cz, yaw + math.pi / 2, d / 2 - 3 * M, 35 * M, tx, 7.6 * M, 8 * M, 7.6 * M, { mat = "Slate", col = 0x4f6a63 })
		local fx, fz = Build.rot(yaw, tx, -d / 2 - 0.6 + 3 * M - 3.6 * M)
		b:cyl(cx + fx, 28 * M, cz + fz, 0.4, 2.2 * M, { yaw = yaw + math.pi / 2, mat = "SmoothPlastic", col = if sx < 0 then 0xf2efe6 else 0xe7c46a, coll = false })
	end
	-- arched entrances
	for i = -2, 2 do
		b:obox(cx, cz, yaw, i * 6 * M, 3 * M, -d / 2 - 0.3, 4 * M, 6 * M, 0.6, { mat = "SmoothPlastic", col = 0x2a201b, coll = false })
	end
	b:landmark("centraal", "Centraal Station", cx, 10, cz + d, 45 * M, "Amsterdam Centraal opened in 1889 and is built on three artificial islands. Its bike parking holds thousands of bikes!")
end

function Amsterdam.windmill(b: BuildList, x: number, z: number)
	b:box(x, 4 * M, z, 9 * M, 8 * M, 9 * M, { mat = "Brick", col = 0x6b4a3a })
	b:cyl(x, 14 * M, z, 12 * M, 3.6 * M, { roll = math.pi / 2, mat = "WoodPlanks", col = 0x5a4636 })
	b:ball(x, 20 * M, z, 3.9 * M, { mat = "Slate", col = 0x3a3a3a })
	-- sails (cross)
	for i = 0, 3 do
		local a = i * math.pi / 2 + 0.3
		local sx, sy = math.cos(a) * 7 * M, math.sin(a) * 7 * M
		-- each sail's long axis (local Y) points along angle a
		b:box(x + sx, 20 * M + sy, z - 4.2 * M, 1.6 * M, 14 * M, 0.4, { roll = a - math.pi / 2, mat = "WoodPlanks", col = 0xe9e4d8, tag = "Sail" })
	end
end

local function damSquare(b: BuildList, rng: Build.Rng)
	-- plaza disc
	b:cyl(0, TOP.plaza - 0.3, 0, 0.6, R_PLAZA + 1, { roll = math.pi / 2, mat = "Pavement", col = 0xb9b1a2 })
	-- National Monument (white obelisk)
	local mx, mz = P(22 * M, rad(80))
	for i = 0, 2 do
		b:cyl(mx, TOP.plaza + i * 0.4 * M, mz, 0.4 * M, (9 - i * 1.5) * M, { roll = math.pi / 2, mat = "Limestone", col = 0xe0dbcf })
	end
	b:box(mx, 12 * M, mz, 2.6 * M, 22 * M, 2.6 * M, { mat = "Limestone", col = 0xeee9dd })
	b:landmark("monument", "National Monument", mx, 10, mz, 20 * M, "This white pillar on the Dam remembers the people who died in the Second World War.")
	-- Royal Palace on the west side of the Dam
	local th = rad(-125)
	local px, pz = P(R_PLAZA + 1 + 7 * M, th)
	local yaw = Kit.faceYaw(-math.sin(th), -math.cos(th))
	b:obox(px, pz, yaw, 0, 12 * M, 0, 40 * M, 24 * M, 14 * M, { mat = "Limestone", col = 0xcbbd9e })
	for f = 0, 3 do
		for i = -4, 4 do
			b:obox(px, pz, yaw, i * 4.4 * M, (3 + f * 5.5) * M, -7 * M - 0.2, 1.6 * M, 3 * M, 0.5, { mat = "SmoothPlastic", col = 0x26323d, coll = false, shadow = false, tag = if rng:chance(0.3) then "NightWindow" else nil })
		end
	end
	b:obox(px, pz, yaw, 0, 25 * M, 0, 36 * M, 2 * M, 12 * M, { mat = "Metal", col = 0x5b5e60 })
	b:cyl(px, 29 * M, pz, 6 * M, 4 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xd6c9aa })
	b:ball(px, 33 * M, pz, 4.2 * M, { mat = "Metal", col = 0x4f8f7a })
	b:box(px, 38 * M, pz, 0.4, 5 * M, 0.4, { mat = "Metal", col = 0xd4af37 })
	b:landmark("palace", "Royal Palace", px, 10, pz, 40 * M, "The Royal Palace on the Dam was built as the city hall in the 1600s. Today the King uses it for big events.")
	b:landmark("dam", "Dam Square", 0, 4, 0, 25 * M, "Amsterdam began here: people built a dam in the river Amstel, and that is how the city got its name.")
	-- pigeons' favourite benches
	for i = 0, 5 do
		local bx, bz = P(28 * M, rad(i * 60 + 10))
		if math.abs(math.atan2(bx, bz)) < math.pi * 0.9 then
			Kit.bench(b, bx, bz, rad(i * 60 + 10))
		end
	end
end

local function westerkerk(b: BuildList)
	local th = rad(-70)
	local r = 202 * M
	local x, z = P(r, th)
	local yaw = Kit.faceYaw(math.sin(th), math.cos(th))
	b:obox(x, z, yaw, 0, 8 * M, 0, 16 * M, 16 * M, 26 * M, { mat = "Brick", col = 0x7d3a2b })
	b:prism(x, z, yaw, 0, 16 * M, 0, 16 * M, 10 * M, 26 * M, { mat = "Slate", col = 0x3b4447 })
	-- tower towards the Keizersgracht
	local tx, tz = Build.rot(yaw, 0, -15 * M)
	local cx, cz = x + tx, z + tz
	b:box(cx, 14 * M, cz, 7 * M, 28 * M, 7 * M, { mat = "Brick", col = 0x7d3a2b })
	b:box(cx, 32 * M, cz, 6 * M, 8 * M, 6 * M, { mat = "Limestone", col = 0xcfc6b3 })
	b:cyl(cx, 40 * M, cz, 8 * M, 2.6 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xd8d0bf })
	b:cyl(cx, 47 * M, cz, 6 * M, 1.9 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xcfc6b3 })
	-- the blue imperial crown
	b:ball(cx, 51.5 * M, cz, 2.2 * M, { mat = "SmoothPlastic", col = 0x2c4f9e })
	b:cyl(cx, 50.2 * M, cz, 0.6 * M, 2.3 * M, { roll = math.pi / 2, mat = "Metal", col = 0xd4af37 })
	b:box(cx, 57 * M, cz, 0.5, 9 * M, 0.5, { mat = "Metal", col = 0xd4af37 })
	b:landmark("westerkerk", "Westerkerk", cx, 10, cz, 45 * M, "Its tower has a blue crown on top and is the tallest church tower in Amsterdam. The famous painter Rembrandt is buried here.")
	return { th - 0.12, th + 0.12 }
end

local function munttoren(b: BuildList)
	local x, z = P(70 * M, rad(10))
	b:box(x, 6 * M, z, 6 * M, 12 * M, 6 * M, { mat = "Brick", col = 0x7d3a2b })
	b:cyl(x, 15 * M, z, 6 * M, 2.6 * M, { roll = math.pi / 2, mat = "Limestone", col = 0xe3dccb })
	b:ball(x, 19 * M, z, 2.4 * M, { mat = "Metal", col = 0x3d5e55 })
	b:box(x, 23 * M, z, 0.6, 6 * M, 0.6, { mat = "Metal", col = 0xd4af37 })
	b:landmark("munt", "Munttoren", x, 10, z, 30 * M, "The Mint Tower: coins were made here a long time ago, in 1672 and 1673.")
	return { rad(10) - 0.15, rad(10) + 0.15 }
end

local function bloemenmarkt(b: BuildList, rng: Build.Rng)
	local cols = { 0xe23d3d, 0xf2c230, 0xf07ab0, 0xffffff, 0xff7f2a, 0x8e4ad6 }
	for deg = -15, -6, 1.6 do
		local th = rad(deg)
		local x, z = P(86 * M + 3 * M, th)
		local yaw = Kit.faceYaw(-math.sin(th), -math.cos(th))
		b:obox(x, z, yaw, 0, WATER_TOP + 1, 0, 4 * M, 2, 5 * M, { mat = "Wood", col = 0x2d3b2f })
		b:obox(x, z, yaw, 0, WATER_TOP + 1 + 2.5 * M, 0, 3.6 * M, 4.6 * M, 4.4 * M, { mat = "Glass", col = 0xe9efe7, transp = 0.3 })
		b:obox(x, z, yaw, 0, WATER_TOP + 1 + 4.9 * M, 0, 4 * M, 0.4 * M, 5 * M, { mat = "SmoothPlastic", col = 0x2f5d3a })
		for k = -2, 2 do
			b:obox(x, z, yaw, k * 0.75 * M, 0.9, -2.8 * M, 0.6 * M, 0.6 * M, 0.6 * M, { mat = "SmoothPlastic", col = rng:pick(cols), coll = false })
		end
	end
	local x, z = P(86 * M, rad(-10))
	b:landmark("bloemenmarkt", "Flower Market", x, 4, z, 30 * M, "The Bloemenmarkt is a flower market that floats on the Singel canal. Look for tulips!")
	b:shop(x, TOP.side, z, 0, "Flower Market")
end

function Amsterdam.generate(): BuildList
	local b = Build.new()
	local rng = Build.rng(1606)
	damSquare(b, rng)
	buildQuays(b, rng)
	buildRadials(b, rng)
	-- block bands
	local wk = westerkerk(b)
	local mt = munttoren(b)
	blockFaces(b, rng, R_PLAZA, CANALS[1].r - CANALS[1].hw - QUAY, false, false, { mt }, nil)
	for i = 1, #CANALS - 1 do
		local r0 = CANALS[i].r + CANALS[i].hw + QUAY
		local r1 = CANALS[i + 1].r - CANALS[i + 1].hw - QUAY
		local ex = if i == 2 then { wk } else nil
		blockFaces(b, rng, r0, r1, false, false, ex, ex)
	end
	-- outer row facing the Prinsengracht
	blockFaces(b, rng, CANALS[4].r + CANALS[4].hw + QUAY, R_EDGE, true)
	buildNorth(b, rng)
	bloemenmarkt(b, rng)
	-- an invisible fence around the edge of the city
	Roads.arcWall(b, R_EDGE + 2, -SECTOR, SECTOR, -2, 40, 2, { mat = "SmoothPlastic", col = 0xffffff }, 60)
	for i = #b.prims, 1, -1 do
		local p = b.prims[i]
		if p.mat == "SmoothPlastic" and p.col == 0xffffff and p.sy == 42 then
			p.transp = 1
			p.shadow = false
		else
			break
		end
	end
	-- a few cafés and shops as delivery pickup points
	for _, deg in { -50, -10, 30, 70 } do
		local x, z = P(CANALS[2].r - CANALS[2].hw - QUAY + 1 * M, rad(deg))
		b:shop(x, TOP.side, z, 0, "Café")
	end
	return b
end

Amsterdam.info = {
	radius = R_EDGE,
	waterTop = WATER_TOP,
}

return Amsterdam
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Hub</string>
            <string name="Source"><![CDATA[--!strict
-- The hub: a round island with a big globe, a practice loop, the bike shop
-- and one glowing portal per city.

local Build = require(script.Parent.Parent.Build)
local Kit = require(script.Parent.Parent.Kit)
local Roads = require(script.Parent.Parent.Roads)

type BuildList = Build.BuildList

local M = Kit.M
local S = Roads.SURF
local TOP = Roads.TOP

local Hub = {}

export type PortalCity = { id: string, name: string, col: number }

local DEFAULT_CITIES: { PortalCity } = {
	{ id = "amsterdam", name = "Amsterdam", col = 0xe63c28 },
	{ id = "paris", name = "Paris", col = 0x2850c8 },
	{ id = "newyork", name = "New York", col = 0xfac828 },
}

function Hub.generate(cities: { PortalCity }?): BuildList
	local list = cities or DEFAULT_CITIES
	local b = Build.new()
	local rng = Build.rng(42)
	local R = 70 * M
	-- island, grass ring and the sea around it
	b:cyl(0, -6, 0, 12, R, { roll = math.pi / 2, mat = "Grass", col = 0x5a8f3a })
	b:cyl(0, TOP.plaza - 0.3, 0, 0.6, 52 * M, { roll = math.pi / 2, mat = "Pavement", col = 0xc4bcae })
	for x = -260 * M, 200 * M, 200 * M do
		for z = -260 * M, 200 * M, 200 * M do
			b:addWater(x + 30 * M, -9, z + 30 * M, 200 * M, 12, 200 * M)
		end
	end
	-- practice loop with coins
	Roads.arc(b, 30 * M, 38 * M, -math.pi, math.pi, TOP.road + 0.05, S.asphalt, 24)
	Roads.arc(b, 29 * M, 30 * M, -math.pi, math.pi, TOP.bike + 0.06, S.bike, 24)
	Roads.arc(b, 38 * M, 39 * M, -math.pi, math.pi, TOP.bike + 0.06, S.bike, 24)
	local loop = {}
	for k = 0, 48 do
		local a = k / 48 * math.pi * 2
		table.insert(loop, { math.sin(a) * 34 * M, TOP.road + 0.4, math.cos(a) * 34 * M })
		if k % 3 == 0 and k < 48 then
			b:coin(math.sin(a) * 34 * M, TOP.road + 3, math.cos(a) * 34 * M)
		end
	end
	b:lane("bike", loop, true)
	-- the globe
	b:cyl(0, 2.5 * M, 0, 5 * M, 7 * M, { roll = math.pi / 2, mat = "Marble", col = 0xe6e2da })
	b:ball(0, 16 * M, 0, 10 * M, { mat = "SmoothPlastic", col = 0x2b6cb0 })
	for k = 1, 9 do
		local a = rng:range(0, math.pi * 2)
		local e = rng:range(-0.9, 0.9)
		local x, y, z = math.cos(a) * math.cos(e), math.sin(e), math.sin(a) * math.cos(e)
		b:ball(x * 8.6 * M, 16 * M + y * 8.6 * M, z * 8.6 * M, rng:range(2.5, 4.5) * M, { mat = "Grass", col = 0x4f9d4a })
	end
	b:sign(0, 30 * M, 0, 0, 40 * M, 6 * M, "BIKE THE WORLD", 0xffffff, 0x1d3f8f)
	b:sign(0, 30 * M, 0, math.pi, 40 * M, 6 * M, "BIKE THE WORLD", 0xffffff, 0x1d3f8f)
	-- portals
	local n = #list
	for i, c in list do
		local a = math.pi + (i - (n + 1) / 2) * (math.pi / 2.4)
		local r = 47 * M
		local x, z = math.sin(a) * r, math.cos(a) * r
		local yaw = Kit.faceYaw(-math.sin(a), -math.cos(a)) -- face the globe
		local w, h = 14 * M, 16 * M
		local frame = { mat = "Neon", col = c.col }
		b:obox(x, z, yaw, -w / 2, h / 2, 0, 1.5 * M, h, 1.5 * M, frame)
		b:obox(x, z, yaw, w / 2, h / 2, 0, 1.5 * M, h, 1.5 * M, frame)
		b:obox(x, z, yaw, 0, h, 0, w + 1.5 * M, 1.5 * M, 1.5 * M, frame)
		b:obox(x, z, yaw, 0, h / 2, 0, w - 1.5 * M, h - 1, 0.6, { mat = "ForceField", col = c.col, transp = 0.2, coll = false, tag = "Portal:" .. c.id })
		local sx, sz = Build.rot(yaw, 0, -1.2 * M)
		b:sign(x + sx, h + 4 * M, z + sz, yaw, w + 4 * M, 3.2 * M, c.name, 0xffffff, c.col)
		table.insert(b.portals, { id = c.id, x = x, y = h / 2, z = z, yaw = yaw })
		-- flower boxes either side
		for _, sd in { -1, 1 } do
			local fx, fz = Build.rot(yaw, sd * (w / 2 + 3 * M), -2 * M)
			Kit.flowerBox(b, rng, x + fx, z + fz, yaw)
		end
	end
	-- bike shop kiosk
	local kx, kz = math.sin(0.4) * 46 * M, math.cos(0.4) * 46 * M
	local kyaw = Kit.faceYaw(-math.sin(0.4), -math.cos(0.4))
	b:obox(kx, kz, kyaw, 0, 2 * M, 0, 12 * M, 4 * M, 6 * M, { mat = "Wood", col = 0xb5651d })
	b:obox(kx, kz, kyaw, 0, 1.2 * M, -3.5 * M, 12 * M, 2.4 * M, 1 * M, { mat = "Wood", col = 0x8b4513, tag = "ShopKiosk" })
	b:obox(kx, kz, kyaw, 0, 4.6 * M, -1.5 * M, 13 * M, 0.4 * M, 9 * M, { mat = "Fabric", col = 0xe63c28, pitch = -0.2 })
	local sx, sz = Build.rot(kyaw, 0, -4.2 * M)
	b:sign(kx + sx, 6.2 * M, kz + sz, kyaw, 12 * M, 2.4 * M, "BIKE SHOP", 0xffffff, 0x2d6a4f)
	for j = -2, 2 do
		local px, pz = Build.rot(kyaw, j * 2.2 * M, -6 * M)
		Kit.parkedBike(b, rng, kx + px, kz + pz, kyaw + math.pi / 2)
	end
	-- trees and benches on the grass ring
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2 + 0.13
		if math.abs(math.cos(a - math.pi)) < 0.6 or k % 2 == 0 then
			Kit.tree(b, rng, math.sin(a) * 61 * M, math.cos(a) * 61 * M, 1.1)
		end
		if k % 4 == 1 then
			Kit.lamp(b, math.sin(a) * 51 * M, math.cos(a) * 51 * M)
		end
	end
	-- an invisible fence at the shore
	Roads.arcWall(b, R + 1, -math.pi, math.pi, -2, 40, 2, { mat = "SmoothPlastic", col = 0xfffffe }, 40)
	for _, p in b.prims do
		if p.col == 0xfffffe then
			p.transp = 1
			p.shadow = false
		end
	end
	b.spawn = { x = 0, y = 4, z = 20 * M, yaw = math.pi }
	return b
end

return Hub
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">NewYork</string>
            <string name="Source"><![CDATA[--!strict
-- New York: a Manhattan street grid with Central Park, Broadway cutting
-- diagonally through Times Square, the Empire State and Flatiron buildings,
-- the Brooklyn Bridge and the Statue of Liberty out in the harbour.

local Build = require(script.Parent.Parent.Build)
local Kit = require(script.Parent.Parent.Kit)
local Roads = require(script.Parent.Parent.Roads)
local Grid = require(script.Parent.Parent.Grid)

type BuildList = Build.BuildList
type Rng = Build.Rng

local M = Kit.M
local S = Roads.SURF
local TOP = Roads.TOP

local NewYork = {}

local AVES = { -300, -180, -60, 60, 180, 300 }
local AVE_W = 22 * M
local ST_W = 14 * M
local Z_FIRST, Z_STEP, Z_COUNT = -400, 55, 14
local X_EDGE = 335 * M -- edge highways
local SHORE = 347 * M -- quay wall position
local Z_SOUTH = 330 * M -- southern edge street
local HARBOUR = 345 * M
local WATER_TOP = -2.5 * M
local WATER_DEPTH = 5 * M
local PARK = { x0 = -180, x1 = 180, z0 = -400, z1 = -235 }
local BROADWAY_A = { -180 * M, -235 * M }
local BROADWAY_B = { 300 * M, 300 * M }
local BROADWAY_W = 20 * M
local PALETTE = { 0x3f6b2f, 0x4d7a35, 0x56823a, 0x5d8a3f }

local function streetZ(k: number): number
	return (Z_FIRST + Z_STEP * k) * M
end

--- Distance from (x, z) to the Broadway centre line.
local function broadwayDist(x: number, z: number): number
	local ax, az = BROADWAY_A[1], BROADWAY_A[2]
	local dx, dz = BROADWAY_B[1] - ax, BROADWAY_B[2] - az
	local len = math.sqrt(dx * dx + dz * dz)
	local t = math.clamp(((x - ax) * dx + (z - az) * dz) / (len * len), 0, 1)
	local px, pz = ax + dx * t, az + dz * t
	return math.sqrt((x - px) ^ 2 + (z - pz) ^ 2)
end

local function broadwayZAt(x: number): number
	local t = (x - BROADWAY_A[1]) / (BROADWAY_B[1] - BROADWAY_A[1])
	return BROADWAY_A[2] + (BROADWAY_B[2] - BROADWAY_A[2]) * t
end

local function inPark(x: number, z: number): boolean
	return x > PARK.x0 * M and x < PARK.x1 * M and z > PARK.z0 * M and z < PARK.z1 * M
end

-- ---------------------------------------------------------------------------
-- Landmarks
function NewYork.liberty(b: BuildList, cx: number, cz: number)
	local copper = 0x5fa894
	local stone = 0xb9ad94
	-- island and star-shaped fort
	b:cyl(cx, WATER_TOP - 2, cz, WATER_DEPTH + 2 * M + 2, 34 * M, { roll = math.pi / 2, mat = "Grass", col = 0x4d7a35 })
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		b:box(cx + math.cos(a) * 9 * M, 1.5 * M, cz + math.sin(a) * 9 * M, 18 * M, 4 * M, 9 * M, { yaw = -a, mat = "Granite", col = 0x9b927f })
	end
	b:box(cx, 4 * M, cz, 18 * M, 8 * M, 18 * M, { mat = "Granite", col = 0x9b927f })
	-- pedestal
	b:box(cx, 14 * M, cz, 12 * M, 12 * M, 12 * M, { mat = "Granite", col = stone })
	b:box(cx, 21.5 * M, cz, 9 * M, 3 * M, 9 * M, { mat = "Granite", col = stone })
	-- robe (tapering), head, crown
	local y = 23 * M
	local rs = { 4.2, 3.6, 3.0, 2.4 }
	for _, r in rs do
		b:cyl(cx, y + 3.5 * M, cz, 7 * M, r * M, { roll = math.pi / 2, mat = "Metal", col = copper })
		y += 7 * M
	end
	b:ball(cx, y + 1.6 * M, cz, 2.2 * M, { mat = "Metal", col = copper })
	for k = 0, 6 do
		local a = -math.pi / 2 + (k - 3) * 0.32
		b:beam(cx, y + 2.4 * M, cz, cx + math.sin(a) * 3.8 * M, y + 3.4 * M + math.cos(a) * 1.5 * M, cz - math.cos(a) * 3.2 * M, 0.35 * M, 0.35 * M, { mat = "Metal", col = copper })
	end
	-- raised right arm with the torch
	local sx, sy, sz = cx + 1.8 * M, y - 1.5 * M, cz
	local tx, ty, tz = cx + 3.2 * M, y + 9 * M, cz - 0.5 * M
	b:beam(sx, sy, sz, tx, ty, tz, 1.1 * M, 1.1 * M, { mat = "Metal", col = copper })
	b:cyl(tx, ty + 1.2 * M, tz, 2.4 * M, 0.7 * M, { roll = math.pi / 2, mat = "Metal", col = 0xd4af37 })
	b:ball(tx, ty + 3 * M, tz, 1 * M, { mat = "Neon", col = 0xffb020, coll = false })
	-- tablet in the left arm
	b:box(cx - 2.6 * M, y - 4 * M, cz - 1.2 * M, 1 * M, 4.5 * M, 2.6 * M, { pitch = 0.3, mat = "Metal", col = copper })
	b:landmark("liberty", "Statue of Liberty", cx, 10, cz, 210 * M, "The Statue of Liberty was a gift from France in 1886. Her torch is 93 metres above the water!")
end

function NewYork.empireState(b: BuildList, cx: number, cz: number)
	local stone = 0xb5ad9d
	local o = { mat = "Concrete", col = stone }
	b:box(cx, 12 * M, cz, 56 * M, 24 * M, 36 * M, o)
	b:box(cx, 24 * M + 45 * M, cz, 40 * M, 90 * M, 26 * M, o)
	b:box(cx, 114 * M + 10 * M, cz, 30 * M, 20 * M, 20 * M, o)
	b:box(cx, 144 * M + 4 * M, cz, 20 * M, 8 * M, 14 * M, o)
	b:box(cx, 152 * M + 3 * M, cz, 12 * M, 6 * M, 10 * M, o)
	b:cyl(cx, 158 * M + 6 * M, cz, 12 * M, 3 * M, { roll = math.pi / 2, mat = "Metal", col = 0x9aa0a6 })
	b:box(cx, 170 * M + 8 * M, cz, 1 * M, 16 * M, 1 * M, { mat = "Metal", col = 0xc0c4c8 })
	-- lit top at night
	b:box(cx, 150 * M, cz, 20.4 * M, 2 * M, 14.4 * M, { mat = "SmoothPlastic", col = 0xfff1c8, tag = "NightWindow", coll = false })
	-- vertical window stripes
	for i = -3, 3 do
		for _, side in { -1, 1 } do
			b:box(cx + i * 5 * M, 24 * M + 45 * M, cz + side * 13.1 * M, 1.2 * M, 88 * M, 0.4, { mat = "SmoothPlastic", col = 0x3a4652, coll = false, shadow = false })
		end
	end
	b:landmark("empire", "Empire State Building", cx, 10, cz, 50 * M, "The Empire State Building has 102 floors and was built in just 410 days, in 1931!")
end

function NewYork.flatiron(b: BuildList, cx: number, cz: number, yaw: number)
	-- a right-triangle prism standing upright (wedge turned on its side)
	b:wedge(cx, 32 * M, cz, 64 * M, 26 * M, 40 * M, { roll = math.pi / 2, yaw = yaw, mat = "Limestone", col = 0xd8ccb0 })
	b:landmark("flatiron", "Flatiron Building", cx, 10, cz, 40 * M, "The Flatiron Building is shaped like an old clothes iron: very thin at one end!")
end

function NewYork.timesSquare(b: BuildList, rng: Rng, cx: number, cz: number)
	local cols = { 0xff2e63, 0x08d9d6, 0xffd23f, 0x3ec300, 0xff7f11, 0x9b5de5, 0xf15bb5, 0x00bbf9 }
	local texts = { "BIKE THE WORLD", "HELLO NEW YORK", "PIZZA", "BROADWAY", "BAGELS", "BIG APPLE", "SHOWS TONIGHT", "SUPER SALE", "ICE CREAM", "NYC" }
	-- red steps (a famous place to sit)
	b:wedge(cx, 2 * M, cz, 16 * M, 4 * M, 12 * M, { yaw = 0, mat = "Glass", col = 0xd81e1e, transp = 0.1 })
	-- billboards on the surrounding buildings
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local r = 42 * M
		local x, z = cx + math.cos(a) * r, cz + math.sin(a) * r
		local yaw = Kit.faceYaw(-math.cos(a), -math.sin(a))
		local y = rng:range(12, 30) * M
		local w, h = rng:range(14, 22) * M, rng:range(8, 14) * M
		b:box(x, y, z, w, h, 0.6, { yaw = yaw, mat = "Neon", col = rng:pick(cols), coll = false })
		b:sign(x, y, z, yaw, w, h, texts[k + 1], 0xffffff, 0x000000)
	end
	b:landmark("timessquare", "Times Square", cx, 10, cz, 45 * M, "Times Square is so bright at night it is called 'the crossroads of the world'. On New Year's Eve a big ball drops here.")
end

function NewYork.brooklynBridge(b: BuildList, z: number, xa: number, xb: number)
	local stone = 0x9b8a72
	local H = 7 * M
	Roads.bridge(b, xa, z, xb, z, 16 * M, H, WATER_TOP, xb - xa - 30 * M, { deck = S.klinker, wall = { mat = "Metal", col = 0x6b5a46 }, segs = 16, lights = true })
	local L = (xb - xa) / 2
	local towers = { xa + (xb - xa) * 0.25, xa + (xb - xa) * 0.75 }
	for _, tx in towers do
		local deckY = Roads.hump(tx - (xa + L), H, L)
		for _, sz in { -1, 1 } do
			b:box(tx, (WATER_TOP + deckY + 40 * M) / 2, z + sz * 7 * M, 6 * M, deckY + 40 * M - WATER_TOP, 4 * M, { mat = "Granite", col = stone })
		end
		b:box(tx, deckY + 36 * M, z, 6 * M, 8 * M, 18 * M, { mat = "Granite", col = stone })
		b:box(tx, deckY + 41 * M, z, 7 * M, 2 * M, 19 * M, { mat = "Granite", col = stone })
	end
	-- main cables
	local function cable(x0: number, y0: number, x1: number, y1: number)
		for _, sz in { -1, 1 } do
			b:beam(x0, y0, z + sz * 7.5 * M, x1, y1, z + sz * 7.5 * M, 0.5 * M, 0.5 * M, { mat = "Metal", col = 0x4a4a4a })
		end
	end
	local topY = 40 * M
	local mid = (towers[1] + towers[2]) / 2
	cable(xa, 2, towers[1], topY)
	cable(towers[1], topY, (towers[1] + mid) / 2, topY * 0.55)
	cable((towers[1] + mid) / 2, topY * 0.55, mid, H + 4 * M)
	cable(mid, H + 4 * M, (mid + towers[2]) / 2, topY * 0.55)
	cable((mid + towers[2]) / 2, topY * 0.55, towers[2], topY)
	cable(towers[2], topY, xb, 2)
	b:landmark("brooklyn", "Brooklyn Bridge", (xa + xb) / 2, 10, z, 70 * M, "The Brooklyn Bridge opened in 1883. You can walk and bike across it!")
end

-- ---------------------------------------------------------------------------
local function lotBuilding(b: BuildList, rng: Rng, x0: number, z0: number, x1: number, z1: number)
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	local w, d = x1 - x0, z1 - z0
	local zM = cz / M
	local xM = cx / M
	-- face the nearest avenue or street
	local yaw = if math.abs(xM) > 240 then (if xM > 0 then -math.pi / 2 else math.pi / 2) else 0
	local fw, fd = w, d
	if yaw ~= 0 then
		fw, fd = d, w
	end
	local fx, fz = Build.rot(yaw, 0, -fd / 2)
	local ox, oz = cx + fx, cz + fz
	local height
	if zM < 0 and zM > -235 then
		height = rng:range(60, 140) * M -- Midtown
	elseif zM > 180 then
		height = rng:range(50, 160) * M -- Financial District
	else
		height = rng:range(25, 70) * M
	end
	if math.abs(xM) > 240 and rng:chance(0.6) then
		-- brownstones on the quieter side streets
		local n = math.max(1, math.floor(fw / (7 * M)))
		for i = 1, n do
			local lx = -fw / 2 + (i - 0.5) * fw / n
			local wx, wz = Build.rot(yaw, lx, 0)
			Kit.brownstone(b, rng, ox + wx, oz + wz, yaw, fw / n - 0.2, math.min(fd, 16 * M))
		end
	else
		Kit.skyscraper(b, rng, ox, oz, yaw, fw - 0.5, fd - 0.5, height)
	end
	local dx, dz = Build.rot(yaw, rng:range(-fw / 3, fw / 3), -2.2 * M)
	if rng:chance(0.35) then
		b:door(ox + dx, TOP.side, oz + dz, yaw)
	end
end

function NewYork.generate(): BuildList
	local b = Build.new()
	local rng = Build.rng(1626)
	local zTop, zBottom = streetZ(0), Z_SOUTH

	-- water: Hudson (west), East River (east), the harbour (south)
	local function water(x0: number, z0: number, x1: number, z1: number)
		local step = 600
		local x = x0
		while x < x1 do
			local xb = math.min(x + step, x1)
			local z = z0
			while z < z1 do
				local zb = math.min(z + step, z1)
				b:addWater((x + xb) / 2, WATER_TOP - WATER_DEPTH / 2, (z + zb) / 2, xb - x, WATER_DEPTH, zb - z)
				z = zb
			end
			x = xb
		end
	end
	water(-560 * M, zTop - 60 * M, -SHORE, HARBOUR + 10)
	water(SHORE, zTop - 60 * M, 470 * M, HARBOUR + 10)
	water(-560 * M, HARBOUR, 620 * M, 640 * M)
	-- quay walls
	Roads.wall(b, -SHORE, zTop - 60 * M, -SHORE, HARBOUR, 3, WATER_TOP - WATER_DEPTH, TOP.side, S.stone)
	Roads.wall(b, SHORE, zTop - 60 * M, SHORE, HARBOUR, 3, WATER_TOP - WATER_DEPTH, TOP.side, S.stone)
	Roads.wall(b, -SHORE, HARBOUR, SHORE, HARBOUR, 3, WATER_TOP - WATER_DEPTH, TOP.side, S.stone)
	-- ground slab for the whole island (blocks and pavements sit on top)
	local gx0, gx1 = -SHORE, SHORE
	local gz0, gz1 = zTop - 60 * M, HARBOUR
	local gx = gx0
	while gx < gx1 do
		local gxb = math.min(gx + 1800, gx1)
		local gz = gz0
		while gz < gz1 do
			local gzb = math.min(gz + 1800, gz1)
			b:box((gx + gxb) / 2, -1, (gz + gzb) / 2, gxb - gx, 2, gzb - gz, { mat = "Pavement", col = 0x8f8a83, shadow = false })
			gz = gzb
		end
		gx = gxb
	end

	-- streets -------------------------------------------------------------------
	for _, ax in AVES do
		local x = ax * M
		if x > PARK.x0 * M and x < PARK.x1 * M then
			Grid.street(b, x, PARK.z1 * M - ST_W / 2, x, zBottom, AVE_W, { layer = 1, car = true, bike = true })
		else
			Grid.street(b, x, zTop - 40 * M, x, zBottom, AVE_W, { layer = 1, car = true, bike = true })
		end
		Grid.coins(b, rng, x, zTop, x, zBottom, 25 * M, 0.35)
	end
	for k = 0, Z_COUNT - 1 do
		local z = streetZ(k)
		if z <= PARK.z1 * M - 1 and z >= PARK.z0 * M then
			-- streets stop at the park
			Grid.street(b, -X_EDGE, z, PARK.x0 * M, z, ST_W, { layer = 2 })
			Grid.street(b, PARK.x1 * M, z, X_EDGE, z, ST_W, { layer = 2 })
		else
			Grid.street(b, -X_EDGE, z, X_EDGE, z, ST_W, { layer = 2, car = true })
			Grid.coins(b, rng, -X_EDGE, z, X_EDGE, z, 25 * M, 0.3)
		end
	end
	-- riverside highways and the southern street
	Grid.street(b, -X_EDGE, zTop - 40 * M, -X_EDGE, zBottom, ST_W, { layer = 1, car = true })
	Grid.street(b, X_EDGE, zTop - 40 * M, X_EDGE, zBottom, ST_W, { layer = 1, car = true })
	Grid.street(b, -X_EDGE, zBottom, X_EDGE, zBottom, ST_W, { layer = 2, car = true })
	-- Broadway, the diagonal
	Grid.street(b, BROADWAY_A[1], BROADWAY_A[2], BROADWAY_B[1], BROADWAY_B[2], BROADWAY_W, { layer = 3, bike = true })
	Grid.coins(b, rng, BROADWAY_A[1], BROADWAY_A[2], BROADWAY_B[1], BROADWAY_B[2], 18 * M, 0.6)

	-- blocks ----------------------------------------------------------------------
	local hx, hz = AVE_W / 2 + 3 * M, ST_W / 2 + 3 * M
	for i = 1, #AVES - 1 do
		for k = 0, Z_COUNT - 1 do
			local x0, x1 = AVES[i] * M + hx, AVES[i + 1] * M - hx
			local z0 = streetZ(k) + hz
			local z1 = (if k == Z_COUNT - 1 then zBottom else streetZ(k + 1)) - hz
			local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
			if not inPark(cx, cz) and z1 > z0 then
				Grid.pavement(b, x0, z0, x1, z1, 3 * M)
				-- 2-3 lots per block, skipping Broadway
				local n = rng:int(2, 3)
				for j = 0, n - 1 do
					local lx0 = x0 + (x1 - x0) * j / n
					local lx1 = x0 + (x1 - x0) * (j + 1) / n
					local lcx = (lx0 + lx1) / 2
					if broadwayDist(lcx, cz) > (BROADWAY_W / 2 + math.max(lx1 - lx0, z1 - z0) * 0.6) then
						lotBuilding(b, rng, lx0 + 0.5, z0 + 0.5, lx1 - 0.5, z1 - 0.5)
					end
				end
			end
		end
	end
	-- edge rows between the outer avenues and the riverside highways
	for _, sx in { -1, 1 } do
		for k = 0, Z_COUNT - 1 do
			local x0 = if sx < 0 then -X_EDGE + ST_W / 2 + 3 * M else 300 * M + hx
			local x1 = if sx < 0 then -300 * M - hx else X_EDGE - ST_W / 2 - 3 * M
			local z0 = streetZ(k) + hz
			local z1 = (if k == Z_COUNT - 1 then zBottom else streetZ(k + 1)) - hz
			if x1 - x0 > 8 * M and z1 - z0 > 8 * M then
				Grid.pavement(b, x0, z0, x1, z1, 3 * M)
				local yaw = if sx < 0 then math.pi / 2 else -math.pi / 2
				local n = math.max(1, math.floor((z1 - z0) / (7 * M)))
				for j = 1, n do
					local z = z0 + (j - 0.5) * (z1 - z0) / n
					local fx = if sx < 0 then x0 else x1
					Kit.brownstone(b, rng, fx, z, yaw, (z1 - z0) / n - 0.2, math.min(x1 - x0, 15 * M))
				end
			end
		end
	end

	-- Central Park -------------------------------------------------------------------
	local px0, px1, pz0, pz1 = PARK.x0 * M + hx, PARK.x1 * M - hx, PARK.z0 * M + hz, PARK.z1 * M - hz
	b:box((px0 + px1) / 2, 0.3, (pz0 + pz1) / 2, px1 - px0, 0.6, pz1 - pz0, { mat = "Grass", col = 0x4f7d34 })
	-- pond
	b:addWater(-60 * M, -1.5, -330 * M, 70 * M, 4, 40 * M)
	b:box(-60 * M, -3.5, -330 * M, 74 * M, 0.5, 44 * M, { mat = "Mud", col = 0x3a3024 })
	-- loop path
	local path = {}
	for k = 0, 40 do
		local a = k / 40 * math.pi * 2
		table.insert(path, { math.cos(a) * 140 * M, 0.9, -318 * M + math.sin(a) * 60 * M })
	end
	for k = 1, #path - 1 do
		Roads.seg(b, path[k][1], path[k][3], path[k + 1][1], path[k + 1][3], 5 * M, 0.7, S.gravel)
	end
	b:lane("bike", path, true)
	b:lane("walk", path, true)
	for _ = 1, 70 do
		local x, z = rng:range(px0 + 8 * M, px1 - 8 * M), rng:range(pz0 + 8 * M, pz1 - 8 * M)
		local onPath = math.abs(((x / (140 * M)) ^ 2 + ((z + 318 * M) / (60 * M)) ^ 2) - 1) < 0.18
		local inPond = math.abs(x + 60 * M) < 40 * M and math.abs(z + 330 * M) < 25 * M
		if not onPath and not inPond then
			Kit.tree(b, rng, x, z, 1.2, PALETTE)
		end
	end
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		b:coin(math.cos(a) * 140 * M, 3, -318 * M + math.sin(a) * 60 * M)
	end
	b:landmark("centralpark", "Central Park", 0, 4, -318 * M, 90 * M, "Central Park is a giant park in the middle of Manhattan, bigger than the whole country of Monaco!")

	-- landmarks -------------------------------------------------------------------------
	NewYork.empireState(b, 120 * M, (streetZ(5) + streetZ(6)) / 2)
	local tsx = -60 * M
	NewYork.timesSquare(b, rng, tsx, broadwayZAt(tsx))
	local fx = 60 * M + 30 * M
	NewYork.flatiron(b, fx, broadwayZAt(60 * M) - 25 * M, math.atan2(BROADWAY_B[1] - BROADWAY_A[1], BROADWAY_B[2] - BROADWAY_A[2]))
	NewYork.liberty(b, -130 * M, 520 * M)
	-- Brooklyn: a small waterfront park across the East River
	local bz = 200 * M
	NewYork.brooklynBridge(b, bz, X_EDGE - 4 * M, 485 * M)
	b:box(540 * M, -1, 220 * M, 140 * M, 2, 260 * M, { mat = "Grass", col = 0x4f7d34 })
	Roads.wall(b, 470 * M, 90 * M, 470 * M, 350 * M, 3, WATER_TOP - WATER_DEPTH, 0.6, S.stone)
	Grid.street(b, 485 * M, 100 * M, 485 * M, 340 * M, 10 * M, { layer = 1 })
	for i = 0, 7 do
		Kit.brownstone(b, rng, 560 * M, 120 * M + i * 9 * M, math.pi / 2, 8.8 * M, 15 * M)
	end
	for i = 0, 6 do
		Kit.tree(b, rng, 505 * M, 120 * M + i * 30 * M, 1.1, PALETTE)
	end
	-- Jane's carousel by the water
	b:cyl(500 * M, 1, 300 * M, 2, 9 * M, { roll = math.pi / 2, mat = "Wood", col = 0xc9a24a })
	b:cyl(500 * M, 7 * M, 300 * M, 1, 9.5 * M, { roll = math.pi / 2, mat = "Fabric", col = 0x2a6fd6, tag = "Spin" })
	b:box(500 * M, 3 * M, 300 * M, 18 * M, 7 * M, 18 * M, { mat = "Glass", col = 0xcfe3ea, transp = 0.75, coll = false })
	-- Battery Park promenade
	for x = -320, 320, 22 do
		Kit.tree(b, rng, x * M, 340 * M, 1, PALETTE)
		if x % 44 == 0 then
			Kit.bench(b, x * M + 10 * M, 340 * M, math.pi)
		end
	end
	-- hot dog carts, hydrants, subway entrances
	for k = 1, 16 do
		local ax = AVES[rng:int(1, #AVES)] * M + AVE_W / 2 + 1.5 * M
		local z = streetZ(rng:int(4, Z_COUNT - 2)) + 12 * M
		if k % 2 == 0 then
			Kit.hydrant(b, ax, z)
		else
			b:box(ax, 1.6, z, 2 * M, 3, 1.2 * M, { mat = "Metal", col = 0xc0c4c8 })
			b:cyl(ax, 3 * M, z, 0.2, 2.2 * M, { roll = math.pi / 2, mat = "Fabric", col = if k % 4 == 1 then 0xd23c3c else 0xf2c230 })
			b:shop(ax, TOP.side, z, 0, "Hot Dog Cart")
		end
		if k % 4 == 0 then
			b:cyl(ax + 3 * M, 2 * M, z + 6 * M, 4 * M, 0.12 * M, { roll = math.pi / 2, mat = "Metal", col = 0x1e5a32 })
			b:ball(ax + 3 * M, 4.2 * M, z + 6 * M, 0.6 * M, { mat = "Neon", col = 0x3ec36b })
		end
	end
	b:shop(-60 * M + 30 * M, TOP.side, broadwayZAt(-60 * M) + 20 * M, 0, "Pizza Place")
	b:shop(180 * M + 14 * M, TOP.side, streetZ(9) + 10 * M, 0, "Bagel Shop")
	-- lamps along the avenues
	for _, ax in AVES do
		for k = 0, Z_COUNT - 1 do
			local z = streetZ(k) + 20 * M
			if not inPark(ax * M + 20, z) then
				Kit.lamp(b, ax * M - AVE_W / 2 - 1 * M, z, "modern")
			end
		end
	end
	-- one fence around everything (the harbour is open water: you can swim to Liberty Island)
	Grid.fence(b, -SHORE - 30 * M, zTop - 70 * M, 615 * M, 630 * M)
	b.spawn = { x = tsx, y = TOP.road + 4, z = broadwayZAt(tsx) + 20 * M, yaw = math.pi }
	return b
end

return NewYork
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Paris</string>
            <string name="Source"><![CDATA[--!strict
-- Paris: the Seine with stone bridges, Haussmann boulevards, the
-- Champs-Élysées from the Arc de Triomphe to Place de la Concorde, the
-- Louvre with its glass pyramid, Notre-Dame and the Eiffel Tower.

local Build = require(script.Parent.Parent.Build)
local Kit = require(script.Parent.Parent.Kit)
local Roads = require(script.Parent.Parent.Roads)
local Grid = require(script.Parent.Parent.Grid)

type BuildList = Build.BuildList
type Rng = Build.Rng

local M = Kit.M
local S = Roads.SURF
local TOP = Roads.TOP

local Paris = {}

local X0, X1 = -330 * M, 330 * M
local Z0, Z1 = -280 * M, 280 * M
local RIVER_HW = 30 * M
local QUAY_W = 19 * M -- tree promenade 6 + road 10 + pavement 3
local WATER_TOP = -2.2 * M
local WATER_DEPTH = 4 * M
local X_STREETS = { -300, -200, -100, 0, 100, 200, 300 }
local STREET_W = 14 * M
local PALETTE = { 0x4d7a35, 0x56823a, 0x5d8a3f, 0x6b8f3a }

local function zc(x: number): number
	return 18 * M * math.sin(x / (120 * M))
end

local function riverPoints(): { { number } }
	local pts = {}
	local x = X0 - 40 * M
	while x <= X1 + 40 * M do
		table.insert(pts, { x, zc(x) })
		x += 20 * M
	end
	return pts
end

--- Offset strip along the river polyline. side = -1 north bank, +1 south.
local function riverStrip(b: BuildList, d0: number, d1: number, side: number, top: number, s: Roads.Surface, cut: ((number) -> boolean)?)
	local pts = riverPoints()
	for i = 1, #pts - 1 do
		local a, c = pts[i], pts[i + 1]
		local mx = (a[1] + c[1]) / 2
		if not (cut and cut(mx)) then
			local dx, dz = c[1] - a[1], c[2] - a[2]
			local len = math.sqrt(dx * dx + dz * dz)
			local ux, uz = dx / len, dz / len
			-- normal pointing to this bank (north bank: side = -1)
			local nx, nz = -uz * side, ux * side
			local dm = (d0 + d1) / 2
			local ex, ez = ux * 1.0, uz * 1.0
			Roads.seg(b, a[1] + nx * dm - ex, a[2] + nz * dm - ez, c[1] + nx * dm + ex, c[2] + nz * dm + ez, d1 - d0, top, s)
		end
	end
end

local function nearStreet(x: number, half: number): boolean
	for _, sx in X_STREETS do
		if math.abs(x - sx * M) < half then
			return true
		end
	end
	return false
end

local function nearBridge(x: number, half: number): boolean
	for _, bx in X_STREETS do
		if bx > -300 and math.abs(x - bx * M) < half then
			return true
		end
	end
	return false
end

local function buildRiver(b: BuildList, rng: Rng)
	local pts = riverPoints()
	for i = 1, #pts - 1 do
		local a, c = pts[i], pts[i + 1]
		local dx, dz = c[1] - a[1], c[2] - a[2]
		local len = math.sqrt(dx * dx + dz * dz)
		b:addWater((a[1] + c[1]) / 2, WATER_TOP - WATER_DEPTH / 2, (a[2] + c[2]) / 2, RIVER_HW * 2 + 2, WATER_DEPTH, len + 2, math.atan2(dx, dz))
		local ux, uz = dx / len, dz / len
		for _, side in { -1, 1 } do
			local nx, nz = -uz * side, ux * side
			local o = RIVER_HW + 1
			Roads.wall(b, a[1] + nx * o, a[2] + nz * o, c[1] + nx * o, c[2] + nz * o, 2, WATER_TOP - WATER_DEPTH, TOP.edge, S.stone)
		end
	end
	-- quays on both banks: granite edge, tree promenade, road, pavement
	for _, side in { -1, 1 } do
		riverStrip(b, RIVER_HW, RIVER_HW + 6 * M, side, TOP.side, S.stone, function(x)
			return nearBridge(x, 9 * M)
		end)
		riverStrip(b, RIVER_HW + 6 * M, RIVER_HW + 16 * M, side, TOP.road, S.asphalt)
		riverStrip(b, RIVER_HW + 16 * M, RIVER_HW + QUAY_W, side, TOP.side, S.side, function(x)
			return nearStreet(x, STREET_W / 2 + 10 * M)
		end)
		-- trees and lamps along the promenade, lanes on the quay road
		local bike, walk = {}, {}
		for i, p in pts do
			local q = pts[math.min(i + 1, #pts)]
			local r = pts[math.max(i - 1, 1)]
			local dx, dz = q[1] - r[1], q[2] - r[2]
			local len = math.sqrt(dx * dx + dz * dz)
			local nx, nz = -dz / len * side, dx / len * side
			local function at(d: number): (number, number)
				return p[1] + nx * d, p[2] + nz * d
			end
			if p[1] > X0 and p[1] < X1 then
				local tx, tz = at(RIVER_HW + 3 * M)
				if not nearBridge(p[1], 12 * M) then
					if i % 3 == 0 then
						Kit.lamp(b, tx, tz)
					else
						Kit.tree(b, rng, tx, tz, 1, PALETTE)
					end
				end
				local lx, lz = at(RIVER_HW + 11 * M)
				table.insert(bike, { lx, TOP.road + 0.3, lz })
				local wx, wz = at(RIVER_HW + 17.5 * M)
				table.insert(walk, { wx, TOP.side + 0.3, wz })
				if rng:chance(0.35) then
					b:coin(lx, TOP.road + 3, lz)
				end
			end
		end
		b:lane("bike", bike)
		b:lane("walk", walk)
		local cars = {}
		for i = #bike, 1, -1 do
			table.insert(cars, bike[i])
		end
		b:lane("car", cars)
	end
	-- tour boats on the Seine
	for _, off in { -10 * M, 10 * M } do
		local lane = {}
		for _, p in pts do
			table.insert(lane, { p[1], WATER_TOP, p[2] + off })
		end
		b:lane("boat", lane)
	end
	-- stone bridges along the main streets
	for _, x in X_STREETS do
		local bx = x * M
		if bx > X0 + 20 and bx < X1 - 20 then
			local z = zc(bx)
			Roads.bridge(b, bx, z - RIVER_HW - 8 * M, bx, z + RIVER_HW + 8 * M, 18 * M, 1.4 * M, WATER_TOP, RIVER_HW * 2, { deck = S.asphalt, wall = S.stone, segs = 8, lights = true })
		end
	end
end

--- Bank building line (where the riverfront buildings stand).
local function bankLine(x: number, side: number): number
	return zc(x) + side * (RIVER_HW + QUAY_W)
end

local function haussmannPlacer(shop: boolean): Grid.Placer
	return function(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number)
		Kit.haussmann(b, rng, ox, oz, yaw, w, d, shop)
	end
end

local function riverfrontRow(b: BuildList, rng: Rng, side: number)
	local x = X0 + 2
	while x < X1 - 10 * M do
		local w = rng:range(20, 28) * M
		local xa, xb = x, math.min(x + w, X1 - 2)
		x = xb
		local xm = (xa + xb) / 2
		if not nearStreet(xm, w / 2 + STREET_W / 2 + 1 * M) then
			local za, zb = bankLine(xa, side), bankLine(xb, side)
			local fx, fz = xm, (za + zb) / 2
			-- face the river
			local yaw = math.atan2(xb - xa, zb - za) + (if side < 0 then math.pi / 2 else -math.pi / 2)
			local ok = true
			-- leave room for the Eiffel Tower park and the Louvre
			if side > 0 and xm > -300 * M and xm < -100 * M then
				ok = false
			end
			if ok then
				Kit.haussmann(b, rng, fx, fz, yaw, xb - xa - 0.5, 14 * M, true)
				if rng:chance(0.4) then
					local dx, dz = Build.rot(yaw, 0, -2.2 * M)
					b:door(fx + dx, TOP.side, fz + dz, yaw)
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Landmarks
function Paris.eiffel(b: BuildList, cx: number, cz: number)
	local bronze = 0x6b5a46
	local o = { mat = "Metal", col = bronze }
	local function beam(ax: number, ay: number, az: number, bx: number, by: number, bz: number, w: number)
		b:beam(cx + ax, ay, cz + az, cx + bx, by, cz + bz, w, w, o)
	end
	local base, p1, p2, top = 36 * M, 22 * M, 11 * M, 2.2 * M
	local h1, h2, h3 = 30 * M, 62 * M, 112 * M
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			-- four curved legs to the first platform (two beams each)
			beam(sx * base, 0, sz * base, sx * (base + p1) / 2 * 1.05, h1 * 0.5, sz * (base + p1) / 2 * 1.05, 4 * M)
			beam(sx * (base + p1) / 2 * 1.05, h1 * 0.5, sz * (base + p1) / 2 * 1.05, sx * p1, h1, sz * p1, 3.4 * M)
			beam(sx * p1, h1, sz * p1, sx * p2, h2, sz * p2, 2.6 * M)
			beam(sx * p2, h2, sz * p2, sx * top, h3, sz * top, 1.6 * M)
			-- cross bracing on each face
			beam(sx * base * 0.95, 4 * M, sz * base * 0.95, sx * p1 * 1.1, h1 * 0.9, -sz * p1 * 1.1, 0.9 * M)
		end
	end
	-- arches between the legs
	for k = 0, 3 do
		local a = k * math.pi / 2
		local ca, sa = math.cos(a), math.sin(a)
		for i = 0, 5 do
			local t0, t1 = i / 6, (i + 1) / 6
			local x0, x1 = -base * 0.8 + t0 * base * 1.6, -base * 0.8 + t1 * base * 1.6
			local y0 = h1 * 0.55 * math.sqrt(math.max(0, 1 - (x0 / (base * 0.8)) ^ 2))
			local y1 = h1 * 0.55 * math.sqrt(math.max(0, 1 - (x1 / (base * 0.8)) ^ 2))
			local d = base * 0.82
			beam(x0 * ca - d * sa, y0 + 6, x0 * sa + d * ca, x1 * ca - d * sa, y1 + 6, x1 * sa + d * ca, 1.2 * M)
		end
	end
	-- platforms
	b:box(cx, h1 + 1.5 * M, cz, p1 * 2 + 4 * M, 3 * M, p1 * 2 + 4 * M, { mat = "Metal", col = bronze })
	b:box(cx, h2 + 1 * M, cz, p2 * 2 + 3 * M, 2 * M, p2 * 2 + 3 * M, { mat = "Metal", col = bronze })
	b:box(cx, h3, cz, 4 * M, 4 * M, 4 * M, { mat = "Metal", col = bronze })
	b:box(cx, h3 + 6 * M, cz, 0.8 * M, 12 * M, 0.8 * M, { mat = "Metal", col = 0x9aa0a6 })
	-- sparkle lights for the night show
	local rng = Build.rng(1889)
	for _ = 1, 60 do
		local t = rng:next()
		local hh = t * h3
		local spread = if hh < h1 then base - (base - p1) * hh / h1 elseif hh < h2 then p1 - (p1 - p2) * (hh - h1) / (h2 - h1) else p2 - (p2 - top) * (hh - h2) / (h3 - h2)
		local sx, sz = rng:pick({ -1, 1 }), rng:pick({ -1, 1 })
		b:ball(cx + sx * spread, hh + 2, cz + sz * spread, 0.5, { mat = "Neon", col = 0xfff4c2, tag = "Sparkle", coll = false, shadow = false })
	end
	b:landmark("eiffel", "Eiffel Tower", cx, 10, cz, 70 * M, "The Eiffel Tower is 330 metres tall and was built in 1889. At night it sparkles with 20,000 lights!")
end

function Paris.arc(b: BuildList, cx: number, cz: number)
	local stone = 0xe3d6bb
	local o = { mat = "Limestone", col = stone }
	local w, d, h = 27 * M, 13 * M, 30 * M
	-- two piers
	b:box(cx - w / 2 + 4.5 * M, h * 0.35, cz, 9 * M, h * 0.7, d, o)
	b:box(cx + w / 2 - 4.5 * M, h * 0.35, cz, 9 * M, h * 0.7, d, o)
	-- arch top and attic
	b:box(cx, h * 0.62, cz, w - 18 * M + 1, h * 0.16, d, o)
	b:box(cx, h * 0.85, cz, w, h * 0.3, d, o)
	b:box(cx, h + 0.4, cz, w + 1, 0.8, d + 1, o)
	-- the eternal flame under the arch
	b:box(cx, 0.6, cz, 1.2, 1.2, 1.2, { mat = "Neon", col = 0xff7a1a, coll = false })
	b:landmark("arc", "Arc de Triomphe", cx, 10, cz, 50 * M, "The Arc de Triomphe stands in the middle of a huge roundabout where 12 avenues meet!")
end

function Paris.louvre(b: BuildList, x0: number, z0: number, x1: number, z1: number)
	local stone = 0xe0d3b6
	local roof = 0x5f666b
	local d = 16 * M
	local function wing(ax: number, az: number, bx: number, bz: number)
		local mx, mz = (ax + bx) / 2, (az + bz) / 2
		local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
		local yaw = math.atan2(bx - ax, bz - az)
		b:box(mx, 9 * M, mz, d, 18 * M, len, { yaw = yaw, mat = "Limestone", col = stone })
		b:prism(mx, mz, yaw, 0, 18 * M, 0, d, 6 * M, len, { mat = "Metal", col = roof })
		-- windows along both sides
		local n = math.floor(len / (6 * M))
		for i = 1, n do
			local t = (i - 0.5) / n - 0.5
			for _, side in { -1, 1 } do
				local lx, lz = Build.rot(yaw, side * (d / 2 + 0.2), t * len)
				b:box(mx + lx, 9 * M, mz + lz, 0.4, 4 * M, 2 * M, { yaw = yaw, mat = "SmoothPlastic", col = 0x26323d, coll = false, shadow = false })
			end
		end
	end
	-- U-shape open to the west, around the Cour Napoléon
	wing(x0, z0 + d / 2, x1, z0 + d / 2)
	wing(x0, z1 - d / 2, x1, z1 - d / 2)
	wing(x1 - d / 2, z0 + d, x1 - d / 2, z1 - d)
	-- courtyard and the glass pyramid (built as stacked glass steps)
	local cx, cz = (x0 + x1) / 2 - 10 * M, (z0 + z1) / 2
	b:box((x0 + x1) / 2, TOP.plaza - 0.3, cz, x1 - x0, 0.6, z1 - z0 - 2 * d, { mat = "Pavement", col = 0xc9c1b0 })
	local steps = 10
	local base, h = 34 * M, 21 * M
	for i = 0, steps - 1 do
		local s = base * (1 - i / steps)
		b:box(cx, TOP.plaza + (i + 0.5) * h / steps, cz, s, h / steps, s, { mat = "Glass", col = 0x9fc3d6, transp = 0.35, refl = 0.3 })
	end
	-- fountains
	for _, sx in { -1, 1 } do
		b:cyl(cx + sx * 26 * M, TOP.plaza + 0.4, cz, 0.8, 7 * M, { roll = math.pi / 2, mat = "Granite", col = 0x6b6f73 })
	end
	b:landmark("louvre", "Louvre Pyramid", cx, 10, cz, 45 * M, "The Louvre is the world's biggest art museum. The famous Mona Lisa painting lives here!")
end

function Paris.notreDame(b: BuildList, cx: number, cz: number)
	local stone = 0xcfc4a8
	local o = { mat = "Limestone", col = stone }
	-- nave (pointing east), west facade faces -x
	b:box(cx + 30 * M, 14 * M, cz, 70 * M, 28 * M, 26 * M, o)
	b:prism(cx + 30 * M, cz, math.pi / 2, 0, 28 * M, 0, 26 * M, 12 * M, 70 * M, { mat = "Slate", col = 0x4a5258 })
	-- facade and twin towers
	b:box(cx - 8 * M, 17 * M, cz, 8 * M, 34 * M, 40 * M, o)
	for _, sz in { -1, 1 } do
		b:box(cx - 8 * M, 34 * M + 9 * M, cz + sz * 13 * M, 9 * M, 18 * M, 13 * M, o)
	end
	-- rose window and portals
	b:cyl(cx - 12.2 * M, 22 * M, cz, 0.4, 5 * M, { mat = "SmoothPlastic", col = 0x3b4f9e, coll = false })
	for _, sz in { -1, 0, 1 } do
		b:box(cx - 12.3 * M, 4 * M, cz + sz * 11 * M, 0.5, 8 * M, 5 * M, { mat = "SmoothPlastic", col = 0x3a3027, coll = false })
	end
	-- spire
	b:box(cx + 40 * M, 46 * M, cz, 1.2 * M, 26 * M, 1.2 * M, { mat = "Metal", col = 0x5d6a64 })
	b:landmark("notredame", "Notre-Dame", cx, 10, cz, 50 * M, "Notre-Dame cathedral is more than 850 years old. It was carefully rebuilt after a big fire in 2019.")
end

-- ---------------------------------------------------------------------------
function Paris.generate(): BuildList
	local b = Build.new()
	local rng = Build.rng(1789)
	buildRiver(b, rng)

	-- streets ----------------------------------------------------------------
	-- north-south streets on both banks (they meet the bridges)
	for _, xs in X_STREETS do
		local x = xs * M
		local zN = bankLine(x, -1)
		local zS = bankLine(x, 1)
		-- streets run on into the quay road so there is no curb to bump over
		Grid.street(b, x, Z0, x, zN + 5 * M, STREET_W, { layer = 1, car = true })
		if xs ~= -200 then
			Grid.street(b, x, zS - 5 * M, x, Z1, STREET_W, { layer = 1, car = true })
		end
		Grid.coins(b, rng, x, Z0, x, zN, 26 * M, 0.45)
		Grid.coins(b, rng, x, zS, x, Z1, 26 * M, 0.45)
	end
	-- east-west streets
	local Z_NORTH = { -270 * M, -110 * M }
	local Z_SOUTH = { 120 * M, 200 * M, 270 * M }
	for _, z in Z_NORTH do
		Grid.street(b, X0, z, X1, z, STREET_W, { layer = 2, car = true })
		Grid.coins(b, rng, X0, z, X1, z, 26 * M, 0.4)
	end
	for _, z in Z_SOUTH do
		Grid.street(b, X0, z, X1, z, STREET_W, { layer = 2, car = true })
		Grid.coins(b, rng, X0, z, X1, z, 26 * M, 0.4)
	end
	-- Champs-Élysées: wide avenue with bike lanes and four rows of trees
	local ZC = -190 * M
	Grid.street(b, X0, ZC, X1, ZC, 30 * M, { layer = 3, bike = true, car = true })
	for _, o in { -13.5 * M, 13.5 * M } do
		Grid.treeLine(b, rng, -300 * M + 40 * M, ZC + o, 0, ZC + o, 13 * M, PALETTE)
	end
	Grid.coins(b, rng, X0, ZC, X1, ZC, 20 * M, 0.6)

	-- blocks -------------------------------------------------------------------
	local half = STREET_W / 2 + 3 * M
	local function block(x0: number, z0: number, x1: number, z1: number)
		if x1 - x0 < 20 * M or z1 - z0 < 20 * M then
			return
		end
		Grid.pavement(b, x0, z0, x1, z1, 3 * M)
		Grid.perimeter(b, rng, x0, z0, x1, z1, 14 * M, 20 * M, 28 * M, haussmannPlacer(true), 3)
	end
	for i = 1, #X_STREETS - 1 do
		local xa, xb = X_STREETS[i] * M + half, X_STREETS[i + 1] * M - half
		local xm = (X_STREETS[i] + X_STREETS[i + 1]) / 2
		-- north rows
		block(xa, Z_NORTH[1] + half, xb, ZC - 15 * M - 3 * M)
		local tuileries = xm > 0 and xm < 100
		local louvre = xm > 100
		if not tuileries and not louvre then
			block(xa, ZC + 15 * M + 3 * M, xb, Z_NORTH[2] - half)
		end
		-- the row between Rue de Rivoli and the riverfront buildings
		local zBank = math.min(bankLine(xa, -1), bankLine(xb, -1)) - 14 * M - 4 * M
		block(xa, Z_NORTH[2] + half, xb, zBank)
		-- south rows (Champ de Mars between -300 and -100)
		local champ = xm > -300 and xm < -100
		if not champ then
			local zBankS = math.max(bankLine(xa, 1), bankLine(xb, 1)) + 14 * M + 4 * M
			if not (xm > 100 and xm < 200) then
				block(xa, zBankS, xb, Z_SOUTH[1] - half)
			end
			block(xa, Z_SOUTH[1] + half, xb, Z_SOUTH[2] - half)
			block(xa, Z_SOUTH[2] + half, xb, Z_SOUTH[3] - half)
		end
	end
	riverfrontRow(b, rng, -1)
	riverfrontRow(b, rng, 1)
	-- ground between the riverfront rows and the blocks
	for _, side in { -1, 1 } do
		riverStrip(b, RIVER_HW + QUAY_W, RIVER_HW + QUAY_W + 40 * M, side, 0.15, S.ground)
	end

	-- squares and landmarks ----------------------------------------------------
	-- Étoile roundabout with the Arc de Triomphe
	local ex, ez = -300 * M, ZC
	b:cyl(ex, TOP.road + 0.04, ez, 0.6, 42 * M, { roll = math.pi / 2, mat = "Cobblestone", col = 0x7d766c })
	b:cyl(ex, TOP.plaza + 0.1, ez, 0.8, 22 * M, { roll = math.pi / 2, mat = "Pavement", col = 0xb9b1a2 })
	Paris.arc(b, ex, ez)
	local ring = {}
	for k = 0, 24 do
		local a = k / 24 * math.pi * 2
		table.insert(ring, { ex + math.cos(a) * 32 * M, TOP.road + 0.3, ez + math.sin(a) * 32 * M })
	end
	b:lane("bike", ring, true)
	-- Place de la Concorde with its obelisk
	local cx, cz = 0, ZC
	b:box(cx, TOP.plaza - 0.3, cz, 60 * M, 0.6, 50 * M, { mat = "Cobblestone", col = 0x8d857a })
	b:box(cx, 12 * M, cz, 2.4 * M, 23 * M, 2.4 * M, { mat = "Granite", col = 0xc9a77c })
	b:box(cx, 24 * M, cz, 1.4 * M, 1.6 * M, 1.4 * M, { mat = "Metal", col = 0xd4af37 })
	for _, sx in { -1, 1 } do
		b:cyl(cx + sx * 18 * M, TOP.plaza + 0.6, cz, 1.2, 6 * M, { roll = math.pi / 2, mat = "Granite", col = 0x6b6f73 })
		b:cyl(cx + sx * 18 * M, 3 * M, cz, 4 * M, 1 * M, { roll = math.pi / 2, mat = "Metal", col = 0x8a7a3a })
	end
	b:landmark("concorde", "Place de la Concorde", cx, 10, cz, 35 * M, "This obelisk is more than 3,000 years old and came all the way from Egypt!")
	-- Tuileries garden
	local tx0, tx1 = 0 + half, 100 * M - half
	local tz0, tz1 = ZC + 18 * M, -110 * M - half
	b:box((tx0 + tx1) / 2, 0.25, (tz0 + tz1) / 2, tx1 - tx0, 0.5, tz1 - tz0, { mat = "Sand", col = 0xd8c9a3 })
	for _, z in { tz0 + 8 * M, tz1 - 8 * M } do
		Grid.treeLine(b, rng, tx0 + 6 * M, z, tx1 - 6 * M, z, 9 * M, PALETTE)
	end
	b:cyl((tx0 + tx1) / 2, 0.6, (tz0 + tz1) / 2, 1, 9 * M, { roll = math.pi / 2, mat = "Granite", col = 0x6b6f73 })
	-- Louvre (two blocks between x=100 and x=300)
	Paris.louvre(b, 100 * M + half, ZC + 18 * M, 300 * M - half, -110 * M - half)
	-- Champ de Mars and the Eiffel Tower
	local cm0, cm1 = -300 * M + half, -100 * M - half
	local czs = bankLine(-200 * M, 1) + 3 * M
	b:box((cm0 + cm1) / 2, 0.25, (czs + Z1) / 2, cm1 - cm0, 0.5, Z1 - czs, { mat = "Grass", col = 0x4d7a35 })
	b:box((cm0 + cm1) / 2, 0.3, (czs + Z1) / 2 + 20 * M, 16 * M, 0.5, Z1 - czs - 40 * M, { mat = "Sand", col = 0xd8c9a3 })
	for _, x in { cm0 + 10 * M, cm1 - 10 * M } do
		Grid.treeLine(b, rng, x, czs + 90 * M, x, Z1 - 10 * M, 11 * M, PALETTE)
	end
	Paris.eiffel(b, -200 * M, czs + 45 * M)
	b.spawn = { x = -200 * M, y = TOP.plaza + 4, z = czs + 110 * M, yaw = 0 }
	-- a carousel for the little ones
	local carx, carz = -150 * M, czs + 120 * M
	b:cyl(carx, 1, carz, 2, 8 * M, { roll = math.pi / 2, mat = "Wood", col = 0xc9a24a })
	b:cyl(carx, 7 * M, carz, 1, 8.5 * M, { roll = math.pi / 2, mat = "Fabric", col = 0xd23c3c, tag = "Spin" })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b:cyl(carx + math.cos(a) * 6 * M, 3.5 * M, carz + math.sin(a) * 6 * M, 7 * M, 0.15 * M, { roll = math.pi / 2, mat = "Metal", col = 0xd4af37 })
		b:box(carx + math.cos(a) * 6 * M, 2.2 * M, carz + math.sin(a) * 6 * M, 0.8 * M, 1.2 * M, 2 * M, { yaw = a, mat = "SmoothPlastic", col = if k % 2 == 0 then 0xffffff else 0x8b5a2b })
	end
	-- Notre-Dame on the south bank
	Paris.notreDame(b, 125 * M, bankLine(150 * M, 1) + 40 * M)

	-- café terraces and boulangeries (delivery pickups)
	for _, x in { -250, -50, 50, 250 } do
		local z = Z_NORTH[2] + half + 1 * M
		for k = 0, 3 do
			Kit.cafeTable(b, rng, x * M - 12 * M + k * 7 * M, z - 3.5 * M)
		end
		b:shop(x * M, TOP.side, z - 2 * M, 0, "Boulangerie")
	end
	-- lamps on the north-south streets
	for _, xs in X_STREETS do
		local x = xs * M
		for z = Z0 + 20 * M, Z1 - 20 * M, 30 * M do
			if math.abs(z - zc(x)) > RIVER_HW + QUAY_W + 6 * M then
				Kit.lamp(b, x + STREET_W / 2 + 1.2 * M, z)
			end
		end
	end
	Grid.fence(b, X0 - 4 * M, Z0 - 10 * M, X1 + 4 * M, Z1 + 10 * M)
	b:landmark("seine", "The Seine", 0, 4, zc(0), 40 * M, "The river Seine flows right through Paris. There are 37 bridges across it in the city!")
	return b
end

return Paris
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Game settings. Edit prices, Robux item IDs and cities here.
--
-- ROBUX ITEMS: create each Game Pass / Developer Product on the Roblox
-- Creator Dashboard (create.roblox.com > your experience > Monetization),
-- then paste its ID below. Items with id = 0 show "Coming soon" in the shop.

local Config = {}

Config.GameName = "Bike the World"

-- 1 metre = 3 studs (a Roblox character is about 1.7 m tall)
Config.M = 3

-- Coins you earn by playing
Config.Rewards = {
	PerKilometre = 12, -- riding distance
	CoinPickup = 5, -- spinning coins on the streets
	Landmark = 50, -- first visit of a famous place
	DeliveryBase = 30, -- delivering an order
	DeliveryTimeBonus = 30, -- extra when you are fast
	DailyBonus = 75, -- once per day
}

export type BikeDef = {
	id: string,
	name: string,
	price: number, -- coins (0 = free)
	gamePass: string?, -- key into Config.GamePasses if it is a Robux bike
	topSpeed: number, -- metres per second without boost
	power: number, -- acceleration multiplier
	handling: number, -- steering multiplier
	wheel: number, -- wheel radius in metres
	style: string, -- model style
	color: Color3,
	description: string,
}

Config.Bikes = {
	{ id = "city", name = "Dutch City Bike", price = 0, topSpeed = 7.5, power = 1.0, handling = 1.0, wheel = 0.355, style = "city", color = Color3.fromRGB(25, 25, 28), description = "The classic Dutch 'omafiets'. Comfy and cool." },
	{ id = "bmx", name = "BMX", price = 250, topSpeed = 8.0, power = 1.3, handling = 1.35, wheel = 0.26, style = "bmx", color = Color3.fromRGB(0, 170, 255), description = "Small, quick and super nimble." },
	{ id = "cargo", name = "Cargo Bike", price = 400, topSpeed = 7.0, power = 0.95, handling = 0.8, wheel = 0.3, style = "cargo", color = Color3.fromRGB(60, 110, 70), description = "A Dutch bakfiets with a big box in front." },
	{ id = "racer", name = "Racing Bike", price = 900, topSpeed = 10.5, power = 1.35, handling = 0.95, wheel = 0.34, style = "racer", color = Color3.fromRGB(220, 40, 40), description = "Thin tyres, drop bars, very fast!" },
	{ id = "ebike", name = "E-Bike", price = 1500, topSpeed = 10.0, power = 1.8, handling = 1.0, wheel = 0.35, style = "city", color = Color3.fromRGB(240, 240, 240), description = "An electric motor helps you pedal." },
	{ id = "golden", name = "Golden Bike", price = 0, gamePass = "GoldenBike", topSpeed = 11.0, power = 1.6, handling = 1.25, wheel = 0.35, style = "racer", color = Color3.fromRGB(255, 196, 40), description = "Shiny gold and the fastest bike in town." },
} :: { BikeDef }

export type ColorDef = { id: string, name: string, price: number, color: Color3 }
Config.Colors = {
	{ id = "black", name = "Black", price = 0, color = Color3.fromRGB(25, 25, 28) },
	{ id = "red", name = "Red", price = 0, color = Color3.fromRGB(205, 45, 45) },
	{ id = "blue", name = "Blue", price = 50, color = Color3.fromRGB(40, 100, 220) },
	{ id = "mint", name = "Mint", price = 50, color = Color3.fromRGB(130, 210, 180) },
	{ id = "pink", name = "Pink", price = 50, color = Color3.fromRGB(255, 120, 190) },
	{ id = "orange", name = "Orange", price = 50, color = Color3.fromRGB(255, 140, 30) },
	{ id = "purple", name = "Purple", price = 50, color = Color3.fromRGB(140, 80, 210) },
	{ id = "white", name = "White", price = 50, color = Color3.fromRGB(240, 240, 240) },
} :: { ColorDef }

export type CosmeticDef = { id: string, name: string, price: number, gamePass: string?, description: string }
Config.Cosmetics = {
	{ id = "helmet", name = "Helmet", price = 100, description = "Safety first!" },
	{ id = "flowers", name = "Flower Basket", price = 150, description = "Tulips in your front basket." },
	{ id = "streamers", name = "Streamers", price = 80, description = "Colourful streamers on the handlebars." },
	{ id = "rainbow", name = "Rainbow Trail", price = 0, gamePass = "RainbowTrail", description = "Leave a rainbow behind you." },
	{ id = "puppy", name = "Puppy in Basket", price = 0, gamePass = "Puppy", description = "A happy puppy rides along." },
} :: { CosmeticDef }

export type PassDef = { id: number, name: string, suggestedPrice: number, description: string }

-- Robux: Game Passes (bought once, kept forever)
Config.GamePasses = {
	DoubleCoins = { id = 0, name = "2x Coins", suggestedPrice = 199, description = "Earn double coins from everything." },
	GoldenBike = { id = 0, name = "Golden Bike", suggestedPrice = 149, description = "The fastest bike, in shiny gold." },
	RainbowTrail = { id = 0, name = "Rainbow Trail", suggestedPrice = 99, description = "A rainbow trail behind your bike." },
	Puppy = { id = 0, name = "Puppy in Basket", suggestedPrice = 99, description = "A puppy that rides in your basket." },
} :: { [string]: PassDef }

-- Robux: Developer Products (can be bought many times)
export type ProductDef = { key: string, id: number, coins: number, suggestedPrice: number }
Config.Products = {
	{ key = "Coins100", id = 0, coins = 100, suggestedPrice = 25 },
	{ key = "Coins550", id = 0, coins = 550, suggestedPrice = 99 },
	{ key = "Coins1500", id = 0, coins = 1500, suggestedPrice = 249 },
} :: { ProductDef }

export type CityDef = {
	id: string,
	name: string,
	country: string,
	origin: Vector3,
	color: Color3,
	food: { string },
	rainChance: number,
	module: string,
}

Config.Cities = {
	{ id = "amsterdam", name = "Amsterdam", country = "Netherlands", origin = Vector3.new(9000, 0, 0), color = Color3.fromRGB(230, 60, 40), food = { "stroopwafels", "a cheese wheel", "poffertjes", "bitterballen", "a tulip bouquet" }, rainChance = 0.35, module = "Amsterdam" },
	{ id = "paris", name = "Paris", country = "France", origin = Vector3.new(-9000, 0, 0), color = Color3.fromRGB(40, 80, 200), food = { "croissants", "a baguette", "macarons", "crêpes", "a fresh flower bunch" }, rainChance = 0.1, module = "Paris" },
	{ id = "newyork", name = "New York", country = "USA", origin = Vector3.new(0, 0, 9000), color = Color3.fromRGB(250, 200, 40), food = { "a pizza slice", "bagels", "hot dogs", "a pretzel", "a big cookie" }, rainChance = 0.1, module = "NewYork" },
} :: { CityDef }

Config.HubOrigin = Vector3.new(0, 0, 0)

-- Day/night: one full day takes this many real minutes
Config.DayLengthMinutes = 24

-- Data store name (change the version suffix to wipe all saves)
Config.DataStoreName = "BikeTheWorld_v1"

-- Optional sound IDs (upload the WAV files from the roblox/assets folder,
-- or pick free sounds in the Creator Store, then paste "rbxassetid://123").
Config.Sounds = {
	Bell = "",
	Coin = "",
	Landmark = "",
	Purchase = "",
	Splash = "rbxasset://sounds/impact_water.mp3",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Grid</string>
          <string name="Source"><![CDATA[--!strict
-- Helpers for grid-shaped cities (Paris boulevards, Manhattan avenues).

local Build = require(script.Parent.Build)
local Roads = require(script.Parent.Roads)
local Kit = require(script.Parent.Kit)

type BuildList = Build.BuildList
type Rng = Build.Rng

local Grid = {}
local M = Kit.M
local S = Roads.SURF
local TOP = Roads.TOP

export type StreetOpts = { bike: boolean?, layer: number?, car: boolean?, surface: Roads.Surface?, lanes: boolean? }
export type Placer = (b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number) -> ()

--- A straight street from A to B with an asphalt road, optional red bike
--- lanes and traffic lanes in both directions. `layer` lifts crossing
--- streets a hair so overlapping roads never z-fight.
function Grid.street(b: BuildList, ax: number, az: number, bx: number, bz: number, width: number, opts: StreetOpts?)
	local o: StreetOpts = opts or {}
	local lift = (o.layer or 0) * 0.05
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	if len < 1 then
		return
	end
	local ux, uz = dx / len, dz / len
	local nx, nz = uz, -ux
	Roads.seg(b, ax, az, bx, bz, width, TOP.road + lift, o.surface or S.asphalt)
	if o.bike then
		for _, sgn in { -1, 1 } do
			local off = sgn * (width / 2 - 1.5 * M)
			Roads.seg(b, ax + nx * off, az + nz * off, bx + nx * off, bz + nz * off, 2 * M, TOP.bike + lift, S.bike)
		end
	end
	if o.lanes ~= false then
		for _, sgn in { -1, 1 } do
			local off = sgn * (if o.bike then width / 2 - 1.5 * M else 2.2 * M)
			local pts = {}
			local n = math.max(1, math.ceil(len / 30))
			for i = 0, n do
				local t = i / n
				table.insert(pts, { ax + dx * t + nx * off, TOP.road + 0.3, az + dz * t + nz * off })
			end
			if sgn < 0 then
				local rev = {}
				for i = #pts, 1, -1 do
					table.insert(rev, pts[i])
				end
				pts = rev
			end
			b:lane("bike", pts)
			if o.car then
				local cpts = {}
				for _, p in pts do
					local co = -sgn * 1.5 * M
					table.insert(cpts, { p[1] + nx * co, p[2], p[3] + nz * co })
				end
				b:lane("car", cpts)
			end
		end
	end
end

--- Pavement slab under a block (with a curb), plus walking lanes around it.
function Grid.pavement(b: BuildList, x0: number, z0: number, x1: number, z1: number, rim: number)
	b:box((x0 + x1) / 2, TOP.side - 0.3, (z0 + z1) / 2, x1 - x0 + 2 * rim, 0.6, z1 - z0 + 2 * rim, { mat = S.side.mat, col = S.side.col })
	local r = rim * 0.5
	local pts = {
		{ x0 - r, TOP.side + 0.3, z0 - r },
		{ x1 + r, TOP.side + 0.3, z0 - r },
		{ x1 + r, TOP.side + 0.3, z1 + r },
		{ x0 - r, TOP.side + 0.3, z1 + r },
		{ x0 - r, TOP.side + 0.3, z0 - r },
	}
	b:lane("walk", pts, true)
end

--- Buildings around a rectangular block, all facing outwards.
--- Returns nothing; adds delivery doors on some of them.
function Grid.perimeter(b: BuildList, rng: Rng, x0: number, z0: number, x1: number, z1: number, depth: number, wMin: number, wMax: number, place: Placer, doorEvery: number?)
	local W, D = x1 - x0, z1 - z0
	local d = math.min(depth, D / 2 - 0.5, W / 2 - 0.5)
	local every = doorEvery or 3
	local count = 0
	local function side(ax: number, az: number, ux: number, uz: number, len: number, yaw: number)
		local acc = 0
		while acc < len - 2 do
			local w = rng:range(wMin, wMax)
			if len - acc - w < wMin * 0.6 then
				w = len - acc
			end
			local ox, oz = ax + ux * (acc + w / 2), az + uz * (acc + w / 2)
			place(b, rng, ox, oz, yaw, w - 0.15, d)
			count += 1
			if count % every == 0 then
				local fx, fz = Build.rot(yaw, 0, -2.2 * M)
				b:door(ox + fx, TOP.side, oz + fz, yaw)
			end
			acc += w
		end
	end
	-- north (faces -z) and south (faces +z) sides span the full width
	side(x0, z0, 1, 0, W, 0)
	side(x1, z1, -1, 0, W, math.pi)
	-- west (faces -x) and east (faces +x) sides fit between them
	if D - 2 * d > wMin * 0.8 then
		side(x0, z1 - d, 0, -1, D - 2 * d, math.pi / 2)
		side(x1, z0 + d, 0, 1, D - 2 * d, -math.pi / 2)
	end
	-- roof/courtyard fill so you never see through the block
	if W - 2 * d > 2 and D - 2 * d > 2 then
		b:box((x0 + x1) / 2, 0.1, (z0 + z1) / 2, W - 2 * d, 0.2, D - 2 * d, { mat = "Ground", col = 0x4a4038, shadow = false })
	end
end

--- Trees along a straight line, every `spacing` studs.
function Grid.treeLine(b: BuildList, rng: Rng, ax: number, az: number, bx: number, bz: number, spacing: number, palette: { number }?)
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	local n = math.floor(len / spacing)
	for i = 0, n do
		local t = (i + 0.5) / (n + 1)
		Kit.tree(b, rng, ax + dx * t, az + dz * t, 1, palette)
	end
end

--- Coins along a straight line.
function Grid.coins(b: BuildList, rng: Rng, ax: number, az: number, bx: number, bz: number, spacing: number, chance: number)
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	local n = math.floor(len / spacing)
	for i = 1, n do
		if rng:chance(chance) then
			local t = i / (n + 1)
			b:coin(ax + dx * t, TOP.road + 3, az + dz * t)
		end
	end
end

--- Invisible fence around a rectangle so nobody rides off the map.
function Grid.fence(b: BuildList, x0: number, z0: number, x1: number, z1: number)
	local function wall(ax: number, az: number, bx: number, bz: number)
		Roads.wall(b, ax, az, bx, bz, 2, -4, 60, { mat = "SmoothPlastic", col = 0xffffff }, { transp = 1, shadow = false })
	end
	wall(x0, z0, x1, z0)
	wall(x0, z1, x1, z1)
	wall(x0, z0, x0, z1)
	wall(x1, z0, x1, z1)
end

return Grid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Kit</string>
          <string name="Source"><![CDATA[--!strict
-- Reusable building and street-furniture generators (pure data).
-- Building frame: origin at the bottom centre of the facade, local -Z points
-- out to the street, the building extends towards local +Z.

local Build = require(script.Parent.Build)

type BuildList = Build.BuildList
type Rng = Build.Rng

local Kit = {}

local M = 3 -- studs per metre

Kit.M = M

local GLASS = 0x26323d
local GLASS_TAG_CHANCE = 0.35

--- Yaw that makes a building face along the normal (nx, nz).
function Kit.faceYaw(nx: number, nz: number): number
	return math.atan2(-nx, -nz)
end

local function window(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, lx: number, ly: number, w: number, h: number, col: number?)
	local tag = if rng:chance(GLASS_TAG_CHANCE) then "NightWindow" else nil
	b:obox(ox, oz, yaw, lx, ly, -0.18, w, h, 0.36, { mat = "SmoothPlastic", col = col or GLASS, refl = 0.15, tag = tag, shadow = false, coll = false })
end

-- ---------------------------------------------------------------------------
-- Amsterdam canal house
-- ---------------------------------------------------------------------------
local BRICKS = { 0x5a2c22, 0x7d3a2b, 0x8a4430, 0x2b2726, 0x6e4a35, 0x9b5a3c }
local PLASTER = { 0xe9e4d8, 0x7e8a86, 0xc8b089, 0x6b2420, 0x3f4b45 }
local DOORS = { 0x1f3b2d, 0x161616, 0x1d2a44, 0x5a1c1c, 0x2d4a3e }
local GABLES = { "triangle", "step", "neck", "bell", "cornice", "cornice" }

function Kit.canalHouse(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number, floors: number?)
	local nFloors = floors or rng:int(3, 4)
	local plaster = rng:chance(0.3)
	local col = if plaster then rng:pick(PLASTER) else rng:pick(BRICKS)
	local mat = if plaster then "Plaster" else "Brick"
	local groundH = 3.6 * M
	local floorH = 3.0 * M
	local H = groundH + (nFloors - 1) * floorH
	-- slight lean, like the real "dancing houses"
	local lean = if rng:chance(0.3) then rng:range(-0.025, 0.025) else 0
	b:obox(ox, oz, yaw, 0, H / 2, d / 2, w, H, d, { mat = mat, col = col, roll = lean })
	-- windows
	local bays = if w < 8.5 * M then 2 else 3
	local doorBay = rng:int(1, bays)
	for f = 0, nFloors - 1 do
		local base = if f == 0 then 0 else groundH + (f - 1) * floorH
		local fh = if f == 0 then groundH else floorH
		for i = 1, bays do
			local lx = -w / 2 + (i - 0.5) * w / bays
			if f == 0 and i == doorBay then
				b:obox(ox, oz, yaw, lx, 1.15 * M + 0.2, -0.15, 1.1 * M, 2.3 * M, 0.3, { mat = "Wood", col = rng:pick(DOORS) })
				b:obox(ox, oz, yaw, lx, 0.25, -0.6, 1.5 * M, 0.5, 1.2, { mat = "Concrete", col = 0x8d877c })
			else
				window(b, rng, ox, oz, yaw, lx, base + fh * 0.55, 1.15 * M, (if f == 0 then 1.9 else 1.75) * M)
			end
		end
	end
	-- gable / roof
	local gable = rng:pick(GABLES)
	local roofCol = 0x2c2b2e
	if gable == "cornice" then
		b:obox(ox, oz, yaw, 0, H + 0.4, -0.2, w + 0.6, 0.8, 1.4, { mat = "SmoothPlastic", col = 0xf2efe8 })
		b:obox(ox, oz, yaw, 0, H + 0.5, d / 2 + 0.5, w - 0.4, 1.0, d - 1, { mat = "Slate", col = roofCol })
	else
		local hg = math.min(w * 0.85, 7 * M)
		-- pitched roof behind the gable
		b:prism(ox, oz, yaw, 0, H, d / 2 + 0.6, w, hg * 0.85, d - 1.2, { mat = "ClayRoofTiles", col = roofCol })
		if gable == "triangle" then
			b:prism(ox, oz, yaw, 0, H, -0.05, w + 0.1, hg, 0.6, { mat = mat, col = col })
		elseif gable == "step" then
			local steps = 3
			for s = 1, steps do
				local sw = w * (1 - (s - 1) * 0.28)
				b:obox(ox, oz, yaw, 0, H + (s - 0.5) * hg / steps, 0.3, sw, hg / steps, 1.2, { mat = mat, col = col })
			end
		else
			local nw = w * 0.45
			b:obox(ox, oz, yaw, 0, H + hg * 0.42, 0.3, nw, hg * 0.84, 1.2, { mat = mat, col = col })
			-- shoulders
			b:prism(ox, oz, yaw, -nw / 2 - (w - nw) / 4, H, 0.3, (w - nw) / 2, hg * 0.35, 1.2, { mat = mat, col = col })
			b:prism(ox, oz, yaw, nw / 2 + (w - nw) / 4, H, 0.3, (w - nw) / 2, hg * 0.35, 1.2, { mat = mat, col = col })
			if gable == "bell" then
				-- rounded top: a cylinder whose axis runs into the facade
				local cx, cz = Build.rot(yaw, 0, 0.3)
				b:cyl(ox + cx, H + hg * 0.84, oz + cz, 1.2, nw / 2, { yaw = yaw + math.pi / 2, mat = mat, col = col })
			else
				b:prism(ox, oz, yaw, 0, H + hg * 0.84, 0.3, nw + 0.6, hg * 0.22, 1.3, { mat = "SmoothPlastic", col = 0xf2efe8 })
			end
		end
		-- hoist beam
		b:obox(ox, oz, yaw, 0, H + hg * 0.55, -0.9, 0.45, 0.45, 2.2, { mat = "Wood", col = 0x2b2420, coll = false })
	end
	-- the front door's position along the facade (for delivery targets)
	local doorLx = -w / 2 + (doorBay - 0.5) * w / bays
	return H, doorLx
end

-- ---------------------------------------------------------------------------
-- Paris: Haussmann building
-- ---------------------------------------------------------------------------
local AWNINGS = { 0x9b1c1c, 0x1f4d2b, 0x1d3557, 0x7a1f3d, 0x3a3a3a }

function Kit.haussmann(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number, shop: boolean?)
	local stone = rng:pick({ 0xe8dcc2, 0xe2d5b8, 0xeee4cf, 0xd9cbb0 })
	local groundH = 4.5 * M
	local floorH = 3.2 * M
	local nFloors = 4
	local H = groundH + nFloors * floorH
	b:obox(ox, oz, yaw, 0, H / 2, d / 2, w, H, d, { mat = "Limestone", col = stone })
	-- shopfront
	if shop ~= false then
		b:obox(ox, oz, yaw, 0, groundH * 0.45, -0.15, w - 1.5, groundH * 0.75, 0.3, { mat = "SmoothPlastic", col = 0x1f262c, refl = 0.2, tag = if rng:chance(0.6) then "NightWindow" else nil, coll = false })
		if rng:chance(0.45) then
			b:obox(ox, oz, yaw, 0, groundH * 0.85, -1.6, w - 2, 0.4, 3.2, { mat = "Fabric", col = rng:pick(AWNINGS), pitch = -0.25, coll = false })
		end
	end
	local bays = math.max(2, math.floor(w / (5 * M)))
	for f = 1, nFloors do
		local base = groundH + (f - 1) * floorH
		for i = 1, bays do
			local lx = -w / 2 + (i - 0.5) * w / bays
			window(b, rng, ox, oz, yaw, lx, base + floorH * 0.5, 1.25 * M, 2.2 * M)
		end
		-- wrought iron balconies on the 2nd and top floors
		if f == 2 or f == nFloors then
			b:obox(ox, oz, yaw, 0, base + 0.2, -0.9, w - 0.4, 0.35, 1.8, { mat = "Limestone", col = stone })
			b:obox(ox, oz, yaw, 0, base + 1.3, -1.7, w - 0.6, 2.0, 0.15, { mat = "Metal", col = 0x1b1b1b, transp = 0.25, coll = false, shadow = false })
		end
	end
	-- cornice and grey zinc mansard roof with dormers
	b:obox(ox, oz, yaw, 0, H + 0.35, -0.3, w + 0.4, 0.7, 1.6, { mat = "Limestone", col = stone })
	local mh = 3.2 * M
	b:owedge(ox, oz, yaw, 0, H + 0.7 + mh / 2, 1.6, w, mh, 3.2, { mat = "Metal", col = 0x6d7378 })
	b:obox(ox, oz, yaw, 0, H + 0.7 + mh / 2, d / 2 + 1.6, w, mh, d - 3.2, { mat = "Metal", col = 0x6d7378 })
	for i = 1, math.max(1, bays - 1) do
		local lx = -w / 2 + (i + 0.0) * w / bays
		b:obox(ox, oz, yaw, lx, H + 0.7 + mh * 0.45, 1.1, 1.1 * M, 1.6 * M, 1.4, { mat = "Limestone", col = stone, coll = false })
	end
	-- chimney
	b:obox(ox, oz, yaw, rng:range(-w / 3, w / 3), H + mh + 2, d * 0.6, 1.5, 3.5, 3, { mat = "Brick", col = 0x9b5a3c })
	return H
end

-- ---------------------------------------------------------------------------
-- New York
-- ---------------------------------------------------------------------------
local TOWER_GLASS = { 0x3c5468, 0x2f4252, 0x50677a, 0x6b7c88, 0x33424d }
local TOWER_STONE = { 0xb8b0a2, 0x8f8676, 0xcfc6b5, 0x7d6c5c, 0xa39684 }

function Kit.skyscraper(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number, h: number)
	local glassy = rng:chance(0.55)
	local col = if glassy then rng:pick(TOWER_GLASS) else rng:pick(TOWER_STONE)
	local mat = if glassy then "Glass" else "Concrete"
	-- lobby
	b:obox(ox, oz, yaw, 0, 3 * M, d / 2, w, 6 * M, d, { mat = "SmoothPlastic", col = 0x1e2328, refl = 0.2 })
	local setback = rng:chance(0.45)
	local segs = if setback then 3 else 1
	local y = 6 * M
	local cw, cd = w, d
	for s = 1, segs do
		local sh = (h - 6 * M) / segs
		b:obox(ox, oz, yaw, 0, y + sh / 2, d / 2, cw, sh, cd, { mat = mat, col = col, refl = if glassy then 0.25 else 0 })
		-- floor bands: a few lit at night
		local bands = math.floor(sh / (12 * M))
		for k = 1, bands do
			local by = y + k * sh / (bands + 1)
			b:obox(ox, oz, yaw, 0, by, d / 2, cw + 0.3, 0.6, cd + 0.3, { mat = "SmoothPlastic", col = if glassy then 0x8899a6 else 0x5d544a, shadow = false, coll = false, tag = if rng:chance(0.5) then "NightWindow" else nil })
		end
		y += sh
		cw *= 0.78
		cd *= 0.78
	end
	if rng:chance(0.35) then
		b:obox(ox, oz, yaw, 0, y + 6, d / 2, 0.8, 12, 0.8, { mat = "Metal", col = 0x9aa0a6 })
		b:obox(ox, oz, yaw, 0, y + 12.5, d / 2, 1.2, 1.2, 1.2, { mat = "Neon", col = 0xff3030, tag = "NightBeacon" })
	end
	return y
end

local BROWN = { 0x6b4436, 0x5c3a2e, 0x7a5040, 0x4f3328, 0x8c6a55 }
function Kit.brownstone(b: BuildList, rng: Rng, ox: number, oz: number, yaw: number, w: number, d: number)
	local col = rng:pick(BROWN)
	local floorH = 3.2 * M
	local H = 4 * floorH
	b:obox(ox, oz, yaw, 0, H / 2, d / 2, w, H, d, { mat = "Sandstone", col = col })
	for f = 1, 3 do
		for i = 1, 3 do
			window(b, rng, ox, oz, yaw, -w / 2 + (i - 0.5) * w / 3, f * floorH + floorH * 0.5, 1.1 * M, 1.9 * M)
		end
	end
	-- stoop (front steps)
	-- a wedge is tallest at its local +Z side, which here is the building side
	b:owedge(ox, oz, yaw, w * 0.28, floorH * 0.4, -1.8 * M, 1.6 * M, floorH * 0.8, 3.6 * M, { mat = "Sandstone", col = col })
	b:obox(ox, oz, yaw, w * 0.28, floorH * 0.85 + 0.6, -0.15, 1.2 * M, 2.4 * M, 0.3, { mat = "Wood", col = 0x2a1a12 })
	b:obox(ox, oz, yaw, 0, H + 0.4, -0.2, w + 0.4, 0.8, 1.2, { mat = "SmoothPlastic", col = 0x2e2420 })
	return H
end

-- ---------------------------------------------------------------------------
-- Street furniture
-- ---------------------------------------------------------------------------
function Kit.tree(b: BuildList, rng: Rng, x: number, z: number, scale: number?, palette: { number }?)
	local s = (scale or 1) * rng:range(0.85, 1.2)
	local trunkH = 5 * M * s
	b:cyl(x, trunkH / 2, z, trunkH, 0.28 * M * s, { roll = math.pi / 2, mat = "Wood", col = 0x4a3b2f })
	local greens = palette or { 0x3f6b2f, 0x4d7a35, 0x56823a, 0x3a5f2a }
	local leaf = rng:pick(greens)
	b:ball(x, trunkH + 1.6 * M * s, z, 2.7 * M * s, { mat = "LeafyGrass", col = leaf, coll = false })
	b:ball(x + rng:range(-1.2, 1.2) * M * s, trunkH + 0.4 * M * s, z + rng:range(-1.2, 1.2) * M * s, 2.0 * M * s, { mat = "LeafyGrass", col = leaf, coll = false })
end

function Kit.lamp(b: BuildList, x: number, z: number, style: string?)
	local h = 4.8 * M
	b:cyl(x, h / 2, z, h, 0.09 * M, { roll = math.pi / 2, mat = "Metal", col = 0x15171a })
	local head
	if style == "modern" then
		head = b:box(x, h + 0.3, z, 0.9 * M, 0.25 * M, 0.5 * M, { mat = "SmoothPlastic", col = 0xfff1c8, tag = "StreetLight", coll = false })
	else
		b:box(x, h + 0.5 * M + 0.6, z, 0.75 * M, 0.2 * M, 0.75 * M, { mat = "Metal", col = 0x15171a, coll = false })
		head = b:box(x, h + 0.3 * M, z, 0.55 * M, 0.6 * M, 0.55 * M, { mat = "SmoothPlastic", col = 0xfff1c8, tag = "StreetLight", coll = false, shadow = false })
	end
	b:light(head, 40, 1.4, 0xffcf8a)
end

function Kit.bollard(b: BuildList, x: number, z: number)
	b:cyl(x, 1.25, z, 2.5, 0.32, { roll = math.pi / 2, mat = "Metal", col = 0x4a1d16 })
end

function Kit.bench(b: BuildList, x: number, z: number, yaw: number)
	b:obox(x, z, yaw, 0, 1.4, 0, 1.8 * M, 0.3, 0.55 * M, { mat = "Wood", col = 0x6b4a2f })
	b:obox(x, z, yaw, 0, 2.6, 0.75, 1.8 * M, 1.2, 0.2, { mat = "Wood", col = 0x6b4a2f })
	b:obox(x, z, yaw, -0.8 * M, 0.7, 0, 0.3, 1.4, 0.5 * M, { mat = "Metal", col = 0x222222 })
	b:obox(x, z, yaw, 0.8 * M, 0.7, 0, 0.3, 1.4, 0.5 * M, { mat = "Metal", col = 0x222222 })
end

local FRAME_COLS = { 0x141414, 0x141414, 0x1d2533, 0x1f3326, 0xe9e6dd, 0x7d1f1f, 0x8fbfb0 }
--- A parked bike (5 parts). yaw = direction the bike points.
function Kit.parkedBike(b: BuildList, rng: Rng, x: number, z: number, yaw: number)
	local r = 0.35 * M
	local col = rng:pick(FRAME_COLS)
	for _, lz in { -0.56 * M, 0.56 * M } do
		local wx, wz = Build.rot(yaw, 0, lz)
		b:cyl(x + wx, r, z + wz, 0.12, r, { yaw = yaw, mat = "Rubber", col = 0x151515, coll = false, shadow = false })
	end
	b:obox(x, z, yaw, 0, 0.75 * M, 0, 0.15, 0.15, 1.15 * M, { mat = "Metal", col = col, pitch = 0.35, coll = false })
	b:obox(x, z, yaw, 0, 1.0 * M, 0.25 * M, 0.5, 0.25, 0.8, { mat = "Leather", col = 0x3b2a1c, coll = false })
	b:obox(x, z, yaw, 0, 1.06 * M, -0.42 * M, 1.6, 0.15, 0.15, { mat = "Metal", col = 0x9a9da0, coll = false })
end

function Kit.cafeTable(b: BuildList, rng: Rng, x: number, z: number)
	b:cyl(x, 1.2, z, 2.4, 0.15, { roll = math.pi / 2, mat = "Metal", col = 0x222222 })
	b:cyl(x, 2.45, z, 0.15, 1.1, { roll = math.pi / 2, mat = "Marble", col = 0xeeeeee })
	for k = 0, 1 do
		local a = k * math.pi + rng:range(0, 1)
		b:box(x + math.cos(a) * 2.2, 1.4, z + math.sin(a) * 2.2, 1.3, 0.25, 1.3, { mat = "Wood", col = 0x8b5a2b, coll = false })
	end
end

function Kit.hydrant(b: BuildList, x: number, z: number)
	b:cyl(x, 1.1, z, 2.2, 0.45, { roll = math.pi / 2, mat = "Metal", col = 0xc62828 })
	b:ball(x, 2.2, z, 0.5, { mat = "Metal", col = 0xc62828 })
end

function Kit.flowerBox(b: BuildList, rng: Rng, x: number, z: number, yaw: number)
	b:obox(x, z, yaw, 0, 0.6, 0, 3, 1.2, 1.2, { mat = "Wood", col = 0x5a3a22 })
	for i = -1, 1 do
		local cols = { 0xe23d3d, 0xf2c230, 0xf07ab0, 0xffffff, 0xff7f2a }
		local wx, wz = Build.rot(yaw, i * 0.9, 0)
		b:ball(x + wx, 1.45, z + wz, 0.45, { mat = "SmoothPlastic", col = rng:pick(cols), coll = false, shadow = false })
	end
end

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Roads</string>
          <string name="Source"><![CDATA[--!strict
-- Streets, curved streets, quay walls, canal water and bridges (pure data).
-- Polar helpers use the convention x = r*sin(theta), z = r*cos(theta).

local Build = require(script.Parent.Build)

type BuildList = Build.BuildList
type Opts = Build.Opts

local Roads = {}

local THICK = 0.6

export type Surface = { mat: string, col: number }

Roads.SURF = {
	klinker = { mat = "Brick", col = 0x7a4436 },
	strip = { mat = "Cobblestone", col = 0x6e5a50 },
	asphalt = { mat = "Asphalt", col = 0x3d3e42 },
	bike = { mat = "Asphalt", col = 0x9a3b33 },
	side = { mat = "Pavement", col = 0x9d9891 },
	granite = { mat = "Granite", col = 0xa7a39b },
	plaza = { mat = "Pavement", col = 0xb4ac9d },
	grass = { mat = "Grass", col = 0x4d7a35 },
	gravel = { mat = "Sand", col = 0xc9b48a },
	stone = { mat = "Limestone", col = 0xd8ccb0 },
	brick = { mat = "Brick", col = 0x6b3426 },
	ground = { mat = "Ground", col = 0x5a4a3f },
}

--- Heights of the different surfaces (top face), in studs.
Roads.TOP = { road = 0.2, bike = 0.25, strip = 0.22, side = 0.65, edge = 0.6, plaza = 0.3, base = 0 }

--- Flat strip between two points, top at `top`.
function Roads.seg(b: BuildList, ax: number, az: number, bx: number, bz: number, width: number, top: number, s: Surface, o: Opts?): Build.Prim?
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	if len < 0.05 then
		return nil
	end
	if len > 1900 then
		-- parts can be at most 2048 studs long: split in two
		local mx, mz = (ax + bx) / 2, (az + bz) / 2
		Roads.seg(b, ax, az, mx, mz, width, top, s, o)
		return Roads.seg(b, mx, mz, bx, bz, width, top, s, o)
	end
	local op: Opts = table.clone(o or {}) :: Opts
	op.yaw = math.atan2(dx, dz)
	op.mat = s.mat
	op.col = s.col
	return b:box((ax + bx) / 2, top - THICK / 2, (az + bz) / 2, width, THICK, len, op)
end

--- Vertical wall from A to B between heights y0..y1 (split if very long).
function Roads.wall(b: BuildList, ax: number, az: number, bx: number, bz: number, thick: number, y0: number, y1: number, s: Surface, o: Opts?)
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	if len < 0.05 then
		return
	end
	if len > 1900 then
		local mx, mz = (ax + bx) / 2, (az + bz) / 2
		Roads.wall(b, ax, az, mx, mz, thick, y0, y1, s, o)
		Roads.wall(b, mx, mz, bx, bz, thick, y0, y1, s, o)
		return
	end
	local op: Opts = table.clone(o or {}) :: Opts
	op.yaw = math.atan2(dx, dz)
	op.mat = s.mat
	op.col = s.col
	b:box((ax + bx) / 2, (y0 + y1) / 2, (az + bz) / 2, thick, y1 - y0, len, op)
end

--- Polar point.
function Roads.P(r: number, th: number): (number, number)
	return r * math.sin(th), r * math.cos(th)
end

--- Curved band between radii r0..r1 and angles th0..th1, approximated by
--- straight boxes about `segLen` studs long.
function Roads.arc(b: BuildList, r0: number, r1: number, th0: number, th1: number, top: number, s: Surface, segLen: number?, o: Opts?)
	local rm = (r0 + r1) / 2
	local w = r1 - r0
	local span = th1 - th0
	if span <= 0 then
		return
	end
	local n = math.max(1, math.ceil(rm * span / (segLen or 36)))
	local d = span / n
	for i = 0, n - 1 do
		local ta = th0 + i * d
		local tm = ta + d / 2
		local len = 2 * rm * math.sin(d / 2) + w * d * 0.55 + 0.2
		local x, z = Roads.P(rm, tm)
		local op: Opts = table.clone(o or {}) :: Opts
		op.yaw = math.atan2(math.cos(tm), -math.sin(tm))
		op.mat = s.mat
		op.col = s.col
		-- alternate a hair in height so overlapping ends never z-fight
		local dy = if i % 2 == 0 then 0 else 0.02
		b:box(x, top - THICK / 2 + dy, z, w, THICK, len, op)
	end
end

--- Vertical wall along an arc (canal edges). `face` = +1 wall faces outward.
function Roads.arcWall(b: BuildList, r: number, th0: number, th1: number, y0: number, y1: number, thick: number, s: Surface, segLen: number?)
	local span = th1 - th0
	if span <= 0 then
		return
	end
	local n = math.max(1, math.ceil(r * span / (segLen or 30)))
	local d = span / n
	for i = 0, n - 1 do
		local tm = th0 + (i + 0.5) * d
		local len = 2 * r * math.sin(d / 2) + 0.4
		local x, z = Roads.P(r, tm)
		b:box(x, (y0 + y1) / 2, z, thick, y1 - y0, len, { yaw = math.atan2(math.cos(tm), -math.sin(tm)), mat = s.mat, col = s.col })
	end
end

--- Terrain water along an arc band.
function Roads.arcWater(b: BuildList, r0: number, r1: number, th0: number, th1: number, top: number, depth: number)
	local rm = (r0 + r1) / 2
	local w = r1 - r0
	local span = th1 - th0
	local n = math.max(1, math.ceil(rm * span / 40))
	local d = span / n
	for i = 0, n - 1 do
		local tm = th0 + (i + 0.5) * d
		local len = 2 * rm * math.sin(d / 2) + w * d * 0.6 + 1
		local x, z = Roads.P(rm, tm)
		b:addWater(x, top - depth / 2, z, w, depth, len, math.atan2(math.cos(tm), -math.sin(tm)))
	end
end

--- Bridge profile: smooth hump of height H over half-length L (u in [-L, L]).
function Roads.hump(u: number, H: number, L: number): number
	local t = math.abs(u) / L
	if t >= 1 then
		return 0
	end
	return H * (1 - t * t) * (1 - t * t)
end

export type BridgeOpts = { deck: Surface?, wall: Surface?, segs: number?, railCol: number?, lights: boolean? }

--- Arched bridge along a straight line from A to B (A,B on the two banks,
--- including ramps). `span` = length of open water in the middle.
--- Returns nothing; adds deck, parapets, spandrel walls with an arch.
function Roads.bridge(b: BuildList, ax: number, az: number, bx: number, bz: number, width: number, H: number, waterTop: number, span: number, opts: BridgeOpts?)
	local op: BridgeOpts = opts or {}
	local deck: Surface = op.deck or Roads.SURF.klinker
	local wall: Surface = op.wall or Roads.SURF.brick
	local dx, dz = bx - ax, bz - az
	local len = math.sqrt(dx * dx + dz * dz)
	local ux, uz = dx / len, dz / len
	local nx, nz = uz, -ux -- sideways
	local L = len / 2
	local n = op.segs or math.max(6, math.floor(len / 9))
	local yaw = math.atan2(dx, dz)
	local function hAt(u: number): number
		return Roads.hump(u, H, L)
	end
	for i = 0, n - 1 do
		local u0 = -L + (2 * L) * i / n
		local u1 = -L + (2 * L) * (i + 1) / n
		local h0, h1 = hAt(u0), hAt(u1)
		local um = (u0 + u1) / 2
		local cx, cz = ax + ux * (um + L), az + uz * (um + L)
		local segLen = (u1 - u0) / math.cos(math.atan2(h1 - h0, u1 - u0)) + 0.3
		local pitch = -math.atan2(h1 - h0, u1 - u0)
		local hm = (h0 + h1) / 2
		-- deck top sits a little above street level so the ramps never z-fight
		b:box(cx, hm + 0.3 - 0.5, cz, width, 1.0, segLen, { yaw = yaw, pitch = pitch, mat = deck.mat, col = deck.col })
		for _, side in { -1, 1 } do
			local px, pz = cx + nx * side * (width / 2 - 0.4), cz + nz * side * (width / 2 - 0.4)
			-- parapet
			b:box(px, hm + 1.6, pz, 0.8, 2.6, segLen, { yaw = yaw, pitch = pitch, mat = wall.mat, col = wall.col })
			-- spandrel wall down to the arch (open arch in the middle)
			local archTop
			if math.abs(um) < span / 2 then
				local t = um / (span / 2)
				archTop = waterTop + (hm - 2.2 - waterTop) * math.sqrt(math.max(0, 1 - t * t))
			else
				archTop = waterTop - 1
			end
			local wallH = hm - 0.3 - archTop
			if wallH > 0.4 then
				local wx, wz = cx + nx * side * (width / 2 - 0.5), cz + nz * side * (width / 2 - 0.5)
				b:box(wx, archTop + wallH / 2, wz, 1.0, wallH, segLen, { yaw = yaw, mat = wall.mat, col = wall.col })
			end
		end
		-- bridge lights on the parapet
		if op.lights and i % 2 == 0 then
			for _, side in { -1, 1 } do
				local px, pz = cx + nx * side * (width / 2 - 0.4), cz + nz * side * (width / 2 - 0.4)
				b:box(px, hm + 3.05, pz, 0.35, 0.35, 0.35, { mat = "SmoothPlastic", col = 0xffe2a0, tag = "BridgeBulb", coll = false, shadow = false })
			end
		end
	end
end

--- Height of a bridge deck at distance u from its centre (for lanes/coins).
function Roads.bridgeHeight(u: number, H: number, L: number): number
	return Roads.hump(u, H, L) + 0.2
end

return Roads
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">BikeService</string>
          <string name="Source"><![CDATA[--!strict
-- Gives every player a bike, sits them on it and moves them between cities.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local BikeModel = require(Shared.BikeModel)
local DataService = require(script.Parent.DataService)
local Worlds = require(script.Parent.Worlds)

local BikeService = {}
BikeService.bikes = {} :: { [Player]: Model }
BikeService.hasPass = function(_player: Player, _key: string): boolean
	return false
end
BikeService.remotes = nil :: Folder?

local bikesFolder = Instance.new("Folder")
bikesFolder.Name = "Bikes"
bikesFolder.Parent = Workspace

local wantsBike: { [Player]: boolean } = {}

local function setGroup(model: Instance, group: string)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

function BikeService.bikeDef(id: string): Config.BikeDef
	for _, b in Config.Bikes do
		if b.id == id then
			return b
		end
	end
	return Config.Bikes[1]
end

local function colorOf(id: string): Color3
	for _, c in Config.Colors do
		if c.id == id then
			return c.color
		end
	end
	return Config.Colors[1].color
end

function BikeService.ownsBike(player: Player, def: Config.BikeDef): boolean
	local profile = DataService.get(player)
	if def.gamePass then
		return BikeService.hasPass(player, def.gamePass)
	end
	return profile ~= nil and profile.bikes[def.id] == true
end

--- The bike the player has equipped (or the free one if they lost it).
function BikeService.chosenDef(player: Player): Config.BikeDef
	local profile = DataService.get(player)
	local def = BikeService.bikeDef(if profile then profile.bike else "city")
	if not BikeService.ownsBike(player, def) then
		def = Config.Bikes[1]
	end
	return def
end

function BikeService.lookFor(player: Player): BikeModel.Look
	local profile = DataService.get(player)
	local def = BikeService.chosenDef(player)
	local cosmetics: { [string]: boolean } = {}
	if profile then
		for id, on in profile.worn do
			if on then
				cosmetics[id] = true
			end
		end
	end
	-- pass cosmetics are only shown while owned
	for _, c in Config.Cosmetics do
		if c.gamePass and cosmetics[c.id] and not BikeService.hasPass(player, c.gamePass) then
			cosmetics[c.id] = nil
		end
	end
	local gold = def.id == "golden"
	return {
		style = def.style,
		color = if gold then def.color elseif profile then colorOf(profile.color) else def.color,
		wheel = def.wheel,
		cosmetics = cosmetics,
		gold = gold,
	}
end

function BikeService.removeBike(player: Player)
	local old = BikeService.bikes[player]
	BikeService.bikes[player] = nil
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then
			hum.Sit = false
		end
		setGroup(char, "Default")
		local helmet = char:FindFirstChild("BikeHelmet")
		if helmet then
			helmet:Destroy()
		end
	end
	if old then
		old:Destroy()
	end
	player:SetAttribute("OnBike", false)
	local ref = player:FindFirstChild("Bike")
	if ref and ref:IsA("ObjectValue") then
		ref.Value = nil
	end
end

function BikeService.spawnBike(player: Player, at: CFrame?)
	local char = player.Character
	if not char then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not hrp or hum.Health <= 0 then
		return
	end
	BikeService.removeBike(player)
	local origin: CFrame
	if at then
		origin = at
	else
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char, bikesFolder }
		local pos = hrp.Position
		local hit = Workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -40, 0), params)
		local groundY = if hit then hit.Position.Y else pos.Y - 3
		local look = hrp.CFrame.LookVector
		origin = CFrame.new(pos.X, groundY, pos.Z) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
	end
	local model = BikeModel.build(BikeService.lookFor(player), origin, nil)
	model.Name = player.Name .. "_Bike"
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("BikeId", BikeService.chosenDef(player).id)
	-- always streamed to its rider, streamed as one piece to everyone else
	model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	local root = model.PrimaryPart :: BasePart
	-- the client drives the bike by moving these rigid targets
	local att = Instance.new("Attachment")
	att.Name = "Drive"
	att.Parent = root
	local ap = Instance.new("AlignPosition")
	ap.Name = "DrivePosition"
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.RigidityEnabled = true
	ap.Position = root.Position
	ap.Parent = root
	local ao = Instance.new("AlignOrientation")
	ao.Name = "DriveOrientation"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = true
	ao.CFrame = root.CFrame
	ao.Parent = root
	setGroup(model, "Riders")
	model.Parent = bikesFolder
	pcall(function()
		model:AddPersistentPlayer(player)
	end)
	pcall(function()
		root:SetNetworkOwner(player)
	end)
	-- sit down
	hrp.CFrame = origin * CFrame.new(0, 4, 0)
	local seat = model:FindFirstChild("Saddle") :: Seat
	seat:Sit(hum)
	setGroup(char, "Riders")
	-- accessories that load later must not bump into the city either
	local added = char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and BikeService.bikes[player] == model then
			d.CollisionGroup = "Riders"
		end
	end)
	model.Destroying:Connect(function()
		added:Disconnect()
	end)
	-- helmet
	local profile = DataService.get(player)
	local head = char:FindFirstChild("Head") :: BasePart?
	if profile and profile.worn.helmet and head then
		local h = Instance.new("Part")
		h.Name = "BikeHelmet"
		h.Shape = Enum.PartType.Ball
		h.Size = Vector3.new(1.5, 1.5, 1.5)
		h.Color = Color3.fromRGB(255, 120, 40)
		h.Material = Enum.Material.SmoothPlastic
		h.CanCollide = false
		h.CanQuery = false
		h.Massless = true
		h.CFrame = head.CFrame * CFrame.new(0, 0.3, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0 = head
		w.Part1 = h
		w.Parent = h
		h.Parent = char
	end
	BikeService.bikes[player] = model
	player:SetAttribute("OnBike", true)
	local ref = player:FindFirstChild("Bike")
	if ref and ref:IsA("ObjectValue") then
		ref.Value = model
	end
end

function BikeService.toggle(player: Player)
	if BikeService.bikes[player] then
		wantsBike[player] = false
		BikeService.removeBike(player)
	else
		wantsBike[player] = true
		BikeService.spawnBike(player)
	end
end

--- Teleport a player to the hub or a city.
function BikeService.goTo(player: Player, worldId: string)
	local w = Worlds.list[worldId]
	if not w or not w.ready then
		return false
	end
	pcall(function()
		player:RequestStreamAroundAsync(w.spawn.Position, 10)
	end)
	player:SetAttribute("City", worldId)
	local remotes = BikeService.remotes
	if BikeService.bikes[player] and remotes then
		(remotes:FindFirstChild("Teleport") :: RemoteEvent):FireClient(player, w.spawn)
	else
		local char = player.Character
		if char then
			char:PivotTo(w.spawn * CFrame.new(0, 3, 0))
		end
	end
	return true
end

function BikeService.onPlayer(player: Player)
	wantsBike[player] = true
	local ref = Instance.new("ObjectValue")
	ref.Name = "Bike"
	ref.Parent = player
	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
		char:WaitForChild("HumanoidRootPart", 10)
		if not hum then
			return
		end
		hum.Died:Connect(function()
			BikeService.removeBike(player)
		end)
		task.wait(0.6)
		player:SetAttribute("City", "hub")
		if wantsBike[player] ~= false then
			BikeService.spawnBike(player)
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	BikeService.removeBike(player)
	wantsBike[player] = nil
end)

return BikeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Saves coins, bikes, cosmetics and discovered landmarks with DataStores.
-- In Studio, turn on "Enable Studio Access to API Services" (Game Settings >
-- Security) to test saving; without it the game still works, it just
-- doesn't remember anything.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

export type Profile = {
	coins: number,
	totalCoins: number,
	bikes: { [string]: boolean },
	colors: { [string]: boolean },
	cosmetics: { [string]: boolean },
	worn: { [string]: boolean },
	bike: string,
	color: string,
	landmarks: { [string]: boolean },
	deliveries: number,
	metres: number,
	lastDaily: number,
	receipts: { string },
}

local DataService = {}
DataService.profiles = {} :: { [Player]: Profile }
DataService.changed = Instance.new("BindableEvent")

local store: DataStore? = nil
local ok = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)
if not ok then
	warn("[Bike the World] DataStores unavailable: progress will not be saved in this session.")
end

local function default(): Profile
	return {
		coins = 0,
		totalCoins = 0,
		bikes = { city = true },
		colors = { black = true, red = true },
		cosmetics = {},
		worn = {},
		bike = "city",
		color = "black",
		landmarks = {},
		deliveries = 0,
		metres = 0,
		lastDaily = 0,
		receipts = {},
	}
end

--- Fill in any fields missing from older saves.
local function reconcile(data: any): Profile
	local p = default()
	if type(data) ~= "table" then
		return p
	end
	for k, v in data do
		if (p :: any)[k] ~= nil and type(v) == type((p :: any)[k]) then
			(p :: any)[k] = v
		end
	end
	p.bikes.city = true
	p.colors.black = true
	p.colors.red = true
	return p
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

function DataService.load(player: Player): Profile
	local data = nil
	local s = store
	if s then
		for attempt = 1, 3 do
			local okLoad, result = pcall(function()
				return s:GetAsync(key(player))
			end)
			if okLoad then
				data = result
				break
			end
			warn("[Bike the World] load failed (" .. attempt .. "): " .. tostring(result))
			task.wait(attempt)
		end
	end
	local profile = reconcile(data)
	DataService.profiles[player] = profile
	return profile
end

function DataService.save(player: Player): boolean
	local profile = DataService.profiles[player]
	local s = store
	if not profile or not s then
		return false
	end
	for attempt = 1, 3 do
		local okSave, err = pcall(function()
			s:UpdateAsync(key(player), function()
				return profile
			end)
		end)
		if okSave then
			return true
		end
		warn("[Bike the World] save failed (" .. attempt .. "): " .. tostring(err))
		task.wait(attempt)
	end
	return false
end

function DataService.get(player: Player): Profile?
	return DataService.profiles[player]
end

--- Tell listeners (leaderstats, the player's UI) that a profile changed.
function DataService.touch(player: Player)
	DataService.changed:Fire(player)
end

function DataService.release(player: Player)
	DataService.save(player)
	DataService.profiles[player] = nil
end

-- autosave every two minutes and when the server shuts down
task.spawn(function()
	while true do
		task.wait(120)
		for _, player in Players:GetPlayers() do
			task.spawn(DataService.save, player)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			DataService.save(player)
			pending -= 1
		end)
	end
	local t = os.clock()
	while pending > 0 and os.clock() - t < 25 do
		task.wait(0.1)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Bike the World: server start-up. Builds the hub and the cities, sets up
-- remotes, players, portals, the bike shop, weather and the day/night cycle.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- characters spawn once the hub is built and the save file is loaded
Players.CharacterAutoLoads = false

-- Remotes first, so client scripts can wait for them
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in {
	"Profile", "Toast", "Coins", "Landmark", "Teleport", "Delivery", "OpenShop", "BellRang",
	"Bell", "CollectCoin", "ToggleBike", "GoToCity", "CancelDelivery",
} do
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = remotes
end
for _, name in { "Buy", "Equip", "GetProfile" } do
	local fn = Instance.new("RemoteFunction")
	fn.Name = name
	fn.Parent = remotes
end
remotes.Parent = ReplicatedStorage

local function remote(name: string): RemoteEvent
	return remotes:FindFirstChild(name) :: RemoteEvent
end
local function func(name: string): RemoteFunction
	return remotes:FindFirstChild(name) :: RemoteFunction
end

-- Riders don't bump into the world or each other: the client steers the bike
-- around walls itself, which feels much smoother than physics collisions.
pcall(function()
	PhysicsService:RegisterCollisionGroup("Riders")
end)
PhysicsService:CollisionGroupSetCollidable("Riders", "Default", false)
PhysicsService:CollisionGroupSetCollidable("Riders", "Riders", false)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Hub = require(Shared.Cities.Hub)
local Materializer = require(script.Parent.Materializer)
local DataService = require(script.Parent.DataService)
local Worlds = require(script.Parent.Worlds)
local BikeService = require(script.Parent.BikeService)
local ShopService = require(script.Parent.ShopService)
local RewardService = require(script.Parent.RewardService)

BikeService.remotes = remotes

local function toast(player: Player, text: string, kind: string?)
	remote("Toast"):FireClient(player, text, kind or "info")
end
RewardService.init(remotes, toast)

-- Sky and light ------------------------------------------------------------------
local function ensure(className: string, parent: Instance): Instance
	local found = parent:FindFirstChildOfClass(className)
	if found then
		return found
	end
	local made = Instance.new(className)
	made.Parent = parent
	return made
end

do
	local atmo = ensure("Atmosphere", Lighting) :: Atmosphere
	atmo.Density = 0.28
	atmo.Offset = 0.1
	atmo.Color = Color3.fromRGB(199, 214, 230)
	atmo.Decay = Color3.fromRGB(106, 120, 140)
	atmo.Glare = 0.2
	atmo.Haze = 1.2
	local bloom = ensure("BloomEffect", Lighting) :: BloomEffect
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 1.6
	local cc = ensure("ColorCorrectionEffect", Lighting) :: ColorCorrectionEffect
	cc.Saturation = 0.12
	cc.Contrast = 0.04
	ensure("Sky", Lighting)
	local terrain = Workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(52, 92, 96)
	terrain.WaterReflectance = 0.6
	terrain.WaterTransparency = 0.35
	terrain.WaterWaveSize = 0.08
	terrain.WaterWaveSpeed = 6
	local clouds = ensure("Clouds", terrain) :: Clouds
	clouds.Cover = 0.55
	clouds.Density = 0.5
end

-- Day and night: one day takes Config.DayLengthMinutes; nights go twice as
-- fast so there is more daylight to ride in.
RunService.Heartbeat:Connect(function(dt: number)
	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	local t = Lighting.ClockTime
	local night = t < 6 or t > 19
	Lighting.ClockTime = (t + dt * hoursPerSecond * (if night then 2 else 1)) % 24
end)

-- Rain comes and goes per city (the client shows it and makes streets slippery)
task.spawn(function()
	while true do
		for _, c in Config.Cities do
			Workspace:SetAttribute("Rain_" .. c.id, math.random() < c.rainChance)
		end
		task.wait(math.random(180, 360))
	end
end)

-- The world ---------------------------------------------------------------------
local worldFolder = Instance.new("Folder")
worldFolder.Name = "World"
worldFolder.Parent = Workspace

local portalList: { BasePart } = {}

local function setupKiosk(part: BasePart)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open the Bike Shop"
	prompt.ObjectText = "Bike Shop"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 30
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		remote("OpenShop"):FireClient(player)
	end)
end

local function buildWorld(id: string, b: any, origin: Vector3, name: string)
	local built = Materializer.build(b, origin, name, worldFolder)
	Worlds.fill(id, b)
	RewardService.spawnCoins(id, origin, b.coins, built.folder)
	RewardService.spawnShopMarkers(Worlds.list[id], built.folder)
	for _, p in built.portals do
		table.insert(portalList, p)
	end
	for _, k in built.kiosks do
		setupKiosk(k)
	end
	Worlds.list[id].ready = true
	return built
end

-- the hub first, so players can start straight away
local portalCities = {}
for _, c in Config.Cities do
	table.insert(portalCities, {
		id = c.id,
		name = c.name,
		col = bit32.bor(
			bit32.lshift(math.floor(c.color.R * 255 + 0.5), 16),
			bit32.lshift(math.floor(c.color.G * 255 + 0.5), 8),
			math.floor(c.color.B * 255 + 0.5)
		),
	})
end
local hubList = Hub.generate(portalCities)
buildWorld("hub", hubList, Config.HubOrigin, "Hub")

local spawnLocation = Instance.new("SpawnLocation")
spawnLocation.Name = "HubSpawn"
spawnLocation.Anchored = true
spawnLocation.CanCollide = false
spawnLocation.CanQuery = false
spawnLocation.Transparency = 1
spawnLocation.Size = Vector3.new(6, 1, 6)
spawnLocation.Duration = 0
spawnLocation.Neutral = true
spawnLocation.CFrame = Worlds.list.hub.spawn
spawnLocation.Parent = Workspace
local spawnDecal = spawnLocation:FindFirstChildOfClass("Decal")
if spawnDecal then
	spawnDecal:Destroy()
end

-- then the cities, one after another
task.spawn(function()
	for _, c in Config.Cities do
		local t0 = os.clock()
		local ok, err = pcall(function()
			local mod = Shared:WaitForChild("Cities"):FindFirstChild(c.module)
			if not mod then
				error("no city module " .. c.module)
			end
			local gen = require(mod :: ModuleScript) :: any
			buildWorld(c.id, gen.generate(), c.origin, c.name)
		end)
		if ok then
			print(string.format("[Bike the World] %s ready in %.1fs", c.name, os.clock() - t0))
			for _, player in Players:GetPlayers() do
				toast(player, c.name .. " is ready! Ride through its portal.", "info")
				DataService.touch(player) -- sends the new landmark list
			end
		else
			warn("[Bike the World] could not build " .. c.name .. ": " .. tostring(err))
		end
	end
end)

-- Portals: checked by position, which works with streaming and fast bikes
local lastPortal: { [Player]: number } = {}
task.spawn(function()
	while true do
		task.wait(0.15)
		for _, player in Players:GetPlayers() do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp and os.clock() - (lastPortal[player] or 0) > 3 then
				for _, p in portalList do
					local lp = p.CFrame:PointToObjectSpace(hrp.Position)
					if math.abs(lp.X) < p.Size.X / 2 and math.abs(lp.Z) < 6 and lp.Y > -p.Size.Y / 2 - 6 and lp.Y < p.Size.Y / 2 then
						lastPortal[player] = os.clock()
						local city = p:GetAttribute("City")
						if type(city) == "string" then
							local w = Worlds.list[city]
							if w and w.ready then
								BikeService.goTo(player, city)
								remote("Toast"):FireClient(player, "Welcome to " .. w.name .. "!", "city")
							else
								toast(player, "This city is still being built. Try again in a moment!", "info")
							end
						end
						break
					end
				end
			end
		end
	end
end)

-- Players ----------------------------------------------------------------------------
local function snapshot(player: Player): { [string]: any }?
	local profile = DataService.get(player)
	if not profile then
		return nil
	end
	local passes = {}
	for key: string in Config.GamePasses do
		passes[key] = ShopService.hasPass(player, key)
	end
	local found = 0
	for _ in profile.landmarks do
		found += 1
	end
	local total = 0
	local list = {}
	for _, w in Worlds.list do
		total += #w.landmarks
		for _, l in w.landmarks do
			table.insert(list, { id = l.id, name = l.name, city = w.id })
		end
	end
	return {
		coins = profile.coins,
		bikes = profile.bikes,
		colors = profile.colors,
		cosmetics = profile.cosmetics,
		worn = profile.worn,
		bike = profile.bike,
		color = profile.color,
		landmarks = profile.landmarks,
		found = found,
		totalLandmarks = total,
		landmarkList = list,
		deliveries = profile.deliveries,
		metres = profile.metres,
		passes = passes,
	}
end

local function setStat(player: Player, name: string, value: number)
	local stats = player:FindFirstChild("leaderstats")
	local v = stats and stats:FindFirstChild(name)
	if v and v:IsA("IntValue") then
		v.Value = value
	end
end

DataService.changed.Event:Connect(function(player: Player)
	local snap = snapshot(player)
	if not snap then
		return
	end
	setStat(player, "Coins", snap.coins)
	setStat(player, "Landmarks", snap.found)
	remote("Profile"):FireClient(player, snap)
end)

-- LoadCharacterAsync is the new name of LoadCharacter; use whichever exists
local function spawnCharacter(player: Player)
	local ok = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok and player.Parent then
		(player :: any):LoadCharacter()
	end
end

local function onPlayerAdded(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Coins", "Landmarks" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player
	player:SetAttribute("City", "hub")

	DataService.load(player)
	if not player.Parent then
		return
	end
	BikeService.onPlayer(player)
	RewardService.onPlayer(player)
	ShopService.onJoin(player, toast)
	DataService.touch(player)

	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
		if hum then
			hum.Died:Connect(function()
				task.wait(3)
				if player.Parent then
					spawnCharacter(player)
				end
			end)
		end
	end)
	spawnCharacter(player)
	task.delay(4, function()
		if player.Parent then
			toast(player, "Welcome to " .. Config.GameName .. "! Ride through a portal to visit a city.", "info")
			RewardService.dailyBonus(player)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	lastPortal[player] = nil
	DataService.release(player)
end)

-- Remote handlers ----------------------------------------------------------------------
local busy: { [Player]: number } = {}
local function throttle(player: Player, gap: number): boolean
	local now = os.clock()
	if now - (busy[player] or 0) < gap then
		return false
	end
	busy[player] = now
	return true
end
Players.PlayerRemoving:Connect(function(player)
	busy[player] = nil
end)

func("GetProfile").OnServerInvoke = function(player)
	return snapshot(player)
end

func("Buy").OnServerInvoke = function(player, kind, id)
	if type(kind) ~= "string" or type(id) ~= "string" then
		return false, "Oops!"
	end
	if not throttle(player, 0.3) then
		return false, "One moment..."
	end
	return ShopService.buy(player, kind, id)
end

func("Equip").OnServerInvoke = function(player, kind, id)
	if type(kind) ~= "string" or type(id) ~= "string" then
		return false, "Oops!"
	end
	if not throttle(player, 0.3) then
		return false, "One moment..."
	end
	return ShopService.equip(player, kind, id)
end

remote("CollectCoin").OnServerEvent:Connect(function(player, id)
	RewardService.collectCoin(player, id)
end)

remote("CancelDelivery").OnServerEvent:Connect(function(player)
	RewardService.cancelJob(player)
end)

local lastToggle: { [Player]: number } = {}
remote("ToggleBike").OnServerEvent:Connect(function(player)
	if os.clock() - (lastToggle[player] or 0) < 1 then
		return
	end
	lastToggle[player] = os.clock()
	BikeService.toggle(player)
end)

local lastTravel: { [Player]: number } = {}
remote("GoToCity").OnServerEvent:Connect(function(player, id)
	if type(id) ~= "string" or not Worlds.list[id] then
		return
	end
	if os.clock() - (lastTravel[player] or 0) < 3 then
		return
	end
	lastTravel[player] = os.clock()
	if not Worlds.list[id].ready then
		toast(player, "This city is still being built. Try again in a moment!", "info")
		return
	end
	if BikeService.goTo(player, id) then
		toast(player, "Welcome to " .. Worlds.list[id].name .. "!", "city")
	end
end)

local lastBell: { [Player]: number } = {}
remote("Bell").OnServerEvent:Connect(function(player)
	if os.clock() - (lastBell[player] or 0) < 0.35 then
		return
	end
	lastBell[player] = os.clock()
	local bike = BikeService.bikes[player]
	if not bike then
		return
	end
	for _, other in Players:GetPlayers() do
		if other ~= player then
			remote("BellRang"):FireClient(other, bike)
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	lastToggle[player] = nil
	lastTravel[player] = nil
	lastBell[player] = nil
end)

-- If someone hops off the saddle (e.g. by jumping) the bike goes away; the
-- "Bike" button brings it back.
RunService.Heartbeat:Connect(function()
	for player, bike in BikeService.bikes do
		local seat = bike:FindFirstChild("Saddle") :: Seat?
		if seat and not seat.Occupant and bike:GetAttribute("Seated") then
			BikeService.toggle(player)
		elseif seat and seat.Occupant then
			bike:SetAttribute("Seated", true)
		end
	end
end)

-- tagged so other scripts can find the hub spawn if they need it
CollectionService:AddTag(spawnLocation, "HubSpawn")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Materializer</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a build list (plain data) into parts, terrain water, lights and signs.

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Build = require(Shared.Build)

local Materializer = {}

local MATERIALS: { [string]: Enum.Material } = {
	SmoothPlastic = Enum.Material.SmoothPlastic,
	Plastic = Enum.Material.Plastic,
	Brick = Enum.Material.Brick,
	Cobblestone = Enum.Material.Cobblestone,
	Concrete = Enum.Material.Concrete,
	Asphalt = Enum.Material.Asphalt,
	Pavement = Enum.Material.Pavement,
	Granite = Enum.Material.Granite,
	Limestone = Enum.Material.Limestone,
	Sandstone = Enum.Material.Sandstone,
	Marble = Enum.Material.Marble,
	Slate = Enum.Material.Slate,
	Wood = Enum.Material.Wood,
	WoodPlanks = Enum.Material.WoodPlanks,
	Metal = Enum.Material.Metal,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Fabric = Enum.Material.Fabric,
	Grass = Enum.Material.Grass,
	LeafyGrass = Enum.Material.LeafyGrass,
	Ground = Enum.Material.Ground,
	Sand = Enum.Material.Sand,
	Mud = Enum.Material.Mud,
	Rubber = Enum.Material.Rubber,
	Leather = Enum.Material.Leather,
	Plaster = Enum.Material.Plaster,
	ClayRoofTiles = Enum.Material.ClayRoofTiles,
	RoofShingles = Enum.Material.RoofShingles,
	ForceField = Enum.Material.ForceField,
	Foil = Enum.Material.Foil,
}

local function color(hex: number): Color3
	return Color3.fromRGB(bit32.extract(hex, 16, 8), bit32.extract(hex, 8, 8), bit32.extract(hex, 0, 8))
end
Materializer.color = color

local function cframeOf(origin: Vector3, p: Build.Prim): CFrame
	return CFrame.new(origin.X + p.x, origin.Y + p.y, origin.Z + p.z)
		* CFrame.Angles(0, p.yaw, 0)
		* CFrame.Angles(p.pitch, 0, 0)
		* CFrame.Angles(0, 0, p.roll)
end

local function makeSign(origin: Vector3, s: Build.Sign, parent: Instance)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Size = Vector3.new(s.w, s.h, 0.4)
	part.CFrame = CFrame.new(origin.X + s.x, origin.Y + s.y, origin.Z + s.z) * CFrame.Angles(0, s.yaw, 0)
	part.Color = color(s.bg)
	part.Material = Enum.Material.SmoothPlastic
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = s.text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color(s.col)
	label.Parent = gui
	part.Parent = parent
end

export type Built = {
	folder: Folder,
	portals: { BasePart },
	kiosks: { BasePart },
}

--- Create everything in `b` at `origin`, under a new Folder in `parent`.
--- Yields every so often so big cities don't time out the script.
function Materializer.build(b: Build.BuildList, origin: Vector3, name: string, parent: Instance): Built
	local folder = Instance.new("Folder")
	folder.Name = name
	local result: Built = { folder = folder, portals = {}, kiosks = {} }
	-- group parts into chunks so the explorer stays readable
	local chunks: { [string]: Model } = {}
	local function chunkFor(x: number, z: number): Model
		local key = string.format("%d_%d", math.floor(x / 400), math.floor(z / 400))
		local found = chunks[key]
		if found then
			return found
		end
		local m = Instance.new("Model")
		m.Name = "Chunk_" .. key
		m.Parent = folder
		chunks[key] = m
		return m
	end
	local made = 0
	for _, p in b.prims do
		local part: BasePart
		if p.k == "wedge" then
			part = Instance.new("WedgePart")
		elseif p.k == "cwedge" then
			part = Instance.new("CornerWedgePart")
		else
			local pp = Instance.new("Part")
			if p.k == "cyl" then
				pp.Shape = Enum.PartType.Cylinder
			elseif p.k == "ball" then
				pp.Shape = Enum.PartType.Ball
			end
			part = pp
		end
		part.Anchored = true
		part.Size = Vector3.new(p.sx, p.sy, p.sz)
		part.CFrame = cframeOf(origin, p)
		part.Material = MATERIALS[p.mat] or Enum.Material.SmoothPlastic
		part.Color = color(p.col)
		part.CanCollide = p.coll
		part.CanTouch = false
		part.CanQuery = p.coll -- the bike's raycasts only need solid things
		part.CastShadow = p.shadow
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		if p.transp > 0 then
			part.Transparency = p.transp
		end
		if p.refl > 0 then
			part.Reflectance = p.refl
		end
		if p.light then
			local light = Instance.new("PointLight")
			light.Range = p.light.range
			light.Brightness = p.light.brightness
			light.Color = color(p.light.col)
			light.Shadows = false
			light.Enabled = false -- switched on at night by the client
			light.Parent = part
		end
		local tag = p.tag
		if tag then
			if string.sub(tag, 1, 7) == "Portal:" then
				part:SetAttribute("City", string.sub(tag, 8))
				part.CanTouch = true
				CollectionService:AddTag(part, "Portal")
				table.insert(result.portals, part)
			elseif tag == "ShopKiosk" then
				table.insert(result.kiosks, part)
				CollectionService:AddTag(part, tag)
			else
				CollectionService:AddTag(part, tag)
			end
		end
		part.Parent = chunkFor(p.x, p.z)
		made += 1
		if made % 1500 == 0 then
			task.wait()
		end
	end
	for _, s in b.signs do
		makeSign(origin, s, folder)
	end
	-- terrain water with a muddy bottom
	local terrain = Workspace.Terrain
	for i, w in b.water do
		local cf = CFrame.new(origin.X + w[1], origin.Y + w[2], origin.Z + w[3]) * CFrame.Angles(0, w[7], 0)
		local size = Vector3.new(w[4], w[5], w[6])
		terrain:FillBlock(cf, size, Enum.Material.Water)
		terrain:FillBlock(cf * CFrame.new(0, -w[5] / 2 - 2, 0), Vector3.new(w[4], 4, w[6]), Enum.Material.Mud)
		if i % 100 == 0 then
			task.wait()
		end
	end
	folder.Parent = parent
	return result
end

return Materializer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--!strict
-- Everything that earns coins: spinning street coins, kilometres ridden,
-- discovering landmarks, delivery jobs and the daily bonus. The server checks
-- every reward, so a player can't simply tell it "give me coins".

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local DataService = require(script.Parent.DataService)
local BikeService = require(script.Parent.BikeService)
local Worlds = require(script.Parent.Worlds)

local M = Config.M
local R = Config.Rewards

local RewardService = {}

local remotes: Folder? = nil
local toast: (Player, string, string?) -> () = function() end

local COIN_RESPAWN = 40 -- seconds before a coin comes back (per player)
local COIN_REACH = 26 -- studs; generous because of network delay
local SHOP_REACH = 7 * M
local DOOR_REACH = 7 * M
local MAX_SPEED = 22 * M -- studs per second; faster means a teleport

local coinPos: { [string]: Vector3 } = {}
local collected: { [Player]: { [string]: number } } = {}
local coinBudget: { [Player]: number } = {}

type Job = {
	world: string,
	item: string,
	shop: string,
	from: Vector3,
	to: Vector3,
	started: number,
	limit: number,
}

type Track = {
	last: Vector3?,
	world: string?,
	metres: number,
	job: Job?,
	nextJob: number,
}
local tracks: { [Player]: Track } = {}

local function fire(name: string, player: Player, ...: any)
	local r = remotes
	if r then
		local ev = r:FindFirstChild(name)
		if ev and ev:IsA("RemoteEvent") then
			ev:FireClient(player, ...)
		end
	end
end

function RewardService.init(remoteFolder: Folder, sendToast: (Player, string, string?) -> ())
	remotes = remoteFolder
	toast = sendToast
end

--- Add earned coins (doubled with the 2x Coins pass). Returns the amount.
function RewardService.give(player: Player, amount: number, reason: string?): number
	local profile = DataService.get(player)
	if not profile or amount <= 0 then
		return 0
	end
	if BikeService.hasPass(player, "DoubleCoins") then
		amount *= 2
	end
	amount = math.floor(amount + 0.5)
	profile.coins += amount
	profile.totalCoins += amount
	DataService.touch(player)
	fire("Coins", player, amount, reason or "")
	return amount
end

-- Coins ----------------------------------------------------------------------

--- Create the spinning coins of a world. `spots` are relative to `origin`.
function RewardService.spawnCoins(worldId: string, origin: Vector3, spots: { any }, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Coins"
	for i, s in spots do
		local id = worldId .. ":" .. i
		local pos = origin + Vector3.new(s.x, s.y, s.z)
		coinPos[id] = pos
		local coin = Instance.new("Part")
		coin.Name = "Coin"
		coin.Shape = Enum.PartType.Cylinder
		coin.Size = Vector3.new(0.35, 2.6, 2.6)
		coin.CFrame = CFrame.new(pos)
		coin.Color = Color3.fromRGB(255, 200, 40)
		coin.Material = Enum.Material.Neon
		coin.Anchored = true
		coin.CanCollide = false
		coin.CanQuery = false
		coin.CanTouch = false
		coin.CastShadow = false
		coin:SetAttribute("Id", id)
		CollectionService:AddTag(coin, "Coin")
		coin.Parent = folder
	end
	folder.Parent = parent
end

local function playerPos(player: Player): Vector3?
	local bike = BikeService.bikes[player]
	if bike and bike.PrimaryPart then
		return bike.PrimaryPart.Position
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if hrp then hrp.Position else nil
end

--- The client says it rode through a coin; check it really did.
function RewardService.collectCoin(player: Player, id: any)
	if type(id) ~= "string" then
		return
	end
	local pos = coinPos[id]
	local at = playerPos(player)
	if not pos or not at then
		return
	end
	if (pos - at).Magnitude > COIN_REACH then
		return
	end
	-- at most ~8 coins a second
	local budget = coinBudget[player] or 0
	if budget >= 8 then
		return
	end
	coinBudget[player] = budget + 1
	local mine = collected[player]
	if not mine then
		mine = {}
		collected[player] = mine
	end
	local now = os.clock()
	local last = mine[id]
	if last and now - last < COIN_RESPAWN - 2 then
		return
	end
	mine[id] = now
	RewardService.give(player, R.CoinPickup, "coin")
end

-- Shops and deliveries ---------------------------------------------------------

local SHOP_ICONS: { [string]: string } = {
	["Café"] = "☕",
	["Flower Market"] = "🌷",
	["Boulangerie"] = "🥐",
	["Pizza Place"] = "🍕",
	["Bagel Shop"] = "🥯",
	["Hot Dog Cart"] = "🌭",
}

--- Glowing rings where you pick up delivery orders.
function RewardService.spawnShopMarkers(world: Worlds.World, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "ShopMarkers"
	for _, s in world.shops do
		local ring = Instance.new("Part")
		ring.Name = "ShopMarker"
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.3, SHOP_REACH * 1.6, SHOP_REACH * 1.6)
		ring.CFrame = CFrame.new(s.pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		ring.Color = Color3.fromRGB(60, 200, 120)
		ring.Material = Enum.Material.Neon
		ring.Transparency = 0.45
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.CastShadow = false
		CollectionService:AddTag(ring, "ShopMarker")
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(220, 70)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 9, 0)
		gui.MaxDistance = 260
		gui.AlwaysOnTop = false
		gui.Parent = ring
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.3
		label.Text = (SHOP_ICONS[s.label or ""] or "📦") .. " " .. (s.label or "Shop") .. "\nRide here to deliver!"
		label.Parent = gui
		ring.Parent = folder
	end
	folder.Parent = parent
end

local function flat(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

local function startJob(player: Player, t: Track, world: Worlds.World, shop: Worlds.Spot)
	if #world.doors == 0 or #world.food == 0 then
		return
	end
	-- pick a door that is a nice ride away (not too close, not too far)
	local best: Vector3? = nil
	for _ = 1, 30 do
		local d = world.doors[math.random(1, #world.doors)].pos
		local dist = flat(d, shop.pos)
		if dist > 90 * M and dist < 380 * M then
			best = d
			break
		end
		if not best or math.abs(dist - 200 * M) < math.abs(flat(best, shop.pos) - 200 * M) then
			best = d
		end
	end
	local to = best :: Vector3
	local dist = flat(to, shop.pos)
	local item = world.food[math.random(1, #world.food)]
	-- about 4.5 m/s average plus a little extra, so kids can make it
	local limit = math.floor(dist / (4.5 * M) + 25)
	t.job = {
		world = world.id,
		item = item,
		shop = shop.label or "Shop",
		from = shop.pos,
		to = to,
		started = os.clock(),
		limit = limit,
	}
	fire("Delivery", player, {
		state = "start",
		item = item,
		shop = shop.label or "Shop",
		to = to,
		limit = limit,
		metres = math.floor(dist / M),
	})
end

local function finishJob(player: Player, t: Track)
	local job = t.job :: Job
	t.job = nil
	t.nextJob = os.clock() + 4
	local used = os.clock() - job.started
	local bonus = 0
	if used < job.limit then
		bonus = R.DeliveryTimeBonus * (1 - used / job.limit) + R.DeliveryTimeBonus * 0.25
	end
	local profile = DataService.get(player)
	if profile then
		profile.deliveries += 1
	end
	local got = RewardService.give(player, R.DeliveryBase + bonus, "delivery")
	fire("Delivery", player, { state = "done", item = job.item, coins = got, fast = used < job.limit })
end

function RewardService.cancelJob(player: Player)
	local t = tracks[player]
	if t and t.job then
		t.job = nil
		t.nextJob = os.clock() + 6
		fire("Delivery", player, { state = "cancel" })
	end
end

-- Landmarks and distance ---------------------------------------------------------

local function checkLandmarks(player: Player, world: Worlds.World, pos: Vector3)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	for _, l in world.landmarks do
		if not profile.landmarks[l.id] and flat(pos, l.pos) < l.radius then
			profile.landmarks[l.id] = true
			local got = RewardService.give(player, R.Landmark, "landmark")
			local total = 0
			for _ in profile.landmarks do
				total += 1
			end
			fire("Landmark", player, { id = l.id, name = l.name, fact = l.fact, coins = got, found = total })
			task.spawn(DataService.save, player)
		end
	end
end

local function update(player: Player, t: Track, dt: number)
	local pos = playerPos(player)
	if not pos then
		t.last = nil
		return
	end
	local worldId = player:GetAttribute("City")
	local world = if type(worldId) == "string" then Worlds.list[worldId] else nil
	if not world or not world.ready then
		t.last = nil
		return
	end
	if t.world ~= world.id then
		-- changed city: drop the old order and don't count the jump
		if t.job then
			RewardService.cancelJob(player)
		end
		t.world = world.id
		t.last = nil
	end
	-- distance ridden (only on the bike, ignoring teleports)
	local onBike = if BikeService.bikes[player] then true else false
	local last = t.last
	if onBike and last then
		local d = flat(pos, last)
		if d < MAX_SPEED * dt * 1.5 then
			t.metres += d / M
		end
	end
	t.last = pos
	if t.metres >= 1 then
		local whole = math.floor(t.metres)
		t.metres -= whole
		local profile = DataService.get(player)
		if profile then
			local before = math.floor(profile.metres * R.PerKilometre / 1000)
			profile.metres += whole
			local after = math.floor(profile.metres * R.PerKilometre / 1000)
			if after > before then
				RewardService.give(player, after - before, "ride")
			end
		end
	end
	checkLandmarks(player, world, pos)
	-- deliveries
	local job = t.job
	if job then
		if flat(pos, job.to) < DOOR_REACH and math.abs(pos.Y - job.to.Y) < 30 then
			finishJob(player, t)
		end
	elseif os.clock() > t.nextJob then
		for _, s in world.shops do
			if flat(pos, s.pos) < SHOP_REACH and math.abs(pos.Y - s.pos.Y) < 20 then
				startJob(player, t, world, s)
				break
			end
		end
	end
end

--- Once a day: free coins for coming back.
function RewardService.dailyBonus(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local today = math.floor(os.time() / 86400)
	if math.floor(profile.lastDaily / 86400) < today then
		profile.lastDaily = os.time()
		local got = RewardService.give(player, R.DailyBonus, "daily")
		toast(player, string.format("Daily bonus: +%d coins! Come back tomorrow for more.", got), "good")
	end
end

function RewardService.onPlayer(player: Player)
	tracks[player] = { metres = 0, nextJob = 0 }
	collected[player] = {}
end

Players.PlayerRemoving:Connect(function(player)
	tracks[player] = nil
	collected[player] = nil
	coinBudget[player] = nil
end)

task.spawn(function()
	local STEP = 0.25
	local sinceBudget = 0
	while true do
		local dt = task.wait(STEP)
		sinceBudget += dt
		if sinceBudget >= 1 then
			sinceBudget = 0
			table.clear(coinBudget)
		end
		for player, t in tracks do
			local ok, err = pcall(function()
				update(player, t, dt)
			end)
			if not ok then
				warn("[Bike the World] reward update failed: " .. tostring(err))
			end
		end
	end
end)

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--!strict
-- The shop: buy bikes, colours and cosmetics with coins; Game Passes and
-- coin packs with Robux.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local DataService = require(script.Parent.DataService)
local BikeService = require(script.Parent.BikeService)

local ShopService = {}
local passes: { [Player]: { [string]: boolean } } = {}
local toast: (Player, string, string?) -> () = function() end

function ShopService.hasPass(player: Player, key: string): boolean
	local p = passes[player]
	return p ~= nil and p[key] == true
end
BikeService.hasPass = ShopService.hasPass

local function passKeyById(id: number): string?
	for key, def in Config.GamePasses do
		if def.id ~= 0 and def.id == id then
			return key
		end
	end
	return nil
end

--- Give the items that come with a pass.
local function grantPass(player: Player, key: string)
	passes[player] = passes[player] or {}
	passes[player][key] = true
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if key == "GoldenBike" then
		profile.bikes.golden = true
	end
	for _, c in Config.Cosmetics do
		if c.gamePass == key then
			profile.cosmetics[c.id] = true
		end
	end
	DataService.touch(player)
end

function ShopService.onJoin(player: Player, sendToast: (Player, string, string?) -> ())
	toast = sendToast
	passes[player] = {}
	for key, def in Config.GamePasses do
		if def.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok and owns then
				grantPass(player, key)
			end
		end
	end
end

Players.PlayerRemoving:Connect(function(player)
	passes[player] = nil
end)

local function findItem(kind: string, id: string): any
	local list = if kind == "bike" then Config.Bikes elseif kind == "color" then Config.Colors elseif kind == "cosmetic" then Config.Cosmetics else nil
	if not list then
		return nil
	end
	for _, item in list :: { any } do
		if item.id == id then
			return item
		end
	end
	return nil
end

local function owned(profile: DataService.Profile, kind: string, id: string): boolean
	if kind == "bike" then
		return profile.bikes[id] == true
	elseif kind == "color" then
		return profile.colors[id] == true
	end
	return profile.cosmetics[id] == true
end

--- Buy an item with coins. Returns (ok, message).
function ShopService.buy(player: Player, kind: string, id: string): (boolean, string)
	local profile = DataService.get(player)
	local item = findItem(kind, id)
	if not profile or not item then
		return false, "That item does not exist."
	end
	if item.gamePass then
		return false, "This one is bought with Robux."
	end
	if owned(profile, kind, id) then
		return false, "You already have it."
	end
	if profile.coins < item.price then
		return false, string.format("You need %d more coins.", item.price - profile.coins)
	end
	profile.coins -= item.price
	if kind == "bike" then
		profile.bikes[id] = true
	elseif kind == "color" then
		profile.colors[id] = true
	else
		profile.cosmetics[id] = true
	end
	DataService.touch(player)
	task.spawn(DataService.save, player)
	return true, "Bought " .. item.name .. "!"
end

--- Equip a bike/colour or toggle a cosmetic. Returns (ok, message).
function ShopService.equip(player: Player, kind: string, id: string): (boolean, string)
	local profile = DataService.get(player)
	local item = findItem(kind, id)
	if not profile or not item then
		return false, "That item does not exist."
	end
	local has = owned(profile, kind, id)
	if item.gamePass then
		has = ShopService.hasPass(player, item.gamePass)
	end
	if not has then
		return false, "You don't own that yet."
	end
	if kind == "bike" then
		profile.bike = id
	elseif kind == "color" then
		profile.color = id
	else
		profile.worn[id] = not profile.worn[id]
	end
	DataService.touch(player)
	if BikeService.bikes[player] then
		BikeService.spawnBike(player)
	end
	return true, "Equipped " .. item.name .. "."
end

-- Robux: Game Passes ----------------------------------------------------------
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local key = passKeyById(passId)
	if key then
		grantPass(player, key)
		toast(player, "Thank you! " .. Config.GamePasses[key].name .. " unlocked.", "good")
		if BikeService.bikes[player] then
			BikeService.spawnBike(player)
		end
	end
end)

-- Robux: Developer Products (coin packs) ---------------------------------------
-- ProcessReceipt must be safe to call more than once for the same purchase:
-- we remember receipt ids in the save file and only grant each one once.
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = DataService.get(player)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipt = tostring(info.PurchaseId)
	if table.find(profile.receipts, receipt) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local pack = nil
	for _, p in Config.Products do
		if p.id ~= 0 and p.id == info.ProductId then
			pack = p
		end
	end
	if not pack then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	profile.coins += pack.coins
	table.insert(profile.receipts, receipt)
	while #profile.receipts > 60 do
		table.remove(profile.receipts, 1)
	end
	if not DataService.save(player) then
		-- undo so Roblox retries later, and the coins are never lost
		profile.coins -= pack.coins
		table.remove(profile.receipts)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService.touch(player)
	toast(player, string.format("Thank you! +%d coins.", pack.coins), "good")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Worlds</string>
          <string name="Source"><![CDATA[--!strict
-- Server registry of the hub and the cities: where they are and what is in
-- them (landmarks, shops, delivery doors), all in world coordinates.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

export type Spot = { pos: Vector3, label: string? }
export type LandmarkW = { id: string, name: string, pos: Vector3, radius: number, fact: string }
export type World = {
	id: string,
	name: string,
	origin: Vector3,
	ready: boolean,
	spawn: CFrame,
	landmarks: { LandmarkW },
	shops: { Spot },
	doors: { Spot },
	food: { string },
}

local Worlds = {}
Worlds.list = {} :: { [string]: World }

local function add(id: string, name: string, origin: Vector3, food: { string })
	Worlds.list[id] = {
		id = id,
		name = name,
		origin = origin,
		ready = false,
		spawn = CFrame.new(origin + Vector3.new(0, 5, 0)),
		landmarks = {},
		shops = {},
		doors = {},
		food = food,
	}
end

add("hub", "World Bike Hub", Config.HubOrigin, {})
for _, c in Config.Cities do
	add(c.id, c.name, c.origin, c.food)
end

--- Fill a world's data from its build list.
function Worlds.fill(id: string, b: any)
	local w = Worlds.list[id]
	local o = w.origin
	w.spawn = CFrame.new(o + Vector3.new(b.spawn.x, b.spawn.y, b.spawn.z)) * CFrame.Angles(0, b.spawn.yaw or 0, 0)
	for _, l in b.landmarks do
		table.insert(w.landmarks, { id = id .. ":" .. l.id, name = l.name, pos = o + Vector3.new(l.x, l.y, l.z), radius = l.radius, fact = l.fact })
	end
	for _, s in b.shops do
		table.insert(w.shops, { pos = o + Vector3.new(s.x, s.y, s.z), label = s.label })
	end
	for _, d in b.doors do
		table.insert(w.doors, { pos = o + Vector3.new(d.x, d.y, d.z) })
	end
end

--- Which world is this position in?
function Worlds.at(pos: Vector3): World?
	local best: World? = nil
	local bestD = math.huge
	for _, w in Worlds.list do
		local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(w.origin.X, 0, w.origin.Z)).Magnitude
		if d < bestD then
			bestD = d
			best = w
		end
	end
	if bestD < 4000 then
		return best
	end
	return nil
end

return Worlds
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="25">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CharacterJumpHeight">7.2</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--!strict
-- Spins wheels and pedals and turns the handlebars of every player's bike.
-- Our own bike uses the physics state; other bikes are animated from how
-- they move. Head lamps switch on at night.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)

local M = Config.M

local Animator = {}

type Rig = {
	root: BasePart,
	rear: Motor6D?,
	front: Motor6D?,
	steerJoint: Motor6D?,
	crank: Motor6D?,
	beam: SpotLight?,
	rearLight: BasePart?,
	wheelR: number, -- metres
	lastPos: Vector3?,
	lastYaw: number,
	speed: number,
	steer: number,
	wheel: number,
	crankA: number,
}

local rigs: { [Model]: Rig } = {}

local function makeRig(m: Model): Rig?
	local root = m.PrimaryPart or m:FindFirstChild("Root") :: BasePart?
	if not root then
		return nil
	end
	local steerPart = m:FindFirstChild("Steer")
	local wheelPart = m:FindFirstChild("Wheel") :: BasePart?
	local lamp = m:FindFirstChild("HeadLamp")
	return {
		root = root,
		rear = root:FindFirstChild("RearWheel") :: Motor6D?,
		crank = root:FindFirstChild("Crank") :: Motor6D?,
		steerJoint = root:FindFirstChild("SteerJoint") :: Motor6D?,
		front = if steerPart then steerPart:FindFirstChild("FrontWheel") :: Motor6D? else nil,
		beam = if lamp then lamp:FindFirstChild("Beam") :: SpotLight? else nil,
		rearLight = m:FindFirstChild("RearLight") :: BasePart?,
		wheelR = if wheelPart then wheelPart.Size.Y / 2 / M else 0.35,
		lastPos = nil,
		lastYaw = 0,
		speed = 0,
		steer = 0,
		wheel = 0,
		crankA = 0,
	}
end

local function yawOf(cf: CFrame): number
	local lv = cf.LookVector
	return math.atan2(-lv.X, -lv.Z)
end

local function update(dt: number)
	local folder = Workspace:FindFirstChild("Bikes")
	if not folder or dt <= 0 then
		return
	end
	local mine = State.ride.model
	local night = State.night
	for _, child in folder:GetChildren() do
		if not child:IsA("Model") then
			continue
		end
		local rig = rigs[child]
		if not rig then
			local made = makeRig(child)
			if not made then
				continue
			end
			rig = made
			rigs[child] = made
		end
		local r = rig :: Rig
		local wheelA, crankA, steer
		if child == mine then
			local ride = State.ride
			wheelA, crankA, steer = ride.wheel, ride.crank, ride.steer
		else
			-- estimate from movement
			local cf = r.root.CFrame
			local p = cf.Position
			local y = yawOf(cf)
			local last = r.lastPos
			if last then
				local delta = p - last
				local flat = Vector3.new(delta.X, 0, delta.Z)
				local sgn = if flat:Dot(cf.LookVector) >= 0 then 1 else -1
				local v = sgn * flat.Magnitude / M / dt
				if v ~= v or math.abs(v) > 40 then
					v = 0
				end
				r.speed += (v - r.speed) * math.min(1, dt * 8)
				local dy = (y - r.lastYaw + math.pi) % (2 * math.pi) - math.pi
				local yawRate = dy / dt
				local target = 0
				if math.abs(r.speed) > 0.8 then
					target = math.clamp(math.atan(-yawRate * 1.1 / r.speed), -0.6, 0.6)
				end
				r.steer += (target - r.steer) * math.min(1, dt * 6)
			end
			r.lastPos = p
			r.lastYaw = y
			r.wheel += r.speed * dt / r.wheelR
			if r.speed > 0.5 then
				r.crankA += r.speed / 4.3 * math.pi * 2 * dt
			end
			wheelA, crankA, steer = r.wheel, r.crankA, r.steer
		end
		if r.rear then
			r.rear.Transform = CFrame.Angles(-wheelA, 0, 0)
		end
		if r.front then
			r.front.Transform = CFrame.Angles(-wheelA, 0, 0)
		end
		if r.crank then
			r.crank.Transform = CFrame.Angles(-crankA, 0, 0)
		end
		if r.steerJoint then
			r.steerJoint.Transform = CFrame.Angles(0, -steer, 0)
		end
		if r.beam and r.beam.Enabled ~= night then
			r.beam.Enabled = night
			if r.rearLight then
				r.rearLight.Material = if night then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
	for m in rigs do
		if not m.Parent then
			rigs[m] = nil
		end
	end
end

function Animator.init()
	RunService.PreSimulation:Connect(update)
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">BikeCamera</string>
            <string name="Source"><![CDATA[--!strict
-- Camera while riding: a smooth chase camera (drag or right-click to look
-- around, scroll or pinch to zoom) or a first-person view over the
-- handlebars. Press C (or the camera button) to switch.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local BikeCamera = {}

local player = State.player
local active = false
local camYaw = 0
local orbit = 0
local orbitPitch = 0
local zoom = 17
local lastLook = 0
local dragging = false
local lastPan: Vector2? = nil
local shake = 0
local hidden = false

local camParams = RaycastParams.new()
camParams.FilterType = Enum.RaycastFilterType.Exclude
camParams.IgnoreWater = true

local function angleLerp(a: number, b: number, t: number): number
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * t
end

local function setCharacterHidden(hide: boolean)
	if hidden == hide then
		return
	end
	hidden = hide
	local char = player.Character
	if not char then
		return
	end
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = if hide then 1 else 0
		end
	end
end

--- A little shake when you bump into something.
function BikeCamera.bump(strength: number)
	shake = math.max(shake, math.clamp(strength / 10, 0.1, 0.5))
end

local function update(dt: number)
	local camera = Workspace.CurrentCamera
	local ride = State.ride
	local m = ride.model
	local r = m and m.PrimaryPart
	if not ride.onBike or not r then
		if active then
			active = false
			setCharacterHidden(false)
			camera.CameraType = Enum.CameraType.Custom
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				camera.CameraSubject = hum
			end
			camera.FieldOfView = 70
		end
		return
	end
	if not active then
		active = true
		camera.CameraType = Enum.CameraType.Scriptable
		camYaw = ride.yaw
		orbit, orbitPitch = 0, 0
	end
	local ignore: { Instance } = { r }
	if m then
		table.insert(ignore, m)
	end
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local traffic = Workspace:FindFirstChild("Traffic")
	if traffic then
		table.insert(ignore, traffic)
	end
	camParams.FilterDescendantsInstances = ignore

	-- swing back behind the bike when the player stops looking around
	if os.clock() - lastLook > 1.6 and not dragging then
		local k = 1 - math.exp(-3 * dt)
		orbit += (0 - orbit) * k
		orbitPitch += (0 - orbitPitch) * k
	end
	-- right thumbstick looks around
	for _, input: InputObject in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if input.KeyCode == Enum.KeyCode.Thumbstick2 and input.Position.Magnitude > 0.2 then
			orbit -= input.Position.X * 2.5 * dt
			orbitPitch = math.clamp(orbitPitch - input.Position.Y * 1.5 * dt, -0.25, 0.9)
			lastLook = os.clock()
		end
	end

	local speed = math.abs(ride.speed)
	local shakeOffset = Vector3.zero
	if shake > 0.01 then
		shakeOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shake
		shake *= math.exp(-8 * dt)
	end

	if State.cameraMode == "first" then
		setCharacterHidden(true)
		local cf = CFrame.new(r.Position)
			* CFrame.Angles(0, ride.yaw, 0)
			* CFrame.Angles(0, 0, -ride.lean * 0.5)
			* CFrame.new(0, 4.4, 0.7)
			* CFrame.Angles(-0.2 - orbitPitch * 0.6, orbit, 0)
		camera.CFrame = cf * CFrame.new(shakeOffset)
		camera.FieldOfView = 76 + math.min(speed, 14) * 0.7
	else
		setCharacterHidden(false)
		camYaw = angleLerp(camYaw, ride.yaw, 1 - math.exp(-4 * dt))
		local target = r.Position + Vector3.new(0, 3.4, 0)
		local yawC = camYaw + orbit
		local pitchC = 0.26 + orbitPitch
		local dist = zoom + math.min(speed, 12) * 0.25
		local camPos = target + (CFrame.Angles(0, yawC, 0) * CFrame.Angles(-pitchC, 0, 0)):VectorToWorldSpace(Vector3.new(0, 0, dist))
		local hit = Workspace:Raycast(target, camPos - target, camParams)
		if hit then
			camPos = hit.Position + (target - camPos).Unit * 0.8
		end
		camera.CFrame = CFrame.lookAt(camPos, target) * CFrame.new(shakeOffset)
		camera.FieldOfView = 70 + math.min(speed, 14) * 0.8
	end
end

function BikeCamera.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 and State.ride.onBike then
			dragging = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and dragging then
			dragging = false
			lastLook = os.clock()
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		if not State.ride.onBike then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
			orbit -= input.Delta.X * 0.008
			orbitPitch = math.clamp(orbitPitch + input.Delta.Y * 0.006, -0.25, 0.9)
			lastLook = os.clock()
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			zoom = math.clamp(zoom - input.Position.Z * 2, 8, 40)
		end
	end)
	-- touch: drag on the screen to look around, pinch to zoom
	UserInputService.TouchPan:Connect(function(_touches: { Vector2 }, translation: Vector2, _velocity: Vector2, inputState: Enum.UserInputState, processed: boolean)
		if processed or not State.ride.onBike then
			lastPan = nil
			return
		end
		if inputState == Enum.UserInputState.Begin or lastPan == nil then
			lastPan = translation
			return
		end
		local last = lastPan :: Vector2
		local delta = translation - last
		lastPan = translation
		orbit -= delta.X * 0.01
		orbitPitch = math.clamp(orbitPitch + delta.Y * 0.006, -0.25, 0.9)
		lastLook = os.clock()
		if inputState == Enum.UserInputState.End then
			lastPan = nil
		end
	end)
	local pinchStart = zoom
	UserInputService.TouchPinch:Connect(function(_touches: { Vector2 }, scale: number, _velocity: number, inputState: Enum.UserInputState, processed: boolean)
		if processed or not State.ride.onBike then
			return
		end
		if inputState == Enum.UserInputState.Begin then
			pinchStart = zoom
		end
		zoom = math.clamp(pinchStart / math.max(scale, 0.1), 8, 40)
	end)
	RunService:BindToRenderStep("BikeCamera", Enum.RenderPriority.Camera.Value + 1, update)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		hidden = false
	end)
end

return BikeCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">BikeController</string>
            <string name="Source"><![CDATA[--!strict
-- Rides the player's bike. The server gives the bike to this client (network
-- ownership); every frame we run the bike physics, follow the ground with
-- raycasts, slide along walls, and move the bike's rigid align targets.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local BikePhysics = require(Shared.BikePhysics)
local BikeModel = require(Shared.BikeModel)
local State = require(script.Parent.State)
local Sfx = require(script.Parent.Sfx)

local M = Config.M
local GRAVITY = 9.81 * M * 2 -- studs/s^2 (a bit stronger than real, feels snappier)
local STEP_UP = 1.6 -- highest kerb (studs) you can ride up
local SPHERE_R = 1.1
local SPHERE_Y = 2.4

local player = State.player

local BikeController = {}
BikeController.splashed = Instance.new("BindableEvent")
BikeController.bumped = Instance.new("BindableEvent")

-- the ride ---------------------------------------------------------------------
local model: Model? = nil
local root: BasePart? = nil
local alignPos: AlignPosition? = nil
local alignRot: AlignOrientation? = nil
local params: BikePhysics.Params = { topSpeed = 7.5, power = 1, handling = 1, wheel = 0.35 }
local state = BikePhysics.newState()
local pos = Vector3.zero -- ground point under the bike
local yaw = 0
local pitch = 0
local vy = 0
local holdUntil = 0 -- wait for the ground to stream in until this time
local splashing = false
local safe: { { pos: Vector3, yaw: number } } = {}
local lastSafe = 0

-- input
local boostKey = false
local triggerGas = 0
local triggerBrake = 0
local lastBell = 0

local controls: any = nil
local function getControls(): any
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local ps = player:WaitForChild("PlayerScripts")
		local pm = require(ps:WaitForChild("PlayerModule") :: ModuleScript) :: any
		return pm:GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

-- raycasts ignore bikes, characters and the city traffic
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = false
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true

local function refreshFilter()
	local list: { Instance } = {}
	for _, name in { "Bikes", "Traffic", "LocalEffects" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = list
	wallParams.FilterDescendantsInstances = list
end

local function groundAt(p: Vector3, fromY: number): RaycastResult?
	return Workspace:Raycast(Vector3.new(p.X, fromY, p.Z), Vector3.new(0, -80, 0), groundParams)
end

local function isWater(hit: RaycastResult?): boolean
	return hit ~= nil and hit.Material == Enum.Material.Water
end

local function bikeDef(id: any): Config.BikeDef
	for _, b in Config.Bikes do
		if b.id == id then
			return b
		end
	end
	return Config.Bikes[1]
end

local function poseCFrame(): CFrame
	return CFrame.new(pos + Vector3.new(0, BikeModel.RootHeight, 0))
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(pitch, 0, 0)
		* CFrame.Angles(0, 0, -state.lean)
end

--- Put the bike somewhere (a city spawn, or back on the road after a splash).
function BikeController.teleport(p: Vector3, newYaw: number, keepSafe: boolean?)
	pos = p
	yaw = newYaw
	pitch = 0
	vy = 0
	state.speed = 0
	state.lean = 0
	state.steer = 0
	holdUntil = os.clock() + 8
	if not keepSafe then
		table.clear(safe)
	end
	local r = root
	if r then
		local cf = poseCFrame()
		r.CFrame = cf -- moves the whole bike and the rider with it
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		if alignPos then
			alignPos.Position = cf.Position
		end
		if alignRot then
			alignRot.CFrame = cf
		end
	end
end

--- Back to the last safe spot on the road (also used by the "I'm stuck" button).
function BikeController.unstuck()
	local s = safe[math.max(1, #safe - 4)]
	if s then
		BikeController.teleport(s.pos, s.yaw, true)
	end
end

local function splash(waterY: number)
	if splashing then
		return
	end
	splashing = true
	state.speed = 0
	local r = root
	Sfx.play("Splash", r, 0.9)
	BikeController.splashed:Fire(Vector3.new(pos.X, waterY, pos.Z))
	task.delay(1.2, function()
		splashing = false
		if not model then
			return
		end
		local s = safe[math.max(1, #safe - 4)]
		if s then
			BikeController.teleport(s.pos, s.yaw, true)
		else
			BikeController.teleport(pos + Vector3.new(0, 20, 0), yaw, true)
		end
	end)
end

-- the physics step ----------------------------------------------------------------
local function step(dt: number)
	local r, ap, ao = root, alignPos, alignRot
	if not model or not r or not ap or not ao then
		return
	end
	if splashing then
		-- sink slowly while the splash plays
		pos -= Vector3.new(0, 4 * dt, 0)
		local cf = poseCFrame()
		ap.Position = cf.Position
		ao.CFrame = cf
		return
	end
	dt = math.min(dt, 1 / 20)

	-- input: the default controls give us the thumbstick / WASD / gamepad stick
	local mv = Vector3.zero
	local c = controls -- loaded in init(), never waited for here
	if c then
		local ok, v = pcall(function()
			return c:GetMoveVector()
		end)
		if ok and typeof(v) == "Vector3" then
			mv = v
		end
	end
	local throttle = math.max(math.clamp(-mv.Z, 0, 1), triggerGas)
	local brake = math.max(math.clamp(mv.Z, 0, 1), triggerBrake)
	local steer = math.clamp(mv.X, -1, 1)
	if UserInputService:GetFocusedTextBox() then
		throttle, brake, steer = 0, 0, 0
	end
	local boost = boostKey or State.touchBoost

	-- what are we riding on?
	local fwd = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local here = groundAt(pos, pos.Y + 1.8)
	local onGround = here ~= nil and not isWater(here) and pos.Y - here.Position.Y < 0.35
	local crr = 0.008
	local slope = 0
	if here and onGround then
		crr = BikePhysics.Surfaces[here.Material.Name] or 0.008
		local f = groundAt(pos + fwd * 1.6, pos.Y + 1.8)
		local b = groundAt(pos - fwd * 1.6, pos.Y + 1.8)
		if f and b and not isWater(f) and not isWater(b) then
			slope = math.clamp((f.Position.Y - b.Position.Y) / 3.2, -0.35, 0.35)
		end
	end
	BikePhysics.step(state, params, {
		throttle = if onGround then throttle else 0,
		brake = brake,
		steer = steer,
		boost = boost,
	}, {
		crr = if onGround then crr else 0,
		slope = if onGround then slope else 0,
		grip = if State.rain then 0.75 else 1,
	}, 0, dt)
	yaw += state.yawRate * dt
	fwd = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))

	-- move, sliding along walls
	local d = fwd * state.speed * M * dt
	local move = d
	if d.Magnitude > 1e-4 then
		local center = pos + Vector3.new(0, SPHERE_Y, 0)
		local hit = Workspace:Spherecast(center, SPHERE_R, d, wallParams)
		if hit and hit.Normal.Y < 0.55 then
			local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
			if n.Magnitude > 1e-3 then
				n = n.Unit
				local dir = d.Unit
				move = dir * math.max(0, hit.Distance - 0.05)
				local rest = d - move
				local slide = rest - n * rest:Dot(n)
				if slide.Magnitude > 1e-4 and not Workspace:Spherecast(center + move, SPHERE_R, slide, wallParams) then
					move += slide
				end
				local into = -dir:Dot(n) -- 1 = straight into the wall
				if into > 0.2 then
					local before = math.abs(state.speed)
					state.speed *= math.clamp(1.15 - into, 0, 1)
					if into > 0.6 and before > 3 then
						Sfx.play("Bump", r, 0.5)
						BikeController.bumped:Fire(before)
					end
				end
			end
		end
	end

	-- follow the ground
	local newPos = pos + move
	local y = pos.Y
	local g = groundAt(newPos, pos.Y + 1.8)
	if g then
		local gy = g.Position.Y
		if isWater(g) then
			vy -= GRAVITY * dt
			y += vy * dt
			if y < gy - 1.5 then
				pos = Vector3.new(newPos.X, y, newPos.Z)
				splash(gy)
				return
			end
		elseif gy > y + STEP_UP then
			-- too high to ride onto: treat it like a wall
			newPos = pos
			state.speed = 0
		elseif gy >= y - 0.05 then
			y = if gy - y > 0.25 then y + (gy - y) * math.min(1, dt * 18) else gy
			vy = 0
			holdUntil = 0
		elseif vy >= -2 and y - gy < 0.15 + math.abs(state.speed) * M * dt * 0.7 then
			-- riding down a slope: stay on it
			y = gy
			vy = 0
		else
			vy -= GRAVITY * dt
			y = math.max(gy, y + vy * dt)
			if y <= gy + 1e-3 then
				vy = 0
			end
		end
		pitch += (math.atan(slope) - pitch) * math.min(1, dt * 10)
	elseif os.clock() > holdUntil then
		-- nothing below at all
		vy -= GRAVITY * dt
		y += vy * dt
		if y < -150 then
			BikeController.unstuck()
			return
		end
	end
	pos = Vector3.new(newPos.X, y, newPos.Z)

	-- remember safe spots to come back to after a splash
	if onGround and os.clock() - lastSafe > 0.4 then
		lastSafe = os.clock()
		table.insert(safe, { pos = pos, yaw = yaw })
		if #safe > 15 then
			table.remove(safe, 1)
		end
	end

	local cf = poseCFrame()
	ap.Position = cf.Position
	ao.CFrame = cf

	local ride = State.ride
	ride.speed = state.speed
	ride.stamina = state.stamina
	ride.steer = state.steer
	ride.lean = state.lean
	ride.crank = state.crank
	ride.wheel = state.wheel
	ride.boosting = boost and state.stamina > 0.02 and throttle > 0
	ride.pos = pos
	ride.yaw = yaw
end

-- actions while riding ------------------------------------------------------------------
local function ringBell()
	if os.clock() - lastBell < 0.35 then
		return
	end
	lastBell = os.clock()
	local m = model
	local bell = m and m:FindFirstChild("Bell", true) :: BasePart?
	Sfx.bell(bell)
	State.remote("Bell"):FireServer()
end
BikeController.ringBell = ringBell

local function onAction(name: string, inputState: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
	if name == "BikeBell" then
		if inputState == Enum.UserInputState.Begin then
			ringBell()
		end
	elseif name == "BikeBoost" then
		boostKey = inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change
	elseif name == "BikeCamera" then
		if inputState == Enum.UserInputState.Begin then
			State.cameraMode = if State.cameraMode == "chase" then "first" else "chase"
		end
	end
	return Enum.ContextActionResult.Sink
end

local function setJump(enabled: boolean)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, enabled)
	end
end

local function bindActions()
	local high = Enum.ContextActionPriority.High.Value + 10
	-- Space rings the bell instead of jumping off the bike
	ContextActionService:BindActionAtPriority("BikeBell", onAction, false, high, Enum.KeyCode.Space, Enum.KeyCode.B, Enum.KeyCode.ButtonY)
	ContextActionService:BindActionAtPriority("BikeBoost", onAction, false, high, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonX)
	ContextActionService:BindActionAtPriority("BikeCamera", onAction, false, high, Enum.KeyCode.C, Enum.KeyCode.ButtonR3)
end

local function unbindActions()
	for _, name in { "BikeBell", "BikeBoost", "BikeCamera" } do
		ContextActionService:UnbindAction(name)
	end
	boostKey = false
end

-- attaching to the bike the server gave us -------------------------------------------
local function detach()
	model, root, alignPos, alignRot = nil, nil, nil, nil
	splashing = false
	unbindActions()
	setJump(true)
	local ride = State.ride
	ride.onBike = false
	ride.model = nil
	ride.speed = 0
	ride.boosting = false
end

local function attach(m: Model)
	local r = m:WaitForChild("Root", 10) :: BasePart?
	if not r then
		return
	end
	local ap = r:WaitForChild("DrivePosition", 10) :: AlignPosition?
	local ao = r:WaitForChild("DriveOrientation", 10) :: AlignOrientation?
	local ref = player:FindFirstChild("Bike") :: ObjectValue?
	if not ap or not ao or not ref or ref.Value ~= m then
		return
	end
	model, root, alignPos, alignRot = m, r, ap, ao
	local def = bikeDef(m:GetAttribute("BikeId"))
	params = { topSpeed = def.topSpeed, power = def.power, handling = def.handling, wheel = def.wheel }
	local keepStamina = state.stamina
	state = BikePhysics.newState()
	state.stamina = keepStamina
	local cf = r.CFrame
	pos = cf.Position - Vector3.new(0, BikeModel.RootHeight, 0)
	local lv = cf.LookVector
	yaw = math.atan2(-lv.X, -lv.Z)
	pitch, vy = 0, 0
	holdUntil = os.clock() + 4
	table.clear(safe)
	refreshFilter()
	bindActions()
	setJump(false)
	local ride = State.ride
	ride.onBike = true
	ride.model = m
	ride.pos = pos
	ride.yaw = yaw
end

function BikeController.init()
	task.spawn(getControls)
	local ref = player:WaitForChild("Bike") :: ObjectValue
	local function changed()
		local v = ref.Value
		detach()
		if v and v:IsA("Model") then
			task.spawn(attach, v)
		end
	end
	ref.Changed:Connect(changed)
	changed()

	player.CharacterAdded:Connect(function()
		if model then
			setJump(false)
		end
	end)

	-- gamepad triggers for pedalling and braking
	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			triggerGas = input.Position.Z
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			triggerBrake = input.Position.Z
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			triggerGas = 0
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			triggerBrake = 0
		end
	end)

	State.remote("Teleport").OnClientEvent:Connect(function(cf: CFrame)
		local lv = cf.LookVector
		BikeController.teleport(cf.Position, math.atan2(-lv.X, -lv.Z))
	end)

	RunService.PreSimulation:Connect(step)
	task.spawn(function()
		while true do
			task.wait(1)
			refreshFilter()
		end
	end)
end

return BikeController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Local eye candy and pick-ups: street lights and glowing windows at night,
-- the sparkling Eiffel Tower, windmill sails, carousels, spinning coins
-- (and collecting them), rain, delivery markers and splashes.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)
local Sfx = require(script.Parent.Sfx)

local Effects = {}

local player = Players.LocalPlayer
local localFolder = Instance.new("Folder")
localFolder.Name = "LocalEffects"
localFolder.Parent = Workspace

-- Night lights ------------------------------------------------------------------------
local WINDOW_GLOW = { Color3.fromRGB(255, 214, 140), Color3.fromRGB(255, 196, 120), Color3.fromRGB(255, 230, 170) }

type Orig = { color: Color3, material: Enum.Material, transparency: number }
local orig: { [BasePart]: Orig } = {}
local pending: { BasePart } = {}

local function remember(p: BasePart): Orig
	local o = orig[p]
	if not o then
		o = { color = p.Color, material = p.Material, transparency = p.Transparency }
		orig[p] = o
	end
	return o :: Orig
end

local function applyNight(p: BasePart)
	if not p.Parent then
		return
	end
	local night = State.night
	local o = remember(p)
	if CollectionService:HasTag(p, "NightWindow") then
		if night then
			p.Material = Enum.Material.Neon
			p.Color = WINDOW_GLOW[(#p.Name + math.floor(p.Position.X)) % #WINDOW_GLOW + 1]
		else
			p.Material = o.material
			p.Color = o.color
		end
	elseif CollectionService:HasTag(p, "StreetLight") or CollectionService:HasTag(p, "BridgeBulb") then
		p.Material = if night then Enum.Material.Neon else o.material
		local light = p:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = night
		end
	elseif CollectionService:HasTag(p, "Sparkle") then
		p.Transparency = if night then 0 else 1
	end
end

local NIGHT_TAGS = { "NightWindow", "StreetLight", "BridgeBulb", "Sparkle" }

local function queueAll()
	for _, tag in NIGHT_TAGS do
		for _, inst in CollectionService:GetTagged(tag) do
			if inst:IsA("BasePart") then
				table.insert(pending, inst)
			end
		end
	end
end

-- Moving things (sails, carousels, sparkles, beacons) --------------------------------------
local sails: { [BasePart]: Vector3 } = {} -- part -> hub position
local spinners: { [BasePart]: boolean } = {}
local sparkles: { [BasePart]: boolean } = {}
local beacons: { [BasePart]: boolean } = {}

-- Coins -------------------------------------------------------------------------------
type Coin = { base: Vector3, id: string, phase: number }
local coins: { [BasePart]: Coin } = {}
local hiddenUntil: { [string]: number } = {}
local COIN_RESPAWN = 40

local function addCoin(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local id = inst:GetAttribute("Id")
	if type(id) ~= "string" then
		return
	end
	coins[inst] = { base = inst.Position, id = id, phase = (inst.Position.X + inst.Position.Z) * 0.37 }
	local hide = hiddenUntil[id]
	inst.Transparency = if hide and hide > os.clock() then 1 else 0
end

local function collectorPos(): Vector3?
	local ride = State.ride
	if ride.onBike then
		return ride.pos + Vector3.new(0, 2.5, 0)
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if hrp then hrp.Position else nil
end

local coinParts: { BasePart } = {}
local coinCFrames: { CFrame } = {}

local function updateCoins()
	local t = os.clock()
	local cam = Workspace.CurrentCamera.CFrame.Position
	local me = collectorPos()
	table.clear(coinParts)
	table.clear(coinCFrames)
	for part, c in coins do
		if not part.Parent then
			coins[part] = nil
			continue
		end
		local hide = hiddenUntil[c.id]
		if hide then
			if hide > t then
				continue
			end
			hiddenUntil[c.id] = nil
			part.Transparency = 0
		end
		if me and (c.base - me).Magnitude < 6 then
			hiddenUntil[c.id] = t + COIN_RESPAWN
			part.Transparency = 1
			Sfx.play("Coin", nil, 0.5, 0.95 + math.random() * 0.1)
			State.remote("CollectCoin"):FireServer(c.id)
			continue
		end
		if (c.base - cam).Magnitude < 250 then
			table.insert(coinParts, part)
			table.insert(coinCFrames, CFrame.new(c.base + Vector3.new(0, math.sin(t * 2 + c.phase) * 0.35, 0)) * CFrame.Angles(0, t * 3 + c.phase, 0))
		end
	end
	if #coinParts > 0 then
		Workspace:BulkMoveTo(coinParts, coinCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Rain ------------------------------------------------------------------------------------
local rainPart: Part? = nil
local rainEmitter: ParticleEmitter? = nil

local function makeRain()
	local p = Instance.new("Part")
	p.Name = "Rain"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(160, 1, 160)
	p.Parent = localFolder
	local e = Instance.new("ParticleEmitter")
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.9, 1.1)
	e.Speed = NumberRange.new(90, 110)
	e.Size = NumberSequence.new(0.12)
	e.Transparency = NumberSequence.new(0.35)
	e.Color = ColorSequence.new(Color3.fromRGB(190, 205, 225))
	e.LightInfluence = 1
	e.Orientation = Enum.ParticleOrientation.VelocityParallel
	e.Parent = p
	rainPart = p
	rainEmitter = e
end

local function updateRain(dt: number)
	local city = State.city()
	local raining = Workspace:GetAttribute("Rain_" .. city) == true
	State.rain = raining
	local e = rainEmitter
	local p = rainPart
	if not e or not p then
		return
	end
	local target = if raining then 900 else 0
	e.Rate += (target - e.Rate) * math.min(1, dt * 0.8)
	if e.Rate < 5 then
		e.Rate = 0
	end
	e.Enabled = e.Rate > 0
	p.CFrame = CFrame.new(Workspace.CurrentCamera.CFrame.Position + Vector3.new(0, 45, 0))
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		local want = if raining then 0.42 else 0.28
		atmo.Density += (want - atmo.Density) * math.min(1, dt * 0.3)
	end
	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		local want = if raining then 0.9 else 0.55
		clouds.Cover += (want - clouds.Cover) * math.min(1, dt * 0.3)
	end
end

-- Delivery marker ---------------------------------------------------------------------
local marker: Part? = nil

local function updateDeliveryMarker()
	if marker then
		marker:Destroy()
		marker = nil
	end
	local d = State.delivery
	if not d then
		return
	end
	local p = Instance.new("Part")
	p.Name = "DeliveryMarker"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 200, 40)
	p.Transparency = 0.35
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(70, 4, 4)
	p.CFrame = CFrame.new(d.to + Vector3.new(0, 35, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, -26, 0)
	gui.AlwaysOnTop = true
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Text = "📦 Deliver here!"
	label.Parent = gui
	p.Parent = localFolder
	marker = p
end

-- Splash ------------------------------------------------------------------------------
local function splashAt(at: Vector3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(4, 0.2, 4)
	p.CFrame = CFrame.new(at)
	p.Parent = localFolder
	local e = Instance.new("ParticleEmitter")
	e.EmissionDirection = Enum.NormalId.Top
	e.SpreadAngle = Vector2.new(35, 35)
	e.Speed = NumberRange.new(18, 30)
	e.Acceleration = Vector3.new(0, -60, 0)
	e.Lifetime = NumberRange.new(0.6, 1)
	e.Size = NumberSequence.new(0.6, 0.1)
	e.Color = ColorSequence.new(Color3.fromRGB(210, 235, 255))
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Rate = 0
	e.Parent = p
	e:Emit(60)
	task.delay(2, function()
		p:Destroy()
	end)
end
Effects.splashAt = splashAt

-- Main loop ---------------------------------------------------------------------------------
local function onRender(dt: number)
	local t = os.clock()
	-- day / night
	local clock = Lighting.ClockTime
	local night = clock >= 18.25 or clock < 6.25
	if night ~= State.night then
		State.night = night
		queueAll()
	end
	for _ = 1, 400 do
		local p = table.remove(pending)
		if not p then
			break
		end
		applyNight(p)
	end
	-- windmill sails turn around their hub
	for part, hub in sails do
		if not part.Parent then
			sails[part] = nil
			continue
		end
		local axis = part.CFrame.ZVector
		part.CFrame = CFrame.new(hub) * CFrame.fromAxisAngle(axis, dt * 0.6) * CFrame.new(-hub) * part.CFrame
	end
	for part in spinners do
		if not part.Parent then
			spinners[part] = nil
			continue
		end
		part.CFrame *= CFrame.Angles(dt * 0.7, 0, 0)
	end
	if night then
		for part in sparkles do
			if part.Parent then
				part.Transparency = if math.random() < 0.35 then 0 else 0.9
			else
				sparkles[part] = nil
			end
		end
	end
	local blink = night and (t % 1.5) < 0.6
	for part in beacons do
		if part.Parent then
			part.Transparency = if night and not blink then 0.8 else 0
		else
			beacons[part] = nil
		end
	end
	for _, ring in CollectionService:GetTagged("ShopMarker") do
		if ring:IsA("BasePart") then
			ring.Transparency = 0.45 + math.sin(t * 3) * 0.15
		end
	end
	updateCoins()
	updateRain(dt)
	if marker then
		marker.Transparency = 0.3 + math.sin(t * 4) * 0.15
	end
end

local function watch(tag: string, added: (Instance) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(added, inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(added)
end

function Effects.init(onSplash: RBXScriptSignal?)
	makeRain()
	for _, tag in NIGHT_TAGS do
		watch(tag, function(inst)
			if inst:IsA("BasePart") then
				remember(inst)
				if State.night or tag == "Sparkle" then
					table.insert(pending, inst)
				end
			end
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
			if inst:IsA("BasePart") then
				orig[inst] = nil
			end
		end)
	end
	watch("Sail", function(inst)
		if inst:IsA("BasePart") then
			sails[inst] = inst.Position - inst.CFrame.UpVector * (inst.Size.Y / 2)
		end
	end)
	watch("Spin", function(inst)
		if inst:IsA("BasePart") then
			spinners[inst] = true
		end
	end)
	watch("Sparkle", function(inst)
		if inst:IsA("BasePart") then
			sparkles[inst] = true
		end
	end)
	watch("NightBeacon", function(inst)
		if inst:IsA("BasePart") then
			beacons[inst] = true
		end
	end)
	watch("Coin", addCoin)
	State.deliveryChanged.Event:Connect(updateDeliveryMarker)
	if onSplash then
		onSplash:Connect(function(at: Vector3)
			splashAt(at)
		end)
	end
	RunService.RenderStepped:Connect(onRender)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- The on-screen display: coins, landmarks, speed and boost, messages, the
-- landmark card, the delivery panel with its arrow, and the big buttons.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)
local Sfx = require(script.Parent.Sfx)

local C = Ui.Colors

local Hud = {}

export type Callbacks = {
	shop: () -> (),
	travel: () -> (),
	bike: () -> (),
	camera: () -> (),
	bell: () -> (),
}

local gui: ScreenGui
local coinLabel: TextLabel
local coinPill: Frame
local landmarkLabel: TextLabel
local toastList: Frame
local speedLabel: TextLabel
local speedFrame: Frame
local staminaFill: Frame
local deliveryFrame: Frame
local deliveryTitle: TextLabel
local deliveryInfo: TextLabel
local deliveryArrow: TextLabel
local banner: TextLabel
local splashLabel: TextLabel
local mobileButtons: Frame
local helpLabel: TextLabel

local shownCoins = 0
local targetCoins = 0

local CITY_FLAGS: { [string]: string } = {
	hub = "🌍",
	amsterdam = "🇳🇱",
	paris = "🇫🇷",
	newyork = "🇺🇸",
}
Hud.flags = CITY_FLAGS

local function cityName(id: string): string
	if id == "hub" then
		return "World Bike Hub"
	end
	for _, c in Config.Cities do
		if c.id == id then
			return c.name
		end
	end
	return id
end
Hud.cityName = cityName

--- A message that pops in at the top and fades away.
function Hud.toast(text: string, kind: string?)
	local color = if kind == "good" then C.green elseif kind == "bad" then C.red elseif kind == "city" then C.blue else C.panelDark
	local f = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.1,
		Parent = toastList,
	}) :: Frame
	Ui.corner(f, 12)
	Ui.stroke(f, Color3.fromRGB(20, 24, 40), 2)
	Ui.label({ Size = UDim2.fromScale(1, 1), Text = text, MaxTextSize = 24, TextStrokeTransparency = 0.8, Parent = f })
	Ui.pad(f, 6)
	Ui.pop(f, 1.1)
	task.delay(4, function()
		Ui.tween(f, 0.4, { BackgroundTransparency = 1 })
		for _, d in f:GetDescendants() do
			if d:IsA("TextLabel") then
				Ui.tween(d, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
			elseif d:IsA("UIStroke") then
				Ui.tween(d, 0.4, { Transparency = 1 })
			end
		end
		task.wait(0.45)
		f:Destroy()
	end)
	-- keep at most 4 messages
	local frames = {}
	for _, ch in toastList:GetChildren() do
		if ch:IsA("Frame") then
			table.insert(frames, ch)
		end
	end
	if #frames > 4 then
		frames[1]:Destroy()
	end
end

--- "+5" flying up from the coin counter.
function Hud.coins(amount: number, reason: string?)
	local big = reason == "landmark" or reason == "delivery" or reason == "daily"
	local l = Ui.label({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 190, 0, 30),
		Size = UDim2.fromOffset(160, if big then 50 else 34),
		Text = "+" .. amount .. " 🪙",
		TextColor3 = C.gold,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = if big then 44 else 30,
		Parent = gui,
	})
	Ui.tween(l, 1.2, { Position = UDim2.new(0, 190, 0, -10), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1.3, function()
		l:Destroy()
	end)
	if reason ~= "coin" then
		Sfx.play("Coin", nil, 0.5, 0.8)
	end
end

--- The "you found a landmark" card.
function Hud.landmark(info: { [string]: any })
	Sfx.play("Landmark", nil, 0.8)
	local card = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0.9, 0, 0, 210),
		BackgroundColor3 = C.panel,
		Parent = gui,
	}) :: Frame
	Ui.new("UISizeConstraint", { MaxSize = Vector2.new(520, 260), Parent = card })
	Ui.corner(card, 20)
	Ui.stroke(card, C.gold, 5)
	Ui.pad(card, 14)
	Ui.label({ Size = UDim2.new(1, 0, 0, 30), Text = "📍 New landmark found!", TextColor3 = C.orange, TextStrokeTransparency = 1, MaxTextSize = 26, Parent = card })
	Ui.label({ Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, 0, 0, 44), Text = tostring(info.name), TextColor3 = C.ink, TextStrokeTransparency = 1, MaxTextSize = 40, Parent = card })
	Ui.label({
		Position = UDim2.new(0, 0, 0, 80),
		Size = UDim2.new(1, 0, 0, 70),
		Text = tostring(info.fact),
		TextColor3 = C.ink,
		TextStrokeTransparency = 1,
		TextWrapped = true,
		Font = Enum.Font.GothamMedium,
		MaxTextSize = 20,
		Parent = card,
	})
	Ui.label({
		Position = UDim2.new(0, 0, 1, -34),
		Size = UDim2.new(0.6, 0, 0, 34),
		Text = string.format("+%d 🪙   (%d found)", info.coins or 0, info.found or 0),
		TextColor3 = C.orange,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = card,
	})
	local ok = Ui.button("Cool!", C.green, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.fromOffset(110, 40), Parent = card })
	ok.Activated:Connect(function()
		card:Destroy()
	end)
	Ui.pop(card, 0.6)
	task.delay(10, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

function Hud.splash()
	splashLabel.Visible = true
	splashLabel.TextTransparency = 0
	splashLabel.TextStrokeTransparency = 0
	Ui.pop(splashLabel, 1.6)
	task.delay(0.9, function()
		Ui.tween(splashLabel, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
end

local function showBanner(id: string)
	banner.Text = (CITY_FLAGS[id] or "") .. "  " .. string.upper(cityName(id))
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0
	Ui.pop(banner, 1.3)
	task.delay(3, function()
		Ui.tween(banner, 0.8, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
end

--- Delivery messages from the server.
function Hud.delivery(data: { [string]: any })
	if data.state == "start" then
		State.delivery = {
			item = data.item,
			shop = data.shop,
			to = data.to,
			limit = data.limit,
			started = os.clock(),
			metres = data.metres,
		}
		Hud.toast("📦 Order! Bring " .. tostring(data.item) .. " to the glowing marker.", "good")
	elseif data.state == "done" then
		State.delivery = nil
		local msg = if data.fast then "Super fast delivery! +" else "Delivered! +"
		Hud.toast("🎉 " .. msg .. tostring(data.coins) .. " coins", "good")
	else
		State.delivery = nil
		Hud.toast("Delivery cancelled.", "info")
	end
	State.deliveryChanged:Fire()
end

local function updateProfile()
	local p = State.profile
	if not p then
		return
	end
	if p.coins > targetCoins then
		Ui.pop(coinPill, 1.15)
	end
	targetCoins = p.coins
	landmarkLabel.Text = string.format("📍 %d / %d", p.found, p.totalLandmarks)
end

local function sideButton(parent: Instance, icon: string, caption: string, color: Color3, order: number, onClick: () -> ())
	local holder = Ui.new("Frame", { Size = UDim2.fromOffset(72, 86), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local b = Ui.button(icon, color, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(4, 0), MaxTextSize = 36, Parent = holder })
	Ui.label({ Position = UDim2.fromOffset(0, 64), Size = UDim2.fromOffset(72, 20), Text = caption, MaxTextSize = 16, TextStrokeTransparency = 0.3, Parent = holder })
	b.Activated:Connect(onClick)
	return b
end

local function onRender()
	-- count coins up smoothly
	if shownCoins ~= targetCoins then
		local diff = targetCoins - shownCoins
		local stepBy = math.max(1, math.floor(math.abs(diff) / 12))
		shownCoins += if diff > 0 then math.min(diff, stepBy) else math.max(diff, -stepBy)
		coinLabel.Text = Ui.commas(shownCoins)
	end
	-- speed and boost
	local ride = State.ride
	speedFrame.Visible = ride.onBike
	mobileButtons.Visible = ride.onBike and State.isTouch()
	if ride.onBike then
		speedLabel.Text = tostring(math.floor(math.abs(ride.speed) * 3.6 + 0.5))
		staminaFill.Size = UDim2.fromScale(math.clamp(ride.stamina, 0, 1), 1)
		staminaFill.BackgroundColor3 = if ride.boosting then C.orange else C.gold
	end
	-- delivery arrow and countdown
	local d = State.delivery
	deliveryFrame.Visible = d ~= nil
	if d then
		local me = ride.pos
		if not ride.onBike then
			local char = Players.LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				me = hrp.Position
			end
		end
		local dir = Vector3.new(d.to.X - me.X, 0, d.to.Z - me.Z)
		local metres = dir.Magnitude / Config.M
		local cam = Workspace.CurrentCamera.CFrame
		local look = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
		local right = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
		if dir.Magnitude > 0.1 and look.Magnitude > 0.01 then
			deliveryArrow.Rotation = math.deg(math.atan2(dir:Dot(right.Unit), dir:Dot(look.Unit)))
		end
		local left = d.limit - (os.clock() - d.started)
		local timeText = if left > 0 then string.format("⏱ %d:%02d", math.floor(left / 60), math.floor(left % 60)) else "Take your time!"
		deliveryTitle.Text = "📦 Bring " .. d.item
		deliveryInfo.Text = string.format("%d m   %s", math.floor(metres), timeText)
	end
end

function Hud.init(cb: Callbacks)
	gui = Ui.new("ScreenGui", {
		Name = "Hud",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})

	-- coins and landmarks (top left)
	coinPill = Ui.new("Frame", { Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(170, 46), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.15, Parent = gui })
	Ui.corner(coinPill, 23)
	Ui.stroke(coinPill, C.gold, 3)
	Ui.label({ Position = UDim2.fromOffset(8, 4), Size = UDim2.fromOffset(38, 38), Text = "🪙", Parent = coinPill })
	coinLabel = Ui.label({ Position = UDim2.fromOffset(50, 4), Size = UDim2.new(1, -60, 0, 38), Text = "0", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, MaxTextSize = 30, Parent = coinPill })
	local lmPill = Ui.new("Frame", { Position = UDim2.fromOffset(12, 62), Size = UDim2.fromOffset(130, 34), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.15, Parent = gui })
	Ui.corner(lmPill, 17)
	landmarkLabel = Ui.label({ Size = UDim2.fromScale(1, 1), Text = "📍 0 / 0", MaxTextSize = 22, Parent = lmPill })

	-- delivery panel
	deliveryFrame = Ui.new("Frame", { Position = UDim2.fromOffset(12, 104), Size = UDim2.fromOffset(250, 96), BackgroundColor3 = C.panel, Visible = false, Parent = gui })
	Ui.corner(deliveryFrame, 16)
	Ui.stroke(deliveryFrame, C.orange, 3)
	deliveryTitle = Ui.label({ Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -84, 0, 30), Text = "", TextColor3 = C.ink, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = deliveryFrame })
	deliveryInfo = Ui.label({ Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -84, 0, 24), Text = "", TextColor3 = C.blue, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = deliveryFrame })
	deliveryArrow = Ui.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -40, 0.5, 0), Size = UDim2.fromOffset(60, 60), Text = "⬆", TextColor3 = C.orange, TextStrokeTransparency = 0, MaxTextSize = 56, Parent = deliveryFrame })
	local cancel = Ui.button("Cancel", C.grey, { Position = UDim2.fromOffset(10, 66), Size = UDim2.fromOffset(80, 24), MaxTextSize = 16, Parent = deliveryFrame })
	cancel.Activated:Connect(function()
		State.remote("CancelDelivery"):FireServer()
	end)

	-- messages
	toastList = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(0.5, 0, 0, 220), BackgroundTransparency = 1, Parent = gui })
	Ui.new("UISizeConstraint", { MaxSize = Vector2.new(560, 220), MinSize = Vector2.new(260, 0), Parent = toastList })
	Ui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = toastList })

	banner = Ui.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.new(0.8, 0, 0, 80), Text = "", TextTransparency = 1, TextStrokeTransparency = 1, TextColor3 = Color3.new(1, 1, 1), MaxTextSize = 72, Parent = gui })
	splashLabel = Ui.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.new(0.8, 0, 0, 90), Text = "SPLASH! 💦", TextColor3 = Color3.fromRGB(120, 200, 255), Visible = false, MaxTextSize = 80, Parent = gui })

	-- speed and boost (bottom centre)
	speedFrame = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(190, 74), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.2, Visible = false, Parent = gui })
	Ui.corner(speedFrame, 18)
	speedLabel = Ui.label({ Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(90, 46), Text = "0", MaxTextSize = 44, TextXAlignment = Enum.TextXAlignment.Right, Parent = speedFrame })
	Ui.label({ Position = UDim2.fromOffset(106, 16), Size = UDim2.fromOffset(70, 26), Text = "km/h", MaxTextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, Parent = speedFrame })
	local bar = Ui.new("Frame", { Position = UDim2.new(0, 34, 1, -18), Size = UDim2.new(1, -46, 0, 10), BackgroundColor3 = Color3.fromRGB(60, 66, 90), Parent = speedFrame })
	Ui.corner(bar, 5)
	staminaFill = Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.gold, Parent = bar })
	Ui.corner(staminaFill, 5)
	Ui.label({ Position = UDim2.new(0, 8, 1, -24), Size = UDim2.fromOffset(22, 22), Text = "⚡", Parent = speedFrame })

	-- big menu buttons (right side)
	local side = Ui.new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.45, 0), Size = UDim2.fromOffset(72, 4 * 92), BackgroundTransparency = 1, Parent = gui })
	Ui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = side })
	sideButton(side, "🛒", "Shop", C.green, 1, cb.shop)
	sideButton(side, "🌍", "Travel", C.blue, 2, cb.travel)
	sideButton(side, "🚲", "Bike", C.orange, 3, cb.bike)
	sideButton(side, "🎥", "Camera", C.purple, 4, cb.camera)

	-- touch buttons while riding
	mobileButtons = Ui.new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(200, 110), BackgroundTransparency = 1, Visible = false, Parent = gui })
	local boost = Ui.button("⚡", C.orange, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(100, 100), MaxTextSize = 54, Parent = mobileButtons })
	boost.MouseButton1Down:Connect(function()
		State.touchBoost = true
	end)
	boost.MouseButton1Up:Connect(function()
		State.touchBoost = false
	end)
	boost.MouseLeave:Connect(function()
		State.touchBoost = false
	end)
	local bell = Ui.button("🔔", C.gold, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -112, 1, -10), Size = UDim2.fromOffset(76, 76), MaxTextSize = 40, Parent = mobileButtons })
	bell.Activated:Connect(cb.bell)

	-- how to play (keyboard), fades after a while
	if not State.isTouch() then
		helpLabel = Ui.label({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -96),
			Size = UDim2.new(0.8, 0, 0, 26),
			Text = "W / S  pedal & brake   •   A / D  steer   •   Shift  boost   •   Space  bell   •   C  camera",
			MaxTextSize = 20,
			TextStrokeTransparency = 0.3,
			Parent = gui,
		})
		task.delay(60, function()
			Ui.tween(helpLabel, 2, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end)
	end

	State.profileChanged.Event:Connect(updateProfile)
	updateProfile()
	local lastCity = State.city()
	Players.LocalPlayer:GetAttributeChangedSignal("City"):Connect(function()
		local now = State.city()
		if now ~= lastCity then
			lastCity = now
			showBanner(now)
		end
	end)
	RunService.RenderStepped:Connect(onRender)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="33">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Bike the World: client start-up. Wires the HUD, menus, the bike and the
-- city effects to the server's messages.

local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local ShopUI = require(Client:WaitForChild("ShopUI"))
local TravelUI = require(Client:WaitForChild("TravelUI"))
local BikeController = require(Client:WaitForChild("BikeController"))
local BikeCamera = require(Client:WaitForChild("BikeCamera"))
local Animator = require(Client:WaitForChild("Animator"))
local Effects = require(Client:WaitForChild("Effects"))
local Traffic = require(Client:WaitForChild("Traffic"))
local Sfx = require(Client:WaitForChild("Sfx"))

Hud.init({
	shop = function()
		ShopUI.toggle()
	end,
	travel = function()
		TravelUI.toggle()
	end,
	bike = function()
		State.remote("ToggleBike"):FireServer()
	end,
	camera = function()
		State.cameraMode = if State.cameraMode == "chase" then "first" else "chase"
	end,
	bell = function()
		BikeController.ringBell()
	end,
})
ShopUI.init(Hud.toast)
TravelUI.init(function()
	if State.ride.onBike then
		BikeController.unstuck()
	else
		State.remote("GoToCity"):FireServer(State.city())
	end
end)
BikeController.init()
BikeCamera.init()
Animator.init()
Effects.init(BikeController.splashed.Event)
Traffic.init()

BikeController.splashed.Event:Connect(function()
	Hud.splash()
end)
BikeController.bumped.Event:Connect(function(speed: number)
	BikeCamera.bump(speed)
end)

-- messages from the server
State.remote("Profile").OnClientEvent:Connect(function(p)
	State.setProfile(p)
end)
State.remote("Toast").OnClientEvent:Connect(function(text: string, kind: string?)
	Hud.toast(text, kind)
end)
State.remote("Coins").OnClientEvent:Connect(function(amount: number, reason: string?)
	Hud.coins(amount, reason)
end)
State.remote("Landmark").OnClientEvent:Connect(function(info)
	Hud.landmark(info)
end)
State.remote("Delivery").OnClientEvent:Connect(function(data)
	Hud.delivery(data)
end)
State.remote("OpenShop").OnClientEvent:Connect(function()
	ShopUI.open()
end)
State.remote("BellRang").OnClientEvent:Connect(function(bike: Instance?)
	local bell = bike and bike:FindFirstChild("Bell", true)
	if bell and bell:IsA("BasePart") then
		Sfx.bell(bell)
	end
end)

-- first profile
task.spawn(function()
	for _ = 1, 20 do
		local ok, p = pcall(function()
			return State.func("GetProfile"):InvokeServer()
		end)
		if ok and p then
			State.setProfile(p)
			return
		end
		task.wait(1)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
-- Little sound helper. Sound IDs come from Config.Sounds; empty ones fall
-- back to sounds that ship with Roblox.

local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sfx = {}

local FALLBACK: { [string]: string } = {
	Bell = "rbxasset://sounds/electronicpingshort.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Landmark = "rbxasset://sounds/electronicpingshort.wav",
	Purchase = "rbxasset://sounds/electronicpingshort.wav",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Bump = "rbxasset://sounds/action_jump_land.mp3",
}

-- pitch for the fallback sounds, so they don't all sound the same
local FALLBACK_PITCH: { [string]: number } = {
	Bell = 1.6,
	Coin = 2.2,
	Landmark = 0.8,
	Purchase = 1.2,
	Click = 3,
}

local function idFor(name: string): (string, number)
	local id = (Config.Sounds :: { [string]: string })[name]
	if id and id ~= "" then
		return id, 1
	end
	return FALLBACK[name] or "", FALLBACK_PITCH[name] or 1
end

--- Play a sound once. With `at` (a part) it is a 3D sound from that part.
function Sfx.play(name: string, at: BasePart?, volume: number?, pitch: number?)
	local id, basePitch = idFor(name)
	if id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = basePitch * (pitch or 1)
	if at then
		s.RollOffMaxDistance = 120
		s.Parent = at
		s:Play()
		s.Ended:Once(function()
			s:Destroy()
		end)
		task.delay(6, function()
			s:Destroy()
		end)
	else
		s.Parent = SoundService
		SoundService:PlayLocalSound(s)
		task.delay(6, function()
			s:Destroy()
		end)
	end
end

--- The bell goes "ring-ring". The uploaded bell.wav already rings twice;
--- the built-in fallback ping is played twice instead.
function Sfx.bell(at: BasePart?)
	Sfx.play("Bell", at, 0.7)
	if Config.Sounds.Bell == "" then
		task.delay(0.16, function()
			Sfx.play("Bell", at, 0.6, 1.06)
		end)
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[--!strict
-- The shop: bikes, colours and extras for coins, and the Robux items.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)
local Sfx = require(script.Parent.Sfx)

local C = Ui.Colors
local player = Players.LocalPlayer

local ShopUI = {}

local win: Frame
local content: Frame
local tabButtons: { [string]: TextButton } = {}
local current = "bikes"
local toast: (string, string?) -> () = function() end
local priceCache: { [number]: number } = {}

local COSMETIC_ICONS: { [string]: string } = {
	helmet = "⛑️",
	flowers = "💐",
	streamers = "🎏",
	rainbow = "🌈",
	puppy = "🐶",
}
local PASS_ICONS: { [string]: string } = {
	DoubleCoins = "💰",
	GoldenBike = "🏆",
	RainbowTrail = "🌈",
	Puppy = "🐶",
}

local function priceOf(id: number, infoType: Enum.InfoType): number?
	if priceCache[id] then
		return priceCache[id]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfoAsync(id, infoType)
	end)
	if not ok then
		ok, info = pcall(function()
			return (MarketplaceService :: any):GetProductInfo(id, infoType)
		end)
	end
	if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
		priceCache[id] = info.PriceInRobux
		return info.PriceInRobux
	end
	return nil
end

local function card(order: number, accent: Color3): Frame
	local f = Ui.new("Frame", { BackgroundColor3 = C.panel, LayoutOrder = order }) :: Frame
	Ui.corner(f, 16)
	Ui.stroke(f, accent, 3)
	return f
end

local function title(f: Frame, text: string, y: number)
	Ui.label({ Position = UDim2.fromOffset(8, y), Size = UDim2.new(1, -16, 0, 28), Text = text, TextColor3 = C.ink, TextStrokeTransparency = 1, MaxTextSize = 24, Parent = f })
end

local function desc(f: Frame, text: string, y: number, h: number?)
	Ui.label({
		Position = UDim2.fromOffset(10, y),
		Size = UDim2.new(1, -20, 0, h or 34),
		Text = text,
		TextColor3 = Color3.fromRGB(90, 96, 115),
		TextStrokeTransparency = 1,
		TextWrapped = true,
		Font = Enum.Font.GothamMedium,
		MaxTextSize = 14,
		Parent = f,
	})
end

local function actionButton(f: Frame, text: string, color: Color3, onClick: (() -> ())?): TextButton
	local b = Ui.button(text, color, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -24, 0, 40), MaxTextSize = 22, Parent = f })
	if onClick then
		b.Activated:Connect(onClick)
	else
		b.AutoButtonColor = false
	end
	return b
end

local function statBar(f: Frame, y: number, label: string, value: number, color: Color3)
	Ui.label({ Position = UDim2.fromOffset(10, y), Size = UDim2.fromOffset(70, 16), Text = label, TextColor3 = C.ink, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxTextSize = 13, Parent = f })
	local back = Ui.new("Frame", { Position = UDim2.fromOffset(80, y + 3), Size = UDim2.new(1, -92, 0, 10), BackgroundColor3 = Color3.fromRGB(225, 229, 238), Parent = f })
	Ui.corner(back, 5)
	local fill = Ui.new("Frame", { Size = UDim2.fromScale(math.clamp(value, 0.05, 1), 1), BackgroundColor3 = color, Parent = back })
	Ui.corner(fill, 5)
end

-- talking to the server ------------------------------------------------------------
local function buy(kind: string, id: string)
	local ok, msg = State.func("Buy"):InvokeServer(kind, id)
	toast(tostring(msg), if ok then "good" else "bad")
	if ok then
		Sfx.play("Purchase")
		State.func("Equip"):InvokeServer(kind, id)
	end
end

local function equip(kind: string, id: string)
	local ok, msg = State.func("Equip"):InvokeServer(kind, id)
	if not ok then
		toast(tostring(msg), "bad")
	end
end

local function promptPass(key: string)
	local def = Config.GamePasses[key]
	if not def or def.id == 0 then
		toast("Coming soon!", "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, def.id)
end

local function promptProduct(id: number)
	if id == 0 then
		toast("Coming soon!", "info")
		return
	end
	MarketplaceService:PromptProductPurchase(player, id)
end

--- Text for a Robux button; fills in the real price when Roblox tells us.
local function robuxButton(f: Frame, id: number, infoType: Enum.InfoType, onClick: () -> ()): TextButton
	if id == 0 then
		return actionButton(f, "Coming soon", C.grey, onClick)
	end
	local b = actionButton(f, "⭐ Robux", C.purple, onClick)
	task.spawn(function()
		local price = priceOf(id, infoType)
		if price and b.Parent then
			b.Text = "R$ " .. price
		end
	end)
	return b
end

-- tabs --------------------------------------------------------------------------------
local function renderBikes(grid: ScrollingFrame, p: State.Profile)
	for i, def in Config.Bikes do
		local owned = if def.gamePass then p.passes[def.gamePass] == true else p.bikes[def.id] == true
		local f = card(i, if def.gamePass then C.gold else C.blue)
		local sw = Ui.new("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = def.color, Parent = f })
		Ui.corner(sw, 18)
		Ui.label({ Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(36, 36), Text = "🚲", MaxTextSize = 24, Parent = f })
		Ui.label({ Position = UDim2.fromOffset(52, 12), Size = UDim2.new(1, -60, 0, 30), Text = def.name, TextColor3 = C.ink, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = f })
		desc(f, def.description, 50)
		statBar(f, 88, "Speed", (def.topSpeed - 5) / 6.5, C.red)
		statBar(f, 106, "Power", def.power / 1.8, C.orange)
		statBar(f, 124, "Steering", def.handling / 1.35, C.green)
		if owned then
			if p.bike == def.id then
				actionButton(f, "Riding ✓", C.grey, nil)
			else
				actionButton(f, "Ride it!", C.green, function()
					equip("bike", def.id)
				end)
			end
		elseif def.gamePass then
			local gp = def.gamePass :: string
			robuxButton(f, Config.GamePasses[gp].id, Enum.InfoType.GamePass, function()
				promptPass(gp)
			end)
		else
			local afford = p.coins >= def.price
			actionButton(f, "🪙 " .. Ui.commas(def.price), if afford then C.orange else C.grey, function()
				buy("bike", def.id)
			end)
		end
		f.Parent = grid
	end
end

local function renderColors(grid: ScrollingFrame, p: State.Profile)
	for i, def in Config.Colors do
		local owned = p.colors[def.id] == true
		local f = card(i, def.color)
		local sw = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(70, 70), BackgroundColor3 = def.color, Parent = f })
		Ui.corner(sw, 35)
		Ui.stroke(sw, Color3.fromRGB(20, 24, 40), 3)
		title(f, def.name, 90)
		if owned then
			if p.color == def.id then
				actionButton(f, "Using ✓", C.grey, nil)
			else
				actionButton(f, "Paint!", C.green, function()
					equip("color", def.id)
				end)
			end
		else
			actionButton(f, "🪙 " .. def.price, if p.coins >= def.price then C.orange else C.grey, function()
				buy("color", def.id)
			end)
		end
		f.Parent = grid
	end
	desc(Ui.new("Frame", { BackgroundTransparency = 1, LayoutOrder = 99, Parent = grid }), "The Golden Bike always stays gold.", 0, 30)
end

local function renderExtras(grid: ScrollingFrame, p: State.Profile)
	for i, def in Config.Cosmetics do
		local owned = if def.gamePass then p.passes[def.gamePass] == true else p.cosmetics[def.id] == true
		local f = card(i, if def.gamePass then C.gold else C.green)
		Ui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(70, 60), Text = COSMETIC_ICONS[def.id] or "🎁", MaxTextSize = 52, Parent = f })
		title(f, def.name, 72)
		desc(f, def.description, 100)
		if owned then
			local wearing = p.worn[def.id] == true
			actionButton(f, if wearing then "Take off" else "Put on!", if wearing then C.grey else C.green, function()
				equip("cosmetic", def.id)
			end)
		elseif def.gamePass then
			local gp = def.gamePass :: string
			robuxButton(f, Config.GamePasses[gp].id, Enum.InfoType.GamePass, function()
				promptPass(gp)
			end)
		else
			actionButton(f, "🪙 " .. def.price, if p.coins >= def.price then C.orange else C.grey, function()
				buy("cosmetic", def.id)
			end)
		end
		f.Parent = grid
	end
end

local function renderRobux(grid: ScrollingFrame, p: State.Profile)
	local order = 0
	local keys = {}
	for key in Config.GamePasses do
		table.insert(keys, key)
	end
	table.sort(keys)
	for _, key in keys do
		local def = Config.GamePasses[key]
		order += 1
		local f = card(order, C.gold)
		Ui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(70, 60), Text = PASS_ICONS[key] or "⭐", MaxTextSize = 52, Parent = f })
		title(f, def.name, 72)
		desc(f, def.description, 100)
		if p.passes[key] then
			actionButton(f, "Owned ✓", C.grey, nil)
		else
			robuxButton(f, def.id, Enum.InfoType.GamePass, function()
				promptPass(key)
			end)
		end
		f.Parent = grid
	end
	for _, prod in Config.Products do
		order += 1
		local f = card(order, C.orange)
		Ui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(70, 60), Text = "🪙", MaxTextSize = 52, Parent = f })
		title(f, Ui.commas(prod.coins) .. " coins", 72)
		desc(f, "A bag of coins for the bike shop.", 100)
		robuxButton(f, prod.id, Enum.InfoType.Product, function()
			promptProduct(prod.id)
		end)
		f.Parent = grid
	end
end

local function render()
	for _, ch in content:GetChildren() do
		if ch.Name == "Grid" then
			ch:Destroy()
		end
	end
	for name, b in tabButtons do
		b.BackgroundColor3 = if name == current then C.blue else C.grey
	end
	local p = State.profile
	if not p then
		return
	end
	local grid = Ui.grid(content, Vector2.new(190, 210))
	grid.Name = "Grid"
	grid.Position = UDim2.fromOffset(0, 54)
	grid.Size = UDim2.new(1, 0, 1, -54)
	if current == "bikes" then
		renderBikes(grid, p)
	elseif current == "colors" then
		renderColors(grid, p)
	elseif current == "extras" then
		renderExtras(grid, p)
	else
		renderRobux(grid, p)
	end
end

function ShopUI.open(tab: string?)
	if tab then
		current = tab
	end
	win.Visible = true
	render()
end

function ShopUI.toggle()
	if win.Visible then
		win.Visible = false
	else
		ShopUI.open()
	end
end

function ShopUI.init(sendToast: (string, string?) -> ())
	toast = sendToast
	local gui = Ui.new("ScreenGui", { Name = "Shop", ResetOnSpawn = false, DisplayOrder = 5, Parent = player:WaitForChild("PlayerGui") })
	win, content = Ui.window(gui, "🛒 Bike Shop", C.green)
	local tabs = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Parent = content })
	Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = tabs })
	for i, t in { { "bikes", "🚲 Bikes" }, { "colors", "🎨 Colours" }, { "extras", "🎁 Extras" }, { "robux", "⭐ Robux" } } do
		local b = Ui.button(t[2], C.grey, { Size = UDim2.new(0.24, -6, 1, 0), LayoutOrder = i, MaxTextSize = 22, Parent = tabs })
		tabButtons[t[1]] = b
		b.Activated:Connect(function()
			current = t[1]
			render()
		end)
	end
	State.profileChanged.Event:Connect(function()
		if win.Visible then
			render()
		end
	end)
end

return ShopUI
]]></string>
          </Properties>
