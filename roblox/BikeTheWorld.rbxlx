        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--!strict
-- Spins wheels and pedals and turns the handlebars of every player's bike.
-- Our own bike uses the physics state; other bikes are animated from how
-- they move. Head lamps switch on at night.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)

local M = Config.M

local Animator = {}

type Rig = {
	root: BasePart,
	rear: Motor6D?,
	front: Motor6D?,
	steerJoint: Motor6D?,
	crank: Motor6D?,
	beam: SpotLight?,
	rearLight: BasePart?,
	wheelR: number, -- metres
	lastPos: Vector3?,
	lastYaw: number,
	speed: number,
	steer: number,
	wheel: number,
	crankA: number,
}

local rigs: { [Model]: Rig } = {}

local function makeRig(m: Model): Rig?
	local root = m.PrimaryPart or m:FindFirstChild("Root") :: BasePart?
	if not root then
		return nil
	end
	local steerPart = m:FindFirstChild("Steer")
	local wheelPart = m:FindFirstChild("Wheel") :: BasePart?
	local lamp = m:FindFirstChild("HeadLamp")
	return {
		root = root,
		rear = root:FindFirstChild("RearWheel") :: Motor6D?,
		crank = root:FindFirstChild("Crank") :: Motor6D?,
		steerJoint = root:FindFirstChild("SteerJoint") :: Motor6D?,
		front = if steerPart then steerPart:FindFirstChild("FrontWheel") :: Motor6D? else nil,
		beam = if lamp then lamp:FindFirstChild("Beam") :: SpotLight? else nil,
		rearLight = m:FindFirstChild("RearLight") :: BasePart?,
		wheelR = if wheelPart then wheelPart.Size.Y / 2 / M else 0.35,
		lastPos = nil,
		lastYaw = 0,
		speed = 0,
		steer = 0,
		wheel = 0,
		crankA = 0,
	}
end

local function yawOf(cf: CFrame): number
	local lv = cf.LookVector
	return math.atan2(-lv.X, -lv.Z)
end

local function update(dt: number)
	local folder = Workspace:FindFirstChild("Bikes")
	if not folder or dt <= 0 then
		return
	end
	local mine = State.ride.model
	local night = State.night
	for _, child in folder:GetChildren() do
		if not child:IsA("Model") then
			continue
		end
		local rig = rigs[child]
		if not rig then
			local made = makeRig(child)
			if not made then
				continue
			end
			rig = made
			rigs[child] = made
		end
		local r = rig :: Rig
		local wheelA, crankA, steer
		if child == mine then
			local ride = State.ride
			wheelA, crankA, steer = ride.wheel, ride.crank, ride.steer
		else
			-- estimate from movement
			local cf = r.root.CFrame
			local p = cf.Position
			local y = yawOf(cf)
			local last = r.lastPos
			if last then
				local delta = p - last
				local flat = Vector3.new(delta.X, 0, delta.Z)
				local sgn = if flat:Dot(cf.LookVector) >= 0 then 1 else -1
				local v = sgn * flat.Magnitude / M / dt
				if v ~= v or math.abs(v) > 40 then
					v = 0
				end
				r.speed += (v - r.speed) * math.min(1, dt * 8)
				local dy = (y - r.lastYaw + math.pi) % (2 * math.pi) - math.pi
				local yawRate = dy / dt
				local target = 0
				if math.abs(r.speed) > 0.8 then
					target = math.clamp(math.atan(-yawRate * 1.1 / r.speed), -0.6, 0.6)
				end
				r.steer += (target - r.steer) * math.min(1, dt * 6)
			end
			r.lastPos = p
			r.lastYaw = y
			r.wheel += r.speed * dt / r.wheelR
			if r.speed > 0.5 then
				r.crankA += r.speed / 4.3 * math.pi * 2 * dt
			end
			wheelA, crankA, steer = r.wheel, r.crankA, r.steer
		end
		if r.rear then
			r.rear.Transform = CFrame.Angles(-wheelA, 0, 0)
		end
		if r.front then
			r.front.Transform = CFrame.Angles(-wheelA, 0, 0)
		end
		if r.crank then
			r.crank.Transform = CFrame.Angles(-crankA, 0, 0)
		end
		if r.steerJoint then
			r.steerJoint.Transform = CFrame.Angles(0, -steer, 0)
		end
		if r.beam and r.beam.Enabled ~= night then
			r.beam.Enabled = night
			if r.rearLight then
				r.rearLight.Material = if night then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
	for m in rigs do
		if not m.Parent then
			rigs[m] = nil
		end
	end
end

function Animator.init()
	RunService.PreSimulation:Connect(update)
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">BikeCamera</string>
            <string name="Source"><![CDATA[--!strict
-- Camera while riding: a smooth chase camera (drag or right-click to look
-- around, scroll or pinch to zoom) or a first-person view over the
-- handlebars. Press C (or the camera button) to switch.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local BikeCamera = {}

local player = State.player
local active = false
local camYaw = 0
local orbit = 0
local orbitPitch = 0
local zoom = 17
local lastLook = 0
local dragging = false
local lastPan: Vector2? = nil
local shake = 0
local hidden = false

local camParams = RaycastParams.new()
camParams.FilterType = Enum.RaycastFilterType.Exclude
camParams.IgnoreWater = true

local function angleLerp(a: number, b: number, t: number): number
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * t
end

local function setCharacterHidden(hide: boolean)
	if hidden == hide then
		return
	end
	hidden = hide
	local char = player.Character
	if not char then
		return
	end
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = if hide then 1 else 0
		end
	end
end

--- A little shake when you bump into something.
function BikeCamera.bump(strength: number)
	shake = math.max(shake, math.clamp(strength / 10, 0.1, 0.5))
end

local function update(dt: number)
	local camera = Workspace.CurrentCamera
	local ride = State.ride
	local m = ride.model
	local r = m and m.PrimaryPart
	if not ride.onBike or not r then
		if active then
			active = false
			setCharacterHidden(false)
			camera.CameraType = Enum.CameraType.Custom
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				camera.CameraSubject = hum
			end
			camera.FieldOfView = 70
		end
		return
	end
	if not active then
		active = true
		camera.CameraType = Enum.CameraType.Scriptable
		camYaw = ride.yaw
		orbit, orbitPitch = 0, 0
	end
	local ignore: { Instance } = { r }
	if m then
		table.insert(ignore, m)
	end
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local traffic = Workspace:FindFirstChild("Traffic")
	if traffic then
		table.insert(ignore, traffic)
	end
	camParams.FilterDescendantsInstances = ignore

	-- swing back behind the bike when the player stops looking around
	if os.clock() - lastLook > 1.6 and not dragging then
		local k = 1 - math.exp(-3 * dt)
		orbit += (0 - orbit) * k
		orbitPitch += (0 - orbitPitch) * k
	end
	-- right thumbstick looks around
	for _, input: InputObject in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if input.KeyCode == Enum.KeyCode.Thumbstick2 and input.Position.Magnitude > 0.2 then
			orbit -= input.Position.X * 2.5 * dt
			orbitPitch = math.clamp(orbitPitch - input.Position.Y * 1.5 * dt, -0.25, 0.9)
			lastLook = os.clock()
		end
	end

	local speed = math.abs(ride.speed)
	local shakeOffset = Vector3.zero
	if shake > 0.01 then
		shakeOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shake
		shake *= math.exp(-8 * dt)
	end

	if State.cameraMode == "first" then
		setCharacterHidden(true)
		local cf = CFrame.new(r.Position)
			* CFrame.Angles(0, ride.yaw, 0)
			* CFrame.Angles(0, 0, -ride.lean * 0.5)
			* CFrame.new(0, 4.4, 0.7)
			* CFrame.Angles(-0.2 - orbitPitch * 0.6, orbit, 0)
		camera.CFrame = cf * CFrame.new(shakeOffset)
		camera.FieldOfView = 76 + math.min(speed, 14) * 0.7
	else
		setCharacterHidden(false)
		camYaw = angleLerp(camYaw, ride.yaw, 1 - math.exp(-4 * dt))
		local target = r.Position + Vector3.new(0, 3.4, 0)
		local yawC = camYaw + orbit
		local pitchC = 0.26 + orbitPitch
		local dist = zoom + math.min(speed, 12) * 0.25
		local camPos = target + (CFrame.Angles(0, yawC, 0) * CFrame.Angles(-pitchC, 0, 0)):VectorToWorldSpace(Vector3.new(0, 0, dist))
		local hit = Workspace:Raycast(target, camPos - target, camParams)
		if hit then
			camPos = hit.Position + (target - camPos).Unit * 0.8
		end
		camera.CFrame = CFrame.lookAt(camPos, target) * CFrame.new(shakeOffset)
		camera.FieldOfView = 70 + math.min(speed, 14) * 0.8
	end
end

function BikeCamera.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 and State.ride.onBike then
			dragging = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and dragging then
			dragging = false
			lastLook = os.clock()
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		if not State.ride.onBike then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
			orbit -= input.Delta.X * 0.008
			orbitPitch = math.clamp(orbitPitch + input.Delta.Y * 0.006, -0.25, 0.9)
			lastLook = os.clock()
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			zoom = math.clamp(zoom - input.Position.Z * 2, 8, 40)
		end
	end)
	-- touch: drag on the screen to look around, pinch to zoom
	UserInputService.TouchPan:Connect(function(_touches: { Vector2 }, translation: Vector2, _velocity: Vector2, inputState: Enum.UserInputState, processed: boolean)
		if processed or not State.ride.onBike then
			lastPan = nil
			return
		end
		if inputState == Enum.UserInputState.Begin or lastPan == nil then
			lastPan = translation
			return
		end
		local last = lastPan :: Vector2
		local delta = translation - last
		lastPan = translation
		orbit -= delta.X * 0.01
		orbitPitch = math.clamp(orbitPitch + delta.Y * 0.006, -0.25, 0.9)
		lastLook = os.clock()
		if inputState == Enum.UserInputState.End then
			lastPan = nil
		end
	end)
	local pinchStart = zoom
	UserInputService.TouchPinch:Connect(function(_touches: { Vector2 }, scale: number, _velocity: number, inputState: Enum.UserInputState, processed: boolean)
		if processed or not State.ride.onBike then
			return
		end
		if inputState == Enum.UserInputState.Begin then
			pinchStart = zoom
		end
		zoom = math.clamp(pinchStart / math.max(scale, 0.1), 8, 40)
	end)
	RunService:BindToRenderStep("BikeCamera", Enum.RenderPriority.Camera.Value + 1, update)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		hidden = false
	end)
end

return BikeCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">BikeController</string>
            <string name="Source"><![CDATA[--!strict
-- Rides the player's bike. The server gives the bike to this client (network
-- ownership); every frame we run the bike physics, follow the ground with
-- raycasts, slide along walls, and move the bike's rigid align targets.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local BikePhysics = require(Shared.BikePhysics)
local BikeModel = require(Shared.BikeModel)
local State = require(script.Parent.State)
local Sfx = require(script.Parent.Sfx)

local M = Config.M
local GRAVITY = 9.81 * M * 2 -- studs/s^2 (a bit stronger than real, feels snappier)
local STEP_UP = 1.6 -- highest kerb (studs) you can ride up
local SPHERE_R = 1.1
local SPHERE_Y = 2.4

local player = State.player

local BikeController = {}
BikeController.splashed = Instance.new("BindableEvent")
BikeController.bumped = Instance.new("BindableEvent")

-- the ride ---------------------------------------------------------------------
local model: Model? = nil
local root: BasePart? = nil
local alignPos: AlignPosition? = nil
local alignRot: AlignOrientation? = nil
local params: BikePhysics.Params = { topSpeed = 7.5, power = 1, handling = 1, wheel = 0.35 }
local state = BikePhysics.newState()
local pos = Vector3.zero -- ground point under the bike
local yaw = 0
local pitch = 0
local vy = 0
local holdUntil = 0 -- wait for the ground to stream in until this time
local splashing = false
local safe: { { pos: Vector3, yaw: number } } = {}
local lastSafe = 0

-- input
local boostKey = false
local triggerGas = 0
local triggerBrake = 0
local lastBell = 0

local controls: any = nil
local function getControls(): any
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local ps = player:WaitForChild("PlayerScripts")
		local pm = require(ps:WaitForChild("PlayerModule") :: ModuleScript) :: any
		return pm:GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

-- raycasts ignore bikes, characters and the city traffic
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = false
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true

local function refreshFilter()
	local list: { Instance } = {}
	for _, name in { "Bikes", "Traffic", "LocalEffects" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = list
	wallParams.FilterDescendantsInstances = list
end

local function groundAt(p: Vector3, fromY: number): RaycastResult?
	return Workspace:Raycast(Vector3.new(p.X, fromY, p.Z), Vector3.new(0, -80, 0), groundParams)
end

local function isWater(hit: RaycastResult?): boolean
	return hit ~= nil and hit.Material == Enum.Material.Water
end

local function bikeDef(id: any): Config.BikeDef
	for _, b in Config.Bikes do
		if b.id == id then
			return b
		end
	end
	return Config.Bikes[1]
end

local function poseCFrame(): CFrame
	return CFrame.new(pos + Vector3.new(0, BikeModel.RootHeight, 0))
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(pitch, 0, 0)
		* CFrame.Angles(0, 0, -state.lean)
end

--- Put the bike somewhere (a city spawn, or back on the road after a splash).
function BikeController.teleport(p: Vector3, newYaw: number, keepSafe: boolean?)
	pos = p
	yaw = newYaw
	pitch = 0
	vy = 0
	state.speed = 0
	state.lean = 0
	state.steer = 0
	holdUntil = os.clock() + 8
	if not keepSafe then
		table.clear(safe)
	end
	local r = root
	if r then
		local cf = poseCFrame()
		r.CFrame = cf -- moves the whole bike and the rider with it
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		if alignPos then
			alignPos.Position = cf.Position
		end
		if alignRot then
			alignRot.CFrame = cf
		end
	end
end

--- Back to the last safe spot on the road (also used by the "I'm stuck" button).
function BikeController.unstuck()
	local s = safe[math.max(1, #safe - 4)]
	if s then
		BikeController.teleport(s.pos, s.yaw, true)
	end
end

local function splash(waterY: number)
	if splashing then
		return
	end
	splashing = true
	state.speed = 0
	local r = root
	Sfx.play("Splash", r, 0.9)
	BikeController.splashed:Fire(Vector3.new(pos.X, waterY, pos.Z))
	task.delay(1.2, function()
		splashing = false
		if not model then
			return
		end
		local s = safe[math.max(1, #safe - 4)]
		if s then
			BikeController.teleport(s.pos, s.yaw, true)
		else
			BikeController.teleport(pos + Vector3.new(0, 20, 0), yaw, true)
		end
	end)
end

-- the physics step ----------------------------------------------------------------
local function step(dt: number)
	local r, ap, ao = root, alignPos, alignRot
	if not model or not r or not ap or not ao then
		return
	end
	if splashing then
		-- sink slowly while the splash plays
		pos -= Vector3.new(0, 4 * dt, 0)
		local cf = poseCFrame()
		ap.Position = cf.Position
		ao.CFrame = cf
		return
	end
	dt = math.min(dt, 1 / 20)

	-- input: the default controls give us the thumbstick / WASD / gamepad stick
	local mv = Vector3.zero
	local c = controls -- loaded in init(), never waited for here
	if c then
		local ok, v = pcall(function()
			return c:GetMoveVector()
		end)
		if ok and typeof(v) == "Vector3" then
			mv = v
		end
	end
	local throttle = math.max(math.clamp(-mv.Z, 0, 1), triggerGas)
	local brake = math.max(math.clamp(mv.Z, 0, 1), triggerBrake)
	local steer = math.clamp(mv.X, -1, 1)
	if UserInputService:GetFocusedTextBox() then
		throttle, brake, steer = 0, 0, 0
	end
	local boost = boostKey or State.touchBoost

	-- what are we riding on?
	local fwd = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local here = groundAt(pos, pos.Y + 1.8)
	local onGround = here ~= nil and not isWater(here) and pos.Y - here.Position.Y < 0.35
	local crr = 0.008
	local slope = 0
	if here and onGround then
		crr = BikePhysics.Surfaces[here.Material.Name] or 0.008
		local f = groundAt(pos + fwd * 1.6, pos.Y + 1.8)
		local b = groundAt(pos - fwd * 1.6, pos.Y + 1.8)
		if f and b and not isWater(f) and not isWater(b) then
			slope = math.clamp((f.Position.Y - b.Position.Y) / 3.2, -0.35, 0.35)
		end
	end
	BikePhysics.step(state, params, {
		throttle = if onGround then throttle else 0,
		brake = brake,
		steer = steer,
		boost = boost,
	}, {
		crr = if onGround then crr else 0,
		slope = if onGround then slope else 0,
		grip = if State.rain then 0.75 else 1,
	}, 0, dt)
	yaw += state.yawRate * dt
	fwd = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))

	-- move, sliding along walls
	local d = fwd * state.speed * M * dt
	local move = d
	if d.Magnitude > 1e-4 then
		local center = pos + Vector3.new(0, SPHERE_Y, 0)
		local hit = Workspace:Spherecast(center, SPHERE_R, d, wallParams)
		if hit and hit.Normal.Y < 0.55 then
			local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
			if n.Magnitude > 1e-3 then
				n = n.Unit
				local dir = d.Unit
				move = dir * math.max(0, hit.Distance - 0.05)
				local rest = d - move
				local slide = rest - n * rest:Dot(n)
				if slide.Magnitude > 1e-4 and not Workspace:Spherecast(center + move, SPHERE_R, slide, wallParams) then
					move += slide
				end
				local into = -dir:Dot(n) -- 1 = straight into the wall
				if into > 0.2 then
					local before = math.abs(state.speed)
					state.speed *= math.clamp(1.15 - into, 0, 1)
					if into > 0.6 and before > 3 then
						Sfx.play("Bump", r, 0.5)
						BikeController.bumped:Fire(before)
					end
				end
			end
		end
	end

	-- follow the ground
	local newPos = pos + move
	local y = pos.Y
	local g = groundAt(newPos, pos.Y + 1.8)
	if g then
		local gy = g.Position.Y
		if isWater(g) then
			vy -= GRAVITY * dt
			y += vy * dt
			if y < gy - 1.5 then
				pos = Vector3.new(newPos.X, y, newPos.Z)
				splash(gy)
				return
			end
		elseif gy > y + STEP_UP then
			-- too high to ride onto: treat it like a wall
			newPos = pos
			state.speed = 0
		elseif gy >= y - 0.05 then
			y = if gy - y > 0.25 then y + (gy - y) * math.min(1, dt * 18) else gy
			vy = 0
			holdUntil = 0
		elseif vy >= -2 and y - gy < 0.15 + math.abs(state.speed) * M * dt * 0.7 then
			-- riding down a slope: stay on it
			y = gy
			vy = 0
		else
			vy -= GRAVITY * dt
			y = math.max(gy, y + vy * dt)
			if y <= gy + 1e-3 then
				vy = 0
			end
		end
		pitch += (math.atan(slope) - pitch) * math.min(1, dt * 10)
	elseif os.clock() > holdUntil then
		-- nothing below at all
		vy -= GRAVITY * dt
		y += vy * dt
		if y < -150 then
			BikeController.unstuck()
			return
		end
	end
	pos = Vector3.new(newPos.X, y, newPos.Z)

	-- remember safe spots to come back to after a splash
	if onGround and os.clock() - lastSafe > 0.4 then
		lastSafe = os.clock()
		table.insert(safe, { pos = pos, yaw = yaw })
		if #safe > 15 then
			table.remove(safe, 1)
		end
	end

	local cf = poseCFrame()
	ap.Position = cf.Position
	ao.CFrame = cf

	local ride = State.ride
	ride.speed = state.speed
	ride.stamina = state.stamina
	ride.steer = state.steer
	ride.lean = state.lean
	ride.crank = state.crank
	ride.wheel = state.wheel
	ride.boosting = boost and state.stamina > 0.02 and throttle > 0
	ride.pos = pos
	ride.yaw = yaw
end

-- actions while riding ------------------------------------------------------------------
local function ringBell()
	if os.clock() - lastBell < 0.35 then
		return
	end
	lastBell = os.clock()
	local m = model
	local bell = m and m:FindFirstChild("Bell", true) :: BasePart?
	Sfx.bell(bell)
	State.remote("Bell"):FireServer()
end
BikeController.ringBell = ringBell

local function onAction(name: string, inputState: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
	if name == "BikeBell" then
		if inputState == Enum.UserInputState.Begin then
			ringBell()
		end
	elseif name == "BikeBoost" then
		boostKey = inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change
	elseif name == "BikeCamera" then
		if inputState == Enum.UserInputState.Begin then
			State.cameraMode = if State.cameraMode == "chase" then "first" else "chase"
		end
	end
	return Enum.ContextActionResult.Sink
end

local function setJump(enabled: boolean)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, enabled)
	end
end

local function bindActions()
	local high = Enum.ContextActionPriority.High.Value + 10
	-- Space rings the bell instead of jumping off the bike
	ContextActionService:BindActionAtPriority("BikeBell", onAction, false, high, Enum.KeyCode.Space, Enum.KeyCode.B, Enum.KeyCode.ButtonY)
	ContextActionService:BindActionAtPriority("BikeBoost", onAction, false, high, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonX)
	ContextActionService:BindActionAtPriority("BikeCamera", onAction, false, high, Enum.KeyCode.C, Enum.KeyCode.ButtonR3)
end

local function unbindActions()
	for _, name in { "BikeBell", "BikeBoost", "BikeCamera" } do
		ContextActionService:UnbindAction(name)
	end
	boostKey = false
end

-- attaching to the bike the server gave us -------------------------------------------
local function detach()
	model, root, alignPos, alignRot = nil, nil, nil, nil
	splashing = false
	unbindActions()
	setJump(true)
	local ride = State.ride
	ride.onBike = false
	ride.model = nil
	ride.speed = 0
	ride.boosting = false
end

local function attach(m: Model)
	local r = m:WaitForChild("Root", 10) :: BasePart?
	if not r then
		return
	end
	local ap = r:WaitForChild("DrivePosition", 10) :: AlignPosition?
	local ao = r:WaitForChild("DriveOrientation", 10) :: AlignOrientation?
	local ref = player:FindFirstChild("Bike") :: ObjectValue?
	if not ap or not ao or not ref or ref.Value ~= m then
		return
	end
	model, root, alignPos, alignRot = m, r, ap, ao
	local def = bikeDef(m:GetAttribute("BikeId"))
	params = { topSpeed = def.topSpeed, power = def.power, handling = def.handling, wheel = def.wheel }
	local keepStamina = state.stamina
	state = BikePhysics.newState()
	state.stamina = keepStamina
	local cf = r.CFrame
	pos = cf.Position - Vector3.new(0, BikeModel.RootHeight, 0)
	local lv = cf.LookVector
	yaw = math.atan2(-lv.X, -lv.Z)
	pitch, vy = 0, 0
	holdUntil = os.clock() + 4
	table.clear(safe)
	refreshFilter()
	bindActions()
	setJump(false)
	local ride = State.ride
	ride.onBike = true
	ride.model = m
	ride.pos = pos
	ride.yaw = yaw
end

function BikeController.init()
	task.spawn(getControls)
	local ref = player:WaitForChild("Bike") :: ObjectValue
	local function changed()
		local v = ref.Value
		detach()
		if v and v:IsA("Model") then
			task.spawn(attach, v)
		end
	end
	ref.Changed:Connect(changed)
	changed()

	player.CharacterAdded:Connect(function()
		if model then
			setJump(false)
		end
	end)

	-- gamepad triggers for pedalling and braking
	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			triggerGas = input.Position.Z
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			triggerBrake = input.Position.Z
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			triggerGas = 0
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			triggerBrake = 0
		end
	end)

	State.remote("Teleport").OnClientEvent:Connect(function(cf: CFrame)
		local lv = cf.LookVector
		BikeController.teleport(cf.Position, math.atan2(-lv.X, -lv.Z))
	end)

	RunService.PreSimulation:Connect(step)
	task.spawn(function()
		while true do
			task.wait(1)
			refreshFilter()
		end
	end)
end

return BikeController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">Detail</string>
            <string name="Source"><![CDATA[--!strict
-- Adds windows, doors, gable tops, balconies and road markings to the streets
-- around the player (made on this computer only, and removed again when you
-- ride away), so real cities look detailed without slowing anyone down.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Build = require(Shared.Build)
local PartFactory = require(Shared.PartFactory)
local Decode = require(Shared.Real.Decode)
local Facades = require(Shared.Real.Facades)
local State = require(script.Parent.State)

local M = 3
local CELL = 64 * M -- studs per detail cell
local RADIUS = 115 * M -- how far around the player details are shown
local KEEP = RADIUS + CELL
local PARTS_PER_FRAME = 350

local Detail = {}

type Cell = { b: { number }, r: { { number } }, c: { number } }
type CityDetail = {
	id: string,
	origin: Vector3,
	style: string,
	buildings: { Decode.Building },
	roads: { Decode.Road },
	crossings: { Decode.Prop },
	cells: { [string]: Cell },
}
type Job = { key: string, prims: { Build.Prim }, i: number, model: Model }

local folder = Instance.new("Folder")
folder.Name = "Detail"
folder.Parent = Workspace

local city: CityDetail? = nil
local loadingId: string? = nil
local active: { [string]: Model } = {}
local jobs: { Job } = {}

local function cellKey(cx: number, cz: number): string
	return cx .. "," .. cz
end

local function cellOf(x: number, z: number): (number, number)
	return math.floor(x / CELL), math.floor(z / CELL)
end

local function getCell(cells: { [string]: Cell }, x: number, z: number): Cell
	local cx, cz = cellOf(x, z)
	local k = cellKey(cx, cz)
	local c = cells[k]
	if not c then
		c = { b = {}, r = {}, c = {} }
		cells[k] = c
	end
	return c
end

local function clear()
	table.clear(jobs)
	for _, m in active do
		m:Destroy()
	end
	table.clear(active)
end

--- Read a city's data (only real cities have it).
local function load(id: string): CityDetail?
	for _, c in Config.Cities do
		if c.id == id then
			local mod = Shared.Cities:FindFirstChild(c.module)
			if not mod then
				return nil
			end
			local gen = (require :: any)(mod)
			local data = gen.data
			if not data then
				return nil
			end
			local cd: CityDetail = {
				id = id,
				origin = c.origin,
				style = data.meta.style,
				buildings = Decode.buildings(data.buildings),
				roads = {},
				crossings = {},
				cells = {},
			}
			task.wait()
			for i, bld in cd.buildings do
				if string.find(bld.flags, "[23]") then
					table.insert(getCell(cd.cells, bld.xs[1], bld.zs[1]).b, i)
				end
			end
			task.wait()
			cd.roads = Decode.roads(data.roads)
			for ri, r in cd.roads do
				if r.kind ~= 1 and r.kind ~= 6 then
					continue
				end
				if r.kind == 1 and bit32.band(r.flags, 64 + 32) == 0 then
					continue
				end
				for i = 1, #r.xs - 1 do
					local cell = getCell(cd.cells, (r.xs[i] + r.xs[i + 1]) / 2, (r.zs[i] + r.zs[i + 1]) / 2)
					table.insert(cell.r, { ri, i })
				end
			end
			task.wait()
			for _, p in Decode.props(data.props) do
				if p.kind == 11 then
					table.insert(cd.crossings, p)
					table.insert(getCell(cd.cells, p.x, p.z).c, #cd.crossings)
				end
			end
			return cd
		end
	end
	return nil
end

local function makeCell(cd: CityDetail, key: string)
	local cell = cd.cells[key]
	local model = Instance.new("Model")
	model.Name = key
	active[key] = model
	if not cell then
		return
	end
	local b = Build.new()
	for _, bi in cell.b do
		Facades.building(b, cd.buildings[bi], cd.style, Build.rng(bi * 7919 + 13))
	end
	for _, rs in cell.r do
		local r = cd.roads[rs[1]]
		local i = rs[2]
		Facades.road(b, {
			kind = r.kind,
			width = r.width,
			surf = r.surf,
			flags = r.flags,
			xs = { r.xs[i], r.xs[i + 1] },
			zs = { r.zs[i], r.zs[i + 1] },
		}, cd.style)
	end
	for _, ci in cell.c do
		Facades.crossing(b, cd.crossings[ci], cd.style)
	end
	if #b.prims > 0 then
		table.insert(jobs, { key = key, prims = b.prims, i = 1, model = model })
	end
end

local function playerPos(): Vector3?
	local ride = State.ride
	if ride.onBike then
		return ride.pos
	end
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if hrp then hrp.Position else nil
end

local function refresh()
	local id = State.city()
	if not city or city.id ~= id then
		if loadingId == id then
			return
		end
		clear()
		city = nil
		loadingId = id
		task.spawn(function()
			local ok, result = pcall(load, id)
			if loadingId == id then
				-- the hub has no map data: remember that with an empty city
				city = if ok and result then result else { id = id, origin = Vector3.zero, style = "", buildings = {}, roads = {}, crossings = {}, cells = {} }
				loadingId = nil
				if not ok then
					warn("[Bike the World] details failed: " .. tostring(result))
				end
			end
		end)
		return
	end
	local cd = city :: CityDetail
	local pos = playerPos()
	if not pos then
		return
	end
	local lx, lz = pos.X - cd.origin.X, pos.Z - cd.origin.Z
	-- drop cells that are far away
	for key, model in active do
		local cx, cz = string.match(key, "^(-?%d+),(-?%d+)$")
		local mx = (tonumber(cx) :: number + 0.5) * CELL
		local mz = (tonumber(cz) :: number + 0.5) * CELL
		if (mx - lx) ^ 2 + (mz - lz) ^ 2 > KEEP * KEEP then
			model:Destroy()
			active[key] = nil
			for i = #jobs, 1, -1 do
				if jobs[i].key == key then
					table.remove(jobs, i)
				end
			end
		end
	end
	-- add the nearest missing cells first
	local want = {}
	local c0x, c0z = cellOf(lx - RADIUS, lz - RADIUS)
	local c1x, c1z = cellOf(lx + RADIUS, lz + RADIUS)
	for cx = c0x, c1x do
		for cz = c0z, c1z do
			local mx, mz = (cx + 0.5) * CELL, (cz + 0.5) * CELL
			local d = (mx - lx) ^ 2 + (mz - lz) ^ 2
			local key = cellKey(cx, cz)
			if d < RADIUS * RADIUS and not active[key] then
				table.insert(want, { key = key, d = d })
			end
		end
	end
	table.sort(want, function(a, b)
		return a.d < b.d
	end)
	for i = 1, math.min(#want, 3) do
		makeCell(cd, want[i].key)
	end
end

local function work()
	local cd = city
	if not cd then
		return
	end
	local budget = PARTS_PER_FRAME
	while budget > 0 and #jobs > 0 do
		local job = jobs[1]
		local last = math.min(#job.prims, job.i + budget - 1)
		for i = job.i, last do
			local p = job.prims[i]
			local part = PartFactory.make(p, cd.origin)
			if p.tag then
				CollectionService:AddTag(part, p.tag)
			end
			part.Parent = job.model
		end
		budget -= last - job.i + 1
		job.i = last + 1
		if job.i > #job.prims then
			job.model.Parent = folder
			table.remove(jobs, 1)
		elseif not job.model.Parent then
			job.model.Parent = folder
		end
	end
end

function Detail.init()
	RunService.Heartbeat:Connect(work)
	task.spawn(function()
		while true do
			task.wait(0.35)
			local ok, err = pcall(function()
				refresh()
			end)
			if not ok then
				warn("[Bike the World] details: " .. tostring(err))
			end
		end
	end)
end

return Detail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Local eye candy and pick-ups: street lights and glowing windows at night,
-- the sparkling Eiffel Tower, windmill sails, carousels, spinning coins
-- (and collecting them), rain, delivery markers and splashes.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)
local Sfx = require(script.Parent.Sfx)

local Effects = {}

local player = Players.LocalPlayer
local localFolder = Instance.new("Folder")
localFolder.Name = "LocalEffects"
localFolder.Parent = Workspace

-- Night lights ------------------------------------------------------------------------
local WINDOW_GLOW = { Color3.fromRGB(255, 214, 140), Color3.fromRGB(255, 196, 120), Color3.fromRGB(255, 230, 170) }

type Orig = { color: Color3, material: Enum.Material, transparency: number }
local orig: { [BasePart]: Orig } = {}
local pending: { BasePart } = {}

local function remember(p: BasePart): Orig
	local o = orig[p]
	if not o then
		o = { color = p.Color, material = p.Material, transparency = p.Transparency }
		orig[p] = o
	end
	return o :: Orig
end

local function applyNight(p: BasePart)
	if not p.Parent then
		return
	end
	local night = State.night
	local o = remember(p)
	if CollectionService:HasTag(p, "NightWindow") then
		if night then
			p.Material = Enum.Material.Neon
			p.Color = WINDOW_GLOW[(#p.Name + math.floor(p.Position.X)) % #WINDOW_GLOW + 1]
		else
			p.Material = o.material
			p.Color = o.color
		end
	elseif CollectionService:HasTag(p, "StreetLight") or CollectionService:HasTag(p, "BridgeBulb") then
		p.Material = if night then Enum.Material.Neon else o.material
		local light = p:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = night
		end
	elseif CollectionService:HasTag(p, "Sparkle") then
		p.Transparency = if night then 0 else 1
	end
end

local NIGHT_TAGS = { "NightWindow", "StreetLight", "BridgeBulb", "Sparkle" }

local function queueAll()
	for _, tag in NIGHT_TAGS do
		for _, inst in CollectionService:GetTagged(tag) do
			if inst:IsA("BasePart") then
				table.insert(pending, inst)
			end
		end
	end
end

-- Moving things (sails, carousels, sparkles, beacons) --------------------------------------
local sails: { [BasePart]: Vector3 } = {} -- part -> hub position
local spinners: { [BasePart]: boolean } = {}
local sparkles: { [BasePart]: boolean } = {}
local beacons: { [BasePart]: boolean } = {}
local lights: { [BasePart]: number } = {} -- traffic light part -> 1 red, 2 amber, 3 green
local billboards: { [BasePart]: number } = {}

-- Coins -------------------------------------------------------------------------------
type Coin = { base: Vector3, id: string, phase: number }
local coins: { [BasePart]: Coin } = {}
local hiddenUntil: { [string]: number } = {}
local COIN_RESPAWN = 40

local function addCoin(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local id = inst:GetAttribute("Id")
	if type(id) ~= "string" then
		return
	end
	coins[inst] = { base = inst.Position, id = id, phase = (inst.Position.X + inst.Position.Z) * 0.37 }
	local hide = hiddenUntil[id]
	inst.Transparency = if hide and hide > os.clock() then 1 else 0
end

local function collectorPos(): Vector3?
	local ride = State.ride
	if ride.onBike then
		return ride.pos + Vector3.new(0, 2.5, 0)
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if hrp then hrp.Position else nil
end

local coinParts: { BasePart } = {}
local coinCFrames: { CFrame } = {}

local function updateCoins()
	local t = os.clock()
	local cam = Workspace.CurrentCamera.CFrame.Position
	local me = collectorPos()
	table.clear(coinParts)
	table.clear(coinCFrames)
	for part, c in coins do
		if not part.Parent then
			coins[part] = nil
			continue
		end
		local hide = hiddenUntil[c.id]
		if hide then
			if hide > t then
				continue
			end
			hiddenUntil[c.id] = nil
			part.Transparency = 0
		end
		if me and (c.base - me).Magnitude < 6 then
			hiddenUntil[c.id] = t + COIN_RESPAWN
			part.Transparency = 1
			Sfx.play("Coin", nil, 0.5, 0.95 + math.random() * 0.1)
			State.remote("CollectCoin"):FireServer(c.id)
			continue
		end
		if (c.base - cam).Magnitude < 250 then
			table.insert(coinParts, part)
			table.insert(coinCFrames, CFrame.new(c.base + Vector3.new(0, math.sin(t * 2 + c.phase) * 0.35, 0)) * CFrame.Angles(0, t * 3 + c.phase, 0))
		end
	end
	if #coinParts > 0 then
		Workspace:BulkMoveTo(coinParts, coinCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Rain ------------------------------------------------------------------------------------
local rainPart: Part? = nil
local rainEmitter: ParticleEmitter? = nil

local function makeRain()
	local p = Instance.new("Part")
	p.Name = "Rain"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(160, 1, 160)
	p.Parent = localFolder
	local e = Instance.new("ParticleEmitter")
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.9, 1.1)
	e.Speed = NumberRange.new(90, 110)
	e.Size = NumberSequence.new(0.12)
	e.Transparency = NumberSequence.new(0.35)
	e.Color = ColorSequence.new(Color3.fromRGB(190, 205, 225))
	e.LightInfluence = 1
	e.Orientation = Enum.ParticleOrientation.VelocityParallel
	e.Parent = p
	rainPart = p
	rainEmitter = e
end

local function updateRain(dt: number)
	local city = State.city()
	local raining = Workspace:GetAttribute("Rain_" .. city) == true
	State.rain = raining
	local e = rainEmitter
	local p = rainPart
	if not e or not p then
		return
	end
	local target = if raining then 900 else 0
	e.Rate += (target - e.Rate) * math.min(1, dt * 0.8)
	if e.Rate < 5 then
		e.Rate = 0
	end
	e.Enabled = e.Rate > 0
	p.CFrame = CFrame.new(Workspace.CurrentCamera.CFrame.Position + Vector3.new(0, 45, 0))
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		local want = if raining then 0.42 else 0.28
		atmo.Density += (want - atmo.Density) * math.min(1, dt * 0.3)
	end
	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		local want = if raining then 0.9 else 0.55
		clouds.Cover += (want - clouds.Cover) * math.min(1, dt * 0.3)
	end
end

-- Delivery marker ---------------------------------------------------------------------
local marker: Part? = nil

local function updateDeliveryMarker()
	if marker then
		marker:Destroy()
		marker = nil
	end
	local d = State.delivery
	if not d then
		return
	end
	local p = Instance.new("Part")
	p.Name = "DeliveryMarker"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 200, 40)
	p.Transparency = 0.35
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(70, 4, 4)
	p.CFrame = CFrame.new(d.to + Vector3.new(0, 35, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, -26, 0)
	gui.AlwaysOnTop = true
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Text = "📦 Deliver here!"
	label.Parent = gui
	p.Parent = localFolder
	marker = p
end

-- Splash ------------------------------------------------------------------------------
local function splashAt(at: Vector3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(4, 0.2, 4)
	p.CFrame = CFrame.new(at)
	p.Parent = localFolder
	local e = Instance.new("ParticleEmitter")
	e.EmissionDirection = Enum.NormalId.Top
	e.SpreadAngle = Vector2.new(35, 35)
	e.Speed = NumberRange.new(18, 30)
	e.Acceleration = Vector3.new(0, -60, 0)
	e.Lifetime = NumberRange.new(0.6, 1)
	e.Size = NumberSequence.new(0.6, 0.1)
	e.Color = ColorSequence.new(Color3.fromRGB(210, 235, 255))
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Rate = 0
	e.Parent = p
	e:Emit(60)
	task.delay(2, function()
		p:Destroy()
	end)
end
Effects.splashAt = splashAt

-- Main loop ---------------------------------------------------------------------------------
local function onRender(dt: number)
	local t = os.clock()
	-- day / night
	local clock = Lighting.ClockTime
	local night = clock >= 18.25 or clock < 6.25
	if night ~= State.night then
		State.night = night
		queueAll()
	end
	for _ = 1, 400 do
		local p = table.remove(pending)
		if not p then
			break
		end
		applyNight(p)
	end
	-- windmill sails turn around their hub
	for part, hub in sails do
		if not part.Parent then
			sails[part] = nil
			continue
		end
		local axis = part.CFrame.ZVector
		part.CFrame = CFrame.new(hub) * CFrame.fromAxisAngle(axis, dt * 0.6) * CFrame.new(-hub) * part.CFrame
	end
	for part in spinners do
		if not part.Parent then
			spinners[part] = nil
			continue
		end
		part.CFrame *= CFrame.Angles(dt * 0.7, 0, 0)
	end
	if night then
		for part in sparkles do
			if part.Parent then
				part.Transparency = if math.random() < 0.35 then 0 else 0.9
			else
				sparkles[part] = nil
			end
		end
	end
	local blink = night and (t % 1.5) < 0.6
	for part in beacons do
		if part.Parent then
			part.Transparency = if night and not blink then 0.8 else 0
		else
			beacons[part] = nil
		end
	end
	-- traffic lights: green 12 s, amber 3 s, red 15 s (each crossing a bit different)
	for part, which in lights do
		if not part.Parent then
			lights[part] = nil
			continue
		end
		local phase = (t + (part.Position.X + part.Position.Z) * 0.05) % 30
		local on = if phase < 12 then 3 elseif phase < 15 then 2 else 1
		part.Transparency = if on == which then 0 else 0.75
	end
	-- neon billboards slowly change colour
	for part, seed in billboards do
		if not part.Parent then
			billboards[part] = nil
			continue
		end
		if math.floor(t * 2 + seed) % 7 == 0 then
			part.Color = Color3.fromHSV(((t * 0.05) + seed * 0.13) % 1, 0.75, 1)
		end
	end
	for _, ring in CollectionService:GetTagged("ShopMarker") do
		if ring:IsA("BasePart") then
			ring.Transparency = 0.45 + math.sin(t * 3) * 0.15
		end
	end
	updateCoins()
	updateRain(dt)
	if marker then
		marker.Transparency = 0.3 + math.sin(t * 4) * 0.15
	end
end

local function watch(tag: string, added: (Instance) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(added, inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(added)
end

function Effects.init(onSplash: RBXScriptSignal?)
	makeRain()
	for _, tag in NIGHT_TAGS do
		watch(tag, function(inst)
			if inst:IsA("BasePart") then
				remember(inst)
				if State.night or tag == "Sparkle" then
					table.insert(pending, inst)
				end
			end
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
			if inst:IsA("BasePart") then
				orig[inst] = nil
			end
		end)
	end
	watch("Sail", function(inst)
		if inst:IsA("BasePart") then
			sails[inst] = inst.Position - inst.CFrame.UpVector * (inst.Size.Y / 2)
		end
	end)
	watch("Spin", function(inst)
		if inst:IsA("BasePart") then
			spinners[inst] = true
		end
	end)
	watch("Sparkle", function(inst)
		if inst:IsA("BasePart") then
			sparkles[inst] = true
		end
	end)
	watch("NightBeacon", function(inst)
		if inst:IsA("BasePart") then
			beacons[inst] = true
		end
	end)
	watch("Beacon", function(inst)
		if inst:IsA("BasePart") then
			beacons[inst] = true
		end
	end)
	for i = 1, 3 do
		watch("TrafficLight" .. i, function(inst)
			if inst:IsA("BasePart") then
				lights[inst] = i
				inst.Transparency = 0.75
			end
		end)
	end
	watch("Billboard", function(inst)
		if inst:IsA("BasePart") then
			billboards[inst] = math.random() * 10
		end
	end)
	watch("Coin", addCoin)
	State.deliveryChanged.Event:Connect(updateDeliveryMarker)
	if onSplash then
		onSplash:Connect(function(at: Vector3)
			splashAt(at)
		end)
	end
	RunService.RenderStepped:Connect(onRender)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- The on-screen display: coins, landmarks, speed and boost, messages, the
-- landmark card, the delivery panel with its arrow, and the big buttons.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)
local Sfx = require(script.Parent.Sfx)

local C = Ui.Colors

local Hud = {}

export type Callbacks = {
	shop: () -> (),
	travel: () -> (),
	bike: () -> (),
	camera: () -> (),
	bell: () -> (),
}

local gui: ScreenGui
local coinLabel: TextLabel
local coinPill: Frame
local landmarkLabel: TextLabel
local toastList: Frame
local speedLabel: TextLabel
local speedFrame: Frame
local staminaFill: Frame
local deliveryFrame: Frame
local deliveryTitle: TextLabel
local deliveryInfo: TextLabel
local deliveryArrow: TextLabel
local banner: TextLabel
local splashLabel: TextLabel
local mobileButtons: Frame
local helpLabel: TextLabel

local shownCoins = 0
local targetCoins = 0

local CITY_FLAGS: { [string]: string } = {
	hub = "🌍",
	amsterdam = "🇳🇱",
	paris = "🇫🇷",
	newyork = "🇺🇸",
}
Hud.flags = CITY_FLAGS

local function cityName(id: string): string
	if id == "hub" then
		return "World Bike Hub"
	end
	for _, c in Config.Cities do
		if c.id == id then
			return c.name
		end
	end
	return id
end
Hud.cityName = cityName

--- A message that pops in at the top and fades away.
function Hud.toast(text: string, kind: string?)
	local color = if kind == "good" then C.green elseif kind == "bad" then C.red elseif kind == "city" then C.blue else C.panelDark
	local f = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.1,
		Parent = toastList,
	}) :: Frame
	Ui.corner(f, 12)
	Ui.stroke(f, Color3.fromRGB(20, 24, 40), 2)
	Ui.label({ Size = UDim2.fromScale(1, 1), Text = text, MaxTextSize = 24, TextStrokeTransparency = 0.8, Parent = f })
	Ui.pad(f, 6)
	Ui.pop(f, 1.1)
	task.delay(4, function()
		Ui.tween(f, 0.4, { BackgroundTransparency = 1 })
		for _, d in f:GetDescendants() do
			if d:IsA("TextLabel") then
				Ui.tween(d, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
			elseif d:IsA("UIStroke") then
				Ui.tween(d, 0.4, { Transparency = 1 })
			end
		end
		task.wait(0.45)
		f:Destroy()
	end)
	-- keep at most 4 messages
	local frames = {}
	for _, ch in toastList:GetChildren() do
		if ch:IsA("Frame") then
			table.insert(frames, ch)
		end
	end
	if #frames > 4 then
		frames[1]:Destroy()
	end
end

--- "+5" flying up from the coin counter.
function Hud.coins(amount: number, reason: string?)
	local big = reason == "landmark" or reason == "delivery" or reason == "daily"
	local l = Ui.label({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 190, 0, 30),
		Size = UDim2.fromOffset(160, if big then 50 else 34),
		Text = "+" .. amount .. " 🪙",
		TextColor3 = C.gold,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = if big then 44 else 30,
		Parent = gui,
	})
	Ui.tween(l, 1.2, { Position = UDim2.new(0, 190, 0, -10), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1.3, function()
		l:Destroy()
	end)
	if reason ~= "coin" then
		Sfx.play("Coin", nil, 0.5, 0.8)
	end
end

--- The "you found a landmark" card.
function Hud.landmark(info: { [string]: any })
	Sfx.play("Landmark", nil, 0.8)
	local card = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0.9, 0, 0, 210),
		BackgroundColor3 = C.panel,
		Parent = gui,
	}) :: Frame
	Ui.new("UISizeConstraint", { MaxSize = Vector2.new(520, 260), Parent = card })
	Ui.corner(card, 20)
	Ui.stroke(card, C.gold, 5)
	Ui.pad(card, 14)
	Ui.label({ Size = UDim2.new(1, 0, 0, 30), Text = "📍 New landmark found!", TextColor3 = C.orange, TextStrokeTransparency = 1, MaxTextSize = 26, Parent = card })
	Ui.label({ Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, 0, 0, 44), Text = tostring(info.name), TextColor3 = C.ink, TextStrokeTransparency = 1, MaxTextSize = 40, Parent = card })
	Ui.label({
		Position = UDim2.new(0, 0, 0, 80),
		Size = UDim2.new(1, 0, 0, 70),
		Text = tostring(info.fact),
		TextColor3 = C.ink,
		TextStrokeTransparency = 1,
		TextWrapped = true,
		Font = Enum.Font.GothamMedium,
		MaxTextSize = 20,
		Parent = card,
	})
	Ui.label({
		Position = UDim2.new(0, 0, 1, -34),
		Size = UDim2.new(0.6, 0, 0, 34),
		Text = string.format("+%d 🪙   (%d found)", info.coins or 0, info.found or 0),
		TextColor3 = C.orange,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = card,
	})
	local ok = Ui.button("Cool!", C.green, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0), Size = UDim2.fromOffset(110, 40), Parent = card })
	ok.Activated:Connect(function()
		card:Destroy()
	end)
	Ui.pop(card, 0.6)
	task.delay(10, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

function Hud.splash()
	splashLabel.Visible = true
	splashLabel.TextTransparency = 0
	splashLabel.TextStrokeTransparency = 0
	Ui.pop(splashLabel, 1.6)
	task.delay(0.9, function()
		Ui.tween(splashLabel, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
end

local function showBanner(id: string)
	banner.Text = (CITY_FLAGS[id] or "") .. "  " .. string.upper(cityName(id))
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0
	Ui.pop(banner, 1.3)
	task.delay(3, function()
		Ui.tween(banner, 0.8, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
end

--- Delivery messages from the server.
function Hud.delivery(data: { [string]: any })
	if data.state == "start" then
		State.delivery = {
			item = data.item,
			shop = data.shop,
			to = data.to,
			limit = data.limit,
			started = os.clock(),
			metres = data.metres,
		}
		Hud.toast("📦 Order! Bring " .. tostring(data.item) .. " to the glowing marker.", "good")
	elseif data.state == "done" then
		State.delivery = nil
		local msg = if data.fast then "Super fast delivery! +" else "Delivered! +"
		Hud.toast("🎉 " .. msg .. tostring(data.coins) .. " coins", "good")
	else
		State.delivery = nil
		Hud.toast("Delivery cancelled.", "info")
	end
	State.deliveryChanged:Fire()
end

local function updateProfile()
	local p = State.profile
	if not p then
		return
	end
	if p.coins > targetCoins then
		Ui.pop(coinPill, 1.15)
	end
	targetCoins = p.coins
	landmarkLabel.Text = string.format("📍 %d / %d", p.found, p.totalLandmarks)
end

local function sideButton(parent: Instance, icon: string, caption: string, color: Color3, order: number, onClick: () -> ())
	local holder = Ui.new("Frame", { Size = UDim2.fromOffset(72, 86), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local b = Ui.button(icon, color, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(4, 0), MaxTextSize = 36, Parent = holder })
	Ui.label({ Position = UDim2.fromOffset(0, 64), Size = UDim2.fromOffset(72, 20), Text = caption, MaxTextSize = 16, TextStrokeTransparency = 0.3, Parent = holder })
	b.Activated:Connect(onClick)
	return b
end

local function onRender()
	-- count coins up smoothly
	if shownCoins ~= targetCoins then
		local diff = targetCoins - shownCoins
		local stepBy = math.max(1, math.floor(math.abs(diff) / 12))
		shownCoins += if diff > 0 then math.min(diff, stepBy) else math.max(diff, -stepBy)
		coinLabel.Text = Ui.commas(shownCoins)
	end
	-- speed and boost
	local ride = State.ride
	speedFrame.Visible = ride.onBike
	mobileButtons.Visible = ride.onBike and State.isTouch()
	if ride.onBike then
		speedLabel.Text = tostring(math.floor(math.abs(ride.speed) * 3.6 + 0.5))
		staminaFill.Size = UDim2.fromScale(math.clamp(ride.stamina, 0, 1), 1)
		staminaFill.BackgroundColor3 = if ride.boosting then C.orange else C.gold
	end
	-- delivery arrow and countdown
	local d = State.delivery
	deliveryFrame.Visible = d ~= nil
	if d then
		local me = ride.pos
		if not ride.onBike then
			local char = Players.LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				me = hrp.Position
			end
		end
		local dir = Vector3.new(d.to.X - me.X, 0, d.to.Z - me.Z)
		local metres = dir.Magnitude / Config.M
		local cam = Workspace.CurrentCamera.CFrame
		local look = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
		local right = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
		if dir.Magnitude > 0.1 and look.Magnitude > 0.01 then
			deliveryArrow.Rotation = math.deg(math.atan2(dir:Dot(right.Unit), dir:Dot(look.Unit)))
		end
		local left = d.limit - (os.clock() - d.started)
		local timeText = if left > 0 then string.format("⏱ %d:%02d", math.floor(left / 60), math.floor(left % 60)) else "Take your time!"
		deliveryTitle.Text = "📦 Bring " .. d.item
		deliveryInfo.Text = string.format("%d m   %s", math.floor(metres), timeText)
	end
end

function Hud.init(cb: Callbacks)
	gui = Ui.new("ScreenGui", {
		Name = "Hud",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})

	-- coins and landmarks (top left)
	coinPill = Ui.new("Frame", { Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(170, 46), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.15, Parent = gui })
	Ui.corner(coinPill, 23)
	Ui.stroke(coinPill, C.gold, 3)
	Ui.label({ Position = UDim2.fromOffset(8, 4), Size = UDim2.fromOffset(38, 38), Text = "🪙", Parent = coinPill })
	coinLabel = Ui.label({ Position = UDim2.fromOffset(50, 4), Size = UDim2.new(1, -60, 0, 38), Text = "0", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.gold, MaxTextSize = 30, Parent = coinPill })
	local lmPill = Ui.new("Frame", { Position = UDim2.fromOffset(12, 62), Size = UDim2.fromOffset(130, 34), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.15, Parent = gui })
	Ui.corner(lmPill, 17)
	landmarkLabel = Ui.label({ Size = UDim2.fromScale(1, 1), Text = "📍 0 / 0", MaxTextSize = 22, Parent = lmPill })

	-- delivery panel
	deliveryFrame = Ui.new("Frame", { Position = UDim2.fromOffset(12, 104), Size = UDim2.fromOffset(250, 96), BackgroundColor3 = C.panel, Visible = false, Parent = gui })
	Ui.corner(deliveryFrame, 16)
	Ui.stroke(deliveryFrame, C.orange, 3)
	deliveryTitle = Ui.label({ Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -84, 0, 30), Text = "", TextColor3 = C.ink, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = deliveryFrame })
	deliveryInfo = Ui.label({ Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -84, 0, 24), Text = "", TextColor3 = C.blue, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = deliveryFrame })
	deliveryArrow = Ui.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -40, 0.5, 0), Size = UDim2.fromOffset(60, 60), Text = "⬆", TextColor3 = C.orange, TextStrokeTransparency = 0, MaxTextSize = 56, Parent = deliveryFrame })
	local cancel = Ui.button("Cancel", C.grey, { Position = UDim2.fromOffset(10, 66), Size = UDim2.fromOffset(80, 24), MaxTextSize = 16, Parent = deliveryFrame })
	cancel.Activated:Connect(function()
		State.remote("CancelDelivery"):FireServer()
	end)

	-- messages
	toastList = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(0.5, 0, 0, 220), BackgroundTransparency = 1, Parent = gui })
	Ui.new("UISizeConstraint", { MaxSize = Vector2.new(560, 220), MinSize = Vector2.new(260, 0), Parent = toastList })
	Ui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = toastList })

	banner = Ui.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.new(0.8, 0, 0, 80), Text = "", TextTransparency = 1, TextStrokeTransparency = 1, TextColor3 = Color3.new(1, 1, 1), MaxTextSize = 72, Parent = gui })
	splashLabel = Ui.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.new(0.8, 0, 0, 90), Text = "SPLASH! 💦", TextColor3 = Color3.fromRGB(120, 200, 255), Visible = false, MaxTextSize = 80, Parent = gui })

	-- speed and boost (bottom centre)
	speedFrame = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(190, 74), BackgroundColor3 = C.panelDark, BackgroundTransparency = 0.2, Visible = false, Parent = gui })
	Ui.corner(speedFrame, 18)
	speedLabel = Ui.label({ Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(90, 46), Text = "0", MaxTextSize = 44, TextXAlignment = Enum.TextXAlignment.Right, Parent = speedFrame })
	Ui.label({ Position = UDim2.fromOffset(106, 16), Size = UDim2.fromOffset(70, 26), Text = "km/h", MaxTextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, Parent = speedFrame })
	local bar = Ui.new("Frame", { Position = UDim2.new(0, 34, 1, -18), Size = UDim2.new(1, -46, 0, 10), BackgroundColor3 = Color3.fromRGB(60, 66, 90), Parent = speedFrame })
	Ui.corner(bar, 5)
	staminaFill = Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.gold, Parent = bar })
	Ui.corner(staminaFill, 5)
	Ui.label({ Position = UDim2.new(0, 8, 1, -24), Size = UDim2.fromOffset(22, 22), Text = "⚡", Parent = speedFrame })

	-- big menu buttons (right side)
	local side = Ui.new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.45, 0), Size = UDim2.fromOffset(72, 4 * 92), BackgroundTransparency = 1, Parent = gui })
	Ui.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = side })
	sideButton(side, "🛒", "Shop", C.green, 1, cb.shop)
	sideButton(side, "🌍", "Travel", C.blue, 2, cb.travel)
	sideButton(side, "🚲", "Bike", C.orange, 3, cb.bike)
	sideButton(side, "🎥", "Camera", C.purple, 4, cb.camera)

	-- touch buttons while riding
	mobileButtons = Ui.new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(200, 110), BackgroundTransparency = 1, Visible = false, Parent = gui })
	local boost = Ui.button("⚡", C.orange, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(100, 100), MaxTextSize = 54, Parent = mobileButtons })
	boost.MouseButton1Down:Connect(function()
		State.touchBoost = true
	end)
	boost.MouseButton1Up:Connect(function()
		State.touchBoost = false
	end)
	boost.MouseLeave:Connect(function()
		State.touchBoost = false
	end)
	local bell = Ui.button("🔔", C.gold, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -112, 1, -10), Size = UDim2.fromOffset(76, 76), MaxTextSize = 40, Parent = mobileButtons })
	bell.Activated:Connect(cb.bell)

	-- how to play (keyboard), fades after a while
	if not State.isTouch() then
		helpLabel = Ui.label({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -96),
			Size = UDim2.new(0.8, 0, 0, 26),
			Text = "W / S  pedal & brake   •   A / D  steer   •   Shift  boost   •   Space  bell   •   C  camera",
			MaxTextSize = 20,
			TextStrokeTransparency = 0.3,
			Parent = gui,
		})
		task.delay(60, function()
			Ui.tween(helpLabel, 2, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end)
	end

	State.profileChanged.Event:Connect(updateProfile)
	updateProfile()
	local lastCity = State.city()
	Players.LocalPlayer:GetAttributeChangedSignal("City"):Connect(function()
		local now = State.city()
		if now ~= lastCity then
			lastCity = now
			showBanner(now)
		end
	end)
	RunService.RenderStepped:Connect(onRender)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="98">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Bike the World: client start-up. Wires the HUD, menus, the bike and the
-- city effects to the server's messages.

local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("Hud"))
local ShopUI = require(Client:WaitForChild("ShopUI"))
local TravelUI = require(Client:WaitForChild("TravelUI"))
local BikeController = require(Client:WaitForChild("BikeController"))
local BikeCamera = require(Client:WaitForChild("BikeCamera"))
local Animator = require(Client:WaitForChild("Animator"))
local Effects = require(Client:WaitForChild("Effects"))
local Traffic = require(Client:WaitForChild("Traffic"))
local Detail = require(Client:WaitForChild("Detail"))
local Sfx = require(Client:WaitForChild("Sfx"))

Hud.init({
	shop = function()
		ShopUI.toggle()
	end,
	travel = function()
		TravelUI.toggle()
	end,
	bike = function()
		State.remote("ToggleBike"):FireServer()
	end,
	camera = function()
		State.cameraMode = if State.cameraMode == "chase" then "first" else "chase"
	end,
	bell = function()
		BikeController.ringBell()
	end,
})
ShopUI.init(Hud.toast)
TravelUI.init(function()
	if State.ride.onBike then
		BikeController.unstuck()
	else
		State.remote("GoToCity"):FireServer(State.city())
	end
end)
BikeController.init()
BikeCamera.init()
Animator.init()
Effects.init(BikeController.splashed.Event)
Traffic.init()
Detail.init()

BikeController.splashed.Event:Connect(function()
	Hud.splash()
end)
BikeController.bumped.Event:Connect(function(speed: number)
	BikeCamera.bump(speed)
end)

-- messages from the server
State.remote("Profile").OnClientEvent:Connect(function(p)
	State.setProfile(p)
end)
State.remote("Toast").OnClientEvent:Connect(function(text: string, kind: string?)
	Hud.toast(text, kind)
end)
State.remote("Coins").OnClientEvent:Connect(function(amount: number, reason: string?)
	Hud.coins(amount, reason)
end)
State.remote("Landmark").OnClientEvent:Connect(function(info)
	Hud.landmark(info)
end)
State.remote("Delivery").OnClientEvent:Connect(function(data)
	Hud.delivery(data)
end)
State.remote("OpenShop").OnClientEvent:Connect(function()
	ShopUI.open()
end)
State.remote("BellRang").OnClientEvent:Connect(function(bike: Instance?)
	local bell = bike and bike:FindFirstChild("Bell", true)
	if bell and bell:IsA("BasePart") then
		Sfx.bell(bell)
	end
end)

-- first profile
task.spawn(function()
	for _ = 1, 20 do
		local ok, p = pcall(function()
			return State.func("GetProfile"):InvokeServer()
		end)
		if ok and p then
			State.setProfile(p)
			return
		end
		task.wait(1)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
-- Little sound helper. Sound IDs come from Config.Sounds; empty ones fall
-- back to sounds that ship with Roblox.

local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sfx = {}

local FALLBACK: { [string]: string } = {
	Bell = "rbxasset://sounds/electronicpingshort.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Landmark = "rbxasset://sounds/electronicpingshort.wav",
	Purchase = "rbxasset://sounds/electronicpingshort.wav",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Bump = "rbxasset://sounds/action_jump_land.mp3",
}

-- pitch for the fallback sounds, so they don't all sound the same
local FALLBACK_PITCH: { [string]: number } = {
	Bell = 1.6,
	Coin = 2.2,
	Landmark = 0.8,
	Purchase = 1.2,
	Click = 3,
}

local function idFor(name: string): (string, number)
	local id = (Config.Sounds :: { [string]: string })[name]
	if id and id ~= "" then
		return id, 1
	end
	return FALLBACK[name] or "", FALLBACK_PITCH[name] or 1
end

--- Play a sound once. With `at` (a part) it is a 3D sound from that part.
function Sfx.play(name: string, at: BasePart?, volume: number?, pitch: number?)
	local id, basePitch = idFor(name)
	if id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = basePitch * (pitch or 1)
	if at then
		s.RollOffMaxDistance = 120
		s.Parent = at
		s:Play()
		s.Ended:Once(function()
			s:Destroy()
		end)
		task.delay(6, function()
			s:Destroy()
		end)
	else
		s.Parent = SoundService
		SoundService:PlayLocalSound(s)
		task.delay(6, function()
			s:Destroy()
		end)
	end
end

--- The bell goes "ring-ring". The uploaded bell.wav already rings twice;
--- the built-in fallback ping is played twice instead.
function Sfx.bell(at: BasePart?)
	Sfx.play("Bell", at, 0.7)
	if Config.Sounds.Bell == "" then
		task.delay(0.16, function()
			Sfx.play("Bell", at, 0.6, 1.06)
		end)
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[--!strict
-- The shop: bikes, colours and extras for coins, and the Robux items.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)
local Sfx = require(script.Parent.Sfx)

local C = Ui.Colors
local player = Players.LocalPlayer

local ShopUI = {}

local win: Frame
local content: Frame
local tabButtons: { [string]: TextButton } = {}
local current = "bikes"
local toast: (string, string?) -> () = function() end
local priceCache: { [number]: number } = {}

local COSMETIC_ICONS: { [string]: string } = {
	helmet = "⛑️",
	flowers = "💐",
	streamers = "🎏",
	rainbow = "🌈",
	puppy = "🐶",
}
local PASS_ICONS: { [string]: string } = {
	DoubleCoins = "💰",
	GoldenBike = "🏆",
	RainbowTrail = "🌈",
	Puppy = "🐶",
}

local function priceOf(id: number, infoType: Enum.InfoType): number?
	if priceCache[id] then
		return priceCache[id]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfoAsync(id, infoType)
	end)
	if not ok then
		ok, info = pcall(function()
			return (MarketplaceService :: any):GetProductInfo(id, infoType)
		end)
	end
	if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
		priceCache[id] = info.PriceInRobux
		return info.PriceInRobux
	end
	return nil
end

local function card(order: number, accent: Color3): Frame
	local f = Ui.new("Frame", { BackgroundColor3 = C.panel, LayoutOrder = order }) :: Frame
	Ui.corner(f, 16)
	Ui.stroke(f, accent, 3)
	return f
end

local function title(f: Frame, text: string, y: number)
	Ui.label({ Position = UDim2.fromOffset(8, y), Size = UDim2.new(1, -16, 0, 28), Text = text, TextColor3 = C.ink, TextStrokeTransparency = 1, MaxTextSize = 24, Parent = f })
end

local function desc(f: Frame, text: string, y: number, h: number?)
	Ui.label({
		Position = UDim2.fromOffset(10, y),
		Size = UDim2.new(1, -20, 0, h or 34),
		Text = text,
		TextColor3 = Color3.fromRGB(90, 96, 115),
		TextStrokeTransparency = 1,
		TextWrapped = true,
		Font = Enum.Font.GothamMedium,
		MaxTextSize = 14,
		Parent = f,
	})
end

local function actionButton(f: Frame, text: string, color: Color3, onClick: (() -> ())?): TextButton
	local b = Ui.button(text, color, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -24, 0, 40), MaxTextSize = 22, Parent = f })
	if onClick then
		b.Activated:Connect(onClick)
	else
		b.AutoButtonColor = false
	end
	return b
end

local function statBar(f: Frame, y: number, label: string, value: number, color: Color3)
	Ui.label({ Position = UDim2.fromOffset(10, y), Size = UDim2.fromOffset(70, 16), Text = label, TextColor3 = C.ink, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxTextSize = 13, Parent = f })
	local back = Ui.new("Frame", { Position = UDim2.fromOffset(80, y + 3), Size = UDim2.new(1, -92, 0, 10), BackgroundColor3 = Color3.fromRGB(225, 229, 238), Parent = f })
	Ui.corner(back, 5)
	local fill = Ui.new("Frame", { Size = UDim2.fromScale(math.clamp(value, 0.05, 1), 1), BackgroundColor3 = color, Parent = back })
	Ui.corner(fill, 5)
end

-- talking to the server ------------------------------------------------------------
local function buy(kind: string, id: string)
	local ok, msg = State.func("Buy"):InvokeServer(kind, id)
	toast(tostring(msg), if ok then "good" else "bad")
	if ok then
		Sfx.play("Purchase")
		State.func("Equip"):InvokeServer(kind, id)
	end
end

local function equip(kind: string, id: string)
	local ok, msg = State.func("Equip"):InvokeServer(kind, id)
	if not ok then
		toast(tostring(msg), "bad")
	end
end

local function promptPass(key: string)
	local def = Config.GamePasses[key]
	if not def or def.id == 0 then
		toast("Coming soon!", "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, def.id)
end

local function promptProduct(id: number)
	if id == 0 then
		toast("Coming soon!", "info")
		return
	end
	MarketplaceService:PromptProductPurchase(player, id)
end

--- Text for a Robux button; fills in the real price when Roblox tells us.
local function robuxButton(f: Frame, id: number, infoType: Enum.InfoType, onClick: () -> ()): TextButton
	if id == 0 then
		return actionButton(f, "Coming soon", C.grey, onClick)
	end
	local b = actionButton(f, "⭐ Robux", C.purple, onClick)
	task.spawn(function()
		local price = priceOf(id, infoType)
		if price and b.Parent then
			b.Text = "R$ " .. price
		end
	end)
	return b
end

-- tabs --------------------------------------------------------------------------------
local function renderBikes(grid: ScrollingFrame, p: State.Profile)
	for i, def in Config.Bikes do
		local owned = if def.gamePass then p.passes[def.gamePass] == true else p.bikes[def.id] == true
		local f = card(i, if def.gamePass then C.gold else C.blue)
		local sw = Ui.new("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = def.color, Parent = f })
		Ui.corner(sw, 18)
		Ui.label({ Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(36, 36), Text = "🚲", MaxTextSize = 24, Parent = f })
		Ui.label({ Position = UDim2.fromOffset(52, 12), Size = UDim2.new(1, -60, 0, 30), Text = def.name, TextColor3 = C.ink, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = f })
		desc(f, def.description, 50)
		statBar(f, 88, "Speed", (def.topSpeed - 5) / 6.5, C.red)
		statBar(f, 106, "Power", def.power / 1.8, C.orange)
		statBar(f, 124, "Steering", def.handling / 1.35, C.green)
		if owned then
			if p.bike == def.id then
				actionButton(f, "Riding ✓", C.grey, nil)
			else
				actionButton(f, "Ride it!", C.green, function()
					equip("bike", def.id)
				end)
			end
		elseif def.gamePass then
			local gp = def.gamePass :: string
			robuxButton(f, Config.GamePasses[gp].id, Enum.InfoType.GamePass, function()
				promptPass(gp)
			end)
		else
			local afford = p.coins >= def.price
			actionButton(f, "🪙 " .. Ui.commas(def.price), if afford then C.orange else C.grey, function()
				buy("bike", def.id)
			end)
		end
		f.Parent = grid
	end
end

local function renderColors(grid: ScrollingFrame, p: State.Profile)
	for i, def in Config.Colors do
		local owned = p.colors[def.id] == true
		local f = card(i, def.color)
		local sw = Ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(70, 70), BackgroundColor3 = def.color, Parent = f })
		Ui.corner(sw, 35)
		Ui.stroke(sw, Color3.fromRGB(20, 24, 40), 3)
		title(f, def.name, 90)
		if owned then
			if p.color == def.id then
				actionButton(f, "Using ✓", C.grey, nil)
			else
				actionButton(f, "Paint!", C.green, function()
					equip("color", def.id)
				end)
			end
		else
			actionButton(f, "🪙 " .. def.price, if p.coins >= def.price then C.orange else C.grey, function()
				buy("color", def.id)
			end)
		end
		f.Parent = grid
	end
	desc(Ui.new("Frame", { BackgroundTransparency = 1, LayoutOrder = 99, Parent = grid }), "The Golden Bike always stays gold.", 0, 30)
end

local function renderExtras(grid: ScrollingFrame, p: State.Profile)
	for i, def in Config.Cosmetics do
		local owned = if def.gamePass then p.passes[def.gamePass] == true else p.cosmetics[def.id] == true
		local f = card(i, if def.gamePass then C.gold else C.green)
		Ui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(70, 60), Text = COSMETIC_ICONS[def.id] or "🎁", MaxTextSize = 52, Parent = f })
		title(f, def.name, 72)
		desc(f, def.description, 100)
		if owned then
			local wearing = p.worn[def.id] == true
			actionButton(f, if wearing then "Take off" else "Put on!", if wearing then C.grey else C.green, function()
				equip("cosmetic", def.id)
			end)
		elseif def.gamePass then
			local gp = def.gamePass :: string
			robuxButton(f, Config.GamePasses[gp].id, Enum.InfoType.GamePass, function()
				promptPass(gp)
			end)
		else
			actionButton(f, "🪙 " .. def.price, if p.coins >= def.price then C.orange else C.grey, function()
				buy("cosmetic", def.id)
			end)
		end
		f.Parent = grid
	end
end

local function renderRobux(grid: ScrollingFrame, p: State.Profile)
	local order = 0
	local keys = {}
	for key in Config.GamePasses do
		table.insert(keys, key)
	end
	table.sort(keys)
	for _, key in keys do
		local def = Config.GamePasses[key]
		order += 1
		local f = card(order, C.gold)
		Ui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(70, 60), Text = PASS_ICONS[key] or "⭐", MaxTextSize = 52, Parent = f })
		title(f, def.name, 72)
		desc(f, def.description, 100)
		if p.passes[key] then
			actionButton(f, "Owned ✓", C.grey, nil)
		else
			robuxButton(f, def.id, Enum.InfoType.GamePass, function()
				promptPass(key)
			end)
		end
		f.Parent = grid
	end
	for _, prod in Config.Products do
		order += 1
		local f = card(order, C.orange)
		Ui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(70, 60), Text = "🪙", MaxTextSize = 52, Parent = f })
		title(f, Ui.commas(prod.coins) .. " coins", 72)
		desc(f, "A bag of coins for the bike shop.", 100)
		robuxButton(f, prod.id, Enum.InfoType.Product, function()
			promptProduct(prod.id)
		end)
		f.Parent = grid
	end
end

local function render()
	for _, ch in content:GetChildren() do
		if ch.Name == "Grid" then
			ch:Destroy()
		end
	end
	for name, b in tabButtons do
		b.BackgroundColor3 = if name == current then C.blue else C.grey
	end
	local p = State.profile
	if not p then
		return
	end
	local grid = Ui.grid(content, Vector2.new(190, 210))
	grid.Name = "Grid"
	grid.Position = UDim2.fromOffset(0, 54)
	grid.Size = UDim2.new(1, 0, 1, -54)
	if current == "bikes" then
		renderBikes(grid, p)
	elseif current == "colors" then
		renderColors(grid, p)
	elseif current == "extras" then
		renderExtras(grid, p)
	else
		renderRobux(grid, p)
	end
end

function ShopUI.open(tab: string?)
	if tab then
		current = tab
	end
	win.Visible = true
	render()
end

function ShopUI.toggle()
	if win.Visible then
		win.Visible = false
	else
		ShopUI.open()
	end
end

function ShopUI.init(sendToast: (string, string?) -> ())
	toast = sendToast
	local gui = Ui.new("ScreenGui", { Name = "Shop", ResetOnSpawn = false, DisplayOrder = 5, Parent = player:WaitForChild("PlayerGui") })
	win, content = Ui.window(gui, "🛒 Bike Shop", C.green)
	local tabs = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Parent = content })
	Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = tabs })
	for i, t in { { "bikes", "🚲 Bikes" }, { "colors", "🎨 Colours" }, { "extras", "🎁 Extras" }, { "robux", "⭐ Robux" } } do
		local b = Ui.button(t[2], C.grey, { Size = UDim2.new(0.24, -6, 1, 0), LayoutOrder = i, MaxTextSize = 22, Parent = tabs })
		tabButtons[t[1]] = b
		b.Activated:Connect(function()
			current = t[1]
			render()
		end)
	end
	State.profileChanged.Event:Connect(function()
		if win.Visible then
			render()
		end
	end)
end

return ShopUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side shared state: the player's profile, the current ride and the
-- delivery job. Other client modules read this and listen for changes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

export type Profile = {
	coins: number,
	bikes: { [string]: boolean },
	colors: { [string]: boolean },
	cosmetics: { [string]: boolean },
	worn: { [string]: boolean },
	bike: string,
	color: string,
	landmarks: { [string]: boolean },
	found: number,
	totalLandmarks: number,
	landmarkList: { { id: string, name: string, city: string } },
	deliveries: number,
	metres: number,
	passes: { [string]: boolean },
}

export type Delivery = {
	item: string,
	shop: string,
	to: Vector3,
	limit: number,
	started: number,
	metres: number,
}

export type Ride = {
	onBike: boolean,
	model: Model?,
	speed: number, -- m/s
	stamina: number,
	steer: number,
	lean: number,
	crank: number,
	wheel: number,
	boosting: boolean,
	pos: Vector3, -- ground point under the bike
	yaw: number,
}

local State = {}

State.player = Players.LocalPlayer
State.remotes = ReplicatedStorage:WaitForChild("Remotes") :: Folder
State.profile = nil :: Profile?
State.profileChanged = Instance.new("BindableEvent")
State.delivery = nil :: Delivery?
State.deliveryChanged = Instance.new("BindableEvent")
State.ride = {
	onBike = false,
	model = nil,
	speed = 0,
	stamina = 1,
	steer = 0,
	lean = 0,
	crank = 0,
	wheel = 0,
	boosting = false,
	pos = Vector3.zero,
	yaw = 0,
} :: Ride
State.cameraMode = "chase" -- "chase" | "first"
State.night = false
State.rain = false
-- mobile buttons write these; the bike controller reads them
State.touchBoost = false

function State.remote(name: string): RemoteEvent
	return State.remotes:WaitForChild(name) :: RemoteEvent
end

function State.func(name: string): RemoteFunction
	return State.remotes:WaitForChild(name) :: RemoteFunction
end

function State.setProfile(p: Profile?)
	if p then
		State.profile = p
		State.profileChanged:Fire(p)
	end
end

function State.city(): string
	local c = State.player:GetAttribute("City")
	return if type(c) == "string" then c else "hub"
end

--- Is this a phone or tablet (no keyboard)?
function State.isTouch(): boolean
	local UserInputService = game:GetService("UserInputService")
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">Traffic</string>
            <string name="Source"><![CDATA[--!strict
-- City life, made on each player's own computer: cyclists, people walking,
-- cars and boats moving along the lanes that the city generator laid out.
-- Nobody can crash: traffic simply waits when you are in the way.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local BikeModel = require(Shared.BikeModel)
local State = require(script.Parent.State)
local Sfx = require(script.Parent.Sfx)

local M = Config.M
local player = Players.LocalPlayer

local Traffic = {}

local folder = Instance.new("Folder")
folder.Name = "Traffic"
folder.Parent = Workspace

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = true

-- Lanes --------------------------------------------------------------------------------
type Lane = {
	kind: string,
	pts: { Vector3 },
	cum: { number },
	len: number,
	loop: boolean,
	width: number,
	oneway: boolean,
	j0: number,
	j1: number,
}

local laneCache: { [string]: { Lane } } = {}

local function makeLane(kind: string, raw: { { number } }, origin: Vector3, loop: boolean): Lane?
	local pts: { Vector3 } = {}
	for _, p in raw do
		table.insert(pts, origin + Vector3.new(p[1], p[2], p[3]))
	end
	if loop then
		table.insert(pts, pts[1])
	end
	local cum = { 0 }
	for i = 2, #pts do
		cum[i] = cum[i - 1] + (pts[i] - pts[i - 1]).Magnitude
	end
	local len = cum[#cum]
	if len < 10 then
		return nil
	end
	return { kind = kind, pts = pts, cum = cum, len = len, loop = loop, width = 0, oneway = false, j0 = 0, j1 = 0 }
end

-- lanes that meet at each junction (per kind), for turning onto the next street
local junctions: { [string]: { [number]: { Lane } } } = {}
local byKind: { [string]: { Lane } } = {}

local function index(lanes: { Lane })
	table.clear(junctions)
	table.clear(byKind)
	for _, l in lanes do
		local kind = byKind[l.kind]
		if not kind then
			kind = {}
			byKind[l.kind] = kind
		end
		table.insert(kind, l)
		local j = junctions[l.kind]
		if not j then
			j = {}
			junctions[l.kind] = j
		end
		for _, id in { l.j0, l.j1 } do
			if id ~= 0 then
				local list = j[id]
				if not list then
					list = {}
					j[id] = list
				end
				table.insert(list, l)
			end
		end
	end
end

local function lanesFor(city: string): { Lane }
	local cached = laneCache[city]
	if cached then
		return cached
	end
	local lanes: { Lane } = {}
	local ok, err = pcall(function()
		local origin = Config.HubOrigin
		local mod: ModuleScript? = nil
		if city == "hub" then
			mod = Shared.Cities.Hub
		else
			for _, c in Config.Cities do
				if c.id == city then
					origin = c.origin
					mod = Shared.Cities:FindFirstChild(c.module) :: ModuleScript?
				end
			end
		end
		if mod then
			local gen = (require :: any)(mod)
			if gen.lanes then
				-- real cities: lanes come straight from the map data
				local wl = gen.data.meta.waterLevel
				for _, l in gen.lanes() do
					local raw = {}
					for i = 1, #l.xs do
						table.insert(raw, { l.xs[i], (l.y or (wl + 0.2)) + 0.2, l.zs[i] })
					end
					local lane = makeLane(l.kind, raw, origin, false)
					if lane then
						lane.width = l.width
						lane.oneway = l.oneway
						lane.j0 = l.j0
						lane.j1 = l.j1
						table.insert(lanes, lane)
					end
				end
			else
				-- the hub: its generator is quick and deterministic
				local b = gen.generate()
				for _, l in b.lanes do
					local lane = makeLane(l.kind, l.pts, origin, l.loop == true)
					if lane then
						table.insert(lanes, lane)
					end
				end
			end
		end
	end)
	if not ok then
		warn("[Bike the World] traffic lanes failed: " .. tostring(err))
	end
	laneCache[city] = lanes
	return lanes
end

--- Position and direction at distance s along a lane.
local function laneAt(lane: Lane, s: number): (Vector3, Vector3)
	local cum = lane.cum
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local a, b = lane.pts[lo], lane.pts[hi]
	local segLen = cum[hi] - cum[lo]
	local t = if segLen > 0 then math.clamp((s - cum[lo]) / segLen, 0, 1) else 0
	local dir = b - a
	local flat = Vector3.new(dir.X, 0, dir.Z)
	return a:Lerp(b, t), if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
end

-- Looks ---------------------------------------------------------------------------------
local SKIN = { Color3.fromRGB(255, 220, 190), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 134, 94), Color3.fromRGB(141, 85, 54), Color3.fromRGB(96, 60, 40) }
local SHIRTS = { Color3.fromRGB(230, 70, 70), Color3.fromRGB(60, 130, 230), Color3.fromRGB(250, 200, 50), Color3.fromRGB(80, 190, 110), Color3.fromRGB(240, 130, 190), Color3.fromRGB(250, 250, 250), Color3.fromRGB(40, 40, 50), Color3.fromRGB(255, 140, 40), Color3.fromRGB(140, 90, 210) }
local PANTS = { Color3.fromRGB(40, 60, 110), Color3.fromRGB(30, 30, 35), Color3.fromRGB(110, 90, 70), Color3.fromRGB(80, 80, 90) }
local HAIR = { Color3.fromRGB(30, 22, 18), Color3.fromRGB(90, 60, 30), Color3.fromRGB(220, 180, 90), Color3.fromRGB(150, 60, 30), Color3.fromRGB(200, 200, 200) }
local BIKE_COLS = { Color3.fromRGB(25, 25, 28), Color3.fromRGB(30, 60, 120), Color3.fromRGB(150, 30, 30), Color3.fromRGB(40, 100, 60), Color3.fromRGB(220, 220, 220), Color3.fromRGB(120, 90, 160), Color3.fromRGB(230, 120, 160) }
local CAR_COLS = { Color3.fromRGB(200, 40, 40), Color3.fromRGB(30, 70, 160), Color3.fromRGB(230, 230, 230), Color3.fromRGB(40, 40, 45), Color3.fromRGB(120, 125, 130), Color3.fromRGB(40, 120, 70) }

local function pick<T>(list: { T }): T
	return list[math.random(1, #list)]
end

local function part(size: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?): BasePart
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = folder
	return p
end

--- A limb between two points.
local function limb(a: Vector3, b: Vector3): CFrame
	if (b - a).Magnitude < 1e-3 then
		return CFrame.new(a)
	end
	return CFrame.lookAt((a + b) / 2, b)
end

-- NPC bikes: the normal bike model, taken apart so we can move it cheaply ----------------
type BikeRig = {
	parts: { BasePart },
	body: { number },
	offset: { CFrame },
	c0: { CFrame }, -- rear, crank, steer, front
	grips: { CFrame }, -- in the steer frame
	saddle: Vector3, -- in the ground frame
	style: string,
	rider: { BasePart }, -- torso, head, armL, armR, thighL, shinL, thighR, shinR
	tilt: number,
}

local function rigBike(style: string): BikeRig
	local look: BikeModel.Look = { style = style, color = pick(BIKE_COLS), wheel = if style == "bmx" then 0.26 else 0.34, cosmetics = { flowers = math.random() < 0.15 } }
	local m = BikeModel.build(look, CFrame.new(), nil)
	local root = m.PrimaryPart :: BasePart
	local motors: { [string]: Motor6D } = {}
	local parentOf: { [BasePart]: BasePart } = {}
	for _, d in m:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		elseif d:IsA("WeldConstraint") and d.Part0 and d.Part1 then
			parentOf[d.Part1 :: BasePart] = d.Part0 :: BasePart
		end
	end
	local bodyIndex: { [BasePart]: number } = { [root] = 1 }
	local order = { "RearWheel", "Crank", "SteerJoint", "FrontWheel" }
	local c0: { CFrame } = {}
	for i, name in order do
		local mo = motors[name]
		bodyIndex[mo.Part1 :: BasePart] = i + 1
		c0[i] = mo.C0
	end
	local rig: BikeRig = { parts = {}, body = {}, offset = {}, c0 = c0, grips = {}, saddle = Vector3.new(0, 3.3, 0), style = style, rider = {}, tilt = 0.35 }
	local steerPart = motors.SteerJoint.Part1 :: BasePart
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local q: BasePart? = d
			while q and not bodyIndex[q] do
				q = parentOf[q]
			end
			if q then
				table.insert(rig.parts, d)
				table.insert(rig.body, bodyIndex[q])
				table.insert(rig.offset, q.CFrame:Inverse() * d.CFrame)
			end
			if d.Name == "GripL" or d.Name == "GripR" then
				table.insert(rig.grips, steerPart.CFrame:Inverse() * d.CFrame)
			elseif d.Name == "Saddle" then
				rig.saddle = d.Position
			end
		end
	end
	-- take it apart: everything anchored, nothing joined
	for _, d in m:GetDescendants() do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Trail") or d:IsA("Attachment") then
			d:Destroy()
		elseif d:IsA("Seat") then
			d.Disabled = true
		end
	end
	for _, p in rig.parts do
		p.Anchored = true
		p.CanQuery = false
		p.CastShadow = false
	end
	root:Destroy()
	m.Parent = folder
	-- a simple rider
	local skin, shirt, pants = pick(SKIN), pick(SHIRTS), pick(PANTS)
	rig.tilt = if style == "racer" then 0.8 elseif style == "bmx" then 0.5 else 0.25
	rig.rider = {
		part(Vector3.new(1.5, 1.8, 0.8), shirt),
		part(Vector3.new(1.15, 1.15, 1.15), skin, nil, Enum.PartType.Ball),
		part(Vector3.new(0.4, 0.4, 2.2), shirt),
		part(Vector3.new(0.4, 0.4, 2.2), shirt),
		part(Vector3.new(0.55, 0.55, 1.55), pants),
		part(Vector3.new(0.45, 0.45, 1.55), pants),
		part(Vector3.new(0.55, 0.55, 1.55), pants),
		part(Vector3.new(0.45, 0.45, 1.55), pants),
		part(Vector3.new(1.2, 0.5, 1.2), if math.random() < 0.4 then pick(SHIRTS) else pick(HAIR)),
	}
	return rig
end

local L1, L2 = 1.55, 1.55 -- thigh and shin length (studs)

local function knee(hip: Vector3, foot: Vector3, fwd: Vector3): Vector3
	local d = foot - hip
	local dist = math.clamp(d.Magnitude, 0.2, L1 + L2 - 0.01)
	local u = d.Unit
	local a = (L1 * L1 - L2 * L2 + dist * dist) / (2 * dist)
	local h = math.sqrt(math.max(0, L1 * L1 - a * a))
	-- bend the knee forwards
	local side = u:Cross(fwd)
	local perp = side:Cross(u)
	if perp.Magnitude < 1e-3 then
		perp = fwd
	end
	perp = perp.Unit
	if perp:Dot(fwd) < 0 then
		perp = -perp
	end
	return hip + u * a + perp * h
end

local function poseBike(rig: BikeRig, ground: CFrame, wheel: number, crank: number, steer: number, lean: number, outP: { BasePart }, outC: { CFrame })
	local leaned = ground * CFrame.Angles(0, 0, -lean)
	local rootCF = leaned * CFrame.new(0, BikeModel.RootHeight, 0)
	local steerCF = rootCF * rig.c0[3] * CFrame.Angles(0, -steer, 0)
	local bodies = {
		rootCF,
		rootCF * rig.c0[1] * CFrame.Angles(-wheel, 0, 0),
		rootCF * rig.c0[2] * CFrame.Angles(-crank, 0, 0),
		steerCF,
		steerCF * rig.c0[4] * CFrame.Angles(-wheel, 0, 0),
	}
	for i, p in rig.parts do
		table.insert(outP, p)
		table.insert(outC, bodies[rig.body[i]] * rig.offset[i])
	end
	-- rider
	local r = rig.rider
	local up = Vector3.new(0, math.cos(rig.tilt), -math.sin(rig.tilt))
	local hip = rig.saddle + Vector3.new(0, 0.45, 0.1)
	local shoulder = hip + up * 1.75
	local fwdL = Vector3.new(0, 0, -1)
	local function w(v: Vector3): Vector3
		return leaned:PointToWorldSpace(v)
	end
	local torsoCF = leaned * (CFrame.new(hip + up * 0.9) * CFrame.Angles(-rig.tilt, 0, 0))
	table.insert(outP, r[1])
	table.insert(outC, torsoCF)
	table.insert(outP, r[2])
	table.insert(outC, CFrame.new(w(hip + up * 2.35)))
	table.insert(outP, r[9])
	table.insert(outC, leaned * (CFrame.new(hip + up * 2.75) * CFrame.Angles(-rig.tilt, 0, 0)))
	for k, side in { -1, 1 } do
		local grip = if rig.grips[k] then (steerCF * rig.grips[k]).Position else w(shoulder + Vector3.new(side * 0.6, -0.8, -1))
		local sh = w(shoulder + Vector3.new(side * 0.8, -0.15, 0))
		table.insert(outP, r[2 + k])
		table.insert(outC, limb(sh, grip))
		local h = hip + Vector3.new(side * 0.45, 0, 0)
		local pedal = BikeModel.pedalOffset(rig.style, crank, side) + Vector3.new(0, 0.15, 0)
		local kn = knee(h, pedal, fwdL)
		table.insert(outP, r[3 + k * 2])
		table.insert(outC, limb(w(h), w(kn)))
		table.insert(outP, r[4 + k * 2])
		table.insert(outC, limb(w(kn), w(pedal)))
	end
end

-- Pedestrians, cars and boats ---------------------------------------------------------------
type Static = { parts: { BasePart }, offset: { CFrame } }

local function makeStatic(list: { { any } }): Static
	-- each entry: {size, color, material, local CFrame, shape?}
	local s: Static = { parts = {}, offset = {} }
	for _, e in list do
		local p = part(e[1], e[2], e[3], e[5])
		table.insert(s.parts, p)
		table.insert(s.offset, e[4])
	end
	return s
end

local function makeCar(city: string): Static
	local taxi = city == "newyork" and math.random() < 0.5
	local body = if taxi then Color3.fromRGB(250, 200, 30) else pick(CAR_COLS)
	local glass = Color3.fromRGB(60, 80, 100)
	local list: { { any } } = {
		{ Vector3.new(6, 2, 13), body, Enum.Material.SmoothPlastic, CFrame.new(0, 2, 0) },
		{ Vector3.new(5.6, 1.9, 6.5), glass, Enum.Material.Glass, CFrame.new(0, 3.9, 0.6) },
		{ Vector3.new(5.7, 0.3, 6.2), body, Enum.Material.SmoothPlastic, CFrame.new(0, 4.9, 0.6) },
		{ Vector3.new(0.8, 0.6, 0.2), Color3.fromRGB(255, 250, 220), Enum.Material.Neon, CFrame.new(-2.1, 2.3, -6.5) },
		{ Vector3.new(0.8, 0.6, 0.2), Color3.fromRGB(255, 250, 220), Enum.Material.Neon, CFrame.new(2.1, 2.3, -6.5) },
		{ Vector3.new(0.8, 0.5, 0.2), Color3.fromRGB(200, 20, 20), Enum.Material.Neon, CFrame.new(-2.1, 2.3, 6.5) },
		{ Vector3.new(0.8, 0.5, 0.2), Color3.fromRGB(200, 20, 20), Enum.Material.Neon, CFrame.new(2.1, 2.3, 6.5) },
	}
	for _, x in { -2.8, 2.8 } do
		for _, z in { -4.2, 4.2 } do
			table.insert(list, { Vector3.new(0.8, 2.4, 2.4), Color3.fromRGB(25, 25, 25), Enum.Material.Rubber, CFrame.new(x, 1.2, z), Enum.PartType.Cylinder } :: { any })
		end
	end
	if taxi then
		table.insert(list, { Vector3.new(1.6, 0.6, 0.8), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, CFrame.new(0, 5.35, 0.6) } :: { any })
	end
	return makeStatic(list)
end

local function makeBoat(city: string): Static
	local hull = pick({ Color3.fromRGB(30, 40, 60), Color3.fromRGB(120, 30, 30), Color3.fromRGB(230, 230, 230) })
	if city == "amsterdam" then
		-- a low open canal boat (it has to fit under the bridges) with people on board
		local wood = Color3.fromRGB(110, 80, 55)
		local list: { { any } } = {
			{ Vector3.new(6.5, 1.4, 20), hull, Enum.Material.SmoothPlastic, CFrame.new(0, 0.2, 0) },
			{ Vector3.new(5.6, 0.3, 17), wood, Enum.Material.WoodPlanks, CFrame.new(0, 0.95, 0) },
		}
		for k = -1, 1 do
			table.insert(list, { Vector3.new(1.3, 1.3, 0.9), pick(SHIRTS), Enum.Material.SmoothPlastic, CFrame.new(-1.3, 1.7, k * 5) } :: { any })
			table.insert(list, { Vector3.new(0.9, 0.9, 0.9), pick(SKIN), Enum.Material.SmoothPlastic, CFrame.new(-1.3, 2.7, k * 5), Enum.PartType.Ball } :: { any })
		end
		return makeStatic(list)
	end
	return makeStatic({
		{ Vector3.new(8, 2.4, 34), hull, Enum.Material.SmoothPlastic, CFrame.new(0, 0.6, 0) },
		{ Vector3.new(7, 2.6, 24), Color3.fromRGB(150, 190, 210), Enum.Material.Glass, CFrame.new(0, 3.1, 1) },
		{ Vector3.new(7.2, 0.3, 24.4), Color3.fromRGB(240, 240, 240), Enum.Material.SmoothPlastic, CFrame.new(0, 4.5, 1) },
		{ Vector3.new(0.2, 1.6, 2.4), Color3.fromRGB(230, 60, 50), Enum.Material.Fabric, CFrame.new(0, 2.8, 16) },
	})
end

local function makeTram(): Static
	-- an Amsterdam tram: white and blue, two linked cars
	local white, blue = Color3.fromRGB(236, 236, 232), Color3.fromRGB(30, 70, 150)
	local list: { { any } } = {}
	for _, z in { -8.5, 8.5 } do
		table.insert(list, { Vector3.new(7.2, 8.4, 16.6), white, Enum.Material.SmoothPlastic, CFrame.new(0, 4.9, z) } :: { any })
		table.insert(list, { Vector3.new(7.3, 2.6, 16.4), Color3.fromRGB(40, 50, 60), Enum.Material.Glass, CFrame.new(0, 6.2, z) } :: { any })
		table.insert(list, { Vector3.new(7.3, 0.6, 16.4), blue, Enum.Material.SmoothPlastic, CFrame.new(0, 2.4, z) } :: { any })
		table.insert(list, { Vector3.new(2.4, 1, 5), Color3.fromRGB(60, 60, 60), Enum.Material.Metal, CFrame.new(0, 9.6, z) } :: { any })
	end
	table.insert(list, { Vector3.new(6.6, 2.4, 0.4), Color3.fromRGB(255, 220, 120), Enum.Material.Neon, CFrame.new(0, 7.6, -16.9) } :: { any })
	return makeStatic(list)
end

local function makeWalker(): Static
	local skin, shirt, pants = pick(SKIN), pick(SHIRTS), pick(PANTS)
	return makeStatic({
		{ Vector3.new(1.6, 1.8, 0.8), shirt, Enum.Material.SmoothPlastic, CFrame.new(0, 3.9, 0) },
		{ Vector3.new(1.2, 1.2, 1.2), skin, Enum.Material.SmoothPlastic, CFrame.new(0, 5.4, 0), Enum.PartType.Ball },
		{ Vector3.new(1.25, 0.5, 1.25), pick(HAIR), Enum.Material.SmoothPlastic, CFrame.new(0, 5.85, 0.05) },
		{ Vector3.new(0.6, 2.9, 0.6), pants, Enum.Material.SmoothPlastic, CFrame.new(-0.4, 1.5, 0) }, -- legs swing (index 4, 5)
		{ Vector3.new(0.6, 2.9, 0.6), pants, Enum.Material.SmoothPlastic, CFrame.new(0.4, 1.5, 0) },
		{ Vector3.new(0.45, 1.7, 0.45), shirt, Enum.Material.SmoothPlastic, CFrame.new(-1.05, 3.9, 0) }, -- arms (6, 7)
		{ Vector3.new(0.45, 1.7, 0.45), shirt, Enum.Material.SmoothPlastic, CFrame.new(1.05, 3.9, 0) },
	})
end

-- NPCs ------------------------------------------------------------------------------------------
type Npc = {
	kind: string,
	lane: Lane,
	s: number,
	dir: number,
	speed: number, -- studs/s
	cruise: number,
	y: number,
	yaw: number,
	nextRay: number,
	bike: BikeRig?,
	static: Static?,
	wheel: number,
	crank: number,
	phase: number,
	lastBell: number,
	accum: number,
}

local npcs: { Npc } = {}
local lanes: { Lane } = {}
local currentCity = ""

local COUNTS: { [string]: { [string]: number } } = {
	hub = { bike = 6 },
	amsterdam = { bike = 26, walk = 16, car = 4, boat = 4, tram = 5 },
	paris = { bike = 14, walk = 18, car = 16, boat = 3 },
	newyork = { bike = 10, walk = 22, car = 18 },
}
local SPEEDS: { [string]: { number } } = { bike = { 3.8, 5.5 }, walk = { 1.1, 1.5 }, car = { 7, 9 }, boat = { 2.2, 3 }, tram = { 5.5, 6.5 } }

local function me(): Vector3
	local ride = State.ride
	if ride.onBike then
		return ride.pos
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if hrp then hrp.Position else Workspace.CurrentCamera.CFrame.Position
end

--- Put an NPC somewhere on a lane of its kind, between minR and maxR from `near`.
local function place(n: Npc, near: Vector3, minR: number, maxR: number): boolean
	local candidates = byKind[n.kind]
	if not candidates or #candidates == 0 then
		return false
	end
	for _ = 1, 250 do
		local l = pick(candidates)
		local i = math.random(1, #l.pts)
		local d = (l.pts[i] - near)
		local flat = Vector2.new(d.X, d.Z).Magnitude
		if flat >= minR and flat <= maxR then
			n.lane = l
			n.s = l.cum[i]
			n.dir = if l.oneway or math.random() < 0.5 then 1 else -1
			n.y = l.pts[i].Y
			n.nextRay = 0
			return true
		end
	end
	return false
end

--- At the end of a street: turn onto a street that meets it, or turn round.
local function nextLane(n: Npc, j: number)
	local list = (junctions[n.kind] or {})[j]
	local options = {}
	if list then
		for _, l in list do
			if l ~= n.lane then
				if l.j0 == j then
					table.insert(options, { l, 0, 1 })
				elseif l.j1 == j and not l.oneway then
					table.insert(options, { l, l.len, -1 })
				end
			end
		end
	end
	if #options > 0 then
		local o = pick(options)
		n.lane = o[1]
		n.s = o[2]
		n.dir = o[3]
	else
		n.dir = -n.dir
		n.s = math.clamp(n.s, 0, n.lane.len)
	end
end

local function destroyNpc(n: Npc)
	if n.bike then
		for _, p in n.bike.parts do
			p:Destroy()
		end
		for _, p in n.bike.rider do
			p:Destroy()
		end
	end
	if n.static then
		for _, p in n.static.parts do
			p:Destroy()
		end
	end
end

local function clear()
	for _, n in npcs do
		destroyNpc(n)
	end
	table.clear(npcs)
	folder:ClearAllChildren()
end

local function spawnFor(city: string)
	clear()
	currentCity = city
	lanes = lanesFor(city)
	index(lanes)
	local counts: { [string]: number } = COUNTS[city] or {}
	local near = me()
	for kind, count in counts do
		for _ = 1, count do
			local range = SPEEDS[kind] or { 2, 3 }
			local n: Npc = {
				kind = kind,
				lane = lanes[1],
				s = 0,
				dir = 1,
				speed = 0,
				cruise = (range[1] + math.random() * (range[2] - range[1])) * M,
				y = 0,
				yaw = 0,
				nextRay = 0,
				bike = nil,
				static = nil,
				wheel = 0,
				crank = math.random() * 6,
				phase = math.random() * 6,
				lastBell = 0,
				accum = 0,
			}
			if not lanes[1] or not place(n, near, 0, 380) then
				continue
			end
			n.speed = n.cruise
			if kind == "bike" then
				local style = if city == "amsterdam" then pick({ "city", "city", "city", "cargo", "racer" }) else pick({ "city", "racer", "bmx", "city" })
				n.bike = rigBike(style)
			elseif kind == "car" then
				n.static = makeCar(city)
			elseif kind == "boat" then
				n.static = makeBoat(city)
			elseif kind == "tram" then
				n.static = makeTram()
			else
				n.static = makeWalker()
			end
			table.insert(npcs, n)
		end
	end
end

local outP: { BasePart } = {}
local outC: { CFrame } = {}

local function update(dt: number)
	local city = State.city()
	if city ~= currentCity then
		spawnFor(city)
		return
	end
	if dt <= 0 or #npcs == 0 then
		return
	end
	table.clear(outP)
	table.clear(outC)
	local mePos = me()
	local cam = Workspace.CurrentCamera.CFrame.Position
	local world = Workspace:FindFirstChild("World")
	if world then
		groundParams.FilterDescendantsInstances = { world, Workspace.Terrain }
	end
	local now = os.clock()
	for _, n in npcs do
		local lane = n.lane
		local p, tangent = laneAt(lane, n.s)
		local dist = (Vector2.new(p.X - cam.X, p.Z - cam.Z)).Magnitude
		-- far away ones update less often
		n.accum += dt
		local step = if dist < 260 then 0 elseif dist < 600 then 0.1 else 0.4
		if n.accum < step then
			continue
		end
		local ndt = n.accum
		n.accum = 0
		-- too far from the player: move it somewhere closer
		if (Vector2.new(p.X - mePos.X, p.Z - mePos.Z)).Magnitude > 650 then
			place(n, mePos, 220, 450)
			continue
		end
		-- wait for the player if they are in the way
		local dirVec = tangent * n.dir
		local toMe = Vector3.new(mePos.X - p.X, 0, mePos.Z - p.Z)
		local ahead = toMe:Dot(dirVec)
		local side = (toMe - dirVec * ahead).Magnitude
		local blockAt = if n.kind == "car" then 26 elseif n.kind == "boat" or n.kind == "tram" then 45 else 10
		local target = n.cruise
		if ahead > 0 and ahead < blockAt and side < (if n.kind == "car" then 7 else 4) then
			target = 0
			if n.kind == "bike" and now - n.lastBell > 4 and n.bike then
				n.lastBell = now
				Sfx.bell(n.bike.parts[1])
			end
		end
		n.speed += (target - n.speed) * math.min(1, ndt * 3)
		-- move along the lane
		n.s += n.speed * n.dir * ndt
		if lane.loop then
			n.s %= lane.len
		elseif n.s > lane.len then
			n.s = lane.len
			nextLane(n, lane.j1)
		elseif n.s < 0 then
			n.s = 0
			nextLane(n, lane.j0)
		end
		lane = n.lane
		p, tangent = laneAt(lane, n.s)
		local heading = tangent * n.dir
		local targetYaw = math.atan2(-heading.X, -heading.Z)
		local dy = (targetYaw - n.yaw + math.pi) % (2 * math.pi) - math.pi
		n.yaw += dy * math.min(1, ndt * 6)
		-- keep to the right a little
		local right = Vector3.new(-heading.Z, 0, heading.X)
		local offset = 0
		if n.kind == "car" then
			offset = if lane.oneway then 0 else lane.width / 4
		elseif n.kind == "bike" then
			offset = if lane.width > 4 * M then lane.width / 2 - 1.3 * M else 0.5
		elseif n.kind == "walk" then
			offset = 0.8
		elseif n.kind == "boat" then
			offset = 3
		end
		p += right * offset
		-- find the ground (not for boats)
		if n.kind ~= "boat" and n.kind ~= "tram" and now > n.nextRay then
			n.nextRay = now + (if dist < 260 then 0.12 else 0.5)
			local hit = Workspace:Raycast(Vector3.new(p.X, n.y + 8, p.Z), Vector3.new(0, -30, 0), groundParams)
			if hit then
				n.y = hit.Position.Y
			else
				n.y = p.Y
			end
		elseif n.kind == "boat" or n.kind == "tram" then
			n.y = p.Y - 0.2
		end
		local ground = CFrame.new(p.X, n.y, p.Z) * CFrame.Angles(0, n.yaw, 0)
		if n.bike then
			local sp = n.speed / M
			n.wheel += sp * ndt / 0.34
			if sp > 0.3 then
				n.crank += sp / 4.3 * math.pi * 2 * ndt
			end
			poseBike(n.bike, ground, n.wheel, n.crank, math.clamp(-dy * 2, -0.4, 0.4), math.clamp(-dy * 1.5, -0.3, 0.3), outP, outC)
		elseif n.static then
			local st = n.static
			local swing = 0
			if n.kind == "walk" then
				n.phase += n.speed / M * ndt * 3.2
				swing = math.sin(n.phase) * 0.5 * math.min(1, n.speed / M)
			end
			for i, prt in st.parts do
				local off = st.offset[i]
				if n.kind == "walk" and i >= 4 then
					-- legs and arms swing around the hip/shoulder
					local sgn = if i == 4 or i == 7 then 1 else -1
					local pivotY = if i <= 5 then 2.95 else 4.7
					local o = off.Position
					local pivot = Vector3.new(o.X, pivotY, o.Z)
					off = CFrame.new(pivot) * CFrame.Angles(swing * sgn, 0, 0) * CFrame.new(o - pivot)
				end
				table.insert(outP, prt)
				table.insert(outC, ground * off)
			end
		end
	end
	if #outP > 0 then
		Workspace:BulkMoveTo(outP, outC, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Traffic.init()
	RunService.Heartbeat:Connect(update)
end

return Traffic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">TravelUI</string>
            <string name="Source"><![CDATA[--!strict
-- The travel menu: jump to any city, see which landmarks you have found
-- (your "passport"), or get unstuck.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)

local C = Ui.Colors
local player = Players.LocalPlayer

local TravelUI = {}

local win: Frame
local content: Frame
local unstuck: () -> () = function() end

local FLAGS: { [string]: string } = { hub = "🌍", amsterdam = "🇳🇱", paris = "🇫🇷", newyork = "🇺🇸" }

local function render()
	for _, ch in content:GetChildren() do
		if ch.Name == "Grid" then
			ch:Destroy()
		end
	end
	local p = State.profile
	local grid = Ui.grid(content, Vector2.new(230, 330))
	grid.Name = "Grid"
	grid.Size = UDim2.new(1, 0, 1, -50)
	local worlds = { { id = "hub", name = "World Bike Hub", country = "Practice loop & shop", color = C.green } }
	for _, c in Config.Cities do
		table.insert(worlds, { id = c.id, name = c.name, country = c.country, color = c.color })
	end
	local here = State.city()
	for i, w in worlds do
		local f = Ui.new("Frame", { BackgroundColor3 = C.panel, LayoutOrder = i, Parent = grid }) :: Frame
		Ui.corner(f, 16)
		Ui.stroke(f, w.color, 4)
		Ui.label({ Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 44), Text = (FLAGS[w.id] or "🏙️") .. " " .. w.name, TextColor3 = C.ink, TextStrokeTransparency = 1, MaxTextSize = 28, Parent = f })
		Ui.label({ Position = UDim2.fromOffset(8, 50), Size = UDim2.new(1, -16, 0, 20), Text = w.country, TextColor3 = C.grey, TextStrokeTransparency = 1, Font = Enum.Font.GothamBold, MaxTextSize = 15, Parent = f })
		-- passport stamps
		local list = Ui.new("Frame", { Position = UDim2.fromOffset(12, 76), Size = UDim2.new(1, -24, 1, -134), BackgroundTransparency = 1, Parent = f })
		Ui.new("UIListLayout", { Padding = UDim.new(0, 2), Parent = list })
		local found, total = 0, 0
		if p then
			for _, l in p.landmarkList do
				if l.city == w.id then
					total += 1
					local got = p.landmarks[l.id] == true
					if got then
						found += 1
					end
					Ui.label({
						Size = UDim2.new(1, 0, 0, 20),
						Text = if got then "✅ " .. l.name else "❓ ???",
						TextColor3 = if got then C.ink else C.grey,
						TextStrokeTransparency = 1,
						TextXAlignment = Enum.TextXAlignment.Left,
						Font = Enum.Font.GothamBold,
						MaxTextSize = 15,
						Parent = list,
					})
				end
			end
		end
		if total > 0 then
			Ui.label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -56), Size = UDim2.new(1, -24, 0, 20), Text = string.format("📍 %d / %d landmarks", found, total), TextColor3 = C.orange, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 17, Parent = f })
		elseif w.id ~= "hub" then
			Ui.label({ Position = UDim2.fromOffset(12, 80), Size = UDim2.new(1, -24, 0, 40), Text = "Being built... 🧱", TextColor3 = C.grey, TextStrokeTransparency = 1, MaxTextSize = 18, Parent = f })
		end
		local isHere = here == w.id
		local b = Ui.button(if isHere then "You are here" else "Go! 🚲", if isHere then C.grey else w.color, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -10),
			Size = UDim2.new(1, -24, 0, 42),
			MaxTextSize = 24,
			Parent = f,
		})
		if not isHere then
			b.Activated:Connect(function()
				State.remote("GoToCity"):FireServer(w.id)
				win.Visible = false
			end)
		end
	end
end

function TravelUI.toggle()
	win.Visible = not win.Visible
	if win.Visible then
		render()
	end
end

function TravelUI.init(onUnstuck: () -> ())
	unstuck = onUnstuck
	local gui = Ui.new("ScreenGui", { Name = "Travel", ResetOnSpawn = false, DisplayOrder = 5, Parent = player:WaitForChild("PlayerGui") })
	win, content = Ui.window(gui, "🌍 Where do you want to ride?", C.blue)
	Ui.label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, -4),
		Size = UDim2.new(0.4, 0, 0, 18),
		Text = "City maps © OpenStreetMap contributors",
		TextColor3 = C.grey,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.GothamMedium,
		MaxTextSize = 13,
		Parent = content,
	})
	local stuck = Ui.button("😵 I'm stuck!", C.orange, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(200, 42), MaxTextSize = 22, Parent = content })
	stuck.Activated:Connect(function()
		win.Visible = false
		unstuck()
	end)
	State.profileChanged.Event:Connect(function()
		if win.Visible then
			render()
		end
	end)
end

return TravelUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[--!strict
-- Small helpers for building a bright, chunky, kid-friendly UI in code.

local TweenService = game:GetService("TweenService")

local Ui = {}

Ui.Font = Enum.Font.FredokaOne
Ui.Colors = {
	panel = Color3.fromRGB(255, 255, 255),
	panelDark = Color3.fromRGB(32, 40, 62),
	ink = Color3.fromRGB(40, 44, 60),
	blue = Color3.fromRGB(48, 120, 255),
	green = Color3.fromRGB(46, 196, 104),
	orange = Color3.fromRGB(255, 150, 30),
	red = Color3.fromRGB(240, 70, 70),
	purple = Color3.fromRGB(150, 90, 230),
	gold = Color3.fromRGB(255, 200, 40),
	grey = Color3.fromRGB(150, 156, 170),
	light = Color3.fromRGB(240, 244, 252),
}

--- Create an instance with properties and children.
function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className) :: any
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Ui.corner(parent: Instance, radius: number?): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 14), Parent = parent })
end

function Ui.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or Color3.fromRGB(20, 24, 40),
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Ui.pad(parent: Instance, px: number)
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		Parent = parent,
	})
end

--- A text label with the game font and an outline.
function Ui.label(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = Ui.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		TextStrokeTransparency = 0.6,
	}
	for k, v in props do
		base[k] = v
	end
	local maxText = base.MaxTextSize or 40
	base.MaxTextSize = nil
	local l = Ui.new("TextLabel", base) :: TextLabel
	if l.TextScaled then
		Ui.new("UITextSizeConstraint", { MaxTextSize = maxText, Parent = l })
	end
	return l
end

--- A big round button that squishes when pressed.
function Ui.button(text: string, color: Color3, props: { [string]: any }?): TextButton
	local base: { [string]: any } = {
		BackgroundColor3 = color,
		Font = Ui.Font,
		Text = text,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		AutoButtonColor = true,
		TextStrokeTransparency = 0.7,
	}
	local extra: { [string]: any } = props or {}
	for k, v in extra do
		base[k] = v
	end
	local maxText = base.MaxTextSize or 30
	base.MaxTextSize = nil
	local b = Ui.new("TextButton", base) :: TextButton
	Ui.corner(b, 14)
	Ui.stroke(b, Color3.fromRGB(20, 24, 40), 2.5)
	Ui.new("UITextSizeConstraint", { MaxTextSize = maxText, Parent = b })
	Ui.new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = b })
	local scale = Ui.new("UIScale", { Parent = b }) :: UIScale
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	local function up()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	b.MouseButton1Up:Connect(up)
	b.MouseLeave:Connect(up)
	return b
end

--- Pop an element bigger for a moment (for coins, rewards...).
function Ui.pop(guiObject: GuiObject, amount: number?)
	local scale = guiObject:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Parent = guiObject })
	scale.Scale = amount or 1.25
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

function Ui.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

--- A centred pop-up window with a title and a close button.
--- Returns the window and the frame to put content in.
function Ui.window(parent: Instance, title: string, accent: Color3): (Frame, Frame)
	local win = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(0.94, 0.84),
		BackgroundColor3 = Ui.Colors.light,
		Visible = false,
		Parent = parent,
	}) :: Frame
	Ui.new("UISizeConstraint", { MaxSize = Vector2.new(820, 520), Parent = win })
	Ui.corner(win, 22)
	Ui.stroke(win, accent, 5)
	local head = Ui.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = accent, Parent = win })
	Ui.corner(head, 22)
	-- square off the bottom of the header
	Ui.new("Frame", { Position = UDim2.new(0, 0, 1, -22), Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = accent, BorderSizePixel = 0, Parent = head })
	Ui.label({ Position = UDim2.fromOffset(18, 6), Size = UDim2.new(1, -90, 0, 44), Text = title, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 34, TextStrokeTransparency = 0.5, ZIndex = 2, Parent = head })
	local close = Ui.button("✕", Ui.Colors.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(44, 40), ZIndex = 2, MaxTextSize = 26, Parent = head })
	close.Activated:Connect(function()
		win.Visible = false
	end)
	local content = Ui.new("Frame", { Position = UDim2.fromOffset(12, 64), Size = UDim2.new(1, -24, 1, -74), BackgroundTransparency = 1, Parent = win }) :: Frame
	return win, content
end

--- A scrolling grid for cards.
function Ui.grid(parent: Instance, cell: Vector2): ScrollingFrame
	local sf = Ui.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Ui.Colors.grey,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}) :: ScrollingFrame
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = sf,
	})
	Ui.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = sf })
	return sf
end

--- 1234567 -> "1,234,567"
function Ui.commas(n: number): string
	local s = tostring(math.floor(n))
	local out = s
	while true do
		local k
		out, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return out
end

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
