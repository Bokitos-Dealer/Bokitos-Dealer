{
  "name": "BikeTheWorld",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterJumpHeight": 7.2,
        "CameraMaxZoomDistance": 60
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1024,
        "StreamingMinRadius": 256,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "ClockTime": 13,
        "Brightness": 2.2,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 0.6,
        "OutdoorAmbient": [0.55, 0.55, 0.6],
        "Ambient": [0.2, 0.2, 0.24]
      }
    }
  }
}
